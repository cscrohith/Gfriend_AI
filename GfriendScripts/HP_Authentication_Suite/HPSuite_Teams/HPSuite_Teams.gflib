using Vision
using Info
using JediOmni
using BadgeBox
using HPSuite_Teams.gfvar

SetupAzureVision(${AzureEndpoint},${SubscriptionKey})
{
    //${AzureEndpoint} is a variable from AzureVariables.gfvar file which has actual value of the Azure Endpoint , ${AzureEndpointEncryptedValue} stores the encrypted value of Azure Endpoint
     Encrypt(${AzureEndpoint},${AzureEndpointEncryptedValue})
    //${SubscriptionKey} is a variable from AzureVariables.gfvar file which has actual value of the Subscription Key , ${SubscriptionKeyEncryptedValue} stores the encrypted value of Subscription Key
    Encrypt(${SubscriptionKey},${SubscriptionKeyEncryptedValue})
    //Pass the encrypted values of Azure Endpoint and Subscription key in the Set OCR Method Keyword
    //1.If the endpoint and subscriptionkey are encrypted in the Encrypted Variables form , then pass the 3rd parameter as "UI" 
    //2.If the endpoint and subscriptionkey are encrypted using Encrypt Keyword , then pass the 3rd parameter as "ENCRYPT"
    Vision.Set OCR Method(${AzureEndpointEncryptedValue},${SubscriptionKeyEncryptedValue},ENCRYPT)
    Vision.Set Target (JediOmni)
    Vision.Set Text Grouping (word)
}

Authentication(${BADGE_INDEX})
{
   HPSuite_Teams.ClearAuth
   HPSuite_Teams.BadgeBoxSignIn(${BADGE_INDEX})
}

BadgeBoxSignIn(${BADGE_INDEX})
{
    Info.Start Time Check (STF_Authentication)
    Info.Start Time Check (STF_EnterCredentials)
    Info.Start Time Check (STF_AppButtonPress)
    Info.Start Time Check (STF_AppShown)
    Info.Mark End (STF_AppButtonPress,2)
    
    Info.Mark Start (STF_Authentication,4)
    Sleep (2)

    Info.Mark Start (STF_EnterCredentials,4)
    BadgeBox.Scan Badge (${BADGE_INDEX})
    Info.Mark End (STF_EnterCredentials,4)
        
    While:!Vision.Is Text Exist (Sign Out):10
    {
        Sleep (5)
    }
    If: Vision.Is Text Exist (Sign Out)
    {
        Info.Mark End (STF_Authentication,4)
    }
    Fail:
    {
        If: Vision.Is Text Exist (Exit)
        {
            Vision.Click Text (Exit)
            Return With Fail (Sign In was not Successful)
        }
        Fail:
        {
            Return With Fail (Sign In was not Successful)
        }  
    }
    Sleep (2)
    
    //Click on Teams Application
    If: Vision.Is Text Exist (Teams)
    {
        Vision.Click Text (Teams)
        Sleep (2) 
    }    
    Info.Mark End (STF_AppShown,3)
}

HPSuite_SelectTeams(${Teams_Name},${Chat_Name})
{
    While:!Vision.Is Text Exist (${Teams_Name}):30
    {
        Sleep (5)
    }
    If: Vision.Is Text Exist (${Teams_Name})
    {
        Vision.Click Text (${Teams_Name})
        Sleep (5)   
        While:!Vision.Is Text Exist (${Chat_Name}):30
        {
            Sleep (5)
        }
        If: Vision.Is Text Exist (${Chat_Name})
        {
            Vision.Click Text (${Chat_Name})         
        }
        Fail:
        {
            Return With Fail (Unable to find Teams Name ${Teams_Name})
            Stop Test Case
        }        
    }
   Fail:
   {
       Return With Fail (Unable to find Chat Names ${Teams_Name})
       Stop Test Case
   }
}

HPSuite_Teams_Print(${FileName})
{
    Info.Start Time Check (STF_ProcessingJob)
    Info.Mark Start (STF_ProcessingJob,6)
    While:!Vision.Is Text Exist (${FileName}):30
    {
        Sleep (5)
    }
    If: Vision.Is Text Exist (${FileName})
    {
        Vision.Click Text (${FileName})
        HPSuite_Teams.ClickOnPrintButton       
        Info.Mark End (STF_ProcessingJob,6)
    }
    Fail:
    { 
        Return With Fail (No Jobs found)
    }   
}
        
HPSuite_Teams_Scan()
{
    Info.Start Time Check (STF_ProcessingJob)
    Info.Mark Start (STF_ProcessingJob,6)
    While:!Vision.Is Text Exist (Scan):30
    {
        Sleep (5)
    }
    If: Vision.Is Text Exist (Scan)
    {
        Sleep (5)
        Vision.Click Text (Scan)          
    }
    Fail:
    {
        Return With Fail (Unable to find Scan Text)
    }
   
    While:!Vision.Is Text Exist (Scan_MMDDYYY):30
    {
        Sleep (5)
    }
    If: Vision.Is Text Exist (Scan_MMDDYYY)
    {  
        Get Random Number (100,100000,${random})
        Vision.Click Text (Scan_MMDDYYY)
        JediOmni.Input Text (TestFile_${random})
        HPSuite_Teams.ClickOnScanButton         
        Info.Mark End (STF_ProcessingJob,6)
    }    
    Fail:
    {
        If: Vision.Is Text Exist (Scan)
        {
            Vision.Click Text (Scan)
            Get Random Number (100,100000,${random})
            Sleep (5)
            Vision.Click Text (Scan_MMDDYYY)
            JediOmni.Input Text (TestFile_${random})
            HPSuite_Teams.ClickOnScanButton         
            Info.Mark End (STF_ProcessingJob,6)
        }
        Fail:
        {
            JediOmni.Capture Screen Shot (Scan_Fail)
            Return With Fail (Unable to click on Scan)
            Stop Test Case
        }        
    }
    HPSuite_Teams.HPSuite_Teams_Scan_Delete()
}

HPSuite_Teams_Scan_Delete()
{
    While:!Vision.Is Text Exist (...):30
    {
        Sleep (5)
    }
    If: Vision.Is Text Exist (...)
    {
        Vision.Click Text (...)    
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (Select)
        Return With Fail (Unable to find Select)
        Stop Test Case
    }
    
    While:!Vision.Is Text Exist (Delete):30
    {
        Sleep (5)
    }
    If: Vision.Is Text Exist (Delete)
    {
        Vision.Click Text (Delete)
    }
    While:!Vision.Is Text Exist (Delete):30
    {
        Sleep (5)
    }
    If: Vision.Is Text Exist (Delete)
    {
        Vision.Click Text with index (Delete,2)
    }
    Sleep (3)
    While:Vision.Is Text Exist (Cancel Job):25 
    {
        Sleep(10)   
    }
    If:Vision.Is Text Exist (Cancel Job)
    {
        JediOmni.Capture Screen Shot (Scan_Fail)
        Return With Fail (Unable to Delete Scan the Job)
        Stop Test Case
    }
}

ClearAuth
{
    JediOmni.Press Home Key
    If: JediOmni.Wait For Text (Sign In,10)
    {
        // all good, no action needed
    }
    Fail:
    {
        If: JediOmni.Touch Text (Sign Out)
        {
            JediOmni.Wait For Text Gone (Signing out,30)
        }
        Fail:
        {
            Return With Fail (Failed to Sign Out!)
        }
    }
    JediOmni.Reset
}

ClickOnScanButton 
{
   Sleep (2)
   JediOmni.Touch Position (0,0)
   Sleep (2)
   While:!Vision.Is Text Exist (Send): 10
   {
       Sleep(3)   
   }
   If:Vision.Is Text Exist (Send)
   {
       Vision.Click Text with index (Send,2)
   } 
   If: JediOmni.Wait For Text (Continue,30)
   {
       JediOmni.Touch Text (Continue)
   }
   Sleep (3)
   While:Vision.Is Text Exist (Cancel Job):25 
   {
       Sleep(10)   
   }
   If:Vision.Is Text Exist (Cancel Job)
   {
       JediOmni.Capture Screen Shot (San_Fail)
       Return With Fail (Unable to Scan the Job)
       Stop Test Case
   }
}

ClickOnPrintButton
{
   Sleep (2)
   While:Vision.Is Text Exist (Cancel Job):25 
   {
       Sleep(10)   
   }
   If:Vision.Is Text Exist (Sign Out)
   {
       JediOmni.Capture Screen Shot (Homescreen)
       Return With Fail (Unable to Print the Job)
       Stop Test Case
   }
   If:Vision.Is Text Exist (Print)
   {
      JediOmni.Capture Screen Shot (PrintScreen)
      Vision.Click Text (Print)
   }        
   Sleep (2)   
   While:Vision.Is Text Exist (Cancel Job):25 
   {
       Sleep(10)   
   }
   If:Vision.Is Text Exist (Cancel Job)
   {
       JediOmni.Capture Screen Shot (Print_Fail)
       Return With Fail (Unable to Print the Job)
       Stop Test Case
   }
}

HPSuite_Teams_Teardown()
{
   JediOmni.Press Home Key
        
   If: JediOmni.Wait For Text (Sign Out,20)
   {
        JediOmni.Touch Text (Sign Out)
   }
   Fail:
   {
        Return With Fail (Failed to Sign Out!)
   }        
}