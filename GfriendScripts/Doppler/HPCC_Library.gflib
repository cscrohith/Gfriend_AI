CheckTaskCompletion(${InstallCustomer})
{// monitor the last task for the customer until it is completed
    // access Tasks
    If: Web.Wait For Object (//div[@class='hpMenu']//descendant::a[@href='/tasks/main']/div/div/p,20)
    {
        Web.Click Object (//div[@class='hpMenu']//descendant::a[@href='/tasks/main']/div/div/p)
        Sleep (2)
    }
    Fail:
    {
        //        Web.Capture Screenshot (TaskCompletion_Fail.png)
        Return With Fail (Failed accessing Tasks!)
    }

    // wait for Tasks to show
    If: Web.Wait For Object (//div[@class='tasks']//descendant::div[@class='hpLargeTitle'],10)
    {
    }
    Fail:
    {
        //        Web.Capture Screenshot (TaskCompletion_Fail.png)
        Return With Fail (Failed accessing Tasks!)
    }

    // filter to tasks for the customer account
    If: Web.Wait For Object (//*[@id='tasksTableId']//descendant::input[@class='text-search'],10)
    {
        // enter the account in the search
        Web.Click Object(//*[@id='tasksTableId']//descendant::input[@class='text-search'])
        Web.Set Text(//*[@id='tasksTableId']//descendant::input[@class='text-search'],${InstallCustomer})
        // click on the search icon
        Web.Click Object (//*[@id='tasksTableId']//descendant::span[@class='magnifier-icon magnifier-icon-list-filter'])
        
        Sleep (5)
    }
    Fail:
    {
        //        Web.Capture Screenshot (TaskCompletion_Fail.png)
        Return With Fail (Failed filtering Tasks for the customer!)
    }

    // open the top task
    If: Web.Wait For Object (//*[@id='tasksTableId']//descendant::div[@ref='eBodyContainer']/div,20)
    {
        Web.Click Object (//*[@id='tasksTableId']//descendant::div[@ref='eBodyContainer']/div)
        Sleep (10)
    }
    Fail:
    {
        //        Web.Capture Screenshot (TaskCompletion_Fail.png)
        Return With Fail (Failed selecting the Task!)
    }
    
    // monitor for the task complete
    While:!Web.Check Text Of Object(//*[@id='taskDetailDevicesTasksTableId']//descendant::div[@ref='eBodyContainer']//descendant::div[@class='statusWithPopover']/div/span,Succeeded):90
    {
        // check for task Failed
        If: Web.Check Text Of Object(//*[@id='taskDetailDevicesTasksTableId']//descendant::div[@ref='eBodyContainer']//descendant::div[@class='statusWithPopover']/div/span,Failed)
        {
            // click on the icon to display the failure info, then get a screen capture
            Web.Click Object (//*[@id='taskDetailDevicesTasksTableId']//descendant::div[@ref='eBodyContainer']//descendant::div[@class='statusWithPopover']/div/div)
            //            Web.Capture Screenshot (HPCC Task Failure.png)
            Return With Fail (HPCC Task Failed!)
        }

        // check for task Errored
        IF: Web.Check Text Of Object(//*[@id='taskDetailDevicesTasksTableId']//descendant::div[@ref='eBodyContainer']//descendant::div[@class='statusWithPopover']/div/span,Error)
        {
            // get a screen capture
            //            Web.Capture Screenshot (HPCC Task Error.png)
            Return With Fail (HPCC Task Errored!)
        }
        Web.Refresh
        Sleep(20)
    }
    
    //Success
}

SearchAccountDevice(${Device})
{// search for a device in the device list of the current customer account
    If: Web.Wait For Object(//*[@id='accountDetailDevicesTableId']//descendant::input[@class='text-search'],20)
    {
        // page the screen down so the deivces are visible
        Web.Press PageDown Key(//*[@id='accountDetailDevicesTableId'])
        Sleep (1)
        
       // enter the device in the search
        Web.Click Object(//*[@id='accountDetailDevicesTableId']//descendant::input[@class='text-search'])
        Web.Set Text(//*[@id='accountDetailDevicesTableId']//descendant::input[@class='text-search'],${Device})
        Sleep (2)
        // click on the search icon
        Web.Click Object(//*[@id='accountDetailDevicesTableId']//descendant::span[@class='magnifier-icon magnifier-icon-list-filter'])
        Sleep (3)
//        // wait for the spinner to display then disappear
//        If: Web.Wait For Object(//*[@id='accountDetailDevicesTableId']//descendant::div[@class='hpSpinner'],5)
//        {
//            Web.Wait For Object Disappear(//*[@id='accountDetailDevicesTableId']//descendant::div[@class='hpSpinner'],20)
//        }
        // check for 1 or more devices found
        Web.Get Text (//*[@id='accountDetailDevicesTableId']//descendant::span[@id='totalItemCount'],${DeviceCount})
        If: Equals (${DeviceCount},\(0\))
        {
            //            Web.Capture Screenshot (SearchAccountDevice_Fail.png)
            Fail (Failed searching for device ${Device} in HPCC!)
        }
        Fail:
        {
        }
    }
    Fail:
    {
        //        Web.Capture Screenshot (SearchAccountDevice_Fail.png)
        Fail (Failed searching for device ${Device} in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (SearchAccountDevice_Error.png)
        Error (Error occurred searching for device ${Device} in HPCC!)
    }
    
    Sleep (3)
}

