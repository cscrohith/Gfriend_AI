Using Web

SignIn(${ID}, ${PW}, ${url}, ${BRW})
{// sign into the HPCC site with the account using the specified browser
    // open the specified browser to the HPCC url
    IF: Equals (${BRW},Default)
    {
        If: Web.Open (https://${url})
        {
        }
        Fail:
        {
            Return With Fail (Failed to open the browser!)
        }
        Error:
        {
            Return With Error (Error opening the browser!)
        }
    }
    IF: Equals (${BRW},Chrome)
    {
        If: Web.Open with Chrome (https://${url})
        {
        }
        Fail:
        {
            Return With Fail (Failed to open the browser!)
        }
        Error:
        {
            Return With Error (Error opening the browser!)
        }
    }
    IF: Equals (${BRW},FireFox)
    {
        If: Web.Open with FireFox (https://${url})
        {
        }
        Fail:
        {
            Return With Fail (Failed to open the browser!)
        }
        Error:
        {
            Return With Error (Error opening the browser!)
        }
    }
    IF: Equals (${BRW},Edge)
    {
        If: Web.Open with Edge (https://${url})
        {
        }
        Fail:
        {
            Return With Fail (Failed to open the browser!)
        }
        Error:
        {
            Return With Error (Error opening the browser!)
        }
    }

    // sign in
    //    If: Web.Wait For Object(//*[@id='username'],30)
    If: Web.Wait For Object(//*[@id='username'],30)
    {
        Sleep (1)
        Web.Click Object(//*[@id='username'])
        Web.Set Text(//*[@id='username'],${ID})
        Web.Click Object(//button)
    }
    Fail:
    {
        Return With Fail (Failed to access the HPCC sign in page!)
    }
   
    // enter the password
    If: Web.Wait For Object(//*[@id='passwordContainer'],30)
    {
        Web.Click Object(//*[@id='password'])
        Web.Set Text(//*[@id='password'],${PW})
        Web.Click Object(//button)
    }
    Fail:
    {
        Return With Fail (Failed to reach Password page!)
    }
    
    // check that reached the Command Center page
    If: Web.Wait For Object (//div[@class='logoName hpSimplifiedBold'],60)
    {
        // handle the updated Terms of Service pages if displayed
        If: Web.Wait For Text (Please accept the updated Terms of Service and data collection policy,0)
        {
            Web.Click Object (//*[@id='nextButton'])
            // terms of service page
            Web.Wait For Text (Please read the following terms of service.,20)
            Web.Click Object (//input[@id='termsOfServiceCheckbox']/parent::*)
            Web.Click Object (//*[@id='nextButton'])
            // data collection privacy page
            Web.Wait For Text (Please read the following data collection information.,20)
            Web.Click Object (//input[@id='dataCollectionCheckbox']/parent::*)
            Web.Click Object (//*[@id='nextButton'])
        }
        
        Sleep (2)
    }
    Fail:
    {
        Fail (Failed to reach HPCC!)
    }
}

SignOut()
{// sign out of the HPCC site
    Web.Click Object (//*[@id='email'])
    Web.Click Object (//*[@id='signOutButton'])
    Sleep (1)
}

SelectAccount(${AccountCustomer})
{// select the account customer
    // click on Accounts
    If: Web.Wait For Object (//div[@class='hpMenu']//descendant::a[@href='/accounts/main']/div/div/p,10)
    {
         Web.Click Object (//div[@class='hpMenu']//descendant::a[@href='/accounts/main']/div/div/p)
    }
    Fail:
    {
        //        Web.Capture Screenshot (SelectAccount_Fail.png)
        Return With Fail (Failed to select Accounts in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (SelectAccount_Error.png)
        Return With Error (Error occurred selecting Accounts in HPCC!)
    }
    
    Sleep (2)  //force a small wait to eliminate timing issues waiting for/clicking on the search textbox
    
    // enter the account in the search
    Web.Wait For Object (//*[@id='accountsTableId']//descendant::input[@class='text-search'],10)
    If: Web.Click Object(//*[@id='accountsTableId']//descendant::input[@class='text-search'])
    {
        Sleep (1)
        Web.Set Text(//*[@id='accountsTableId']//descendant::input[@class='text-search'],${AccountCustomer})
        // click on the search icon
        Web.Click Object (//*[@id='accountsTableId']//descendant::span[@class='magnifier-icon magnifier-icon-list-filter'])
        
        Sleep (6)

        // select the first found account
        IF: Web.Click Object (//*[@id='accountsTableId']//descendant::div[@ref='eBodyContainer']/div[1])
        {
        }
        Fail:
        {
            //            Web.Capture Screenshot (SelectAccount_Fail.png)
            Return With Fail (Failed to select the account ${AccountCustomer} in HPCC!)
        }
        Error:
        {
            //            Web.Capture Screenshot (SelectAccount_Error.png)
            Return With Error (Error occurred selecting the account ${AccountCustomer} in HPCC!)
        }
    }
    Fail:
    {
        //        Web.Capture Screenshot (SelectAccount_Fail.png)
        Fail (Failed to select the account ${AccountCustomer} in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (SelectAccount_Error.png)
        Error (Error occurred selecting the account ${AccountCustomer} in HPCC!)
    }
}

SearchApp(${App})
{// search for an app in the customer's app list
    // wait for the list of apps to be displayed
    If: Web.Wait For Object (//*[@id='accountDetailSolutionsTableId']//descendant::span[@id='totalItemCount'],20)
    {
        Sleep (3)
    }
    Fail:
    {
        //        Web.Capture Screenshot (SearchApp_Fail.png)
        Return With Fail (Failed searching for app ${App} in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (SearchApp_Error.png)
        Return With Error (Error occurred searching for app ${App} in HPCC!)
    }

    // enter the app into the search textbox and click the search link
    IF: Web.Wait For Object(//*[@id='accountDetailSolutionsTableId']//descendant::input[@class='text-search'],5)
    {
        // enter the app in the search
        Web.Click Object(//*[@id='accountDetailSolutionsTableId']//descendant::input[@class='text-search'])
        Web.Set Text(//*[@id='accountDetailSolutionsTableId']//descendant::input[@class='text-search'],${App})
        // click on the search icon
        Web.Click Object(//*[@id='accountDetailSolutionsTableId']//descendant::span[@class='magnifier-icon magnifier-icon-list-filter'])
        Sleep (3)
    }
    Fail:
    {
        //        Web.Capture Screenshot (SearchApp_Fail.png)
        Fail (Failed searching for app ${App} in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (SearchApp_Error.png)
        Error (Error occurred searching for app ${App} in HPCC!)
    }
}

ManageSelectedApp
{// attempt to click on the selected app and then the manage button
    If: Web.Wait For Object(//*[@id='accountDetailSolutionsTableId']//descendant::div[@class='solutionsDetailRenderer'],10)
    {
        Web.Click Object(//*[@id='accountDetailSolutionsTableId']//descendant::div[@class='solutionsDetailRenderer'])
        If: Web.Click Object(//*[@id='accountDetailSolutionsTableId']//descendant::button[@class='hpBlueButton area'])
        {
        }
        Fail:
        {
            Return With Fail (Click on App Manage button failed!)
        }
        Error:
        {
            Return With Fail (Click on App Manage button failed!)
        }
    }
    Fail:
    {
        //        Web.Capture Screenshot (ManageSelectedApp.png)
        Fail (Failed managing app in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (ManageSelectedApp.png)
        Error (Error occurred managing app in HPCC!)
    }
}

InstallApp(${InstallCustomer},${InstallApp},${InstallDevice})
{// install an app on a device in a customer account
    // select the account
    If: HPCC_Library.SelectAccount(${InstallCustomer})
    {
    }
    Fail:
    {
        //        Web.Capture Screenshot (InstallApp_Fail.png)
        Return With Fail (Failed to select the HPCC account ${InstallCustomer} for app install!)
    }
    Error:
    {
        //        Web.Capture Screenshot (InstallApp_Error.png)
        Return With Error (Error occurred selecting the HPCC account ${InstallCustomer} for app install!)
    }
    
    Sleep (1)

    // select the app
    If: HPCC_Library.SearchApp(${InstallApp})
    {
    }
    Fail:
    {
        //        Web.Capture Screenshot (InstallApp_Fail.png)
        Return With Fail (Failed selecting app ${InstallApp} in HPCC for app install!)
    }
    Error:
    {
        //        Web.Capture Screenshot (InstallApp_Error.png)
        Return With Error (Error occurred selecting app ${InstallApp} in HPCC for app install!)
    }
    
    // manage the app, attempt 3 times to click the Manage button
    If: HPCC_Library.ManageSelectedApp
    {
    }
    Fail:
    {
        If: HPCC_Library.ManageSelectedApp
        {
        }
        Fail:
        {
            If: HPCC_Library.ManageSelectedApp
            {
            }
            Fail:
            {
                //                Web.Capture Screenshot (InstallApp_Fail.png)
                Return With Fail (Failed managing app ${InstallApp} in HPCC for app install!)
            }
            Error:
            {
                //                Web.Capture Screenshot (InstallApp_Fail.png)
                Return With Error (Errored managing app ${InstallApp} in HPCC for app install!)
            }
        }
        Error:
        {
            //            Web.Capture Screenshot (InstallApp_Fail.png)
            Return With Error (Errored managing app ${InstallApp} in HPCC for app install!)
        }
    }
    Error:
    {
        //        Web.Capture Screenshot (InstallApp_Fail.png)
        Return With Error (Errored managing app ${InstallApp} in HPCC for app install!)
    }
    
    Sleep (2)

    // click the install button on the app manage form
    If: Web.Click Object(//*[@id='moveToInstallSolutionButton'])
    {
    }
    Fail:
    {
        //        Web.Capture Screenshot (InstallApp_Fail.png)
        Return With Fail (Failed clicking the Install button in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (InstallApp_Error.png)
        Return With Error (Error occurred clicking the Install button in HPCC!)
    }

    Sleep(1)

    // uncheck all devices
    If: Web.Wait For Object(//*[@id='accountDetailManageSolutionsInstallTableId']//descendant::span[@class='ag-checkbox-checked'],2)
    {
        // the select all checkbox was checked so uncheck it
        Web.Click Object(//*[@id='accountDetailManageSolutionsInstallTableId']//descendant::span[@class='ag-header-select-all'])
        Sleep(1)
    }
    
    // search for the device
    If: Web.Wait For Object (//*[@id='accountDetailManageSolutionsInstallTableId']//descendant::input[@class='text-search'],10)
    {
        // check for a Notice window popup, if so close it
        If: Web.Wait For Text (additional fees will be incurred,2)
        {
            Web.Click Text (OK)
            Sleep (1)
        }
        // enter the device to search
        Web.Click Object(//*[@id='accountDetailManageSolutionsInstallTableId']//descendant::input[@class='text-search'])
        Web.Set Text (//*[@id='accountDetailManageSolutionsInstallTableId']//descendant::input[@class='text-search'],${InstallDevice})
        
        // click the search icon
        Web.Click Object(//*[@id='accountDetailManageSolutionsInstallTableId']//descendant::span[@class='magnifier-icon magnifier-icon-list-filter'])
    }
    Fail:
    {
        //        Web.Capture Screenshot (InstallApp_Fail.png)
        Return With Fail (Failed searching for device ${InstallDevice} in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (InstallApp_Error.png)
        Return With Error (Error occurred searching for device ${InstallDevice} in HPCC!)
    }

    Sleep (3)

    // ensure that all devices found are checked
    Web.Click Object(//*[@id='accountDetailManageSolutionsInstallTableId']//descendant::span[@class='ag-header-select-all'])
    
    Sleep (1)
    
    // the device is selected by default, click the Next button
    If: Web.Click Object(//*[@id='nextButton'])
    {
        Sleep (1)
    }
    Fail:
    {
        //        Web.Capture Screenshot (InstallApp_Fail.png)
        Return With Fail (Failed clicking the Next button after selecting device ${InstallDevice} in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (InstallApp_Error.png)
        Return With Error (Error occurred clicking the Next button after selecting device ${InstallDevice} in HPCC!)
    }

    //install button
    Web.Click Object(//button[2])

    // text "Task created successfully!"
    IF: Web.Wait For Text (Task created successfully!,20)
    {
    }
    Fail:
    {
        //        Web.Capture Screenshot (InstallApp_Fail.png)
        Fail (Install task was not successfully created!)
    }

    // Done button
    Web.Click Object(//button)

    // close button
    If: Web.Wait For Object (//*[@id='closeButton'],2)
    {
        Web.Click Object(//*[@id='closeButton'])
    }
}

