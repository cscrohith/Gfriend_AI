    }
    Error:
    {
        //        Web.Capture Screenshot (DeleteCustomer_Error.png)
        Return With Error (Error occurred searching the HPCC account ${Customer} while deleting account!)
    }
    
    Sleep (2)

    // select the elem ent to show the account edit and delete options
    If: Web.Wait For Object (//div[@class="accountDetail"]//descendant::div[@class="header"]//descendant::div[@class="hpButtonGroup"]//div[@class="image"],5)
    {
         Web.Click Object (//div[@class="accountDetail"]//descendant::div[@class="header"]//descendant::div[@class="hpButtonGroup"]//div[@class="image"])
    }
    Fail:
    {
        //        Web.Capture Screenshot (DeleteCustomer_Fail.png)
