UnassignDevice(${Device})
{// unassign a device from the Assigned list
    // goto the Assigned Devices page
    If: HPCC_Library.GotoDevices(Y)
    {
    }
    Fail:
    {
        //        Web.Capture Screenshot (UnassignDevice_Fail.png)
        Return With Fail (Failed selecting device ${Device} in HPCC for unassigning a device!)
    }
    Error:
    {
        //        Web.Capture Screenshot (UnassignDevice_Error.png)
        Return With Error (Error occurred selecting device ${Device} in HPCC for unassigning a device!)
    }
    
    // select the device
    If: HPCC_Library.SearchAssignedDevice(${Device})
    {
        // click on the select all checkbox
        Web.Click Object(//*[@id='devicesAssignedTableId']//descendant::span[@class='ag-header-select-all'])
        If: Web.Wait For Object(//*[@id="showRemoveDevicesFromAccountModalButton"],2)
        {
            If: Web.Click Object(//*[@id="showRemoveDevicesFromAccountModalButton"])
            {
                // click to remove the device from the account
                Web.Wait For Object (//*[@id="devicesDeleteDevicesTableId"],5)
                If: Web.Wait For Object (//*[@id="devicesDeleteDevicesTableId"]//descendant::button[@class='hpBlueButton'],2)
                {
                    Web.Click Object (//*[@id="devicesDeleteDevicesTableId"]//descendant::button[@class='hpBlueButton'])
                    Sleep (4)
                }
                Fail:
                {
                    //                    Web.Capture Screenshot (UnassignDevice_Fail.png)
                    Fail (Failed unassigning device ${Device} in HPCC!)
                }
                Error:
                {
                    //                    Web.Capture Screenshot (UnassignDevice_Error.png)
                    Error (Error unassigning device ${Device} in HPCC!)
                }
            }
            Fail:
            {
                //                Web.Capture Screenshot (UnassignDevice_Fail.png)
                Fail (Fail unassigning device ${Device} in HPCC!)
            }
        }
        Fail:
        {
            //            Web.Capture Screenshot (UnassignDevice_Fail.png)
            Fail (Fail unassigning device ${Device} in HPCC!)
        }
    }
    Fail:
    {
        //        Web.Capture Screenshot (UnassignDevice_Fail.png)
        Fail (Failed searching for device ${Device} in HPCC for unassigning!)
    }
    Error:
    {
        //        Web.Capture Screenshot (UnassignDevice_Error.png)
        Error (Error occurred searching for device ${Device} in HPCC for unassigning!)
    }
}

UnassignDevice_FromCustomer(${Customer},${Device})
{// unassign a device from a customer account
    // select the account
    If: HPCC_Library.SelectAccount(${Customer})
    {
    }
    Fail:
    {
        //        Web.Capture Screenshot (UnassignDevice_FromCustomer_Fail.png)
        Return With Fail (Failed to select the HPCC account ${Customer} for unassigning a device!)
    }
    Error:
    {
        //        Web.Capture Screenshot (UnassignDevice_FromCustomer_Error.png)
        Return With Error (Error occurred selecting the HPCC account ${Customer} for unassigning a device!)
    }
    
    Sleep (1)

    // select the device
    If: HPCC_Library.SearchAccountDevice(${Device})
    {
        // check to see if the device has any solutions installed
        If: Web.Wait For Object(//*[@id='accountDetailDevicesTableId']//descendant::div[@class='devicesDetailRenderer'],20)
        {
        Web.Get Text (//*[@id='accountDetailDevicesTableId']//descendant::div[@class='devicesDetailRenderer']//descendant::div[@class='solutionsArea'],${SolutionsInstalled})
            Replace (${SolutionsInstalled}, solutions installed,)
            If: Equals (${SolutionsInstalled},0)
            {// no solutions installed, continue
                // click on the first row of the device list, up to 3 times, to get the Unassign link to display
                Web.Click Object(//*[@id='accountDetailDevicesTableId']//descendant::div[@class='devicesDetailRenderer'])
                If: Web.Wait For Object(//*[@id='accountDetailDevicesTableId']//descendant::div[@class='configArea'],0)
                {
                }
                Fail:
                {// try 2
                    Web.Click Object(//*[@id='accountDetailDevicesTableId']//descendant::div[@class='devicesDetailRenderer'])
                }
                If: Web.Wait For Object(//*[@id='accountDetailDevicesTableId']//descendant::div[@class='configArea'],0)
                {
                }
                Fail:
                {// try 3
                    Web.Click Object(//*[@id='accountDetailDevicesTableId']//descendant::div[@class='devicesDetailRenderer'])
                }
                // if the Unassign link is available then click on it
                If: Web.Click Object(//*[@id='accountDetailDevicesTableId']//descendant::div[@class='configArea'])
                {
                    // click to remove the device from the account
                    Web.Wait For Object (//*[@id='deleteDeviceButton'],2)
                    Web.Click Object (//*[@id='deleteDeviceButton'])
                    Sleep (4)
                }
                Fail:
                {
                    //                    Web.Capture Screenshot (UnassignDevice_FromCustomer_Fail.png)
                    Return With Fail (Failed unassigning device ${Device} in HPCC for unassigning a device!)
                }
                Error:
                {
                    //                    Web.Capture Screenshot (UnassignDevice_FromCustomer_Error.png)
                    Return With Error (Error unassigning device ${Device} in HPCC for unassigning a device!)
                }
            }
            Fail:
            {
                //                Web.Capture Screenshot (UnassignDevice_FromCustomer_Fail.png)
                Return With Fail (Fail to unassign device ${Device} from account ${Customer} in HPCC due to ${SolutionsInstalled} solutions installed!)
            }
        }
    }
    Fail:
    {
        //        Web.Capture Screenshot (UnassignDevice_FromCustomer_Fail.png)
        Fail (Failed selecting device ${Device} in HPCC for unassigning a device!)
    }
    Error:
    {
        //        Web.Capture Screenshot (UnassignDevice_FromCustomer_Error.png)
        Error (Error occurred selecting device ${Device} in HPCC for unassigning a device!)
    }
}

AssignDevice(${Customer},${Device})
{// assign a device to a customer account
    // select the account
    If: HPCC_Library.SelectAccount(${Customer})
    {
    }
    Fail:
    {
        //        Web.Capture Screenshot (AssignDevice_Fail.png)
        Return With Fail (Failed to select the HPCC account ${Customer} for assigning a device!)
    }
    Error:
    {
        //        Web.Capture Screenshot (AssignDevice_Error.png)
        Return With Error (Error occurred selecting the HPCC account ${Customer} for assigning a device!)
    }
    
    Sleep (1)

    // click the Assign Devices button
    Web.Wait For Object(//*[@id='accountDetailDevicesTableId']//descendant::button[@id='showAddDevicesButton'],20)
    Web.Click Object(//*[@id='accountDetailDevicesTableId']//descendant::button[@id='showAddDevicesButton'])
    
    // wait for the Assign Devices popup
    Web.Wait For Object(//div[@class='addDevices'],20)

    // uncheck all
    If: Web.Wait For Object(//*[@id='accountDetailAddDevicesTableId']//descendant::span[@class='ag-checkbox-checked'],2)
    {
        // the select all checkbox was checked, uncheck it
        Web.Click Object(//*[@id='accountDetailAddDevicesTableId']//descendant::span[@class='ag-header-select-all'])
    }
    
    // search and select the device
    If: Web.Wait For Object(//*[@id='accountDetailAddDevicesTableId']//descendant::input[@class='text-search'],5)
    {
        // enter the device in the search
        Web.Click Object(//*[@id='accountDetailAddDevicesTableId']//descendant::input[@class='text-search'])
        Web.Set Text(//*[@id='accountDetailAddDevicesTableId']//descendant::input[@class='text-search'],${Device})
        // click on the search icon
        Web.Click Object(//*[@id='accountDetailAddDevicesTableId']//descendant::span[@class='magnifier-icon magnifier-icon-list-filter'])
        Sleep (3)

        // ensure that all device are is selected
        Web.Click Object(//*[@id='accountDetailAddDevicesTableId']//descendant::span[@class='ag-header-select-all'])
        Sleep (1)
    }
    Fail:
    {
        //        Web.Capture Screenshot (AssignDevice_Fail.png)
        Return With Fail (Failed searching for device ${Device} in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (AssignDevice_Error.png)
        Return With Error (Error occurred searching for device ${Device} in HPCC!)
    }

    Sleep (2)
    // add the device
    //    If: Web.Wait For Object(//*[@id='accountDetailAddDevicesTableId']//descendant::div[@class='footer__buttons']//descendant::button[@class='hpBlueButton'],5)
    If: Web.Wait For Object(//*[@id='accountDetailAddDevicesTableId']//descendant::button[@class='hpBlueButton'],5)
    {
        Web.Click Object(//*[@id='accountDetailAddDevicesTableId']//descendant::button[@class='hpBlueButton'])
        Sleep (2)
        // wait for the device to be added
        If: Web.Wait For Object(//*[@id='accountDetailDevicesTableId']//descendant::div[@id='hpSpinner'],1)
        {
            Web.Wait For Object Disappear(//*[@id='accountDetailDevicesTableId']//descendant::div[@id='hpSpinner'],30)
        }
    }
    Fail:
    {
        //        Web.Capture Screenshot (AssignDevice_Fail.png)
        Fail (Failed adding device ${Device} in HPCC for assigning a device!)
    }
    Error:
    {
        //        Web.Capture Screenshot (AssignDevice_Error.png)
        Error (Error occurred adding device ${Device} in HPCC for assigning a device!)
    }
}

SearchAssignedDevice(${Device})
{// search for a device in the Assigned table of the device list
    If: Web.Wait For Object(//*[@id='devicesAssignedTableId']//descendant::input[@class='text-search'],20)
    {
       // enter the device in the search
        Web.Click Object(//*[@id='devicesAssignedTableId']//descendant::input[@class='text-search'])
        Web.Set Text(//*[@id='devicesAssignedTableId']//descendant::input[@class='text-search'],${Device})
        Sleep (2)
        // click on the search icon
        Web.Click Object(//*[@id='devicesAssignedTableId']//descendant::span[@class='magnifier-icon magnifier-icon-list-filter'])
        Sleep (3)
        // check for 1 or more devices found
        Web.Get Text (//*[@id='devicesAssignedTableId']//descendant::span[@id='filteredCount'],${DeviceCount})
        If: Equals (${DeviceCount},1 results)
        {
            Sleep (3)
        }
        Fail:
        {
            //            Web.Capture Screenshot (SearchAssignedDevice_Fail.png)
            Fail (Failed searching for device ${Device} in HPCC Assigned devices!)
        }
    }
    Fail:
    {
        //        Web.Capture Screenshot (SearchAssignedDevice_Fail.png)
        Fail (Failed searching for device ${Device} in HPCC Assigned devices!)
    }
    Error:
    {
        //        Web.Capture Screenshot (SearchAssignedDevice_Error.png)
        Error (Error occurred searching for device ${Device} in HPCC Assigned devices!)
    }
}

GotoDevices(${Assigned})
{// go to the devices page
    If: Web.Wait For Object (//div[@class='hpMenu']//descendant::a[@href='/devices/main']/div/div/p,10)
    {
        Web.Click Object (//div[@class='hpMenu']//descendant::a[@href='/devices/main']/div/div/p)
        Sleep (10)
        Web.Wait For Object(//*[@id="moveToAssignedButton"],10)

        // check if to go to the Assigned list
        If: Equals (${Assigned},Y)
        {
            Web.Click Object (//*[@id="moveToAssignedButton"])
            Web.Wait For Object(//*[@id="devicesAssignedTableId"],10)
        }
    }
    Fail:
    {
        //        Web.Capture Screenshot (GotoDevices_Fail.png)
        Fail (Failed to select Devices in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (GotoDevices_Error.png)
        Error (Error occurred selecting Devices in HPCC!)
    }
}

RemoveDevice(${Device})
{// remove a device from HPCC
    // goto the Unassigned Devices page
    If: HPCC_Library.GotoDevices(N)
    {
    }
    Fail:
    {
        //        Web.Capture Screenshot (RemoveDevice_Fail.png)
