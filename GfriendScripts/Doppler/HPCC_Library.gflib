    }
    Error:
    {
        //        Web.Capture Screenshot (DeleteCustomer_Error.png)
        Return With Error (Error occurred selecting the account edit/delete element in HPCC!)
    }
    
    Sleep (1)

    // select to Delete the account
    If: Web.Wait For Object (//*[@id="showRemoveAccountModalButton"],5)
    {
        // press the Delete button
        Web.Click Object (//*[@id="showRemoveAccountModalButton"])
        
        // wait for the delete popup and then press the Delete button
        Web.Wait For Object (//div[@class="removeAccount"],10)
        Web.Wait For Object (//*[@id="removeAccountButton"],1)
        Web.Click Object (//*[@id="removeAccountButton"])
        Sleep (5)
        
        // wait for the accounts page to show
        If: Web.Wait For Object (//*[@id="showCreateAccountModalButton"],60)
        {
            // good
            Sleep (10)
        }
        Fail:
        {
            //            Web.Capture Screenshot (DeleteCustomer_Fail.png)
            Fail (Fail, deleting customer ${Customer} in HPCC took longer than 60 seconds!)
        }
        Error:
        {
            //            Web.Capture Screenshot (DeleteCustomer_Fail.png)
            Error (Error while deleting customer ${Customer} in HPCC!)
        }
    }
    Fail:
    {
        //        Web.Capture Screenshot (DeleteCustomer_Fail.png)
        Fail (Fail finding the Delete Account button while deleting customer ${Customer} in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (DeleteCustomer_Fail.png)
        Error (Error finding the Delete Account button while deleting customer ${Customer} in HPCC!)
    }
}

VerifyDeviceSynced(${Customer},${Device})
{// verify a device's info status is updated in HPCC
    // select the account
    If: HPCC_Library.SelectAccount(${Customer})
    {
    }
    Fail:
    {
        //        Web.Capture Screenshot (VerifyDeviceInfoStatus_Fail.png)
        Return With Fail (Failed to select the HPCC account ${Customer} for device status verify!)
    }
    Error:
    {
        //        Web.Capture Screenshot (VerifyDeviceInfoStatus_Error.png)
        Return With Error (Error occurred selecting the HPCC account ${Customer} for device status verify!)
    }
    
    Sleep (1)
    
    // select the device
    If: HPCC_Library.SearchAccountDevice(${Device})
    {
    }
    Fail:
    {
        //        Web.Capture Screenshot (VerifyDeviceInfoStatus_Fail.png)
        Return With Fail (Failed selecting device ${Device} in HPCC for device status verify!)
    }
    Error:
    {
        //        Web.Capture Screenshot (VerifyDeviceInfoStatus_Error.png)
        Return With Error (Error occurred selecting device ${Device} in HPCC for device status verify!)
    }
    
    // loop looking for the Sync now text in the device details popup, up to approx. 30 minutes
//    While:!Web.Wait For Object (//*[@id='app']//descendant::div[@class='syncActionButton'],0):50
    While:!Web.Wait For Text(Sync now,0):50
    {
        // close the device details popup
        @Web.Click Object (//*[@id='app']//descendant::div[@class='deviceDetails']//descendant::button[@id='closeButton'])

        // delay to make approx. 30 seconds per loop iteration
        Sleep (26)
        
        // attempt 3 times to click the device info link
        If: HPCC_Library.SelectAccountDeviceInfo
        {
        }
        Fail:
        {
            If: HPCC_Library.SelectAccountDeviceInfo
            {
            }
            Fail:
            {
                If: HPCC_Library.SelectAccountDeviceInfo
                {
                }
                Fail:
                {
                    //                    Web.Capture Screenshot (VerifyDeviceInfoStatus_Fail.png)
                    Return With Fail (Failed accessing the device info in HPCC for device status verify!)
                }
                Error:
                {
                    //                    Web.Capture Screenshot (VerifyDeviceInfoStatus_Error.png)
                    Return With Error (Errored accessing the device info in HPCC for device status verify!)
                }
            }
            Error:
            {
                //                Web.Capture Screenshot (VerifyDeviceInfoStatus_FaVerifyDeviceInfoStatus_Erroril.png)
                Return With Error (Errored accessing the device info in HPCC for device status verify!)
            }
        }
        Error:
        {
            //            Web.Capture Screenshot (VerifyDeviceInfoStatus_Error.png)
            Return With Error (Errored accessing the device info in HPCC for device status verify!)
        }
    
        // wait for the device details popup, and then the sync button to be availaable
        Web.Wait For Object (//*[@id='app']//descendant::div[@class='deviceDetails'],10)
        @Web.Wait For Object (//*[@id='app']//descendant::div[@class='syncActionButton'],5)
    }
    
    // close the device details popup
    @Web.Click Object (//*[@id='app']//descendant::div[@class='deviceDetails']//descendant::button[@id='closeButton'])
    Sleep (1)
}
