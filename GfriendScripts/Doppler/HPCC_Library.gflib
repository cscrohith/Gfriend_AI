            {
                //                Web.Capture Screenshot (SynchDevice_Fail.png)
                Return With Fail (Failed accessing the device info in HPCC for device sych!)
            }
            Error:
            {
                //                Web.Capture Screenshot (SynchDevice_Error.png)
                Return With Error (Errored accessing the device info in HPCC for device sych!)
            }
        }
        Error:
        {
            //            Web.Capture Screenshot (SynchDevice_FaSynchDevice_Erroril.png)
            Return With Error (Errored accessing the device info in HPCC for device sych!)
        }
    }
    Error:
    {
        //        Web.Capture Screenshot (SynchDevice_Error.png)
        Return With Error (Errored accessing the device info in HPCC for device sych!)
    }
    
    // wait for the device details popup
    If: Web.Wait For Object (//*[@id='app']//descendant::div[@class='deviceDetails'],2)
    {
        // click the sync link
        If: Web.Wait For Object (//*[@id='app']//descendant::div[@class='syncActionButton'],5)
        {
            Web.Click Object (//*[@id='app']//descendant::div[@class='syncActionButton'])
            // wait for the spinner to appear
            If: Web.Wait For Object (//*[@id='app']//descendant::div[@class='deviceDetails']//descendant::div[@class='spinnerArea'],5)
            {// wait for the spinner to disappear within the specified time
                If: Web.Wait For Object Disappear (//*[@id='app']//descendant::div[@class='deviceDetails']//descendant::div[@class='spinnerArea'],${MaxSynchTime})
                {
                }
                Fail:
                {
                    //                    Web.Capture Screenshot (SynchDevice_Fail.png)
                    Fail (Failed device info synch wihtin ${MaxSynchTime} seconds in HPCC for device sych!)
                }
            }
            Fail:
            {
                //                Web.Capture Screenshot (SynchDevice_Fail.png)
                Fail (Failed initializing device info synch in HPCC for device sych!)
            }
            Error:
            {
                //                Web.Capture Screenshot (SynchDevice_Error.png)
                Error (Errored initializing device info synch in HPCC for device sych!)
            }
        }
        Fail:
        {
            //            Web.Capture Screenshot (SynchDevice_Fail.png)
            Fail (Failed accessing the device info in HPCC for device sych!)
        }
        Error:
        {
            //            Web.Capture Screenshot (SynchDevice_Error.png)
            Error (Errored accessing the device info in HPCC for device sych!)
        }
        // close the device details popup
        Web.Click Object (//*[@id='app']//descendant::div[@class='deviceDetails']//descendant::button[@id='closeButton'])
    }
    Fail:
    {
        Fail (Failed accessing the device info in HPCC for device sych!)
    }
    Error:
    {
        Error (Errored accessing the device info in HPCC for device sych!)
    }
}

