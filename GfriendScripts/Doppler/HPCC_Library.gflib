        //        Web.Capture Screenshot (RemoveDevice_Fail.png)
        Return With Fail (Failed clicking the Disconnect button after selecting device ${Device} in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (RemoveDevice_Error.png)
        Return With Error (Error occurred clicking the Disconnect button after selecting device ${Device} in HPCC!)
    }

    // complete the disconnect popup
    If: Web.Wait For Object (//div[@class='disconnectDevices'],10)
    {
        Sleep (1)
        Web.Click Object(//button[@class='hpBlueButton'])
        Sleep (3)
    }
    Fail:
    {
        //        Web.Capture Screenshot (RemoveDevice_Fail.png)
        Fail (Failed clicking the Disconnect button after selecting device ${Device} in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (RemoveDevice_Error.png)
        Error (Error occurred clicking the Disconnect button after selecting device ${Device} in HPCC!)
    }
}

CreateCustomer(${Customer},${ReferenceID},${Notes})
{// remove a device in a customer account and then from HPCC
    // try to select the account
    If: HPCC_Library.SelectAccount(${Customer})
    {
        // the account already exists
        //        Web.Capture Screenshot (CreateCustomer_Fail.png)
        Return With Fail (HPCC account ${Customer} already exists while creating a new account!)
    }
    Fail:
    {
    }
    Error:
    {
        //        Web.Capture Screenshot (CreateCustomer_Error.png)
        Return With Error (Error occurred searching the HPCC account ${Customer} while creating a new account!)
    }
    
    Sleep (1)

    // click on Accounts
    If: Web.Wait For Object (//div[@class='hpMenu']//descendant::a[@href='/accounts/main']/div/div/p,10)
    {
         Web.Click Object (//div[@class='hpMenu']//descendant::a[@href='/accounts/main']/div/div/p)
    }
    Fail:
    {
        //        Web.Capture Screenshot (CreateCustomer_Fail.png)
        Return With Fail (Failed to select Accounts in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (CreateCustomer_Error.png)
        Return With Error (Error occurred selecting Accounts in HPCC!)
    }

    Sleep (2)  //force a small wait to eliminate timing issues waiting for/clicking on the search textbox

    // select to create a new account
    If: Web.Wait For Object (//*[@id="showCreateAccountModalButton"],2)
    {
        Web.Click Object (//*[@id="showCreateAccountModalButton"])
    }
    Fail:
    {
        //        Web.Capture Screenshot (CreateCustomer_Fail.png)
        Return With Fail (Failed to select button to create new Account in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (CreateCustomer_Error.png)
        Return With Error (Error occurred selecting button to create new Account in HPCC!)
    }
    
    Sleep (1)
    If: Web.Wait For Object (//div[@class="createAccount"],5)
    {
        // enter the account name
        Web.Wait For Object (//*[@id="accountName"],5)
        Web.Click Object (//*[@id="accountName"])
        Web.Set Text (//*[@id="accountName"],${Customer})
        // enter Reference ID if specified
        
        If: Equals (${ReferenceID},)
        {// no Reference ID specified
        }
        Fail:
        {
            Web.Click Object (//*[@id="referenceId"])
            Web.Set Text (//*[@id="referenceId"],${ReferenceID})
        }
        
        // enter Notes if specified
        If: Equals (${Notes},)
        {// no Notes specified
        }
        Fail:
        {
            Web.Click Object (//*[@id="textArea"]//textarea)
            Web.Set Text (//*[@id="textArea"]//textarea,${Notes})
        }
        
        // clear all selected users if selected
        If: Web.Wait For Object(//*[@id="accountsCreateUserUsersTableId"]//descendant::span[@class='ag-checkbox-checked'],2)
        {
            // the select all checkbox was checked so uncheck it
            Web.Click Object(//*[@id="accountsCreateUserUsersTableId"]//descendant::span[@class='ag-header-select-all'])
            Sleep(1)
        }
        
        // press the Create button
        Web.Wait For Object (//*[@id="createAccountButton"],10)
        Web.Click Object (//*[@id="createAccountButton"])
        Sleep (5)
        
        // wait for the new account to be ready
        Web.Wait For Object (//div[@class="accountDetail"]//descendant::span[@id="name"],90)
        // verify the name of the account
        Web.Get Text (//div[@class="accountDetail"]//descendant::span[@id="name"],${DisplayedCustomer})
        If: Equals(${DisplayedCustomer},${Customer})
        {
            // good
            Sleep (10)
        }
        Fail:
        {
            //            Web.Capture Screenshot (CreateCustomer_Fail.png)
            Fail (Fail creating new customer ${Customer} in HPCC!)
        }
        Error:
        {
            //            Web.Capture Screenshot (CreateCustomer_Fail.png)
            Error (Error while creating new customer ${Customer} in HPCC!)
        }
    }
    Fail:
    {
        //        Web.Capture Screenshot (CreateCustomer_Fail.png)
        Fail (Fail opening the Create Account popup while creating new customer ${Customer} in HPCC!)
    }
    Error:
    {
        //        Web.Capture Screenshot (CreateCustomer_Fail.png)
        Error (Error opening the Create Account popup while creating new customer ${Customer} in HPCC!)
    }
}

DeleteCustomer(${Customer})
{// remove a device in a customer account and then from HPCC
    // try to select the account
    If: HPCC_Library.SelectAccount(${Customer})
    {
    }
    Fail:
    {
        // the account does not exists
