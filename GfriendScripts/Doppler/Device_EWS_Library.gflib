//Using Web As EWS_Web

/////////////////////////////////////////////////
// Routine:         OpenEWS
// Description:     open EWS in Chrome for a specified device
//
// Arguments:       ${OpenEWS_IP} - device IP address
//
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
OpenEWS (${OpenEWS_IP})
{
    // access the device EWS page
    If: EWS_Web.Open with Chrome (${OpenEWS_IP})
    {
        Sleep (2)
        // check for cert issue
        If: EWS_Web.Wait For Text (Your connection is not private,0)
        {
            // click the Advanced button
            EWS_Web.Click Object (//*[@id="details-button"])
            Sleep (1)
            EWS_Web.Click Object (//*[@id="proceed-link"])
        }
        
        // check for the device page to show
        If: EWS_Web.Wait For Object (//*[@id="HomeDeviceIp"],30)
        {
        }
        Fail:
        {
             Fail (Open device EWS failed to complete!)
        }
    }
    Fail:
    {
        Fail (Device EWS failed to open!)
    }
    Error:
    {
        Error (Error while opeing device EWS!)
    }
}

/////////////////////////////////////////////////
// Routine:         CloseEWS
// Description:     close EWS in Chrome
//
// Arguments:       
//
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
CloseEWS
{
    EWS_Web.Close
}

/////////////////////////////////////////////////
// Routine:         SignInWithAdmin
// Description:     sign in to EWS with the admin password
//                  optionally, if the password has not been set
//                  sign in as admin with a blank password,
//                  and set the admin password if blank
//
// Arguments:       ${Dev_Password} - device admin password
//                  ${CheckBlankPW} - Y to check for blank password if above failed
//                  ${SetWhenBlank} - Y to set password if it was blank
//
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
SignInWithAdmin (${Dev_Password}, ${CheckBlankPW}, ${SetWhenBlank})
{
    // check for sign in available
    If: EWS_Web.Wait For Object (//*[@id="EwsLogin"],0)
    {
        EWS_Web.Click Object (//*[@id="EwsLogin"])
        // check for sign in
        If: EWS_Web.Wait For Object (//*[@id="PageSignIn"],10)
        {
            EWS_Web.Set Text (//*[@id="PasswordTextBox"],${Dev_Password})
            EWS_Web.Click Object (//*[@id="signInOk"])
            // check for success, if not attempt to sign in with no password
            If: EWS_Web.Wait For Object (//*[@id="EwsLogoff"],5)
            {// success no further action
            }
            Fail:
            {// if specified to check for blank password, then do so, else Fail
                If: Equals (${CheckBlankPW},Y)
                {// checking for blank
                    EWS_Web.Clear Text (//*[@id="PasswordTextBox"])
                    EWS_Web.Click Object (//*[@id="signInOk"])
                    If: EWS_Web.Wait For Object (//*[@id="EwsLogoff"],5)
                    {// success with blank, set the password if specified to
                        If: Equals (${SetWhenBlank},Y)
                        {
                            // set the admin password
                            If: DevHealth_EWS_Library.SetAdminPassword (${Dev_Password})
                            {// success
                            }
                            Fail:
                            {// signed in with blank, failed to set new admin password
                                EWS_Web.Capture Screenshot (SignInWithAdmin_Fail.png)
                                Fail (Signed in to admin with blank password but failed setting password!)
                            }
                        }
                    }
                    Fail:
                    {
                        Fail (Failed signing in with admin using both specified and blank password!)
                    }
                }
                Fail:
                {
                    Fail (Failed signing in with admin using specified password and blank password not checked!)
                }
            }
        }
        Fail:
        {
            Fail (Failed signing in with admin!)
        }
    }
}

/////////////////////////////////////////////////
// Routine:         SetAdminPassword
// Description:     set the device admin password
//
// Arguments:       ${Dev_Password} - device admin password
//
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
SetAdminPassword (${Dev_Password})
{
    // get the device IP
    If: EWS_Web.Get Text (//*[@id="HomeDeviceIp"],${EWS_Dev_IP})
    {
        // goto the General Security page
        If: EWS_Web.Go To (${EWS_Dev_IP}/hp/device/GeneralSecurity/Index)
        {
            // make sure it gets to the page
            If: EWS_Web.Wait For Object (//*[@id="PageGeneralSecurity"],5)
            {
                // enter the password
                EWS_Web.Set Text (//*[@id="GeneralSecuritySectionId"]//descendant::input[@id="newPassword"],${Dev_Password})
                
                EWS_Web.Set Text (//*[@id="GeneralSecuritySectionId"]//descendant::input[@id="verifyPassword"],${Dev_Password})
                
                EWS_Web.Click Object (//*[@id="FormButtonSubmit"])
            }
            Fail:
            {
                // check for sign in
                If: EWS_Web.Wait For Object (//*[@id="PageSignIn"],10)
                {
                    EWS_Web.Set Text (//*[@id="PasswordTextBox"],${Dev_Password})
                    EWS_Web.Click Object (//*[@id="signInOk"])
                    EWS_Web.Wait For Object (//*[@id="PageGeneralSecurity"],10)
                }
                Fail:
                {
                    Fail (Failed locating the Sign In page!)
                }
            }
        }
        Fail:
        {
            Fail (Failed locating the General Security page!)
        }
    }
    Fail:
    {
        Fail (Failed getting the device IP!)
    }
}

/////////////////////////////////////////////////
// Routine:         SetProxy
// Description:     set the network proxy
//
// Arguments:       ${Dev_ProxyServer} - proxy server IP or DNS name
//                  ${Dev_ProxyPort} - proxy port number
//                  ${Dev_ProxyExceptions} - exceptions for the proxy
//
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
SetProxy (${Dev_ProxyServer},${Dev_ProxyPort},${Dev_ProxyExceptions})
{
    // get the device IP
    If: EWS_Web.Get Text (//*[@id="HomeDeviceIp"],${EWS_Dev_IP})
    {
        // goto the General Security page
        If: EWS_Web.Go To (${EWS_Dev_IP}/webserviceproxy.htm)
        {
            If: EWS_Web.Wait For Object (//*[@id="cloudproxy_server"],5)
            {
                EWS_Web.Set Text (//*[@id="cloudproxy_server"],${Dev_ProxyServer})
                EWS_Web.Set Text (//*[@id="cloudproxy_port"],${Dev_ProxyPort})
                EWS_Web.Set Text (//*[@id="cloudproxy_exceptions"],${Dev_ProxyExceptions})
                EWS_Web.Click Object (//*[@id="Apply"])
                EWS_Web.Wait For Object (//*[@id="Result_type"],20)
                If: EWS_Web.Wait For Text (Success:,0)
                {
                }
                Fail:
                {
                    Fail (Failed setting the Web Services Proxy!)
                }
            }
            Fail:
            {
                Fail (Failed locating the Web Services Proxy page!)
            }
        }
        Fail:
        {
            Fail (Failed locating the Web Services Proxy page!)
        }
    }
    Fail:
    {
        Fail (Failed getting the device IP!)
    }
}

/////////////////////////////////////////////////
// Routine:         ClearProxy
// Description:     clear the network proxy settings
//
// Arguments:       
//
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
ClearProxy
{
    // get the device IP
    If: EWS_Web.Get Text (//*[@id="HomeDeviceIp"],${EWS_Dev_IP})
    {
        // goto the General Security page
        If: EWS_Web.Go To (${EWS_Dev_IP}/webserviceproxy.htm)
        {
            If: EWS_Web.Wait For Object (//*[@id="cloudproxy_server"],5)
            {
                EWS_Web.Clear Text (//*[@id="cloudproxy_server"])
                EWS_Web.Set Text (//*[@id="cloudproxy_port"],80)
                EWS_Web.Clear Text (//*[@id="cloudproxy_exceptions"])
                EWS_Web.Click Object (//*[@id="Apply"])
                EWS_Web.Wait For Object (//*[@id="Result_type"],20)
                If: EWS_Web.Wait For Text (Success:,0)
                {
                }
                Fail:
                {
                    Fail (Failed clearing the Web Services Proxy!)
                }
            }
            Fail:
            {
                Fail (Failed locating the Web Services Proxy page!)
            }
        }
        Fail:
        {
            Fail (Failed locating the Web Services Proxy page!)
        }
    }
    Fail:
    {
        Fail (Failed getting the device IP!)
    }
}

/////////////////////////////////////////////////
// Routine:         EnableWebServices
// Description:     enable Web Services
//
// Arguments:       
//
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
EnableWebServices
{
    // get the device IP
    If: EWS_Web.Get Text (//*[@id="HomeDeviceIp"],${EWS_Dev_IP})
    {
        // goto the General Security page
        If: EWS_Web.Go To (${EWS_Dev_IP}/hp/webservice)
