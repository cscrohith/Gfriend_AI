                // click the Register link
                EWS_Web.Click Object (//*[@id="Register"])
                
                // wait for the result, checking for success
                EWS_Web.Wait For Object (//*[@id="Result_type"],20)
                If: EWS_Web.Wait For Text (Success:,0)
                {
                }
                Fail:
                {
                    Fail (Failed enabling Web Services!)
                }
            }
            Fail:
            {
                Fail (Failed locating the Web Services Enable link page!)
            }
        }
        Fail:
        {
            Fail (Failed locating the Web Services page!)
        }
    }
    Fail:
    {
        Fail (Failed getting the device IP!)
    }
}

/////////////////////////////////////////////////
// Routine:         DisableWebServices
// Description:     disable Web Services
//
// Arguments:       
//
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
DisableWebServices
{
    // get the device IP
    If: EWS_Web.Get Text (//*[@id="HomeDeviceIp"],${EWS_Dev_IP})
    {
        // goto the web services page
        If: EWS_Web.Go To (${EWS_Dev_IP}/hp/webservice)
        {
            // check for the link to disnable web services
            If: EWS_Web.Wait For Object (//*[@id="Remove"],5)
            {
                // click the remove link
                EWS_Web.Click Object (//*[@id="Remove"])
                
                // wait for the verification popup and click OK
                EWS_Web.Wait For Object (//input[@class='buttonA' and @value='OK'],10)
                EWS_Web.Click Object (//input[@class='buttonA' and @value='OK'])
                
                // wait for the result, checking for success
                EWS_Web.Wait For Object (//*[@id="Result_type"],20)
                If: EWS_Web.Wait For Text (Success:,0)
                {
                }
                Fail:
                {
                    Fail (Failed disabling Web Services!)
                }
            }
            Fail:
            {
                // check for web services not enabled
                If: EWS_Web.Wait For Object (//*[@id="Register"],0)
                {
                }
                Fail:
                {
                    Fail (Failed locating the Web Services disable link page!)
                }
            }
        }
        Fail:
        {
            Fail (Failed locating the Web Services page!)
        }
    }
    Fail:
    {
        Fail (Failed getting the device IP!)
    }
}

/////////////////////////////////////////////////
// Routine:         ResetDevice
// Description:     reset the device using the EWS Reset Firmware function
//                  equivilant to a partial clean
//
// Arguments:       
//
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
ResetDevice
{
    // get the device IP
    If: EWS_Web.Get Text (//*[@id="HomeDeviceIp"],${EWS_Dev_IP})
    {
        // goto the Reset Factory Settings page
        If: EWS_Web.Go To (${EWS_Dev_IP}/hp/device/ResetFactoryDefaults)
        {
            // check for the reset firmware button
            If: EWS_Web.Wait For Object (//*[@id="ResetFirmwareButton"],10)
            {
                EWS_Web.Click Object (//*[@id="ResetFirmwareButton"])
                EWS_Web.Wait For Text (Confirmation Page,5)
                EWS_Web.Click Object (//*[@id="DialogButtonYes"])
                Sleep (10)
            }
        }
        Fail:
        {
            Fail (Failed locating the device reset page!)
        }
    }
    Fail:
    {
        Fail (Failed getting the device IP!)
    }
}

/////////////////////////////////////////////////
// Routine:         WaitForDeviceResetComplete
// Description:     wait for the device to reboot after
//                  the ResetDevice routine was executed
//
// Arguments:       ${Dev_IP} - device IP address
//
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
WaitForDeviceResetComplete(${Dev_IP})
{
    // try to go to the device ews default page looking for the information page
    @EWS_Web.Go To (${Dev_IP})
    While:!EWS_Web.Wait For Object (//*[@id="Information"],1):30
    {
        // check for cert issue
        If: EWS_Web.Wait For Text (Your connection is not private,0)
        {
            // click the Advanced button
            EWS_Web.Click Object (//*[@id="details-button"])
            Sleep (1)
            EWS_Web.Click Object (//*[@id="proceed-link"])
        }
        // wait then retry the default page
        Sleep (20)
        @EWS_Web.Go To (${Dev_IP})
        Sleep (20)
    }
    
    // rechedk that on the informatino page
    If: EWS_Web.Wait For Object (//*[@id="Information"],20)
    {
    }
    Fail:
    {
        Fail (Failed checking for device reset completion!)
    }
}

/////////////////////////////////////////////////
// Routine:         CheckForDevMode
// Description:     check EWS for the <IP>/webserviceDebug.htm
//                  page, which indicates Dev Mode
//
// Arguments:       ${Dev_IP} - device IP address
//
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
CheckForDevMode(${Dev_IP})
{
    // get the device IP
    If: EWS_Web.Get Text (//*[@id="HomeDeviceIp"],${Dev_IP})
    {
        // goto the WebService Debug page
        // if successful, then in Dev Mode
        // if not, then in Prod Mode
        If: EWS_Web.Go To (${Dev_IP}/webserviceDebug.htm)
        {
            If: EWS_Web.Wait For Object (//*[@id="stackSelection"],5)
            {
                // success - in Dev Mode
            }
            Fail:
            {
                If: EWS_Web.Wait For Text (HTTP ERROR 404,0)
                {
                    // page not found - in Prod Mode
                    Fail (Failed locating the Web Services Debug page! Device not in Dev Mode.)
                }
                Fail:
                {
                    Error (Failed locating the Web Services Debug page!)
                }
            }
        }
        Fail:
        {
            Error (Failed locating the Web Services Debug page!)
        }
    }
    Fail:
    {
        Error (Failed verifying the device IP on the EWS site!)
    }
}