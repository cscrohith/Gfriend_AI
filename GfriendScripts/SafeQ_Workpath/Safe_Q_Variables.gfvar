//To Print all the jobs, provide the variable (${PRINT_ALL}) value as Y
//To Print one job, provide the variable (${PRINT_ALL}) value as N
${PRINT_ALL} = N

//For BADGE Authentication, provide the variable (${BADGE_AUTH}) value as Y
//And provide desired value to ${BADGE_INDEX}
${BADGE_AUTH} = N
${BADGE_INDEX} = 0

//Short ID Parameter
${PIN} = 1234
