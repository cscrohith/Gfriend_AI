using Vision
using JediOmni
using Info
using BadgeBox

AzureVision(${AzureEndpoint},${SubscriptionKey})
{  
    Encrypt(${AzureEndpoint},${AzureEndpointEncryptedValue})

    Encrypt(${SubscriptionKey},${SubscriptionKeyEncryptedValue})

    Vision.Set OCR Method(${AzureEndpointEncryptedValue},${SubscriptionKeyEncryptedValue},ENCRYPT)

    Vision.Set Target (JediOmni)

    Vision.Set Text Grouping (word)
}

/////////////////////////////////////////////////
// Routine:         Printix_PullPrint
// Description:     Printix Pullprint Job
//
// Arguments:       ${PRINT_ALL}) - Print All Variable
//                   
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////

Printix_PullPrint(${PRINT_ALL},${BADGE_AUTH},${BADGE_INDEX},${First_Digit},${Second_Digit},${Third_Digit},${Fourth_Digit},${Fifth_Digit},${Sixth_Digit},${First_PIN},${Second_PIN},${Third_PIN},${Fourth_PIN},${Crop_Percentage},${XValueForSelectAll},${YValueForSelectAll},${XValueForPrintButton},${YValueForPrintButton},${ActivityId})
{
    Info.Start Time Check (STF_ProcessingJob)
    If: Printix_TestCases.SignInPrintix(${BADGE_AUTH},${BADGE_INDEX},${First_Digit},${Second_Digit},${Third_Digit},${Fourth_Digit},${Fifth_Digit},${Sixth_Digit},${First_PIN},${Second_PIN},${Third_PIN},${Fourth_PIN},${Crop_Percentage})
    {
        //All Good, Continue
    }
    Sleep (5)
    If:Vision.Is Text Exist (Printix Go)
    {
         Sleep (5)
         Info.Mark End (STF_AppButtonPress,2)
         Vision.Click Text (Printix Go)
    }
    Info.Mark End (STF_AppShown,3)
    While:!Vision.Is Text Exist (Print): 50 
    {
        Sleep(1)   
    }
    If:Vision.Is Text Exist (No documents)
    {
        JediOmni.Capture Screen Shot (NoJobsFound)
        Fail (No Jobs found to Pull!)
        Stop Test Case
    }
    Fail:
    {
        Printix_TestCases.PrintJobs(${PRINT_ALL},${XValueForSelectAll},${YValueForSelectAll},${XValueForPrintButton},${YValueForPrintButton},${ActivityId})
    }
}

PrintJobs(${PRINT_ALL},${XValueForSelectAll},${YValueForSelectAll},${XValueForPrintButton},${YValueForPrintButton},${ActivityId})
{
    If:Vision.Is Text Exist (Print)
    {
        Info.Mark Start (STF_ProcessingJob,6)
        //To Print all the Documents
        If: Equals IgnoreCase (${PRINT_ALL},Y)
        {
           Vision.Click Next To Text (Print,${XValueForSelectAll},${YValueForSelectAll})            
           Sleep (1)
           //Clicks on Print button
           Vision.Click Next To Text (Print,${XValueForPrintButton},${YValueForPrintButton})
        }
        //To Print Only 1 Document
        Fail:
        {
        //Clicking on first job using Activity Id
           Printix_TestCases.ClickOnPrintJob(${ActivityId})
           Sleep (1)
           //Clicks on Print button
           Vision.Click Next To Text (Print,${XValueForPrintButton},${YValueForPrintButton})
        }
    }
    Fail:
    {
        Fail(No Jobs found to Pull!)
    }
    Info.Mark End (STF_ProcessingJob,6)
    If: JediOmni.Wait For Active Job (20)
    {
        //Continue
    }
    Fail:
    {
        Return With Fail (Failed to initiate print jobs within 20 seconds!)
    }
    If: JediOmni.Wait For Active Job Gone (300)
    {
        Return With Pass (Print Job Completed Successfully) 
    }
    Fail:
    {
        Return With Fail (Failed to print jobs within 100 seconds!)
    }
}

ClickOnPrintJob(${JobName})
{
    Vision.Set Target (JediOmni)
    Vision.Set Text Grouping (block)
    Substring (${JobName},0,4,${PrintixJOBID_1})
    Substring (${JobName},1,4,${PrintixJOBID_2})
    Substring (${JobName},2,4,${PrintixJOBID_3})
    Substring (${JobName},3,4,${PrintixJOBID_4})
    Substring (${JobName},4,4,${PrintixJOBID_5})
       Repeat:5
       {
           Concatenate Variables And Store Result (${PrintixJOBID_},${R},${newvalue})
           If: Vision.Is Text Exist (${newvalue})
           {
               Vision.Click Text (${newvalue})
               Sleep (3)
               Return With Pass (Print Job ID Clicked)
           }
       }
}

/////////////////////////////////////////////////
//Routine:         ClearAuth
//Description:     make sure at Home screen, signed out and reset
//
//Arguments: 
//      
//Pre-requisites: 
// 
//Notes:
//
//Version:
/////////////////////////////////////////////////

ClearAuth
{
    JediOmni.Press Home Key
    
    While:!Vision.Is Text Exist (Sign In): 5 
    {
        Sleep(1)   
    }
    Sleep (5)
    If:Vision.Is Text Exist (Sign In)
    {
        // all good, no action needed
    }
    Fail:
    {
        If:Vision.Is Text Exist (Sign Out)
        {
            Sleep(2)
            Vision.Click Text (Sign Out)
            While:!Vision.Is Text Exist (Signing out): 10 
            {
                Sleep(1)   
            }
            JediOmni.Wait For Text Gone (Signing out,30)
        }
        Fail:
        {
            Return With Fail (Failed to Sign Out!)
        }
    }
    Vision.Click Text (Reset)
}

//////////////////////////////////////////////////
//Routine:         VerifyUserLoggedIn
//Description:     Make sure user is signed In
//
//Arguments:
//     
//Pre-requisites:
//
//Notes:
//
//Version:
/////////////////////////////////////////////////

SignInPrintix(${BADGE_AUTH},${BADGE_INDEX},${First_Digit},${Second_Digit},${Third_Digit},${Fourth_Digit},${Fifth_Digit},${Sixth_Digit},${First_PIN},${Second_PIN},${Third_PIN},${Fourth_PIN},${Crop_Percentage})
{

    Info.Start Time Check (STF_Authentication)

    Info.Start Time Check (STF_EnterCredentials)

    Info.Start Time Check (STF_AppShown)

    Info.Start Time Check (STF_AppButtonPress)

    Info.Start Time Check (STF_DeviceButtonPress)

    If: Printix_TestCases.ClearAuth
    {
    }
    Fail:
    {
        Return With Fail (Failed clearing any existing authentication!)
    }
    Error:
    {
        Return With Error (Error clearing any existing authentication!)
    }
    Info.Mark End (STF_DeviceButtonPress,1)
    
    If: Equals IgnoreCase (${BADGE_AUTH},Y)
    {
        Info.Mark Start (STF_Authentication,4)

        BadgeBox.Scan Badge (${BADGE_INDEX})
        
        While:!Vision.Is Text Exist (Sign Out): 30 
        {
            Sleep(1)   
        }
        If:Vision.Is Text Exist (Sign Out)
        {
            Return With Pass (Badge Sign In was Successful)
        }
        Fail:
        {
            Fail (Sign In was not Successful within 30 Seconds)
        }
        Info.Mark End (STF_Authentication,4) 
    }
    Fail:
    {
        While:!Vision.Is Text Exist (Sign In): 10 
        {
            Sleep(1)   
        }
        If:Vision.Is Text Exist (Sign In)
        {
            Vision.Click Text (Sign In)
        }

        //Pin Authentication      
        Printix_TestCases.SignInPritixPIN(${First_Digit},${Second_Digit},${Third_Digit},${Fourth_Digit},${Fifth_Digit},${Sixth_Digit},${First_PIN},${Second_PIN},${Third_PIN},${Fourth_PIN},${Crop_Percentage})
    }         
}

//////////////////////////////////////////////////
//Routine:         VerifyUserLoggedIn
//Description:     Make sure user is signed In
//
//Arguments:
//     
//Pre-requisites:
//
//Notes:
//
//Version:
/////////////////////////////////////////////////

SignInPritixPIN(${First_Digit},${Second_Digit},${Third_Digit},${Fourth_Digit},${Fifth_Digit},${Sixth_Digit},${First_PIN},${Second_PIN},${Third_PIN},${Fourth_PIN},${Crop_Percentage})
{ 
    Info.Start Time Check (STF_Authentication)
    
    Info.Start Time Check (STF_EnterCredentials)

    Info.Start Time Check (STF_AppShown)

    Info.Start Time Check (STF_AppButtonPress)

    Info.Mark Start (STF_Authentication,4)

    While:!Vision.Is Text Exist (ID code): 20 
    {
        Sleep(1)   
    }
    If:Vision.Is Text Exist (ID code)
    {
        Vision.Click Text (ID code)
    }
    
    Info.Mark Start (STF_EnterCredentials,5)
    Sleep(5)
    If:Vision.Is Text Exist (ID code)
    {
        Vision.Crop Screenshot (top,${Crop_Percentage})
        Vision.Click Text (${First_Digit})
        Vision.Click Text (${Second_Digit})
        Vision.Click Text (${Third_Digit})
        Vision.Click Text (${Fourth_Digit})
        Vision.Click Text (${Fifth_Digit})
        Vision.Click Text (${Sixth_Digit})
        Vision.Stop Crop

        Sleep(5)
        Vision.Is Text Exist (Sign in)
        {
            Vision.Click Text (Sign in)
        }

        //Enter PIN
        Sleep (5)
        Vision.Is Text Exist (PIN code)
        {
            Vision.Crop Screenshot (top,${Crop_Percentage})
            Vision.Click Text (${First_PIN})
            Vision.Click Text (${Second_PIN})
            Vision.Click Text (${Third_PIN})
            Vision.Click Text (${Fourth_PIN})
            Vision.Stop Crop
        }
        //Click Sign In 
        Sleep (5)
        If:Vision.Is Text Exist (Sign in)
        {
            Vision.Click Text (Sign in)
        }
        Info.Mark End (STF_EnterCredentials,5)        
        While:!Vision.Is Text Exist (LOADING): 10 
        {
            Sleep(1)   
        }        
        If:Vision.Is Text Exist (LOADING)
        {
            While:Vision.Is Text Exist (LOADING): 10
            {
                Sleep(1) 
            }
            //Waithing for the next screen
        }
        Sleep (5)
        If:Vision.Is Text Exist (Sign Out)
        {
            Return With Pass (Sign In was Successful)
        }
        Fail:
        {
            While:!Vision.Is Text Exist (ID code): 15 
            {
                Sleep(1)   
            }
            If:Vision.Is Text Exist (Close)
            {
                Vision.Click Text (Close)
                //Press Home Key
                JediOmni.Press Home Key
                Fail (Invalid Login Credentials)
            }
        }
        Info.Mark End (STF_Authentication,4)
     }                 
     Fail:
     {
         Return With Fail (Fail to Login)
     }
 }

/////////////////////////////////////////////////
// Routine:         SignOut
// Description:     sign out on the device
//
// Arguments:       
//
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////

SignOut
{  
    JediOmni.Press Home Key
    Info.Start Time Check (STF_DeviceSignOutBegin)
    Info.Start Time Check (STF_DeviceSignOutEnd)
    Info.Mark Start (STF_DeviceSignOutBegin,4)
    
    While:!Vision.Is Text Exist (Sign Out): 5 
    {
        Sleep(1)
    }
    Sleep (5)
    If:Vision.Is Text Exist (Sign Out)
    {
        Vision.Click Text (Sign Out)
    }
    Fail:
    {
        Fail (Failed to find Home Screen Sign Out!)
    }
    Info.Mark End (STF_DeviceSignOutEnd,4)
    Info.Draw Time Graph (STF_DeviceSignOutBegin)
    Info.Draw Time Graph (STF_DeviceSignOutEnd)
}