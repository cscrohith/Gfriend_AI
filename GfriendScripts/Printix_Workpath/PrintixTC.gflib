using JediOmni
using Android
using Info
using BadgeBox

/////////////////////////////////////////////////
// Routine:         Printix_PullPrint
// Description:     Printix Pullprint Job
//
// Arguments:       ${PRINT_ALL}) - Print All Variable
//                   
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////

Printix_PullPrint(${PRINT_ALL},${BADGE_AUTH},${BADGE_INDEX},${First_Digit},${Second_Digit},${Third_Digit},${Fourth_Digit},${Fifth_Digit},${Sixth_Digit},${First_PIN},${Second_PIN},${Third_PIN},${Fourth_PIN})
{
    Info.Start Time Check (STF_ProcessingJob)
    If: PrintixTC.SignInPrintix(${BADGE_AUTH},${BADGE_INDEX},${First_Digit},${Second_Digit},${Third_Digit},${Fourth_Digit},${Fifth_Digit},${Sixth_Digit},${First_PIN},${Second_PIN},${Third_PIN},${Fourth_PIN})
    {
        //All Good, Continue
    }
    Sleep (5)
    //Click on Print Application
    If: JediOmni.Wait For Object (hpid-11111111-1111-1111-9993-111111111111-homescreen-button,20)
    {
         Sleep (5)
         Info.Mark End (STF_AppButtonPress,2)
         JediOmni.Touch ID (hpid-11111111-1111-1111-9993-111111111111-homescreen-button)
    }
     
    Info.Mark End (STF_AppShown,3)
    If: Android.Wait For XPath (//node[@resource-id='PRINT_JOBS_CONTAINER'],50)
    {
        Info.Mark Start (STF_ProcessingJob,6)
        //To Print all the Documents
        If: Equals IgnoreCase (${PRINT_ALL},Y)
        {
            If: Android.Wait For Object (CHECKBOX_BUTTON,10)
            {
                Android.Touch ID (CHECKBOX_BUTTON)
            }
            If: Android.Wait For XPath (//node[@resource-id='PRINT_BUTTON_CONTAINER']/node[1],5)
            {
                Android.Touch XPath (//node[@resource-id='PRINT_BUTTON_CONTAINER']/node[1])
            }
        } 
        
        //To Print Only 1 Document
        Fail:
        {
            If: Android.Wait For XPath (//node[@resource-id='PRINT_JOBS_CONTAINER'],5)
            {
                Android.Touch XPath (//node[@resource-id='PRINT_JOBS_CONTAINER'])
            }
            
            If: Android.Wait For XPath (//node[@resource-id='PRINT_BUTTON_CONTAINER']/node[1],5)
            {
                Android.Touch XPath (//node[@resource-id='PRINT_BUTTON_CONTAINER']/node[1])
            }
        }
    }
    Info.Mark End (STF_ProcessingJob,6)
    
    Fail:
    {
        Fail (No Jobs found to Pull!) 
    }
    
    If: JediOmni.Wait For Active Job (20)
    {
        //Continue
    }
    Fail:
    {
        Return With Fail (Failed to initiate print jobs within 20 seconds!)
    }
    
    If: JediOmni.Wait For Active Job Gone (300)
    {
        Return With Pass (Print Job Completed Successfully) 
    }
    Fail:
    {
        Return With Fail (Failed to print jobs within 100 seconds!)
    }
}

/////////////////////////////////////////////////
//Routine:         ClearAuth
//Description:     make sure at Home screen, signed out and reset
//
//Arguments: 
//      
//Pre-requisites: 
// 
//Notes:
//
//Version:
/////////////////////////////////////////////////
      
ClearAuth
{
    JediOmni.Press Home Key
    If: JediOmni.Wait For Text (Sign In,10)
    {
        // all good, no action needed
    }
    Fail:
    {
        If: JediOmni.Touch Text (Sign Out)
        {
            JediOmni.Wait For Text (Signing out,10)
            JediOmni.Wait For Text Gone (Signing out,30)
        }
        Fail:
        {
            Return With Fail (Failed to Sign Out!)
        }
    }
    JediOmni.Reset
}

//////////////////////////////////////////////////
//Routine:         VerifyUserLoggedIn
//Description:     Make sure user is signed In
//
//Arguments:
//     
//Pre-requisites:
//
//Notes:
//
//Version:
/////////////////////////////////////////////////
     

SignInPrintix(${BADGE_AUTH},${BADGE_INDEX},${First_Digit},${Second_Digit},${Third_Digit},${Fourth_Digit},${Fifth_Digit},${Sixth_Digit},${First_PIN},${Second_PIN},${Third_PIN},${Fourth_PIN})
{
    
    Info.Start Time Check (STF_Authentication)
    
    Info.Start Time Check (STF_EnterCredentials)
        
    Info.Start Time Check (STF_AppShown)
    
    Info.Start Time Check (STF_AppButtonPress)
    
    Info.Start Time Check (STF_DeviceButtonPress)
    
    If: PrintixTC.ClearAuth
    {
    }
    Fail:
    {
        Return With Fail (Failed clearing any existing authentication!)
    }
    Error:
    {
        Return With Error (Error clearing any existing authentication!)
    }
    
    Info.Mark End (STF_DeviceButtonPress,1)
    
    If: Equals IgnoreCase (${BADGE_AUTH},Y)
    {
        Info.Mark Start (STF_Authentication,4)
        BadgeBox.Scan Badge (${BADGE_INDEX})
        If: JediOmni.Wait For Text (Sign Out,30)
        {
            Return With Pass (Badge Sign In was Successful)
        }
        Fail:
        {
            Fail (Sign In was not Successful within 30 Seconds)
        }
        Info.Mark End (STF_Authentication,4) 
    }
    Fail:
    {
        // Press the Sign In button
        If: JediOmni.Wait For Object (hp-button-signin-or-signout,10)
        {
            JediOmni.Touch ID (hp-button-signin-or-signout)
        }
        
        //Pin Authentication      
        PrintixTC.SignInPritixPIN(${First_Digit},${Second_Digit},${Third_Digit},${Fourth_Digit},${Fifth_Digit},${Sixth_Digit},${First_PIN},${Second_PIN},${Third_PIN},${Fourth_PIN}) 
    }         
}

//////////////////////////////////////////////////
//Routine:         VerifyUserLoggedIn
//Description:     Make sure user is signed In
//
//Arguments:
//     
//Pre-requisites:
//
//Notes:
//
//Version:
/////////////////////////////////////////////////

SignInPritixPIN(${First_Digit},${Second_Digit},${Third_Digit},${Fourth_Digit},${Fifth_Digit},${Sixth_Digit},${First_PIN},${Second_PIN},${Third_PIN},${Fourth_PIN})
{  
    Info.Start Time Check (STF_Authentication)
    
    Info.Start Time Check (STF_EnterCredentials)
        
    Info.Start Time Check (STF_AppShown)
   
    Info.Start Time Check (STF_AppButtonPress)
    
    Info.Mark Start (STF_Authentication,4)
    
    If: Android.Wait For Object (ID_CODE_BUTTON,20)
    {
        Android.Touch ID (ID_CODE_BUTTON)
    }
    Info.Mark Start (STF_EnterCredentials,5)
    If: Android.Wait For XPath (//node[@class='android.widget.GridView']/node[1]/node[1]/node[1],15)
    {
        Android.Touch XPath (//node[@class='android.widget.GridView']/${First_Digit})
        Android.Touch XPath (//node[@class='android.widget.GridView']/${Second_Digit})
        Android.Touch XPath (//node[@class='android.widget.GridView']/${Third_Digit})
        Android.Touch XPath (//node[@class='android.widget.GridView']/${Fourth_Digit})
        Android.Touch XPath (//node[@class='android.widget.GridView']/${Fifth_Digit})
        Android.Touch XPath (//node[@class='android.widget.GridView']/${Sixth_Digit})
        
        //Click Sign In 
        If: Android.Wait For XPath (//node[@text='Sign in'],15)
        {
            Android.Touch XPath (//node[@text='Sign in'])
        }

        //Enter PIN
        If: Android.Wait For XPath (//node[@class='android.widget.GridView']/node[1]/node[1],5)
        {
            Android.Touch XPath (//node[@class='android.widget.GridView']/${First_PIN})
            Android.Touch XPath (//node[@class='android.widget.GridView']/${Second_PIN})
            Android.Touch XPath (//node[@class='android.widget.GridView']/${Third_PIN})
            Android.Touch XPath (//node[@class='android.widget.GridView']/${Fourth_PIN})
        }
          
        //Click Sign In 
        If: Android.Wait For XPath (//node[@text='Sign in'],15)
        {
            Android.Touch XPath (//node[@text='Sign in'])
        }
        
        Info.Mark End (STF_EnterCredentials,5)       
        If: Android.Wait For XPath Gone (//node[@resource-id='LOADING'],10)
        {
            //Waithing for the next screen
        }
        If: JediOmni.Wait For Text (Sign Out,50)
        {
            Return With Pass (Sign In was Successful)
        }
        Fail:
        {
            If: Android.Wait For XPath (//node[@text='Close'],15)
            {
                Android.Touch XPath (//node[@text='Close'])
                JediOmni.Press Home Key
                Fail (Invalid Login Credentials)
            }
        }
        Info.Mark End (STF_Authentication,4)
     }                 
     Fail:
     {
         Return With Fail (Fail to Login)
     }
 }
 
/////////////////////////////////////////////////
// Routine:         SignOut
// Description:     sign out on the device
//
// Arguments:       
//
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
SignOut
{  
    JediOmni.Press Home Key
    Info.Start Time Check (STF_DeviceSignOutBegin)
    Info.Start Time Check (STF_DeviceSignOutEnd)
    Info.Mark Start (STF_DeviceSignOutBegin,4)
    If: JediOmni.Wait For Text (Sign Out,10)
    {
        JediOmni.Touch Text (Sign Out)
    }
    Fail:
    {
        Fail (Failed to find Home Screen Sign Out!)
    }
    Info.Mark End (STF_DeviceSignOutEnd,4)
    Info.Draw Time Graph (STF_DeviceSignOutBegin)
    Info.Draw Time Graph (STF_DeviceSignOutEnd)
}