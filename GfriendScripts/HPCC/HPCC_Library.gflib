//        @Web.Click Object (//*[@id="app"]/descendant::div[@class="deviceDetails"]/descendant::button[@id="closeButton"])
//
//        // delay to make approx. 30 seconds per loop iteration
//        Sleep (26)
//        
//        // click the device info link
//        If: HPCC_Library.SelectAccountDeviceInfo
//        {
//        }
//        Fail:
//        {
//        }
//        Error:
//        {
//            Return With Error (Error while accessing the device info in HPCC!)
//        }
//    
//        // wait for the device details popup, and then the sync button to be availaable
//        Web.Wait For Object (//*[@id="app"]/descendant::div[@class="deviceDetails"],${Wait_Time})
//        @Web.Wait For Object (//*[@id="app"]/descendant::div[@class="syncActionButton"],${Short_Wait_Time})
//    }

    // click the device info link
    If: HPCC_Library.SelectAccountDeviceInfo
    {
    }
    Fail:
    {
        Return With Fail (Fail while accessing the device info in HPCC!)
    }
    Error:
    {
        Return With Error (Error while accessing the device info in HPCC!)
    }
    
    // check for the synch not running and an indication that the initial sysch did not succeed
    If: Web.Wait For Object (//div[@class="syncActionButton" and contains\(text\(\)\,"Sync now"\)],${Zero_Wait_Time})
    {
        Web.Get Text (//*[@id="firmwareVersion"],${Firmware})
        If: Equals (${Firmware},-)
        {
            // this indicates that the initial synch ended without success
            // initiate another synch
            Web.Click Object (//*[@id="app"]/descendant::div[@class="syncActionButton"])
            Sleep (${Short_Wait_Time})
        }
    }
    
    // wait for the initial sych to complete
    If: Web.Wait For Object (//div[@class="syncActionButton" and contains\(text\(\)\,"Sync now"\)],${MaxSynchTime})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (VerifyDeviceSynced_Fail.png)
        // close the device details popup
        @Web.Click Object (//*[@id="app"]/descendant::div[@class="deviceDetails"]/descendant::button[@id="closeButton"])
        // wait until all done
        HPCC_Library.WaitForSpinner
        
        Return With Fail (Fail while initial device info synch wihtin the specified time!)
    }
    
    // check for the initial synch successful
    Web.Get Text (//*[@id="firmwareVersion"],${Firmware})
    If: Contains Ignore Case (${Firmware},load)
    {
        // the initial sych completed but failed
        Web.Capture Screenshot (VerifyDeviceSynced_Fail.png)
        
        // close the device details popup
        @Web.Click Object (//*[@id="app"]/descendant::div[@class="deviceDetails"]/descendant::button[@id="closeButton"])
        // wait until all done
        HPCC_Library.WaitForSpinner
        
        Return With Fail (Fail initial device info synch failed!)
    }
    
    If: Equals (${Firmware},-)
    {
        // the initial sych completed but failed
        Web.Capture Screenshot (VerifyDeviceSynced_Fail.png)
        
        // close the device details popup
        @Web.Click Object (//*[@id="app"]/descendant::div[@class="deviceDetails"]/descendant::button[@id="closeButton"])
        // wait until all done
        HPCC_Library.WaitForSpinner
        
        Return With Fail (Fail initial device info synch failed!)
    }
    Fail:
    {
        // the initial synch completed successfully
        
        // close the device details popup
        @Web.Click Object (//*[@id="app"]/descendant::div[@class="deviceDetails"]/descendant::button[@id="closeButton"])
        // wait until all done
        HPCC_Library.WaitForSpinner
        
        Return With Pass (VerifyDeviceSynced completed!)
    }
}

/// <Name>GotoCustomerDeviceDiscovery</Name>
/// <Description>Go to a customer Device discovery page</Description>
/// <Parameters>Customer : customer in HPCC</Parameters>
/// <Precondition>Signed into HPCC and in a selected Customer page</Precondition>
/// <Notes></Notes>
GotoCustomerDeviceDiscovery(${Customer})
{
    // select the account
    If: HPCC_Library.SelectAccount(${Customer})
    {
    }
    Fail:
    {
        Return With Fail (Fail selecting the customer account!)
    }
    Error:
    {
        Return With Error (Error selecting the customer account!)
    }
    
    // click the right arrow to make the Discovery link visible
    While:Web.Wait For Object (//div[@class="rightArrow"]/div[@class="pointer deepGray"],${Zero_Wait_Time}):3
    {
        Web.Click Object(//div[@class="rightArrow"]/div[@class="pointer deepGray"])
    }
    
    // click the Discovery link
    //    If: Web.Click Object(//*[@class="discoverySvc"]/div[@class="iconArea"]/img)
    If: Web.Click Object(//img[@id="service"])
    {
        // wait for the Discovery page to show
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (GotoCustomerDeviceDiscovery_Failed.png)
        Return With Fail (Fail while accessing the Discover link in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (GotoCustomerDeviceDiscovery_Error.png)
        Return With Error (Error while accessing the Discover link in HPCC!)
    }
    
    // wait for the discoveries page to show
    If: Web.Wait For Object (//div[@class="discoveries"],${Wait_Time})
    {
        Return With Pass (GotoDeviceDiscovery completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (GotoCustomerDeviceDiscovery_Failed.png)
        Return With Fail (Fail while accessing the Discovered devices page in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (GotoCustomerDeviceDiscovery_Error.png)
        Return With Error (Error while accessing the Discovered devices page in HPCC!)
    }
}

/// <Name>EnableMasterDevice</Name>
/// <Description>Enable a device as a master device</Description>
/// <Parameters>Customer : customer in HPCC</Parameters>
/// <Parameters>Device : device identifier in HPCC</Parameters>
/// <Parameters>Multicast_YN : Y to enable Multi-cast discovery protocol</Parameters>
/// <Parameters>Discover_Period : Multi-cast discovery period (Discover Once; Once a day; Once a week; Once a month)</Parameters>
/// <Parameters>Discover_Hour : Multi-cast discovery time Hour (2-digit with leading 0)</Parameters>
/// <Parameters>Discover_Minute : Multi-cast discovery time Minutes (2-digit with leading 0)</Parameters>
/// <Parameters>Discover_AM_PM : Multi-cast discovery time am/pm (AM or PM)</Parameters>
/// <Parameters>DeviceAnnounce_YN : Y to enable Device Announcement discovery protocol</Parameters>
/// <Parameters>TrustedAuth_YN : Y to enable Truested Authentication discovery</Parameters>
/// <Parameters>SecondaryListeners_YN : Y to enable Secondary Listener(s)</Parameters>
/// <Parameters>AddAllDevices_YN : Y to auto onboard all discovereed devices</Parameters>
/// <Parameters>TaskCompleteLimit : task completion limit in minutes</Parameters>
/// <Precondition>Signed into HPCC and in the customer Discover device</Precondition>
/// <Notes></Notes>
EnableMasterDevice(${Customer},${Device},${Multicast_YN},${Discover_Period},${Discover_Hour},${Discover_Minute},${Discover_AM_PM},${DeviceAnnounce_YN},${TrustedAuth_YN},${SecondaryListeners_YN},${AddAllDevices_YN},${TaskCompleteLimit})
{
    // verify in customer device discovery page
    If: Web.Wait For Object (//div[@class="discoveries"],${Zero_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (EnableMasterDevice_Failed.png)
        Return With Fail (Fail - not in customer Device Discoveries page in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (EnableMasterDevice_Error.png)
        Return With Error (Error - not in customer Device Discoveries page in HPCC!)
    }
    
    Web.Click Object(//button[contains\(text\(\)\,"Manage"\)])

    HPCC_Library.WaitForSpinner

    // when the edit discoveries page shows click the enable master devices button
    If: Web.Wait For Object (//div[@class="discoverySettings"],${Wait_Time})
    {
        Web.Click Object(//button[contains\(text\(\)\,"Add and enable"\)])
        
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (EnableMasterDevice_Failed.png)
        Return With Fail (Fail while accessing the Discovery settings page in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (EnableMasterDevice_Error.png)
        Return With Error (Error while accessing the Discovery settings page in HPCC!)
    }
    
    // wait for the Enable popup
    If: Web.Wait For Object (//div[@class="enableMasterDevices"],${Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (EnableMasterDevice_Failed.png)
        Return With Fail (Fail while accessing the enable master devices popup in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (EnableMasterDevice_Error.png)
        Return With Error (Error while accessing the enable master devices popup in HPCC!)
    }
    
    // uncheck all devices if not already unchecked
    If: Web.Wait For Object(//*[@id="discoveries_enableSelect"]/descendant::span[@class="ag-checkbox-checked"],${Short_Wait_Time})
    {
        Web.Click Object(//*[@id="discoveries_enableSelect"]/descendant::span[@class="ag-header-select-all"])
        Sleep (${Very_Short_Wait_Time})
    }
    
    // search and select the device
    // enter the device in the search
    Web.Click Object(//*[@id="discoveries_enableSelect"]/descendant::input[@class="text-search"])
    Web.Set Text(//*[@id="discoveries_enableSelect"]/descendant::input[@class="text-search"],${Device})
    Web.Click Object(//*[@id="discoveries_enableSelect"]/descendant::span[@class="magnifier-icon magnifier-icon-list-filter"])
        
    // allow the filter to complete
    HPCC_Library.WaitForSpinner
    
    // verify device is listed as first device
    // get the Serial No and Asset No of firt devcie and compare both to specefied device
    Set Variable (${FirstDev_AssetNo},)
    Set Variable (${FirstDev_SerialNo},)
    
    Web.Get Text(//*[@id="discoveries_enableSelect"]/descendant::div[@row-index="0"]/descendant::div[@col-id="assetNumber"]/span/span,${FirstDev_AssetNo})
    
    Web.Get Text(//*[@id="discoveries_enableSelect"]/descendant::div[@row-index="0"]/descendant::div[@col-id="serialNumber"]/span/span,${FirstDev_SerialNo})
    
    If: Contains Ignore Case (${FirstDev_AssetNo} - ${FirstDev_SerialNo},${Device})
    {
        // device found
    }
    Fail:
    {
        Web.Capture Screenshot (EnableMasterDevice_Failed.png)
        Return With Fail (Fail selecting the Enable SIO button!)
    }
    Error:
    {
        Web.Capture Screenshot (EnableMasterDevice_Error.png)
        Return With Error (Error selecting the Enable SIO button!)
    }
    
    // ensure that all device are selected
    If: Web.Wait For Object(//*[@id="discoveries_enableSelect"]/descendant::span[@class="ag-checkbox-checked"],${Minimal_Wait_Time})
    {
    }
    Fail:
    {
        Web.Click Object(//*[@id="discoveries_enableSelect"]/descendant::span[@class="ag-header-select-all"])
        Sleep (${Very_Short_Wait_Time})
    }
    
    // click Next
    Web.Click Object(//div[@class="enableMasterDevices"]/descendant::div[@class="footer"]/button[contains\(text\(\)\,"Next"\)])
    
    HPCC_Library.WaitForSpinner
    
    Web.Wait For Object (//div[@class="enableMasterDevices"]/descendant::div[@class="setDiscoveryMethod"],${Wait_Time})
    
    // check for multicast discovery method
    If: Equals IgnoreCase (${Multicast_YN},Y)
    {
        // select multicast discovery method
        Web.Click Object(//*[@id="useWsDiscoveryCheckbox"]/parent::*)
        
        If: Equals IgnoreCase (${Discover_Period},Discover Once)
        {
            // set to "Discover once"
            Web.Click Object(//*[@id="once"]/following-sibling::span)
        }
        Fail:
        {
            // the following is for setting the "Make Recurring" options settings
            Web.Click Object(//*[@id="recurring"]/following-sibling::span)
            
            // set for the specified period and time
            Web.Click Object(//div[@class="setDiscoveryMethod"]/descendant::div[@class="useWsDiscovery"]/descendant::div[@class="patternDropdown"]/div)
            
            Web.Click Object(//li[@id="${Discover_Period}"])
            
            Web.Click Object(//div[@class="setDiscoveryMethod"]/descendant::div[@class="useWsDiscovery"]/descendant::div[@class="hourDropdown"]/div)
            
            Web.Click Object(//li[@id="${Discover_Hour}"])
            
            Web.Click Object(//div[@class="setDiscoveryMethod"]/descendant::div[@class="useWsDiscovery"]/descendant::div[@class="minuteDropdown"]/div)
            
            Web.Click Object(//li[@id="${Discover_Minute}"])
            
            Web.Click Object(//div[@class="setDiscoveryMethod"]/descendant::div[@class="useWsDiscovery"]/descendant::div[@class="amPmDropdown"]/div)
            
            Web.Click Object(//li[@id="${Discover_AM_PM}"])
        }
    }
    
    // check for DAA discovery method
    If: Equals IgnoreCase (${DeviceAnnounce_YN},Y)
    {
        // select DAA discovery method
        Web.Click Object(//*[@id="useDeviceAnnouncementCheckbox"]/parent::*)
        
        // set trusted authority if specified
        If: Equals IgnoreCase (${TrustedAuth_YN},Y)
        {
            // this needs to be implemented
        }
        
        // select secondary listener if specified
        If: Equals IgnoreCase (${SecondaryListeners_YN},Y)
        {
            // this needs to be implemented
        }
    }
    
    // click Next
    Web.Click Object(//div[@class="setDiscoveryMethod"]/descendant::div[@class="footer"]/button[contains\(text\(\)\,"Next"\)])

    Web.Wait For Object (//div[@class="enableMasterDevices"]/descendant::div[@class="configureOptions"],${Wait_Time})

    If: Equals IgnoreCase (${AddAllDevices_YN},Y)
    {
        // select to add discovered devies
        Web.Click Object(//input[@id="addDeviceCheckbox"]/parent::*)
    }
    
    // complete the enablement
    Web.Click Object(//div[@class="configureOptions"]/descendant::div[@class="footer"]/button[contains\(text\(\)\,"Add and enable"\)])
    
    HPCC_Library.WaitForSpinner
    
    Web.Wait For Object (//div[@class="hpBlueButton" and contains\(text\(\)\,"Done"\)],${Wait_Time})
    
    Web.Click Object(//div[@class="hpBlueButton" and contains\(text\(\)\,"Done"\)])
    
    HPCC_Library.WaitForSpinner
    
    Sleep (${Very_Short_Wait_Time})
    
    Web.Click Object(//button[contains\(text\(\)\,"Close"\)])
    
    HPCC_Library.WaitForSpinner
    
    Sleep (${Very_Short_Wait_Time})
    
    HPCC_Library.WaitForSpinner
    
    //task status
    If: HPCC_Library.CheckTaskCompletion(${Customer},${TaskCompleteLimit})
    {
        Sleep (${Very_Short_Wait_Time})
        Return With Pass (EnableSIO completed!)
    }
    Fail:
    {
        Return With Fail (Fail while checking completion of Master Device Enable task!)
    }
    Error:
    {
        Return With Error (Error while checking completion of Master Device Enable task!)
    }
}

