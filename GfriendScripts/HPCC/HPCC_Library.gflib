    }
    
    // click the uninstall button on the app manage form
    If: Web.Click Object(//*[@id="moveToUninstallSolutionButton"])
    {
        // allow the uninstall page to show
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (UninstallApp_Failed.png)
        Return With Fail (Fail clicking the app Uninstall button!)
    }
    Error:
    {
        Web.Capture Screenshot (UninstallApp_Error.png)
        Return With Error (Error clicking the app Uninstall button!)
    }

    // search and select the device
    Web.Click Object(//*[@id="accountDetailManageSolutionsUninstallTableId"]/descendant::input[@class="text-search"])
    Web.Set Text(//*[@id="accountDetailManageSolutionsUninstallTableId"]/descendant::input[@class="text-search"],${UninstallDevice})
    Web.Click Object(//*[@id="accountDetailManageSolutionsUninstallTableId"]/descendant::span[@class="magnifier-icon magnifier-icon-list-filter"])
    
    // allow the filter to complete
    HPCC_Library.WaitForSpinner
    
    // verify device is listed as first device
    // get the Serial No and Asset No of first devcie and compare both to specefied device
    Set Variable (${FirstDev_AssetNo},)
    Set Variable (${FirstDev_SerialNo},)
    
    Web.Get Text(//*[@id="accountDetailManageSolutionsUninstallTableId"]/descendant::div[@row-index="0"]/descendant::div[@col-id="assetNumber"]/span/span,${FirstDev_AssetNo})
    
    Web.Get Text(//*[@id="accountDetailManageSolutionsUninstallTableId"]/descendant::div[@row-index="0"]/descendant::div[@col-id="serialNumber"]/span/span,${FirstDev_SerialNo})
    
    If: Contains Ignore Case (${FirstDev_AssetNo} - ${FirstDev_SerialNo},${UninstallDevice})
    {
        // device found
    }
    Fail:
    {
        Web.Capture Screenshot (InstallApp_Failed.png)
        Return With Fail (Fail searching for customer device!)
    }
    Error:
    {
        Web.Capture Screenshot (InstallApp_Error.png)
        Return With Error (Error searching for device!)
    }
    
    // check for app already installed
    Web.Get Text (//*[@id="accountDetailManageSolutionsUninstallTableId"]/descendant::div[@row-index="0"]/descendant::div[@col-id="status"]/div/div/span,${InstallStatus})
    If: Equals IgnoreCase (${InstallStatus},Not Installed)
    {
        // already installed, return with a Pass
        Web.Click Object (//*[@id="closeButton"])
        Return With Pass (App not installed!)
    }
    
    // ensure that all device are selected
    If: Web.Wait For Object(//*[@id="accountDetailManageSolutionsUninstallTableId"]/descendant::span[@class="ag-checkbox-checked"],${Minimal_Wait_Time})
    {
    }
    Fail:
    {
        Web.Click Object(//*[@id="accountDetailManageSolutionsUninstallTableId"]/descendant::span[@class="ag-header-select-all"])
        Sleep (${Very_Short_Wait_Time})
    }
    
    // the device is selected by default, click the Next button
    If: Web.Click Object(//*[@id="nextButton"])
    {
        Sleep (${Very_Short_Wait_Time})
    }
    Fail:
    {
        Web.Capture Screenshot (UninstallApp_Failed.png)
        Return With Fail (Fail clicking the Next button after selecting device!)
    }
    Error:
    {
        Web.Capture Screenshot (UninstallApp_Error.png)
        Return With Error (Error clicking the Next button after selecting device!)
    }

    //install button
    Web.Click Object(//*[@id="nextButton"])
    
    HPCC_Library.WaitForSpinner

    // text "Task created successfully!"
    IF: Web.Wait For Text (Task created successfully!,${Short_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (UninstallApp_Failed.png)
        Return With Fail (Uninstall task was not successfully created!)
    }
    
    // Done button
    Web.Click Object(//*[@id="moveToManageSolutionButton"])
    
    HPCC_Library.WaitForSpinner
    
    // close button
    If: Web.Wait For Object (//*[@id="closeButton"],${Very_Short_Wait_Time})
    {
        Web.Click Object(//*[@id="closeButton"])
        HPCC_Library.WaitForSpinner
    }
    
    Sleep (${Very_Short_Wait_Time})
    
    //task status
    If: HPCC_Library.CheckTaskCompletion(${UninstallCustomer},${TaskCompleteLimit})
    {
        Sleep (${Very_Short_Wait_Time})
        Return With Pass (InstallApp completed!)
    }
    Fail:
    {
        Return With Fail (Fail while checking completion of Uninstall App task!)
    }
    Error:
    {
        Return With Error (Error while checking completion of Uninstall App task!)
    }
}

/// <Name>CheckTaskCompletion</Name>
/// <Description>Monitor the last task for the customer until it is completed</Description>
/// <Parameters>TaskCustomer : customer in HPCC</Parameters>
/// <Parameters>TaskCompleteLimit : task completion tiemout in seconds</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
CheckTaskCompletion(${TaskCustomer},${TaskCompleteLimit})
{ 
    // access Tasks
    If: Web.Wait For Object (//div[@class="hpMenu"]/descendant::a[@href="/tasks/main"]/div/div/p,${Long_Wait})
    {
        Web.Click Object (//div[@class="hpMenu"]/descendant::a[@href="/tasks/main"]/div/div/p)
    }
    Fail:
    {
        Web.Capture Screenshot (CheckTaskCompletion_Failed.png)
        Return With Fail (Fail while accessing Tasks!)
    }

    // wait for the tasks page to show
    HPCC_Library.WaitForSpinner
    
    If: Web.Wait For Object (//div[@class="tasks"]/descendant::div[@class="hpLargeTitle"],${Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (CheckTaskCompletion_Failed.png)
        Return With Fail (Fail while accessing Tasks!)
    }

    // filter to tasks for the customer account
    If: Web.Wait For Object (//*[@id="tasksTableId"]/descendant::input[@class="text-search"],${Wait_Time})
    {
        // enter the account in the search
        Web.Click Object(//*[@id="tasksTableId"]/descendant::input[@class="text-search"])
        Web.Set Text(//*[@id="tasksTableId"]/descendant::input[@class="text-search"],${TaskCustomer})
        Web.Click Object (//*[@id="tasksTableId"]/descendant::span[@class="magnifier-icon magnifier-icon-list-filter"])
        
        // allow the filter to complete
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (CheckTaskCompletion_Failed.png)
        Return With Fail (Fail filtering Tasks for the customer '${TaskCustomer}'!)
    }
    
    // open the top task
    If: Web.Wait For Object (//*[@id="tasksTableId"]/descendant::div[@ref="eBodyContainer"]/div,${Long_Wait})
    {
        Web.Click Object (//*[@id="tasksTableId"]/descendant::div[@ref="eBodyContainer"]/div)

        // wait for the task details to show
        HPCC_Library.WaitForSpinner
        
        Web.Wait For Object (//div[@class="taskInfo"],${Wait_Time})
    }
    Fail:
    {
        Web.Capture Screenshot (CheckTaskCompletion_Failed.png)
        Return With Fail (Fail while selecting the Task for customer '${TaskCustomer}'!)
    }
    
    // new monitoring loop and result checking
    // monitor for the task complete
    While:!Web.Wait For Object (//*[@id="detailStatusString"],${Minimal_Wait_Time}):90
    {
        // this sleep adjusts so each loop takes approx 1 minute
        Sleep (39)
        Web.Refresh
        Sleep (${Long_Wait})
    }
    
    // get the overall task status to check for success/fail/error or unknown
    If: Web.Wait For Object (//*[@id="detailStatusString"],${Zero_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (CheckTaskCompletion_Task_Failed.png)
        Return With Fail (Fail - Task for customer '${TaskCustomer}' failed to complete in time!)
    }
    Error:
    {
        Web.Capture Screenshot (CheckTaskCompletion_Task_Error.png)
        Return With Fail (Error while getting Task status for customer '${TaskCustomer}'!)
    }
    
    Web.Get Text (//*[@id="detailStatusString"],${TaskStatus})
    
    If: Contains Ignore Case (${TaskStatus},Succeed)
    {
        Return With Pass (CheckTaskCompletion completed with Success!)
    }
    Fail:
    {
        If: Contains Ignore Case (${TaskStatus},Fail)
        {
            // click on the icon to display the failure info, then get a screen capture
            Web.Click Object (//*[@id="taskDetailDevicesTasksTableId"]/descendant::div[@ref="eBodyContainer"]/descendant::div[@class="statusWithPopover"]/div/div)
            
            Web.Capture Screenshot (CheckTaskCompletion_Task_Failed.png)
            Return With Fail (Fail - Task for customer '${TaskCustomer}' completed with Fail!)
        }
        Fail:
        {
            If: Contains Ignore Case (${TaskStatus},Error)
            {
                // click on the icon to display the failure info, then get a screen capture
                Web.Click Object (//*[@id="taskDetailDevicesTasksTableId"]/descendant::div[@ref="eBodyContainer"]/descendant::div[@class="statusWithPopover"]/div/div)
            
                Web.Capture Screenshot (CheckTaskCompletion_Task_Errored.png)
                Return With Fail (Error - Task for customer '${TaskCustomer}' completed with Error!)
            }
            Fail:
            {
                Web.Capture Screenshot (CheckTaskCompletion_Task_UnkownStatus.png)
                Return With Error (Fail - Task for customer '${TaskCustomer}' completed with an unhandled status!)
            }
        }
    }
}

ClearAccountDeviceSearch
{
    // clear any previous search
    If: Web.Wait For Object(//*[@id="accountDetailDevicesTableId"]/descendant::span[@class="searchClearIcon" or @class="search-clear-icon clear-button-list-filter"],${Zero_Wait_Time})
    {
        Web.Click Object(//*[@id="accountDetailDevicesTableId"]/descendant::span[@class="searchClearIcon" or @class="search-clear-icon clear-button-list-filter"])
        
        HPCC_Library.WaitForSpinner
    }
    Return With Pass (ClearAccountDeviceSearch completed!)
}

/// <Name>SearchAccountDevice</Name>
/// <Description>Search for a device in a customer account</Description>
/// <Parameters>Device : device identifier in HPCC</Parameters>
/// <Precondition></Precondition>
/// <Notes>Called by multiple routines in this library</Notes>
SearchAccountDevice(${Device})
{
    If: Web.Wait For Object(//*[@id="accountDetailDevicesTableId"]/descendant::input[@id="searchInput" or @class="text-search"],${Long_Wait})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (SearchAccountDevice_Failed.png)
        Return With Fail (Fail searching for device '${Device}' in customer account!)
    }
    Error:
    {
        Web.Capture Screenshot (SearchAccountDevice_Error.png)
        Return With Error (Error searching for device '${Device} in customer account!)
    }
    
    // page the screen down so the deivces are visible
    Web.Press PageDown Key(//*[@id="accountDetailDevicesTableId"])
    Sleep (${Minimal_Wait_Time})
    
    // clear any previous search
    HPCC_Library.ClearAccountDeviceSearch
    
    // enter the device in the search
    Web.Click Object(//*[@id="accountDetailDevicesTableId"]/descendant::input[@id="searchInput" or @class="text-search"])
    Web.Set Text(//*[@id="accountDetailDevicesTableId"]/descendant::input[@id="searchInput" or @class="text-search"],${Device})
    Web.Click Object(//*[@id="accountDetailDevicesTableId"]/descendant::span[@class="magnifierIcon" or @class="magnifier-icon magnifier-icon-list-filter"])
    
    // allow the filter to complete
    HPCC_Library.WaitForSpinner
            
    // check for 1 or more devices found
    Web.Get Text (//*[@id="accountDetailDevicesTableId"]/descendant::span[@id="totalItemCount"],${DeviceCount})
    If: Equals (${DeviceCount},\(0\))
    {
        Web.Capture Screenshot (SearchAccountDevice_Failed.png)
        Return With Fail (Fail searching for device '${Device}' in customer account!)
    }
    Fail:
    {
        Return With Pass (SearchAccountDevice completed!)
    }
}

