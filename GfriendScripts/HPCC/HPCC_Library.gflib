/// <Name>SignOut</Name>
/// <Description>Sign out of HPCC</Description>
/// <Parameters></Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
SignOut()
{// sign out of the HPCC site
    If: Web.Click Object (//*[@id="email"])
    {
    }
    Fail:
    {
        Web.Capture Screenshot (SignOut_Failed.png)
        Return With Fail (Fail while signing out of HPCC!)
    }
    
    If: Web.Click Object (//*[@id="signOutButton"])
    {
        Sleep (${Minimal_Wait_Time})
        HPCC_Library.WaitForSpinner
        
        Return With Pass (Sign Out completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (SignOut_Failed.png)
        Return With Fail (Fail while signing out of HPCC!)
    }
}

/// <Name>SelectAccount</Name>
/// <Description>Select the account customer</Description>
/// <Parameters>AccountCustomer : customer in HPCC</Parameters>
/// <Precondition></Precondition>
/// <Notes>Called by multiple routines in this library</Notes>
SelectAccount(${AccountCustomer})
{
    // check for already in specified account page
    If: Web.Wait For Object (//div[@class="accountDetail"]/descendant::span[@id="name" and @title="${AccountCustomer}"],${Zero_Wait_Time})
    {
        // already in account page
        Return With Pass (SelectAccount completed - already in specified account page!)
    }
    
    // click on Accounts
    If: Web.Click Object (//div[@class="hpMenu"]/descendant::a[@href="/accounts/main"]/div/div/p)
    {
    }
    Fail:
    {
        Web.Capture Screenshot (SelectAccount_Failed.png)
        Return With Fail (Fail while selecting Accounts!)
    }
    Error:
    {
        Web.Capture Screenshot (SelectAccount_Error.png)
        Return With Error (Error while selecting Accounts!)
    }
    
    // wait for the account list to populate
    HPCC_Library.WaitForSpinner
    
    // enter the account in the search
    If: Web.Click Object(//*[@id="accountsTableId"]/descendant::input[@class="text-search"])
    {
        Sleep (${Minimal_Wait_Time})
    }
    Fail:
    {
        Web.Capture Screenshot (SelectAccount_Failed.png)
        Return With Fail (Fail while selecting Accounts!)
    }
    Error:
    {
        Web.Capture Screenshot (SelectAccount_Error.png)
        Return With Error (Error while selecting Accounts!)
    }
    
    // enter the search
    Web.Set Text(//*[@id="accountsTableId"]/descendant::input[@class="text-search"],${AccountCustomer})
    Web.Click Object (//*[@id="accountsTableId"]/descendant::span[@class="magnifier-icon magnifier-icon-list-filter"])
    
    // allow filter to complete
    HPCC_Library.WaitForSpinner
    
    // select the first found account
    //    IF: Web.Click Object (//*[@id="accountsTableId"]/descendant::div[@ref="eBodyContainer"]/div[1])
    If: Web.Click Object (//*[@id="accountsTableId"]/descendant::div[@ref="eBodyContainer"]/descendant::div[@col-id="accountName"]/descendant::span[@title="${AccountCustomer}"])
    {
        HPCC_Library.WaitForSpinner
        
        Return With Pass (SelectAccount completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (SelectAccount_Failed.png)
        Return With Fail (Fail while selecting customer account '${AccountCustomer}'!)
    }
    Error:
    {
        Web.Capture Screenshot (SelectAccount_Error.png)
        Return With Error (Error while selecting customer account '${AccountCustomer}'!)
    }
}

/// <Name>SearchApp</Name>
/// <Description>Search for an app in a customer account</Description>
/// <Parameters>App : app name</Parameters>
/// <Precondition></Precondition>
/// <Notes>Called by multiple routines in this library</Notes>
SearchApp(${App})
{// search for an app in the customer"s app list
    // wait for the list of apps to be displayed
    If: Web.Wait For Object (//*[@id="accountDetailSolutionsTableId"]/descendant::span[@id="totalItemCount"],${Long_Wait})
    {
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (SearchApp_Failed.png)
        Return With Fail (Fail accessing the customer account apps!)
    }
    Error:
    {
        Web.Capture Screenshot (SearchApp_Error.png)
        Return With Error (Error accessing the customer account apps!)
    }

    // enter the app into the search textbox and click the search link
    IF: Web.Click Object(//*[@id="accountDetailSolutionsTableId"]/descendant::input[@id="searchInput" or @class="text-search"])
    {
        // enter the search
        Web.Set Text(//*[@id="accountDetailSolutionsTableId"]/descendant::input[@id="searchInput" or @class="text-search"],${App})
        Web.Click Object(//*[@id="accountDetailSolutionsTableId"]/descendant::span[@class="magnifierIcon" or @class="magnifier-icon magnifier-icon-list-filter"])
        
        // allow the filter to complete
        HPCC_Library.WaitForSpinner
        
        Return With Pass (SearchApp completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (SearchApp_Failed.png)
        Return With Fail (Fail while searching for customer account app '${App}'!)
    }
    Error:
    {
        Web.Capture Screenshot (SearchApp_Error.png)
        Return With Error (Error while searching for customer account app '${App}!)
    }
}

/// <Name>ManageSelectedApp</Name>
/// <Description>Select the Manage link of the selected app</Description>
/// <Parameters>SelectedApp : app name</Parameters>
/// <Precondition></Precondition>
/// <Notes>Called by multiple routines in this library</Notes>
ManageSelectedApp(${SelectedApp})
{
    // ensure the app is listed
    If: Web.Wait For Object(//*[@id="accountDetailSolutionsTableId"]/descendant::div[@class="accountSolutionsTable" or @ref="eBody"]/descendant::*[text\(\)="${SelectedApp}"],${Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (ManageSelectedApp_Failed.png)
        Return With Fail (Fail accessing the customer account apps!)
    }
    Error:
    {
        Web.Capture Screenshot (ManageSelectedApp_Error.png)
        Return With Error (Error accessing the customer account apps!)
    }
    
    // attempt to click on the selected app and then the manage button
    While:!Web.Wait For Object (//*[@id="accountDetailSolutionsTableId"]/descendant::div[@class="accountSolutionsTable" or @ref="eBody"]/descendant::div[@class="rightArea" and @style=""],${Zero_Wait_Time}):3
    {
        Web.Click Object(//*[@id="accountDetailSolutionsTableId"]/descendant::div[@class="accountSolutionsTable" or @ref="eBody"]/descendant::span[@class="nameArea" and not\(text\(\)\)]/descendant::*[text\(\)="${SelectedApp}"])
    }
    
    If: Web.Wait For Object (//*[@id="accountDetailSolutionsTableId"]/descendant::div[@class="accountSolutionsTable" or @ref="eBody"]/descendant::div[@class="rightArea" and @style=""],${Zero_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (ManageSelectedApp_Failed.png)
        Return With Fail (Fail while managing customer account app '${SelectedApp}!)
    }
    Error:
    {
        Web.Capture Screenshot (ManageSelectedApp_Error.png)
        Return With Error (Error while managing customer account app '${SelectedApp}!)
    }
    
    If: Web.Click Object(//*[@id="accountDetailSolutionsTableId"]/descendant::div[@class="accountSolutionsTable" or @ref="eBody"]/descendant::div[@class="rightArea" and @style=""]/descendant::button[@class="hpBlueButton area"])
    {
        // allow the manage app popup to show
        HPCC_Library.WaitForSpinner
        
        Return With Pass (ManageSelectedApp completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (ManageSelectedApp_Failed.png)
        Return With Fail (Fail while clicking on App Manage button for app '${SelectedApp}'!)
    }
    Error:
    {
        Web.Capture Screenshot (ManageSelectedApp_Error.png)
        Return With Fail (Error while clicking on App Manage button for app '${SelectedApp}!)
    }
}

/// <Name>InstallApp</Name>
/// <Description>Install the specified app to a device in a customer account</Description>
/// <Parameters>InstallCustomer : customer in HPCC</Parameters>
/// <Parameters>InstallApp : name of app to install</Parameters>
/// <Parameters>InstallDevice : device identifier in HPCC</Parameters>
/// <Parameters>TaskCompleteLimit : task completion limit in minutes</Parameters>
/// <Precondition>Signed into HPCC</Precondition>
/// <Notes></Notes>
InstallApp(${InstallCustomer},${InstallApp},${InstallDevice},${TaskCompleteLimit})
{
    // select the account
    If: HPCC_Library.SelectAccount(${InstallCustomer})
    {
    }
    Fail:
    {
        Return With Fail (Fail selecting the customer account!)
    }
    Error:
    {
        Return With Error (Error selecting the customer account!)
    }
    
    // select the app
    If: HPCC_Library.SearchApp(${InstallApp})
    {
    }
    Fail:
    {
        Return With Fail (Fail selecting the customer app!)
    }
    Error:
    {
        Return With Error (Error selecting the customer app!)
    }
    
    // manage the app
    If: HPCC_Library.ManageSelectedApp(${InstallApp})
    {
    }
    Fail:
    {
    }
    Error:
    {
        Return With Error (Error managing the customer app!)
    }
    
    // verify in Manage App screen
    If: Web.Wait For Object (//*[@id="accountDetailManageSolutionsManageTableId"],${Zero_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (InstallApp_Failed.png)
        Return With Fail (Fail managing the app!)
    }
    Error:
    {
        Web.Capture Screenshot (InstallApp_Error.png)
        Return With Error (Error managing the app!)
    }
    
    // click the install button on the app manage form
    Web.Click Object(//*[@id="moveToInstallSolutionButton"])
    
    // allow the install page to show
    HPCC_Library.WaitForSpinner

    // uncheck all devices if not already unchecked
    If: Web.Wait For Object(//*[@id="accountDetailManageSolutionsInstallTableId"]/descendant::span[@class="ag-checkbox-checked"],${Short_Wait_Time})
    {
        Web.Click Object(//*[@id="accountDetailManageSolutionsInstallTableId"]/descendant::span[@class="ag-header-select-all"])
        Sleep (${Very_Short_Wait_Time})
    }
    
    // search and select the device
    Web.Click Object(//*[@id="accountDetailManageSolutionsInstallTableId"]/descendant::input[@class="text-search"])
    Web.Set Text(//*[@id="accountDetailManageSolutionsInstallTableId"]/descendant::input[@class="text-search"],${InstallDevice})
    Web.Click Object(//*[@id="accountDetailManageSolutionsInstallTableId"]/descendant::span[@class="magnifier-icon magnifier-icon-list-filter"])
    
    // allow the filter to complete
    HPCC_Library.WaitForSpinner
    
    // verify device is listed as first device
    // get the Serial No and Asset No of first devcie and compare both to specefied device
    Set Variable (${FirstDev_AssetNo},)
    Set Variable (${FirstDev_SerialNo},)
    
    Web.Get Text(//*[@id="accountDetailManageSolutionsInstallTableId"]/descendant::div[@row-index="0"]/descendant::div[@col-id="assetNumber"]/span/span,${FirstDev_AssetNo})
    
    Web.Get Text(//*[@id="accountDetailManageSolutionsInstallTableId"]/descendant::div[@row-index="0"]/descendant::div[@col-id="serialNumber"]/span/span,${FirstDev_SerialNo})
    
    If: Contains Ignore Case (${FirstDev_AssetNo} - ${FirstDev_SerialNo},${InstallDevice})
    {
        // device found
    }
    Fail:
    {
        Web.Capture Screenshot (InstallApp_Failed.png)
        Return With Fail (Fail searching for customer device!)
    }
    Error:
    {
        Web.Capture Screenshot (InstallApp_Error.png)
        Return With Error (Error searching for customer device!)
    }
    
    // check for app already installed
    Web.Get Text (//*[@id="accountDetailManageSolutionsInstallTableId"]/descendant::div[@row-index="0"]/descendant::div[@col-id="status"]/div/div/span,${InstallStatus})
    If: Equals IgnoreCase (${InstallStatus},Installed)
    {
        // already installed, return with a Pass
        Web.Click Object (//*[@id="closeButton"])
        Return With Pass (App already installed!)
    }
    
    // ensure that all device are selected
    If: Web.Wait For Object(//*[@id="accountDetailManageSolutionsInstallTableId"]/descendant::span[@class="ag-checkbox-checked"],${Minimal_Wait_Time})
    {
    }
    Fail:
    {
        Web.Click Object(//*[@id="accountDetailManageSolutionsInstallTableId"]/descendant::span[@class="ag-header-select-all"])
        Sleep (${Very_Short_Wait_Time})
    }
    
    // the device is selected by default, click the Next button
    If: Web.Click Object(//*[@id="nextButton"])
    {
        Sleep (${Very_Short_Wait_Time})
    }
    Fail:
    {
        Web.Capture Screenshot (InstallApp_Failed.png)
        Return With Fail (Fail clicking the Next button after selecting device!)
    }
    Error:
    {
        Web.Capture Screenshot (InstallApp_Error.png)
        Return With Error (Error clicking the Next button after selecting device!)
    }

    //install button
    Web.Click Object(//*[@id="nextButton"])
    
    HPCC_Library.WaitForSpinner

    // text "Task created successfully!"
    IF: Web.Wait For Text (Task created successfully!,${Short_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (InstallApp_Failed.png)
        Return With Fail (Install task was not successfully created!)
    }
    
    // Done button
    Web.Click Object(//*[@id="moveToManageSolutionButton"])
    
    HPCC_Library.WaitForSpinner
    
    // close button
    If: Web.Wait For Object (//*[@id="closeButton"],${Very_Short_Wait_Time})
    {
        Web.Click Object(//*[@id="closeButton"])
        HPCC_Library.WaitForSpinner
    }
    
    Sleep (${Very_Short_Wait_Time})
    
    //task status
    If: HPCC_Library.CheckTaskCompletion(${InstallCustomer},${TaskCompleteLimit})
    {
        Sleep (${Very_Short_Wait_Time})
        Return With Pass (InstallApp completed!)
    }
    Fail:
    {
        Return With Fail (Fail while checking completion of Install App task!)
    }
    Error:
    {
        Return With Error (Error while checking completion of Install App task!)
    }
}

/// <Name>UninstallApp</Name>
