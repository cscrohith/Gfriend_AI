/// <Precondition>Signed into HPCC</Precondition>
/// <Notes></Notes>
EnableLinkPlatform(${Customer},${Device},${TaskCompleteLimit})
{
    // select the account
    If: HPCC_Library.SelectAccount(${Customer})
