        Web.Capture Screenshot (EnableLinkPlatform_Failed.png)
        Return With Fail (Fail selecting the Enable SIO button!)
    }
    Error:
    {
        Web.Capture Screenshot (EnableLinkPlatform_Error.png)
        Return With Error (Error selecting the Enable SIO button!)
    }
    
    // check for workpath link already enabled
    Web.Get Text (//*[@id="accountDetailManageServicesEnableTableId"]/descendant::div[@row-index="0"]/descendant::div[@col-id="status"]/div/div/span,${LinkStatus})
    If: Equals IgnoreCase (${LinkStatus},enabled)
    {
        // already enabled, return with a Pass
        Web.Click Object (//*[@id="closeButton"])
        Return With Pass (Workpath already enabled!)
    }
    
    // ensure that all device are selected
    If: Web.Wait For Object(//*[@id="accountDetailManageServicesEnableTableId"]/descendant::span[@class="ag-checkbox-checked"],${Minimal_Wait_Time})
    {
    }
    Fail:
    {
        Web.Click Object(//*[@id="accountDetailManageServicesEnableTableId"]/descendant::span[@class="ag-header-select-all"])
        Sleep (${Very_Short_Wait_Time})
    }
    
    // when available complete the task and close the popup
    If: Web.Wait For Object (//*[@id="nextButton"],${Very_Short_Wait_Time})
    {
        Web.Click Object (//*[@id="nextButton"])
        Sleep (${Minimal_Wait_Time})
        
        Web.Wait For Object (//*[@id="nextButton"],${Very_Short_Wait_Time})
        Web.Click Object (//*[@id="nextButton"])
        HPCC_Library.WaitForSpinner
        
        Web.Wait For Object (//*[@id="moveToManageServiceButton"],${Wait_Time})
        Web.Click Object (//*[@id="moveToManageServiceButton"])
        HPCC_Library.WaitForSpinner
        
        Web.Wait For Object (//*[@id="closeButton"],${Wait_Time})
        Web.Click Object (//*[@id="closeButton"])
    }
    Fail:
    {
        Web.Capture Screenshot (EnableLinkPlatform_Failed.png)
        Return With Fail (Fail while enabling Workpath in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (EnableLinkPlatform_Error.png)
        Return With Error (Error while enabling Workpath in HPCC!)
    }
    
    Sleep (${Very_Short_Wait_Time})
    
    //task status
    If: HPCC_Library.CheckTaskCompletion(${Customer},${TaskCompleteLimit})
    {
        Sleep (${Very_Short_Wait_Time})
        Return With Pass (EnableLinkPlatform completed!)
    }
    Fail:
    {
        Return With Fail (Fail while checking completion of Workpath Enable task!)
    }
    Error:
    {
        Return With Error (Error while checking completion of Workpath Enable task!)
    }
}

