/// <Name>UnassignDevice</Name>
/// <Description>Unassign a device from the Assigned list</Description>
/// <Parameters>Device : device identifier in HPCC</Parameters>
/// <Precondition>Signed into HPCC</Precondition>
/// <Notes></Notes>
UnassignDevice(${Device})
{ 
    // goto the Assigned Devices page
    If: HPCC_Library.GotoDevices(Y)
    {
    }
    Fail:
    {
        Return With Fail (Fail while selecting device in HPCC!)
    }
    Error:
    {
        Return With Error (Error while selecting device in HPCC!)
    }
    
    // select the device
    If: HPCC_Library.SearchAssignedDevice(${Device})
    {
    }
    Fail:
    {
        Return With Fail (Fail selecting the Enable SIO button!)
    }
    Error:
    {
        Return With Error (Error selecting the Enable SIO button!)
    }
    
    // click on the select all checkbox
    Web.Click Object(//*[@id="devicesAssignedTableId"]/descendant::span[@class="ag-header-select-all"])
    If: Web.Wait For Object(//*[@id="showRemoveDevicesFromAccountModalButton"],${Very_Short_Wait_Time})
    {
        // wait for the unassign popup to finish showing
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (UnassignDevice_Failed.png)
        Return With Fail (Fail while unassigning device in HPCC!)
    }
    
    If: Web.Click Object(//*[@id="showRemoveDevicesFromAccountModalButton"])
    {
        // wait for the unassign popup to finish showing
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (UnassignDevice_Failed.png)
        Return With Fail (Fail while unassigning device in HPCC!)
    }
    
    // click to remove the device from the account
    Web.Wait For Object (//*[@id="devicesDeleteDevicesTableId"],${Short_Wait_Time})
    If: Web.Wait For Object (//button[@class="hpBlueButton" and contains\(text\(\)\,"Unassign"\)],${Very_Short_Wait_Time})
    {
        Web.Click Object (//button[@class="hpBlueButton" and contains\(text\(\)\,"Unassign"\)])
        
        // wait for the operation to complete
        HPCC_Library.WaitForSpinner
        
        Return With Pass (UnassignDevice completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (UnassignDevice_Failed.png)
        Return With Fail (Fail while unassigning device in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (UnassignDevice_Error.png)
        Return With Error (Error while unassigning device in HPCC!)
    }
}

/// <Name>UnassignDevice_FromCustomer</Name>
/// <Description>Unassign a device from a customer account</Description>
/// <Parameters>Customer : customer in HPCC</Parameters>
/// <Parameters>Device : device identifier in HPCC</Parameters>
/// <Precondition>Signed into HPCC</Precondition>
/// <Notes></Notes>
UnassignDevice_FromCustomer(${Customer},${Device})
{ 
    // select the account
    If: HPCC_Library.SelectAccount(${Customer})
    {
    }
    Fail:
    {
        Return With Fail (Fail selecting the customer account!)
    }
    Error:
    {
        Return With Error (Error selecting the customer account!)
    }
    
    // select the device
    If: HPCC_Library.SearchAccountDevice(${Device})
    {
    }
    Fail:
    {
        Return With Fail (Fail while selecting device in HPCC!)
    }
    Error:
    {
        Return With Error (Error while selecting device in HPCC!)
    }
    
    // check to see if the device has any solutions installed
    If: Web.Wait For Object(//*[@id="accountDetailDevicesTableId"]/descendant::div[@class="devicesDetailRenderer"],${Long_Wait})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (UnassignDevice_FromCustomer_Failed.png)
        Return With Fail (Fail while unassigning device  in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (UnassignDevice_FromCustomer_Error.png)
        Return With Error (Error while unassigning device in HPCC!)
    }
    
    Web.Get Text (//*[@id="accountDetailDevicesTableId"]/descendant::div[@class="devicesDetailRenderer"]/descendant::div[@class="solutionsArea"],${SolutionsInstalled})
    
    Replace (${SolutionsInstalled}, solutions installed,)
    If: Equals (${SolutionsInstalled},${Zero_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (UnassignDevice_FromCustomer_Failed.png)
        Return With Fail (Fail while unassigning device from account in HPCC due to solutions installed!)
    }
    
    // no solutions installed, continue
    // click on the first row of the device list, up to 3 times, to get the Unassign link to display
    While:!Web.Wait For Object (//*[@id="accountDetailDevicesTableId"]/descendant::div[@class="devicesDetailRenderer"]/descendant::div[@class="rightArea" and @style=""],${Zero_Wait_Time}):3
    {
        Web.Click Object(//*[@id="accountDetailDevicesTableId"]/descendant::div[@class="devicesDetailRenderer"])
    }
    
    If: Web.Wait For Object(//*[@id="accountDetailDevicesTableId"]/descendant::div[@class="devicesDetailRenderer"]/descendant::div[@class="rightArea" and @style=""]/descendant::div[@class="hpInfoIcon"],${Zero_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (UnassignDevice_FromCustomer_Failed.png)
        Return With Fail (Fail while unassigning device  in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (UnassignDevice_FromCustomer_Error.png)
        Return With Error (Error while unassigning device in HPCC!)
    }
    
    // click on the Unassign link
    If: Web.Click Object(//*[@id="accountDetailDevicesTableId"]/descendant::div[@class="configArea"])
    {
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (UnassignDevice_FromCustomer_Failed.png)
        Return With Fail (Fail while unassigning device  in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (UnassignDevice_FromCustomer_Error.png)
        Return With Error (Error while unassigning device in HPCC!)
    }
        
    // click to remove the device from the account
    Web.Wait For Object (//button[@class="hpBlueButton" and contains\(text\(\)\,"Unassign"\)],${Very_Short_Wait_Time})
    If: Web.Click Object (//button[@class="hpBlueButton" and contains\(text\(\)\,"Unassign"\)])
    {
        // wait for the operation to complete
        HPCC_Library.WaitForSpinner
        
        Return With Pass (UnassignDevice_FromCustomer completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (UnassignDevice_FromCustomer_Failed.png)
        Return With Fail (Fail while unassigning device  in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (UnassignDevice_FromCustomer_Error.png)
        Return With Error (Error while unassigning device in HPCC!)
    }
}

/// <Name>AssignDevice</Name>
/// <Description>Assign a device to a customer account</Description>
/// <Parameters>Customer : customer in HPCC</Parameters>
/// <Parameters>Device : device identifier in HPCC</Parameters>
/// <Precondition>Signed into HPCC</Precondition>
/// <Notes></Notes>
AssignDevice(${Customer},${Device})
{ 
    // select the account
    If: HPCC_Library.SelectAccount(${Customer})
    {
    }
    Fail:
    {
        Return With Fail (Fail selecting the customer account!)
    }
    Error:
    {
        Return With Error (Error selecting the customer account!)
    }
    
    // click the Assign Devices button
    Web.Wait For Object(//*[@id="accountDetailDevicesTableId"]/descendant::button[contains\(text\(\)\,"Assign devices"\)],${Long_Wait})
    Web.Click Object(//*[@id="accountDetailDevicesTableId"]/descendant::button[contains\(text\(\)\,"Assign devices"\)])

    // wait for the assign popup to show
    HPCC_Library.WaitForSpinner
    Web.Wait For Object(//div[@class="addDevices"],${Long_Wait})

    // uncheck all
    If: Web.Wait For Object(//*[@id="accountDetailAddDevicesTableId"]/descendant::span[@class="ag-checkbox-checked"],${Wait_Time})
    {
        // the select all checkbox was checked, uncheck it
        Web.Click Object(//*[@id="accountDetailAddDevicesTableId"]/descendant::span[@class="ag-header-select-all"])
    }
    
    // search and select the device
    If: Web.Wait For Object(//*[@id="accountDetailAddDevicesTableId"]/descendant::input[@class="text-search"],${Short_Wait_Time})
    {
        // enter the device in the search
        Web.Click Object(//*[@id="accountDetailAddDevicesTableId"]/descendant::input[@class="text-search"])
        Web.Set Text(//*[@id="accountDetailAddDevicesTableId"]/descendant::input[@class="text-search"],${Device})
        Web.Click Object(//*[@id="accountDetailAddDevicesTableId"]/descendant::span[@class="magnifier-icon magnifier-icon-list-filter"])
        
        // allow the filter to complete
        HPCC_Library.WaitForSpinner

        // ensure that all device are is selected
        Web.Click Object(//*[@id="accountDetailAddDevicesTableId"]/descendant::span[@class="ag-header-select-all"])
        Sleep (${Very_Short_Wait_Time})
    }
    Fail:
    {
        Web.Capture Screenshot (AssignDevice_Failed.png)
        Return With Fail (Fail selecting the Enable SIO button!)
    }
    Error:
    {
        Web.Capture Screenshot (AssignDevice_Error.png)
        Return With Error (Error selecting the Enable SIO button!)
    }

    // add the device
    If: Web.Click Object(//*[@id="simpleTableFooterControlsButtons"]/descendant::button[contains\(text\(\)\,"Add"\)])
    {
        // wait for teh operation to complete
        HPCC_Library.WaitForSpinner
        
        Return With Pass (AssignDevice completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (AssignDevice_Failed.png)
        Return With Fail (Fail while adding device in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (AssignDevice_Error.png)
        Return With Error (Error while adding device in HPCC!)
    }
}

/// <Name>SearchAssignedDevice</Name>
/// <Description>Search for a device in the Assigned table of the device list</Description>
/// <Parameters>Device : device identifier in HPCC</Parameters>
/// <Precondition></Precondition>
/// <Notes>Called by multiple routines in this library</Notes>
SearchAssignedDevice(${Device})
{
    If: Web.Wait For Object(//*[@id="devicesAssignedTableId"]/descendant::input[@class="text-search"],${Long_Wait})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (SearchAssignedDevice_Failed.png)
        Return With Fail (Fail while searching for device in HPCC Assigned devices!)
    }
    Error:
    {
        Web.Capture Screenshot (SearchAssignedDevice_Error.png)
        Return With Error (Error while searching for device in HPCC Assigned devices!)
    }
    
    // enter the device in the search
    Web.Click Object(//*[@id="devicesAssignedTableId"]/descendant::input[@class="text-search"])
    Web.Set Text(//*[@id="devicesAssignedTableId"]/descendant::input[@class="text-search"],${Device})
    Web.Click Object(//*[@id="devicesAssignedTableId"]/descendant::span[@class="magnifier-icon magnifier-icon-list-filter"])
    
    // allow the search to complete
    HPCC_Library.WaitForSpinner
    
    // check for 1 or more devices found
    Web.Get Text (//*[@id="devicesAssignedTableId"]/descendant::span[@id="filteredCount"],${DeviceCount})
    If: Equals (${DeviceCount},1 results)
    {
        Sleep (${Very_Short_Wait_Time})
        
        Return With Pass (SearchAssignedDevice completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (SearchAssignedDevice_Failed.png)
        Return With Fail (Fail while searching for device in HPCC Assigned devices!)
    }
}

/// <Name>GotoDevices</Name>
/// <Description>Go to the devices page</Description>
/// <Parameters>Assigned : Y for the Assinged list</Parameters>
/// <Precondition></Precondition>
/// <Notes>Called by multiple routines in this library</Notes>
GotoDevices(${Assigned})
{
    If: Web.Wait For Object (//div[@class="hpMenu"]/descendant::a[@href="/devices/main"]/div/div/p,${Wait_Time})
    {
        Web.Click Object (//div[@class="hpMenu"]/descendant::a[@href="/devices/main"]/div/div/p)
        
        // wait for the devices page to show
        HPCC_Library.WaitForSpinner
        Web.Wait For Object(//*[@id="moveToAssignedButton"],${Wait_Time})

        // check if to go to the Assigned list
        If: Equals (${Assigned},Y)
        {
            Web.Click Object (//*[@id="moveToAssignedButton"])
            
            // wait for the assigned devices to finish showing
            HPCC_Library.WaitForSpinner
            Web.Wait For Object(//*[@id="devicesAssignedTableId"],${Wait_Time})
        }
    }
    Fail:
    {
        Web.Capture Screenshot (GotoDevices_Failed.png)
        Return With Fail (Fail while selecting Devices in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (GotoDevices_Error.png)
        Return With Error (Error while selecting Devices in HPCC!)
    }
}

/// <Name>RemoveDevice</Name>
/// <Description>Remove a device from HPCC</Description>
/// <Parameters>Device : device identifier in HPCC</Parameters>
/// <Precondition></Precondition>
/// <Notes>Called by multiple routines in this library</Notes>
RemoveDevice(${Device})
{
    // goto the Unassigned Devices page
    If: HPCC_Library.GotoDevices(N)
    {
    }
    Fail:
    {
        Return With Fail (Fail while selecting Devices in HPCC!)
    }
    Error:
    {
        Return With Error (Error while selecting Devices in HPCC!)
    }
    
    // search for the device
    If: Web.Wait For Object (//*[@id="devicesNotAssignedTableId"]/descendant::input[@class="text-search"],${Wait_Time})
    {
        // enter the device to search
        Web.Click Object(//*[@id="devicesNotAssignedTableId"]/descendant::input[@class="text-search"])
        Web.Set Text (//*[@id="devicesNotAssignedTableId"]/descendant::input[@class="text-search"],${Device})
        Web.Click Object(//*[@id="devicesNotAssignedTableId"]/descendant::span[@class="magnifier-icon magnifier-icon-list-filter"])
        
        // allow the filter to complete
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveDevice_Failed.png)
        Return With Fail (Fail while searching for device in HPCC unassigned devices!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveDevice_Error.png)
        Return With Error (Error while searching for device in HPCC unassigned devices!)
    }

    // ensure that all devices found are checked
    If: Web.Wait For Object(//*[@id="devicesNotAssignedTableId"]/descendant::span[@class="ag-checkbox-checked"],${Zero_Wait_Time})
    {
        // the select all checkbox was checked
    }
    Fail:
    {
        // check the select all checkbox
        Web.Click Object(//*[@id="devicesNotAssignedTableId"]/descendant::span[@class="ag-header-select-all"])
    }
    Error:
    {
        // check the select all checkbox
        Web.Click Object(//*[@id="devicesNotAssignedTableId"]/descendant::span[@class="ag-header-select-all"])
    }

    // the device is selected click the button to disconnect the device
    If: Web.Click Object(//*[@id="showDisconnectDevicesModalButton"])
    {
        // wait for the disconnect page to show
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveDevice_Failed.png)
        Return With Fail (Fail while clicking the Disconnect device button in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveDevice_Error.png)
        Return With Error (Error while clicking the Disconnect device button in HPCC!)
    }

    // complete the disconnect popup
    If: Web.Wait For Object (//div[@class="disconnectDevices"],${Wait_Time})
    {
        Web.Click Object(//button[@class="hpBlueButton"])
        HPCC_Library.WaitForSpinner

        // let the process complete
        Web.Wait For Object Disappear (//div[@class="disconnectDevices"],${Long_Wait})
        HPCC_Library.WaitForSpinner
        
        Return With Pass (RemoveDevice completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveDevice_Failed.png)
        Return With Fail (Fail while clicking the Disconnect device button in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveDevice_Error.png)
        Return With Error (Error while clicking the Disconnect device button in HPCC!)
    }
}

/// <Name>RemoveDevice_Customer</Name>
/// <Description>Remove device in a customer from HPCC</Description>
/// <Parameters>Device : device identifier in HPCC</Parameters>
/// <Precondition>Signed into HPCC and in customer page</Precondition>
/// <Notes></Notes>
RemoveDevice_Customer(${Device})
{
    // ensure any device search is cleared
    HPCC_Library.ClearAccountDeviceSearch
    
    // click the right device list button to show the options to unassign and remove devices
    If: Web.Click Object (//*[@id="accountDetailDevicesTableId"]/descendant::div[@class = "accountDevicesButtonGroup" or @class="buttonGroup"]/div/div[@class="image"])
    {
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveDevice_Customer_Failed.png)
        Return With Fail (Fail while accessing the options to unassign and remove devices in a customer!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveDevice_Customer_Error.png)
        Return With Error (Error while accessing the options to unassign and remove devices in a customer!)
    }
    
    // click the Remove from HP Command Center button
    If: Web.Click Object (//*[@id="showOneClickRemovalModalButton"])
    {
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveDevice_Customer_Failed.png)
        Return With Fail (Fail while accessing the button to remove devices in a customer!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveDevice_Customer_Error.png)
        Return With Error (Error while accessing the button to remove devices in a customer!)
    }
    
    // verify in Remove devices from HPCC screen
    If: Web.Wait For Object (//div[@class="oneClickRemoval"],${Short_Wait_Time})
    {
        // wait for the sio popup to finish showing
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveDevice_Customer_Failed.png)
        Return With Fail (Fail while accessing the remove devices from HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveDevice_Customer_Error.png)
        Return With Error (Error while accessing the remove devices from HPCC!)
    }
    
    // uncheck all devices, first click Selet all then click again if it is checked
    Web.Click Object(//*[@id="oneClickRemovalTableId"]/descendant::span[@class="ag-header-select-all"])
    Sleep (${Very_Short_Wait_Time})
    If: Web.Wait For Object(//*[@id="oneClickRemovalTableId"]/descendant::span[@class="ag-checkbox-checked"],${Short_Wait_Time})
    {
        Web.Click Object(//*[@id="oneClickRemovalTableId"]/descendant::span[@class="ag-header-select-all"])
        Sleep (${Very_Short_Wait_Time})
    }
    
    // search and select the device
    If: Web.Wait For Object(//*[@id="oneClickRemovalTableId"]/descendant::input[@class="text-search"],${Short_Wait_Time})
    {
        // enter the device in the search
        Web.Click Object(//*[@id="oneClickRemovalTableId"]/descendant::input[@class="text-search"])
        Web.Set Text(//*[@id="oneClickRemovalTableId"]/descendant::input[@class="text-search"],${Device})
        Web.Click Object(//*[@id="oneClickRemovalTableId"]/descendant::span[@class="magnifier-icon magnifier-icon-list-filter"])
        
        // allow the filter to complete
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveDevice_Customer_Failed.png)
        @Web.Click Object (//button[contains\(text\(\)\,"Cancel"\)])
        Return With Fail (Fail selecting the Enable SIO button!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveDevice_Customer_Error.png)
        @Web.Click Object (//button[contains\(text\(\)\,"Cancel"\)])
        Return With Error (Error selecting the Enable SIO button!)
    }
    
    // verify device is listed as first device
    // get the Serial No and Asset No of firt devcie and compare both to specefied device
    Set Variable (${FirstDev_AssetNo},)
    Set Variable (${FirstDev_SerialNo},)
    
    Web.Get Text(//*[@id="oneClickRemovalTableId"]/descendant::div[@row-index="0"]/descendant::div[@col-id="assetNumber"]/span/span,${FirstDev_AssetNo})
    
    Web.Get Text(//*[@id="oneClickRemovalTableId"]/descendant::div[@row-index="0"]/descendant::div[@col-id="serialNumber"]/span/span,${FirstDev_SerialNo})
    
    If: Contains Ignore Case (${FirstDev_AssetNo} - ${FirstDev_SerialNo},${Device})
    {
        // device found
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveDevice_Customer_Failed.png)
        @Web.Click Object (//button[contains\(text\(\)\,"Cancel"\)])
        Return With Fail (Fail selecting the Enable SIO button!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveDevice_Customer_Error.png)
        @Web.Click Object (//button[contains\(text\(\)\,"Cancel"\)])
        Return With Error (Error selecting the Enable SIO button!)
    }
    
    // ensure that all device are selected
    If: Web.Wait For Object(//*[@id="oneClickRemovalTableId"]/descendant::span[@class="ag-checkbox-checked"],${Minimal_Wait_Time})
    {
    }
    Fail:
    {
        // ensure that the device is selected
        Web.Click Object(//*[@id="oneClickRemovalTableId"]/descendant::span[@class="ag-header-select-all"])
        Sleep (${Very_Short_Wait_Time})
    }
    
    // when available complete the task and close the popup
    If: Web.Wait For Object (//button[contains\(text\(\)\,"Remove"\)],${Very_Short_Wait_Time})
    {
        Web.Click Object (//button[contains\(text\(\)\,"Remove"\)])
        HPCC_Library.WaitForSpinner
        
        Sleep (${Very_Short_Wait_Time})
        
        Return With Pass (RemoveDevice_Customer completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveDevice_Customer_Failed.png)
        @Web.Click Object (//button[contains\(text\(\)\,"Cancel"\)])
        Return With Fail (Fail while removing device from HPCC in customer!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveDevice_Customer_Error.png)
        @Web.Click Object (//button[contains\(text\(\)\,"Cancel"\)])
        Return With Error (Error while removing device from HPCC in customer!)
    }
}


/// <Name>CreateCustomer</Name>
/// <Description>Creeate a new customer account in HPCC</Description>
/// <Parameters>Customer : customer name</Parameters>
/// <Parameters>ReferenceID : customReferend IDer</Parameters>
/// <Parameters>Notes : Notes</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
CreateCustomer(${Customer},${ReferenceID},${Notes})
{ 
    // try to select the account
    If: HPCC_Library.SelectAccount(${Customer})
    {
        // the account already exists
        Return With Fail (HPCC account already exists!)
    }
    Fail:
    {
    }
    Error:
    {
        Return With Error (Error while searching the HPCC account!)
    }
    
    // click on Accounts
    If: Web.Wait For Object (//div[@class="hpMenu"]/descendant::a[@href="/accounts/main"]/div/div/p,${Wait_Time})
    {
         Web.Click Object (//div[@class="hpMenu"]/descendant::a[@href="/accounts/main"]/div/div/p)
    }
    Fail:
    {
        Web.Capture Screenshot (CreateCustomer_Failed.png)
        Return With Fail (Fail while selecting Accounts in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (CreateCustomer_Error.png)
        Return With Error (Error while selecting Accounts in HPCC!)
    }

    // wait for the accounts page to show
    HPCC_Library.WaitForSpinner
    
    //force a small wait to eliminate timing issues waiting for/clicking on the search textbox
    Sleep (${Very_Short_Wait_Time})

    // select to create a new account
    If: Web.Click Object (//*[@id="showCreateAccountModalButton"])
    {
        // wait for the create account popup to show
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (CreateCustomer_Failed.png)
        Return With Fail (Fail while selecting button to create new Account in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (CreateCustomer_Error.png)
        Return With Error (Error while selecting button to create new Account in HPCC!)
    }
    
    If: Web.Wait For Object (//div[@class="createAccount"],${Short_Wait_Time})
    {
        // enter the account name
        Web.Wait For Object (//*[@id="accountName"],${Short_Wait_Time})
        Web.Click Object (//*[@id="accountName"])
        Web.Set Text (//*[@id="accountName"],${Customer})
        
        // enter Reference ID if specified
        If: Equals (${ReferenceID},)
        {// no Reference ID specified
        }
        Fail:
        {
            Web.Click Object (//*[@id="referenceId"])
            Web.Set Text (//*[@id="referenceId"],${ReferenceID})
        }
        
        // enter Notes if specified
        If: Equals (${Notes},)
        {// no Notes specified
        }
        Fail:
        {
            Web.Click Object (//*[@id="textArea"]//textarea)
            Web.Set Text (//*[@id="textArea"]//textarea,${Notes})
        }
        
        // clear all selected users if selected
        If: Web.Wait For Object(//*[@id="accountsCreateUserUsersTableId"]/descendant::span[@class="ag-checkbox-checked"],${Very_Short_Wait_Time})
        {
            // the select all checkbox was checked so uncheck it
            Web.Click Object(//*[@id="accountsCreateUserUsersTableId"]/descendant::span[@class="ag-header-select-all"])
            Sleep (${Very_Short_Wait_Time})
        }
        
        // press the Create button
        Web.Wait For Object (//*[@id="createAccountButton"],${Wait_Time})
        Web.Click Object (//*[@id="createAccountButton"])
        HPCC_Library.WaitForSpinner
        
        // wait for the new account to be ready
        Web.Wait For Object (//div[@class="accountDetail"]/descendant::span[@id="name"],9${Zero_Wait_Time})
    }
    Fail:
    {
        Web.Capture Screenshot (CreateCustomer_Failed.png)
        Return With Fail (Fail while opening the Create Account popup in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (CreateCustomer_Error.png)
        Return With Error (Error while opening the Create Account popup in HPCC!)
    }
    
    // verify the name of the account
    Web.Get Text (//div[@class="accountDetail"]/descendant::span[@id="name"],${DisplayedCustomer})
    If: Equals(${DisplayedCustomer},${Customer})
    {
        // good
        Sleep (${Wait_Time})
        
        Return With Pass (CreateCustomer completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (CreateCustomer_Failed.png)
        Return With Fail (Fail while creating new customer in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (CreateCustomer_Error.png)
        Return With Error (Error while creating new customer in HPCC!)
    }
}

/// <Name>DeleteCustomer</Name>
/// <Description>Remove a device in a customer account and then from HPCC</Description>
/// <Parameters>Customer : customer in HPCC</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
DeleteCustomer(${Customer})
{ 
    // try to select the account
    If: HPCC_Library.SelectAccount(${Customer})
    {
    }
    Fail:
    {
        // the account does not exists
        Return With Fail (Fail while searching the HPCC account!)
    }
    Error:
    {
        Return With Error (Error while searching the HPCC account!)
    }
    
    // select the element to show the account edit and delete options
    If: Web.Wait For Object (//div[@class="accountDetail"]/descendant::div[@class="header"]/descendant::div[@class="hpButtonGroup"]//div[@class="image"],${Short_Wait_Time})
    {
         Web.Click Object (//div[@class="accountDetail"]/descendant::div[@class="header"]/descendant::div[@class="hpButtonGroup"]//div[@class="image"])
         
         // wait for account delete popup to show
         HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (DeleteCustomer_Failed.png)
        Return With Fail (Fail while selecting the account edit/delete element in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (DeleteCustomer_Error.png)
        Return With Error (Error while selecting the account edit/delete element in HPCC!)
    }
    
    // select to Delete the account
    If: Web.Wait For Object (//*[@id="showRemoveAccountModalButton"],${Short_Wait_Time})
    {
        // press the Delete button
        Web.Click Object (//*[@id="showRemoveAccountModalButton"])
        HPCC_Library.WaitForSpinner
        
        // wait for the delete popup and then press the Delete button
        Web.Wait For Object (//div[@class="removeAccount"],${Wait_Time})
        Web.Wait For Object (//*[@id="removeAccountButton"],${Minimal_Wait_Time})
        Web.Click Object (//*[@id="removeAccountButton"])
        
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (DeleteCustomer_Failed.png)
        Return With Fail (Fail finding the Delete Account button in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (DeleteCustomer_Error.png)
        Return With Error (Error finding the Delete Account button in HPCC!)
    }
    
    // wait for the accounts page to show
    If: Web.Wait For Object (//*[@id="showCreateAccountModalButton"],${Very_Long_Wait})
    {
        // good
    }
    Fail:
    {
        Web.Capture Screenshot (DeleteCustomer_Failed.png)
        Return With Fail (Fail, deleting customer in HPCC took longer than 60 seconds!)
    }
    Error:
    {
        Web.Capture Screenshot (DeleteCustomer_Error.png)
        Return With Error (Error while deleting customer in HPCC!)
    }
    
    Sleep (${Very_Short_Wait_Time})
    
    //task status
    If: HPCC_Library.CheckTaskCompletion(${Customer},${TaskCompleteLimit})
    {
        Sleep (${Very_Short_Wait_Time})
        Return With Pass (EnableSIO completed!)
    }
    Fail:
    {
        Return With Fail (Fail while checking completion of Master Device Disable task!)
    }
    Error:
    {
        Return With Error (Error while checking completion of Master Device Disable task!)
    }
}

