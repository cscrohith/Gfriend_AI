/// <Name>InitiateDeviceDiscoverySync</Name>
/// <Description>Initiate a sync of discovered devices from master devices</Description>
/// <Parameters></Parameters>
/// <Precondition>Signed into HPCC and in the customer Discover device</Precondition>
/// <Notes></Notes>
InitiateDeviceDiscoverySync()
{
    // verify in customer device discovery page
    If: Web.Wait For Object (//div[@class="discoveries"],${Zero_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (InitiateDeviceDiscoverySync_Failed.png)
        Return With Fail (Fail - not in customer Device Discoveries page in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (InitiateDeviceDiscoverySync_Error.png)
        Return With Error (Error - not in customer Device Discoveries page in HPCC!)
    }
    
    // click the Instant Discover link
    Web.Click Object(//div[@class="instantDiscover"]/div[@class=""])
    
    // wait for the Instant Discover popup to show
    HPCC_Library.WaitForSpinner
    
