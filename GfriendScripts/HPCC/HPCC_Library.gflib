        Return With Error (Error while  initiating a discovered device sync in HPCC!)
    }
}

/// <Name>InitiateMasterDeviceDiscovery</Name>
/// <Description>Initiated a device discovery using a master device</Description>
/// <Parameters>Device : device identifier in HPCC</Parameters>
/// <Parameters>DiscoveryTimingSet : timing set name if specified</Parameters>
/// <Parameters>DiscoveryTimingLabel : discovery timing label name if specified</Parameters>
/// <Precondition>Signed into HPCC and in the customer Discover device</Precondition>
/// <Notes></Notes>
InitiateMasterDeviceDiscovery(${Device},${DiscoveryTimingSet},${DiscoveryTimingLabel})
{
    // verify in customer device discovery page
    If: Web.Wait For Object (//div[@class="discoveries"],${Zero_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (InitiateMasterDeviceDiscovery_Failed.png)
        Return With Fail (Fail - not in customer Device Discoveries page in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (InitiateMasterDeviceDiscovery_Error.png)
        Return With Error (Error - not in customer Device Discoveries page in HPCC!)
    }
    
    // click the Instant Discover link
    Web.Click Object(//div[@class="instantDiscover"]/div[@class=""])
    
    // wait for the Instant Discover popup to show
    HPCC_Library.WaitForSpinner
    
    Web.Wait For Object (//div[@class="instantDiscover"],${Short_Wait_Time})

    // select the WS-Discovery option
    Web.Click Object(//*[@id="wsDiscovery"]/following-sibling::span)

    Web.Click Object(//button[contains\(text\(\)\,"Next"\)])
    
    HPCC_Library.WaitForSpinner
    
    Web.Wait For Object (//div[@class="wsDiscovery"],${Wait_Time})
    
    // uncheck all devices if not already unchecked
    If: Web.Wait For Object(//*[@id="searching_devices"]/descendant::span[@class="ag-checkbox-checked"],${Short_Wait_Time})
    {
        Web.Click Object(//*[@id="searching_devices"]/descendant::span[@class="ag-header-select-all"])
        Sleep (${Very_Short_Wait_Time})
    }
    
    // search and select the device
    // enter the device in the search
    Web.Click Object(//*[@id="searching_devices"]/descendant::input[@class="text-search"])
    Web.Set Text(//*[@id="searching_devices"]/descendant::input[@class="text-search"],${Device})
    Web.Click Object(//*[@id="searching_devices"]/descendant::span[@class="magnifier-icon magnifier-icon-list-filter"])
        
    // allow the filter to complete
    HPCC_Library.WaitForSpinner
    
    // verify device is listed as first device
    // get the Serial No and Asset No of first device and compare both to specefied device
    Set Variable (${FirstDev_AssetNo},)
    Set Variable (${FirstDev_SerialNo},)
    
    Web.Get Text(//*[@id="searching_devices"]/descendant::div[@row-index="0"]/descendant::div[@col-id="serialNumber"]/span/span,${FirstDev_SerialNo})
    
    If: Contains Ignore Case (${FirstDev_AssetNo} - ${FirstDev_SerialNo},${Device})
    {
        // device found
    }
    Fail:
    {
        Web.Capture Screenshot (InitiateMasterDeviceDiscovery_Failed.png)
        Return With Fail (Fail initiatiating device discovery!)
    }
    Error:
    {
        Web.Capture Screenshot (InitiateMasterDeviceDiscovery_Error.png)
        Return With Error (Error initiatiating device discovery!)
    }
    
    // ensure that all device are selected
    If: Web.Wait For Object(//*[@id="searching_devices"]/descendant::span[@class="ag-checkbox-checked"],${Minimal_Wait_Time})
    {
    }
    Fail:
    {
        Web.Click Object(//*[@id="searching_devices"]/descendant::span[@class="ag-header-select-all"])
        Sleep (${Very_Short_Wait_Time})
    }
    
    // click the Discover button
    Web.Click Object(//button[contains\(text\(\)\,"Discover"\)])
    
    HPCC_Library.WaitForSpinner
    
    // wait for the discover task created popup
    If: Web.Wait For Object (//div[@class="taskCreated"],${Wait_Time})
    {
        // click the Done button
        Web.Click Object(//div[contains\(text\(\)\,"Done"\)])
        
        // start discovery timing if specified
//        Set Variable (${StartTimings},Y)
//        If: Contains (${DiscoveryTimingSet}${DiscoveryTimingLabel},${)
//        {
//            Set Variable (${StartTimings},N)
//        }
//        If: Equals (${DiscoveryTimingSet}${DiscoveryTimingLabel},)
//        {
//            Set Variable (${StartTimings},N)
//        }
//        If: Equals (${StartTimings},Y)
        If: Common_LIbrary.CheckVariableContainsValue (${DiscoveryTimingSet}${DiscoveryTimingLabel})
        {
            @Info.Mark Start (${DiscoveryTimingSet},${DiscoveryTimingLabel})
        }
        
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (InitiateMasterDeviceDiscovery_Failed.png)
        Return With Fail (Fail while initiating a device discovery in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (InitiateMasterDeviceDiscovery_Error.png)
        Return With Error (Error while  initiating a device discovery in HPCC!)
    }
}

/// <Name>VerifySecondaryDevicesDiscovered</Name>
/// <Description>Verify that secondary devices were discovered after a master device discovery has been initiated</Description>
/// <Parameters>MassterDevice : master device identifier in HPCC</Parameters>
/// <Parameters>ExpectedCount : if specified expected number of devices for comparison</Parameters>
/// <Parameters>Max_DiscoverTime : if specified max amount of time (10 sec intervals) to wait for discovered devices to show</Parameters>
/// <Parameters>DiscoveryTimingSet : if specified timing set name</Parameters>
/// <Parameters>DiscoveryTimingLabel : if specified discovery timing label name</Parameters>
/// <Precondition>Signed into HPCC and in the customer Discover device</Precondition>
/// <Notes></Notes>
VerifySecondaryDevicesDiscovered(${MassterDevice},${ExpectedCount},${Max_DiscoverTime},${DiscoveryTimingSet},${DiscoveryTimingLabel})
{
    // verify in customer device discovery page
    If: Web.Wait For Object (//div[@class="discoveries"],${Zero_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (VerifySecondaryDevicesDiscovered_Failed.png)
        Return With Fail (Fail - not in customer Device Discoveries page in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (VerifySecondaryDevicesDiscovered_Error.png)
        Return With Error (Error - not in customer Device Discoveries page in HPCC!)
    }
    
    // get the initial number of devices discovered
    Web.Get Text (//div[@class="discoveriesDashboard"]/descendant::div[@class="rightBox"]/div[@class="count"],${InitialDiscoveredCount})
    
    // looping with page refresh until > 0 or max time reached
    If: Common_LIbrary.CheckVariableContainsValue (${Max_DiscoverTime})
    {
        Set Variable (${LoopMax},${Max_DiscoverTime})
    }
    Fail:
    {
        Set Variable (${LoopMax},1)
    }
    If: Equals (${Max_DiscoverTime},0)
    {
        Set Variable (${LoopMax},1)
    }
    
    Set Variable (${ContLoop},Y)
    While:Equals (${ContLoop},Y):30
    {
        // if a master device is specified then check its status in the Manage page
        // else just refresh
        If: Common_LIbrary.CheckVariableContainsValue (${MassterDevice})
        {
            // open the Manage page and check the status of the master device
            Web.Click Object(//button[contains\(text\(\)\,"Manage"\)])
            HPCC_Library.WaitForSpinner
            
            // search for the master device
            Web.Click Object(//*[@id="discoverySettings"]/descendant::input[@class="text-search"])
            Web.Set Text(//*[@id="discoverySettings"]/descendant::input[@class="text-search"],${MassterDevice})
            Web.Click Object(//*[@id="discoverySettings"]/descendant::span[@class="magnifier-icon magnifier-icon-list-filter"])
                
            // allow the filter to complete
            HPCC_Library.WaitForSpinner
            
            // verify device is listed as first device
            // get the Serial No and Asset No of firt devcie and compare both to specefied device
            Set Variable (${FirstDev_SerialNo},)
            
            Web.Get Text(//*[@id="discoverySettings"]/descendant::div[@row-index="0"]/descendant::div[@col-id="serialNumber"]/span/span,${FirstDev_SerialNo})
            
            If: Equals IgnoreCase (${FirstDev_SerialNo},${MassterDevice})
            {
                // device found
                // get the text of the device status label
                If: Web.Wait For Object (//*[@id="discoverySettings"]/descendant::div[@row-index="0"]/descendant::div[@col-id="status"]/div/div/div/label,${Zero_Wait_Time})
                {
                    Web.Get Text (//*[@id="discoverySettings"]/descendant::div[@row-index="0"]/descendant::div[@col-id="status"]/div/div/div/label,${MasterDeviceStatus})
                }
                Fail:
                {
                    // the status label is not present so default the value
                    Set Variable (${MasterDeviceStatus},-)
                }
                
                // check for the status of the master device = Discovering
                // or Syncing
                Set Variable (${ContLoop},N)
                If: Contains Ignore Case (${MasterDeviceStatus},Discover)
                {
                    Set Variable (${ContLoop},Y)
                }
                If: Contains Ignore Case (${MasterDeviceStatus},Syncing)
                {
                    Set Variable (${ContLoop},Y)
                }
                
                // close the manage page
                Web.Click Object(//button[contains\(text\(\)\,"Close"\)])
                
                HPCC_Library.WaitForSpinner
            }
            Fail:
            {
                Web.Refresh
                HPCC_Library.WaitForSpinner
                
                // delay to force the loop to take approx. 10 seconds per iteration
                Sleep (${VerifyDiscoverDeviceLoopWait})
            }
        }
        
        // get the discovered device count
        Web.Get Text (//div[@class="discoveriesDashboard"]/descendant::div[@class="rightBox"]/div[@class="count"],${DiscoveredCount})

        // check for max time reached
        If: Equals (${LoopMax},${R})
        {
            // max time reached so end loop
            Set Variable (${ContLoop},N)
        }
        
        // check for discovered device count change indicating discovery complete
        If: Equals (${DiscoveredCount},${InitialDiscoveredCount})
        {
        }
        Fail:
        {
            // non-zero count so end loop
            Set Variable (${ContLoop},N)
        }
    }
    
    // end discovery timing if specified
    If: Common_LIbrary.CheckVariableContainsValue (${DiscoveryTimingSet}${DiscoveryTimingLabel})
    {
        @Info.Mark End (${DiscoveryTimingSet},${DiscoveryTimingLabel})
    }
    
    // check for no devices discovered
    If: Equals (${DiscoveredCount},0)
    {
        // this indicates that no devices have been discovered - Fail
        Web.Capture Screenshot (VerifySecondaryDevicesDiscovered_Failed.png)
        Return With Fail (Discovered Device count = ${DiscoveredCount})
    }
    
    // check the number against the expected count if specified
    If: Common_LIbrary.CheckVariableContainsValue (${ExpectedCount})
    {
    }
    Fail:
    {
        // expected number not specified so pass
        Web.Capture Screenshot (VerifySecondaryDevicesDiscovered_DeviceCount.png)
        Return With Pass (Discovered Device count = ${DiscoveredCount})
    }

    If: Equals (${ExpectedCount},0)
    {
        // expected number = 0 so any number of discovered devices means pass
        Web.Capture Screenshot (VerifySecondaryDevicesDiscovered_DeviceCount.png)
        Return With Pass (Discovered Device count = ${DiscoveredCount})
    }
    
    If: Equals (${ExpectedCount},${DiscoveredCount})
    {
        // discovered number = expected number so pass
        Web.Capture Screenshot (VerifySecondaryDevicesDiscovered_DeviceCount.png)
        Return With Pass (Discovered Device count = ${DiscoveredCount})
    }
    Fail:
    {
        Web.Capture Screenshot (VerifySecondaryDevicesDiscovered_Failed.png)
        Return With Fail (Discovered Device count = ${DiscoveredCount})
    }
}

/// <Name>GetDiscoveredNon-SupportedCount</Name>
/// <Description>Get the count of Non-Supported discovered devices</Description>
/// <Parameters></Parameters>
/// <Precondition>Signed into HPCC and in the customer Discover device</Precondition>
/// <Notes></Notes>
GetDiscoveredNon-SupportedCount
{
    // verify in customer device discovery page
    If: Web.Wait For Object (//div[@class="discoveries"],${Zero_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (EnableMasterDevice_Failed.png)
        Return With Fail (Fail - not in customer Device Discoveries page in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (EnableMasterDevice_Error.png)
        Return With Error (Error - not in customer Device Discoveries page in HPCC!)
    }
    
    // set the filter to Non-Supported devices
    Web.Click Object(//*[@id="toggleOpenFilterButton"])
    
    HPCC_Library.WaitForSpinner    

    Web.Click Object(//*[@id="discoveries_mainTableId"]/descendant::label[@title="Not supported"])
    
    Sleep (${Very_Short_Wait_Time})
    
    Web.Get Text (//*[@id="filteredCount"],${NonSupportedCount})
    
    Replace (${NonSupportedCount}," results",)
    
    // clear the filter
    Web.Click Object(//*[@id="clearAllFilterItemsButton"])
    
    Sleep (${Very_Short_Wait_Time})    

    Web.Click Object(//*[@id="toggleOpenFilterButton"])
    
    Sleep (${Very_Short_Wait_Time})    

    // return the count
    Return With Pass (${NonSupportedCount})
}

/// <Name>OnboardDiscoveredDevice</Name>
/// <Description>Add a discovered device to be onboarded to the customer account</Description>
/// <Parameters>Device : device identifier in HPCC, ALL_DEVICES to onboard all supported devices</Parameters>
/// <Parameters>OnboardTimingSet : if specified timing set name</Parameters>
/// <Parameters>OnboardTimingLabel : if specified onboard timing label name</Parameters>
/// <Precondition>Signed into HPCC and in the customer Discover device</Precondition>
/// <Notes></Notes>
OnboardDiscoveredDevice(${Device},${OnboardTimingSet},${OnboardTimingLabel})
{
    // verify in customer device discovery page
    If: Web.Wait For Object (//div[@class="discoveries"],${Zero_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (EnableMasterDevice_Failed.png)
        Return With Fail (Fail - not in customer Device Discoveries page in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (EnableMasterDevice_Error.png)
        Return With Error (Error - not in customer Device Discoveries page in HPCC!)
    }
    
    // clear any previous search
    If: Web.Wait For Object (//div[@class="addedArea" and not\(@style="display: none;"\)]/descendant::div[@id="clearAllFilterItemsButton"],${Zero_Wait_Time})
    {
        Web.Click Object (//div[@class="addedArea" and not\(@style="display: none;"\)]/descendant::div[@id="clearAllFilterItemsButton"])
        
        HPCC_Library.WaitForSpinner
    }
    
    // uncheck all devices if not already unchecked
    If: Web.Wait For Object(//*[@id="discoveries_mainTableId"]/descendant::span[@class="ag-checkbox-checked"],${Short_Wait_Time})
    {
        Web.Click Object(//*[@id="discoveries_mainTableId"]/descendant::span[@class="ag-header-select-all"])
        Sleep (${Very_Short_Wait_Time})
    }
    
    // check for device argument specifying all devices
    If: Equals (${HPCC_Filter_All_Devices},${Device})
    {
        // all devices specified so no search
        Set Variable (${FirstDev_AssetNo},${Device})
        Set Variable (${FirstDev_SerialNo},${Device})
        
        // select all on each page of the list of devices
        Web.Click Object(//*[@id="discoveries_mainTableId"]/descendant::span[@class="ag-header-select-all"])
        
        While:Web.Wait For Object (//*[@id="discoveries_mainTableId"]/descendant::div[@class="pagingComponent"]/descendant::div[@class="button right"],${Zero_Wait_Time}):30
        {
            Web.Click Object (//*[@id="discoveries_mainTableId"]/descendant::div[@class="pagingComponent"]/descendant::div[@class="button right"])
            
            HPCC_Library.WaitForSpinner
            
            Web.Click Object(//*[@id="discoveries_mainTableId"]/descendant::span[@class="ag-header-select-all"])
        }
    }
    Fail:
    {
        // search and select the device
        // enter the device in the search
        Web.Click Object(//*[@id="discoveries_mainTableId"]/descendant::input[@class="text-search"])
        Web.Set Text(//*[@id="discoveries_mainTableId"]/descendant::input[@class="text-search"],${Device})
        Web.Click Object(//*[@id="discoveries_mainTableId"]/descendant::span[@class="magnifier-icon magnifier-icon-list-filter"])
            
        // allow the filter to complete
        HPCC_Library.WaitForSpinner
        
        // verify device is listed as first device
        // get the Serial No and Asset No of firt devcie and compare both to specefied device
        Set Variable (${FirstDev_AssetNo},)
        Set Variable (${FirstDev_SerialNo},)
        
        Web.Get Text(//*[@id="discoveries_mainTableId"]/descendant::div[@row-index="0"]/descendant::div[@col-id="assetNumber"]/span/span,${FirstDev_AssetNo})
        
        Web.Get Text(//*[@id="discoveries_mainTableId"]/descendant::div[@row-index="0"]/descendant::div[@col-id="serialNumber"]/span/span,${FirstDev_SerialNo})
        
        If: Contains Ignore Case (${FirstDev_AssetNo} - ${FirstDev_SerialNo},${Device})
        {
            // device found
            
            // ensure that all device are selected
            If: Web.Wait For Object(//*[@id="discoveries_mainTableId"]/descendant::span[@class="ag-checkbox-checked"],${Minimal_Wait_Time})
            {
            }
            Fail:
            {
                Web.Click Object(//*[@id="discoveries_mainTableId"]/descendant::span[@class="ag-header-select-all"])
                Sleep (${Very_Short_Wait_Time})
            }
        }
        Fail:
        {
            Web.Capture Screenshot (OnboardDiscoveredDevice_Failed.png)
            Return With Fail (Fail searching for device '${Device}' in Discovered Devices!)
        }
        Error:
        {
            Web.Capture Screenshot (OnboardDiscoveredDevice_Error.png)
            Return With Error (Error searching for device '${Device}' in Discovered Devices!)
        }
    }
    
    // click the Add Devices button
    If: Web.Click Object(//button[contains\(text\(\)\,"Add and assign"\)])
    {
    }
    Fail:
    {
        Web.Capture Screenshot (OnboardDiscoveredDevice_Failed.png)
        Return With Fail (Fail while adding discovered device '${Device}' to onboard!)
    }
    Error:
    {
        Web.Capture Screenshot (OnboardDiscoveredDevice_Error.png)
        Return With Error (Error while adding discovered device '${Device}' to onboard!)
    }
    
    // handle the Add devices popup
    If: Web.Wait For Object(//div[@class="addDevices"],${Short_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (OnboardDiscoveredDevice_Failed.png)
        Return With Fail (Fail while adding discovered device '${Device}' to onboard!)
    }
    Error:
    {
        Web.Capture Screenshot (OnboardDiscoveredDevice_Error.png)
        Return With Error (Error while adding discovered device '${Device}' to onboard!)
    }
    
    If: Web.Click Object (//button[contains\(text\(\)\,"Add and assign"\)])
    {
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (OnboardDiscoveredDevice_Failed.png)
        @Web.Click Object (//button[contains\(text\(\)\,"Cancel"\)])
        Return With Fail (Fail while adding discovered device '${Device}' to onboard!)
    }
    Error:
    {
        Web.Capture Screenshot (OnboardDiscoveredDevice_Error.png)
        @Web.Click Object (//button[contains\(text\(\)\,"Cancel"\)])
        Return With Error (Error while adding discovered device '${Device}' to onboard!)
    }
    
    If: Web.Wait For Object (//div[@class="taskCreated"],${Short_Wait_Time})
    {
        Web.Click Object (//div[@class="taskCreated"]/descendant::div[@class="hpBlueButton"])
        
        
        // start discovery timing if specified
//        Set Variable (${StartTimings},Y)
//        If: Contains (${OnboardTimingSet}${OnboardTimingLabel},${)
//        {
//            Set Variable (${StartTimings},N)
//        }
//        If: Equals (${OnboardTimingSet}${OnboardTimingLabel},)
//        {
//            Set Variable (${StartTimings},N)
//        }
//        If: Equals (${StartTimings},Y)
        If: Common_LIbrary.CheckVariableContainsValue (${OnboardTimingSet}${OnboardTimingLabel})
        {
            @Info.Mark Start (${OnboardTimingSet},${OnboardTimingLabel})
        }

        
        HPCC_Library.WaitForSpinner
        
        Return With Pass (Discovered device '${Device}' onboard initiated!)
    }
    Fail:
    {
        Web.Capture Screenshot (OnboardDiscoveredDevice_Failed.png)
        @Web.Click Object (//button[contains\(text\(\)\,"Cancel"\)])
        Return With Fail (Fail while adding discovered device '${Device}' to onboard!)
    }
    Error:
    {
        Web.Capture Screenshot (OnboardDiscoveredDevice_Error.png)
        @Web.Click Object (//button[contains\(text\(\)\,"Cancel"\)])
        Return With Error (Error while adding discovered device '${Device}' to onboard!)
    }
}

/// <Name>MonitorDiscoveredDeviceOnboarding</Name>
/// <Description>Add a discovered device to be onboarded to the customer account</Description>
/// <Parameters>Max_OnboardTime : if specified max amount of time (minutes) to wait for all discovered devices to complete onboarding</Parameters>
/// <Parameters>OnboardTimingSet : if specified timing set name</Parameters>
/// <Parameters>OnboardTimingLabel : if specified onboard timing label name</Parameters>
/// <Parameters>User_ID : UserID (needed if user sing in times out)</Parameters>
/// <Parameters>User_PW : Password (needed if user sing in times out)</Parameters>
/// <Precondition>Signed into HPCC and in the customer Discover device</Precondition>
/// <Notes></Notes>
MonitorDiscoveredDeviceOnboarding(${Max_OnboardTime},${OnboardTimingSet},${OnboardTimingLabel},${User_ID}, ${User_PW})
{
    // verify in customer device discovery page
    If: Web.Wait For Object (//div[@class="discoveries"],${Zero_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (MonitorDiscoveredDeviceOnboarding_Failed.png)
        Return With Fail (Fail - not in customer Device Discoveries page in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (MonitorDiscoveredDeviceOnboarding_Error.png)
        Return With Error (Error - not in customer Device Discoveries page in HPCC!)
    }

    // get the initial device count
    Web.Get Text (//div[@class="discoveriesDashboard"]/descendant::div[@class="rightBox"]/div[@class="count"],${InitialDeviceCount})
    
    // get the number of devices discovered
    // looping with page refresh until = 0, or # of devices has not changed for 10 miutes, or max time reached
    
    // initialize device count variables
    Set Variable (${DevCnt_10},-1)
    Set Variable (${DevCnt_9},-1)
    Set Variable (${DevCnt_8},-1)
    Set Variable (${DevCnt_7},-1)
    Set Variable (${DevCnt_6},-1)
    Set Variable (${DevCnt_5},-1)
    Set Variable (${DevCnt_4},-1)
    Set Variable (${DevCnt_3},-1)
    Set Variable (${DevCnt_2},-1)
    Set Variable (${DevCnt_1},-1)
    
    // initialize loop timing varibles
    If: Common_LIbrary.CheckVariableContainsValue (${Max_OnboardTime})
    {
        Set Variable (${LoopMax},${Max_OnboardTime})
    }
    Fail:
    {
        Set Variable (${LoopMax},1)
    }
    If: Equals (${Max_OnboardTime},0)
    {
        Set Variable (${LoopMax},1)
    }
    
    Set Variable (${ContLoop},Y)
    While:Equals (${ContLoop},Y):${MonitorDiscoverDeviceOnboardLoopMax}
    {
        // refresh the page and delay to make each loop iteration approx 1 minute
        Web.Refresh
        HPCC_Library.WaitForSpinner
        
        If: Web.Get Text (//div[@class="discoveriesDashboard"]/descendant::div[@class="rightBox"]/div[@class="count"],${FinalDeviceCount})
        {
        }
        Fail:
        {
            // check for HPCC user timeout and resign in if needed
            If: Web.Wait For Object (//div[@class="sessionExpired"],${Zero_Wait_Time})
            {
                Web.Click Object (//*[@id="moveToLoginButton"])
                HPCC_Library.WaitForSpinner
                
                If: HPCC_Library.EnterUserCredentials(${User_ID},${User_PW},${Very_Long_Wait})
                {
                    HPCC_Library.WaitForSpinner
                    
                    Web.Get Text (//div[@class="discoveriesDashboard"]/descendant::div[@class="rightBox"]/div[@class="count"],${FinalDeviceCount})
                }
                Fail:
                {
                    Web.Capture Screenshot (MonitorDiscoveredDeviceOnboarding_Failed.png)
                    Return With Fail (Fail - re-signing in to HPCC!)
                }
                Error:
                {
                    Web.Capture Screenshot (MonitorDiscoveredDeviceOnboarding_Error.png)
                    Return With Error (Error - re-signing in to HPCC!)
                }
            }
        }
        
        // update the devic count variables and check for the new 
        // FinalCount = to the one from 10 minutes ago, if so then 
        // assume onboarding complete and end loop
        Set Variable (${DevCnt_10},${DevCnt_9})
        Set Variable (${DevCnt_9},${DevCnt_8})
        Set Variable (${DevCnt_8},${DevCnt_7})
        Set Variable (${DevCnt_7},${DevCnt_6})
        Set Variable (${DevCnt_6},${DevCnt_5})
        Set Variable (${DevCnt_5},${DevCnt_4})
        Set Variable (${DevCnt_4},${DevCnt_3})
        Set Variable (${DevCnt_3},${DevCnt_2})
        Set Variable (${DevCnt_2},${DevCnt_1})
        Set Variable (${DevCnt_1},${FinalDeviceCount})
        If: Equals (${DevCnt_10},${FinalDeviceCount})
        {
            // the current device count = the count
            // 10 minutes ago so end loop
            Set Variable (${ContLoop},N)
        }

        // check for max time reached
        If: Equals (${LoopMax},${R})
        {
            // max time reached so end loop
            Set Variable (${ContLoop},N)
        }
        
        // check for zero discovered device count
        If: Equals (${FinalDeviceCount},0)
        {
            // zero count so end loop
            Set Variable (${ContLoop},N)
        }
        
        // refresh page and delay if still looping
        If: Equals (${ContLoop},Y)
        {
            // delay to force the loop to take approx. 30 seconds per iteration
            Sleep (${MonitorDiscoverDeviceOnboardLoopWait})
        }
    }
    
    // end onboarding timing if specified
    If: Common_LIbrary.CheckVariableContainsValue (${OnboardTimingSet}${OnboardTimingLabel})
    {
        @Info.Mark End (${OnboardTimingSet},${OnboardTimingLabel})
    }
    
    // check for all devices onboarded
    If: Equals (${FinalDeviceCount},0)
    {
        // expected number not specified so pass
        Web.Capture Screenshot (MonitorDiscoveredDeviceOnboarding_DeviceCount.png)
        Return With Pass (Initial Device count = ${InitialDeviceCount}    Final Device Count = ${FinalDeviceCount})
    }
    Fail:
    {
        // not all devices were onboarded
        Web.Capture Screenshot (MonitorDiscoveredDeviceOnboarding_Failed.png)
        Return With Fail (Fail - not all devices onboarded:  Initial Device count = ${InitialDeviceCount}    Final Device Count = ${FinalDeviceCount})
    }
}

/// <Name>GotoSolutionsPorfolio</Name>
/// <Description>Goto the account solutions portfolio page</Description>
/// <Precondition></Precondition>
/// <Notes>Called by multiple routines in this library</Notes>
GotoSolutionsPorfolio()
{
    // click on Solutions
    If: Web.Wait For Object (//div[@class="hpMenu"]/descendant::a[@href="/solutions/main"]/div/div/p,${Wait_Time})
    {
        Web.Click Object (//div[@class="hpMenu"]/descendant::a[@href="/solutions/main"]/div/div/p)
        
        // wait for the page to show
        HPCC_Library.WaitForSpinner
        
        Return With Pass (GotoSolutionsPorfolio completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (GotoSolutionsPorfolio_Failed.png)
        Return With Fail (Fail while selecting Solutions in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (GotoSolutionsPorfolio_Error.png)
        Return With Error (Error while selecting Solutions in HPCC!)
    }
}

/// <Name>AddAppToPortfolio</Name>
/// <Description>Add an app to the portfolio of the open account</Description>
/// <Parameters>PortfolioApp : name of app to install</Parameters>
/// <Precondition>Signed into HPCC</Precondition>
/// <Notes></Notes>
AddAppToPortfolio(${PortfolioApp})
{
    // goto the Solutions portfolio page
    If: HPCC_Library.GotoSolutionsPorfolio
    {
    }
    Fail:
    {
        Return With Fail (Fail while selecting the Solutions portfolio age!)
    }
    Error:
    {
        Return With Error (Error while selecting the Solutions portfolio age!)
    }
    
    // select All Solutions from the catalog
    Web.Click Object (//*[@id="moveToAllSolutionsButton"])
    HPCC_Library.WaitForSpinner
    
    // search for  the app
    // enter the app into the search textbox and click the search link
    IF: Web.Click Object(//*[@id="solutionsSolutionsCatalogTableId"]/descendant::input[@class="text-search"])
    {
        // enter the search
        Web.Set Text(//*[@id="solutionsSolutionsCatalogTableId"]/descendant::input[@class="text-search"],${PortfolioApp})
        Web.Click Object(//*[@id="solutionsSolutionsCatalogTableId"]/descendant::span[@class="magnifier-icon magnifier-icon-list-filter"])
        
        // allow the filter to complete
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (AddAppToPortfolio_Failed.png)
        Return With Fail (Fail while searching for app in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (AddAppToPortfolio_Error.png)
        Return With Error (Error while searching for app in HPCC!)
    }
    
    // click on the app
    If: Web.Click Object (//div[@class="cardTable"]/descendant::span[@class="appName" and @title="${PortfolioApp}"])
    {
    }
    Fail:
    {
        Web.Capture Screenshot (AddAppToPortfolio_Failed.png)
        Return With Fail (Fail while selecting the app in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (AddAppToPortfolio_Error.png)
        Return With Error (Error while selecting the app in HPCC!)
    }
    
    // wait for the solution details page
    If: Web.Wait For Object (//div[@class="solutionDetail"],${Short_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (AddAppToPortfolio_Failed.png)
        Return With Fail (Fail while selecting the app in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (AddAppToPortfolio_Error.png)
        Return With Error (Error while selecting the app in HPCC!)
    }
    
    // click the Add button
    If: Web.Click Object(//*[@id="showNextStepForAddButton"])
    {
        // allow the install page to show
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (AddAppToPortfolio_Failed.png)
        Return With Fail (Fail while adding the app to the portfolio!)
    }
    Error:
    {
        Web.Capture Screenshot (AddAppToPortfolio_Error.png)
        Return With Error (Error while adding the app to the portfolio!)
    }
    
    // if the message about cost appears then click the Add button
    If: Web.Wait For Object (//*[@id="showAddToSolutionPortfolioModalButton"],${Short_Wait_Time})
    {
        Web.Click Object (//*[@id="showAddToSolutionPortfolioModalButton"])
        HPCC_Library.WaitForSpinner
    }
    
    Web.Wait For Object (//div[@class="addToSolutionPortfolio"],${Short_Wait_Time})
    
    // click the checkbox to aggree to terms then the Add button
    Web.Click Object (//*[@id="allAgree"]/parent::*)
    
    // click the checkbox to agree to permissions if it shows
    If: Web.Wait For Object (//*[@id="permissionAgree"],0)
    {
        Web.Click Object (//*[@id="permissionAgree"]/parent::*)
    }
    
    If: Web.Click Object (//*[@id="addToSolutionPortfolioButton"])
    {
        HPCC_Library.WaitForSpinner
        Return With Pass (AddAppToPortfolio)
    }
    Fail:
    {
        Web.Capture Screenshot (AddAppToPortfolio_Failed.png)
        Return With Fail (Fail while adding the app to the portfolio!)
    }
    Error:
    {
        Web.Capture Screenshot (AddAppToPortfolio_Error.png)
        Return With Error (Error while adding the app to the portfolio!)
    }
}

/// <Name>RemoveAppFromPortfolio</Name>
/// <Description>Remove an app to the portfolio of the open account</Description>
/// <Parameters>PortfolioApp : name of app to install</Parameters>
/// <Precondition>Signed into HPCC</Precondition>
/// <Notes></Notes>
RemoveAppFromPortfolio(${PortfolioApp})
{
    // goto the Solutions portfolio page
    If: HPCC_Library.GotoSolutionsPorfolio
    {
    }
    Fail:
    {
        Return With Fail (Fail while selecting the Solutions portfolio age!)
    }
    Error:
    {
        Return With Error (Error while selecting the Solutions portfolio age!)
    }
    
    // search for  the app
    // enter the app into the search textbox and click the search link
    IF: Web.Click Object(//*[@id="solutionsSolutionPortfolioTableId"]/descendant::input[@class="text-search"])
    {
        // enter the search
        Web.Set Text(//*[@id="solutionsSolutionPortfolioTableId"]/descendant::input[@class="text-search"],${PortfolioApp})
        Web.Click Object(//*[@id="solutionsSolutionPortfolioTableId"]/descendant::span[@class="magnifier-icon magnifier-icon-list-filter"])
        
        // allow the filter to complete
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveAppFromPortfolio_Failed.png)
        Return With Fail (Fail while searching for app in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveAppFromPortfolio_Error.png)
        Return With Error (Error while searching for app in HPCC!)
    }
    
    // click on the app
    If: Web.Click Object (//*[@id="solutionsSolutionPortfolioTableId"]/descendant::div[@class="cardTable"]/descendant::span[@class="appName" and @title="${PortfolioApp}"])
    {
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveAppFromPortfolio_Failed.png)
        Return With Fail (Fail while selecting the app in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveAppFromPortfolio_Error.png)
        Return With Error (Error while selecting the app in HPCC!)
    }
    
    // wait for the solution details page
    If: Web.Wait For Object (//div[@class="solutionDetail"],${Short_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveAppFromPortfolio_Failed.png)
        Return With Fail (Fail while selecting the app in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveAppFromPortfolio_Error.png)
        Return With Error (Error while selecting the app in HPCC!)
    }
    
    // click the Delete button
    If: Web.Click Object(//*[@id="showRemoveSolutionModalButton"])
    {
        // allow the install page to show
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveAppFromPortfolio_Failed.png)
        Return With Fail (Fail while removing the app to the portfolio!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveAppFromPortfolio_Error.png)
        Return With Error (Error while removing the app to the portfolio!)
    }
    
    Web.Wait For Object (//div[@class="deleteSolution"],${Short_Wait_Time})
    
    If: Web.Click Object (//*[@id="removeSolutionButton"])
    {
        HPCC_Library.WaitForSpinner
        Return With Pass (RemoveAppFromPortfolio)
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveAppFromPortfolio_Failed.png)
        Return With Fail (Fail while removing the app to the portfolio!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveAppFromPortfolio_Error.png)
        Return With Error (Error while removing the app to the portfolio!)
    }
}

/// <Name>AddAppToCustomer</Name>
/// <Description>Add the specified app to a customer account</Description>
/// <Parameters>SelectCustomer : customer in HPCC</Parameters>
/// <Parameters>CustomerApp : name of app to install</Parameters>
/// <Precondition>Signed into HPCC</Precondition>
/// <Notes></Notes>
AddAppToCustomer(${SelectCustomer},${CustomerApp})
{
    // select the account
    If: HPCC_Library.SelectAccount(${SelectCustomer})
    {
    }
    Fail:
    {
        Return With Fail (Fail selecting the customer account!)
    }
    Error:
    {
        Return With Error (Error selecting the customer account!)
    }
    
    // click the Add solutions button
    If: Web.Click Object(//*[@id="showAddSolutionsButton"])
    {
        // allow the Add solutions popup to show
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (AddAppToCustomer_Failed.png)
        Return With Fail (Fail while selecting the Add solutions button!)
    }
    Error:
    {
        Web.Capture Screenshot (AddAppToCustomer_Error.png)
        Return With Error (Error while selecting the Add solutions button!)
    }
    
    // verify in Manage App screen
    If: Web.Wait For Object (//div[@class="addSolutions"],${Short_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (AddAppToCustomer_Failed.png)
        Return With Fail (Fail while accessing the Add solutions page!)
    }
    Error:
    {
        Web.Capture Screenshot (AddAppToCustomer_Error.png)
        Return With Error (Error while accessing the Add solutions page!)
    }

    // search and select the app
    If: Web.Wait For Object(//*[@id="accountDetailAddSolutionsTableId"]/descendant::input[@class="text-search"],${Short_Wait_Time})
    {
        // enter the device in the search
        Web.Click Object(//*[@id="accountDetailAddSolutionsTableId"]/descendant::input[@class="text-search"])
        Web.Set Text(//*[@id="accountDetailAddSolutionsTableId"]/descendant::input[@class="text-search"],${CustomerApp})
        Web.Click Object(//*[@id="accountDetailAddSolutionsTableId"]/descendant::span[@class="magnifier-icon magnifier-icon-list-filter"])
        
        // allow the filter to complete
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (AddAppToCustomer_Failed.png)
        Return With Fail (Fail while searching for app to add!)
    }
    Error:
    {
        Web.Capture Screenshot (AddAppToCustomer_Error.png)
        Return With Error (Error while searching for app to add!)
    }
    
    // verify app is listed
    If: Web.Wait For Object(//*[@id="accountDetailAddSolutionsTableId"]/descendant::div[@row-index="0"]/descendant::div[@col-id="solutionName"]/descendant::span[@title="${CustomerApp}"],${Minimal_Wait_Time})
    {
        // app found
    }
    Fail:
    {
        Web.Capture Screenshot (AddAppToCustomer_Failed.png)
        Return With Fail (Fail while searching for app to add!)
    }
    Error:
    {
        Web.Capture Screenshot (AddAppToCustomer_Error.png)
        Return With Error (Error while searching for app to add!)
    }
    
    // ensure that all app are selected
    If: Web.Wait For Object(//*[@id="accountDetailAddSolutionsTableId"]/descendant::span[@class="ag-checkbox-checked"],${Minimal_Wait_Time})
    {
    }
    Fail:
    {
        Web.Click Object(//*[@id="accountDetailAddSolutionsTableId"]/descendant::span[@class="ag-header-select-all"])
        Sleep (${Very_Short_Wait_Time})
    }
    
    // the app is selected by default, click the Add button
    If: Web.Click Object(//button[contains\(text\(\)\,"Add"\)])
    {
        HPCC_Library.WaitForSpinner
        
        Return With Pass (AddAppToCustomer completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (AddAppToCustomer_Failed.png)
        Return With Fail (Fail while adding an app to a customer!)
    }
    Error:
    {
        Web.Capture Screenshot (AddAppToCustomer_Error.png)
        Return With Error (Error while adding an app to a customer!)
    }
}

/// <Name>RemoveAppFromCustomer</Name>
/// <Description>Remove an app from a customer account</Description>
/// <Parameters>SelectCustomer : customer in HPCC</Parameters>
/// <Parameters>CustomerApp : name of app to install</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
RemoveAppFromCustomer(${SelectCustomer},${CustomerApp})
{
    // select the account
    If: HPCC_Library.SelectAccount(${SelectCustomer})
    {
    }
    Fail:
    {
        Return With Fail (Fail selecting the customer account!)
    }
    Error:
    {
        Return With Error (Error selecting the customer account!)
    }
    
    // select the app
    If: HPCC_Library.SearchApp(${CustomerApp})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveAppFromCustomer_Failed.png)
        Return With Fail (Fail while selecting app in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveAppFromCustomer_Error.png)
        Return With Error (Error while selecting app in HPCC!)
    }
    
    // ensure the app is listed
    If: Web.Wait For Object(//*[@id="accountDetailSolutionsTableId"]/descendant::div[@class="accountSolutionsTable" or @ref="eBody"]/descendant::*[text\(\)="${CustomerApp}"],${Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveAppFromCustomer_Failed.png)
        Return With Fail (Fail while managing app in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveAppFromCustomer_Error.png)
        Return With Error (Error while managing app in HPCC!)
    }
    
    // attempt to click on the selected app and then the delete button
    While:!Web.Wait For Object (//*[@id="accountDetailSolutionsTableId"]/descendant::div[@class="accountSolutionsTable" or @ref="eBody"]/descendant::div[@class="rightArea" and @style=""],${Zero_Wait_Time}):3
    {
        Web.Click Object(//*[@id="accountDetailSolutionsTableId"]/descendant::div[@class="accountSolutionsTable" or @ref="eBody"]/descendant::span[@class="nameArea" and not\(text\(\)\)]/descendant::*[text\(\)="${CustomerApp}"])
    }
    
    If: Web.Wait For Object (//*[@id="accountDetailSolutionsTableId"]/descendant::div[@class="accountSolutionsTable" or @ref="eBody"]/descendant::div[@class="rightArea" and @style=""],${Zero_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveAppFromCustomer_Failed.png)
        Return With Fail (Fail while managing app in HPCC!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveAppFromCustomer_Error.png)
        Return With Error (Error while managing app in HPCC!)
    }
    
    If: Web.Click Object(//*[@id="accountDetailSolutionsTableId"]/descendant::div[@class="accountSolutionsTable" or @ref="eBody"]/descendant::div[@class="rightArea" and @style=""]/descendant::div[@class="configArea"])
    {
        // allow the delete app popup to show
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveAppFromCustomer_Failed.png)
        Return With Fail (Fail while clicking on Delete button!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveAppFromCustomer_Error.png)
        Return With Fail (Error while clicking on Delete button!)
    }
    
    // verify in delete solution popup
    If: Web.Wait For Object (//*[@id="deleteSolutionButton"],${Zero_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveAppFromCustomer_Failed.png)
        Return With Fail (Fail while accessing the delete app screen!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveAppFromCustomer_Error.png)
        Return With Error (Error while accessing the delete app screen!)
    }
    
    // click the delete button 
    If: Web.Click Object(//*[@id="deleteSolutionButton"])
    {
        // allow the uninstall page to show
        HPCC_Library.WaitForSpinner
        
        Return With Pass (RemoveAppFromCustomer completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (RemoveAppFromCustomer_Failed.png)
        Return With Fail (Fail while clicking the Delete button!)
    }
    Error:
    {
        Web.Capture Screenshot (RemoveAppFromCustomer_Error.png)
        Return With Error (Error while clicking the Delete button!)
    }
}
