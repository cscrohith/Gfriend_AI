        Web.Capture Screenshot (SelectAccountDeviceInfo_Error.png)
        Return With Fail (Error clicking on App Manage button!)
    }
}

/// <Name>SynchDevice</Name>
/// <Description>Select the Synch function for a device in a customer account</Description>
/// <Parameters>Customer : customer in HPCC</Parameters>
/// <Parameters>Device : device identifier in HPCC</Parameters>
/// <Parameters>MaxSynchTime : max time (seconds) to wait for the synch to complete</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
SynchDevice(${Customer},${Device},${MaxSynchTime})
{
    // select the account
    If: HPCC_Library.SelectAccount(${Customer})
    {
    }
