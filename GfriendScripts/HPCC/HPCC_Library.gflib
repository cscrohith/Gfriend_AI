/// <File>HPCC_LIbrary.gflib</File>
/// <Modified>2021-11-11</Modified>
/// <Description>Library of HP Command Center (HPCC) routines</Description>
/// <Precondition></Precondition>
/// <Author>Ron Pridmore</Author>

${HPCC_Filter_All_Devices}=ALL_DEVICES
${VerifyDiscoverDeviceLoopWait}=3
${MonitorDiscoverDeviceOnboardLoopWait}=52
${MonitorDiscoverDeviceOnboardLoopMax}=810

// these variable file references need to be changed to not point to other folders
// when used in the STF GFriend plugin
//Using StandardTimeouts.gfvar
Using ..\Common\StandardTimeouts.gfvar

// these library references need to be changed to not point to other folders
// when used in the STF GFriend plugin
//Using Common_LIbrary.gflib
Using ..\Common\Common_LIbrary.gflib

Using Web
Using Info

/// <Name>WaitForSpinner</Name>
/// <Description>Wait for any spinner icon to show then disappear</Description>
/// <Parameters></Parameters>
/// <Precondition></Precondition>
/// <Notes>Called by multiple routines in this library</Notes>
WaitForSpinner
{
    If: Web.Wait For Object (//*[contains\(@class\,"hpSpinner"\) and not\(contains\(@style\,"none"\)\)],${Short_Wait_Time})
    {
        Web.Wait For Object Disappear (//*[contains\(@class\,"hpSpinner"\) and not\(contains\(@style\,"none"\)\)],${Long_Wait})
        Sleep (${Minimal_Wait_Time})
    }
    Return With Pass (WaitForSpinner completed!)
}

/// <Name>EnterUserCredentials</Name>
/// <Description>Enter the user's credetnials to sign in</Description>
/// <Parameters>User_ID : UserID</Parameters>
/// <Parameters>User_PW : Password</Parameters>
/// <Parameters>MainPageTimeOut : Timeout in seconds for HPCC main page to show</Parameters>
/// <Precondition>Browser open to HPCC sign in page</Precondition>
/// <Notes></Notes>
EnterUserCredentials(${ID},${PW},${MainPageTimeOut})
{
    // sign in
    If: Web.Wait For Object(//*[@id="username"],${Long_Wait})
    {
        // short wait, then click the username textbox twice with a short wait 
        // between to clear an privacy popup if it shows
        Sleep (${Very_Short_Wait_Time})
        Web.Click Object(//*[@id="username"])
        Sleep (${Minimal_Wait_Time})
        Web.Click Object(//*[@id="username"])
        Web.Set Text(//*[@id="username"],${ID})
        Web.Click Object(//*[@id="user-name-form-submit" or @id="next_button"])
    }
    Fail:
    {
        Web.Capture Screenshot (EndterUserCredentials_Failed.png)
        Return With Fail (Fail while accessing the HPCC sign in page!)
    }
   
    // enter the password
    If: Web.Wait For Object(//*[@id="password"],${Long_Wait})
    {
        Web.Click Object(//*[@id="password"])
        Web.Set Text(//*[@id="password"],${PW})
        Web.Click Object(//button[@id="sign-in" or @type="submit"])
    }
    Fail:
    {
        Web.Capture Screenshot (EndterUserCredentials_Failed.png)
        Return With Fail (Fail while accessing the Password page!)
    }

    If: Common_LIbrary.CheckVariableContainsValue (${MainPageTimeOut})
    {
        Set Variable (${Page_Timeout},${MainPageTimeOut})
    }
    Fail:
    {
        Set Variable (${Page_Timeout},${Very_Long_Wait})
    }
    
    // check that reached the Command Center page
    If: Web.Wait For Object (//div[@class="logoName hpSimplifiedBold"],${Page_Timeout})
    {
        // handle the updated Terms of Service pages if displayed
        If: Web.Wait For Text (Please accept the updated Terms of Service and data collection policy,${Zero_Wait_Time})
        {
            Web.Click Object (//*[@id="nextButton"])
            // terms of service page
            Web.Wait For Text (Please read the following terms of service.,${Long_Wait})
            Web.Click Object (//input[@id="termsOfServiceCheckbox"]/parent::*)
            Web.Click Object (//*[@id="nextButton"])
            // data collection privacy page
            Web.Wait For Text (Please read the following data collection information.,${Long_Wait})
            Web.Click Object (//input[@id="dataCollectionCheckbox"]/parent::*)
            Web.Click Object (//*[@id="nextButton"])
        }
        
        Sleep (${Very_Short_Wait_Time})
        
        Return With Pass (EndterUserCredentials completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (EndterUserCredentials_Failed.png)
        Return With Fail (Fail while accessing HPCC within ${MainPageTimeOut} seconds!)
    }
}

/// <Name>SignIn</Name>
/// <Description>Open browser to HPP sign in page and sign in</Description>
/// <Parameters>User_ID : UserID</Parameters>
/// <Parameters>User_PW : Password</Parameters>
/// <Parameters>url : HPCC url</Parameters>
/// <Parameters>BRW : browser to use (Default; Chrome; FireFox; Edge)</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
SignIn(${User_ID}, ${User_PW}, ${url}, ${BRW})
{
    // open the specified browser to the HPCC url
    IF: Equals (${BRW},Default)
    {
        If: Web.Open (https://${url})
        {
        }
        Fail:
        {
            Return With Fail (Fail while opening the browser!)
        }
        Error:
        {
            Return With Error (Error while opening the browser!)
        }
    }
    IF: Equals (${BRW},Chrome)
    {
        If: Web.Open with Chrome (https://${url})
        {
        }
        Fail:
        {
            Return With Fail (Fail while opening the browser!)
        }
        Error:
        {
            Return With Error (Error while opening the browser!)
        }
    }
    IF: Equals (${BRW},FireFox)
    {
        If: Web.Open with FireFox (https://${url})
        {
        }
        Fail:
        {
            Return With Fail (Fail while opening the browser!)
        }
        Error:
        {
            Return With Error (Error while opening the browser!)
        }
    }
    IF: Equals (${BRW},Edge)
    {
        If: Web.Open with Edge (https://${url})
        {
        }
        Fail:
        {
            Return With Fail (Fail while opening the browser!)
        }
        Error:
        {
            Return With Error (Error while opening the browser!)
        }
    }

    // sign in
    If: HPCC_Library.EnterUserCredentials(${User_ID},${User_PW},${Very_Long_Wait})
    {
        Return With Pass (SignIn completed!)
    }
    Fail:
    {
        Return With Fail (Fail while accessing the HPCC sign in page!)
    }
    Error:
    {
        Return With Error (Error while accessing the HPCC sign in page!)
    }
}

