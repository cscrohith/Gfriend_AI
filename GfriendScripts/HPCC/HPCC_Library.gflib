    // select the device
    If: HPCC_Library.SearchAccountDevice(${Device})
    {
    }
    Fail:
    {
        Return With Fail (Fail selecting the customer account device!)
    }
    Error:
    {
        Return With Error (Error selecting the customer account device!)
    }
    
    // click the device info link
    If: HPCC_Library.SelectAccountDeviceInfo
    {
    }
    Fail:
    {
    }
    Error:
    {
        Return With Error (Error accessing the custoemr account device info!)
    }
    
    // wait for the device details popup
    If: Web.Wait For Object (//*[@id="app"]/descendant::div[@class="deviceDetails"],${Very_Short_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (SynchDevice_Failed.png)
        // close the device details popup
        @Web.Click Object (//*[@id="app"]/descendant::div[@class="deviceDetails"]/descendant::button[@id="closeButton"])
        
        Return With Fail (Fail accessing the custoemr account device info!)
    }
    Error:
    {
        Web.Capture Screenshot (SynchDevice_Error.png)
        // close the device details popup
        @Web.Click Object (//*[@id="app"]/descendant::div[@class="deviceDetails"]/descendant::button[@id="closeButton"])
        
        Return With Error (Error accessing the custoemr account device info!)
    }
    
    // click the sync link
    If: Web.Wait For Object (//*[@id="app"]/descendant::div[@class="syncActionButton"],${Short_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (SynchDevice_Failed.png)
        // close the device details popup
        @Web.Click Object (//*[@id="app"]/descendant::div[@class="deviceDetails"]/descendant::button[@id="closeButton"])
        
        Return With Fail (Fail accessing the custoemr account device info!)
    }
    Error:
    {
        Web.Capture Screenshot (SynchDevice_Error.png)
        // close the device details popup
        @Web.Click Object (//*[@id="app"]/descendant::div[@class="deviceDetails"]/descendant::button[@id="closeButton"])
        
        Return With Error (Error accessing the custoemr account device info!)
    }
    
    Web.Click Object (//*[@id="app"]/descendant::div[@class="syncActionButton"])
    
    // wait for the spinner to appear
    If: Web.Wait For Object (//*[@id="app"]/descendant::div[@class="deviceDetails"]/descendant::div[@class="spinnerArea"],${Short_Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (SynchDevice_Failed.png)
        // close the device details popup
        @Web.Click Object (//*[@id="app"]/descendant::div[@class="deviceDetails"]/descendant::button[@id="closeButton"])
        
        Return With Fail (Fail initializing customer device info synch!)
    }
    Error:
    {
        Web.Capture Screenshot (SynchDevice_Error.png)
        // close the device details popup
        @Web.Click Object (//*[@id="app"]/descendant::div[@class="deviceDetails"]/descendant::button[@id="closeButton"])
        
        Return With Error (Error initializing customer device info synch!)
    }
    
    // wait for the spinner to disappear within the specified time
    If: Web.Wait For Object Disappear (//*[@id="app"]/descendant::div[@class="deviceDetails"]/descendant::div[@class="spinnerArea"],${MaxSynchTime})
    {
        // close the device details popup
        Web.Click Object (//*[@id="app"]/descendant::div[@class="deviceDetails"]/descendant::button[@id="closeButton"])
        
        Return With Pass (SynchDevice completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (SynchDevice_Failed.png)
        // close the device details popup
        @Web.Click Object (//*[@id="app"]/descendant::div[@class="deviceDetails"]/descendant::button[@id="closeButton"])
        
        Return With Fail (Fail - customer device info synch did not complete the specified time!)
    }
}

/// <Name>EnableSIO</Name>
/// <Description>Enable SIO for a device in a customer</Description>
/// <Parameters>Customer : customer in HPCC</Parameters>
/// <Parameters>Device : device identifier in HPCC</Parameters>
/// <Parameters>TaskCompleteLimit : task completion limit in minutes</Parameters>
/// <Precondition>Signed into HPCC</Precondition>
/// <Notes></Notes>
EnableSIO(${Customer},${Device},${TaskCompleteLimit})
{
    // select the account
    If: HPCC_Library.SelectAccount(${Customer})
    {
    }
    Fail:
    {
        Return With Fail (Fail selecting the customer account!)
    }
    Error:
    {
        Return With Error (Error selecting the customer account!)
    }
    
    // click the SIO link
    If: Web.Click Object (//*[@id="showManageSignInOnceForLinkModalButton"])
    {
        // wait for the sio popup to show
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Return With Fail (Fail accessing the customer SIO link!)
    }
    Error:
    {
        Return With Error (Error accessing the customer SIO link!)
    }
    
    // verify in Manage Services screen
    If: Web.Wait For Object (//div[@class="manageServices"],${Short_Wait_Time})
    {
        // wait for the sio popup to finish showing
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (EnableSIO_Failed.png)
        Return With Fail (Fail accessing the customer SIO link!)
    }
    Error:
    {
        Web.Capture Screenshot (EnableSIO_Error.png)
        Return With Error (Error accessing the customer SIO link!)
    }
    
    // click the Enable SIO button
    If: Web.Wait For Object (//*[@id="moveToEnableServiceButton"],${Short_Wait_Time})
    {
        Web.Click Object (//*[@id="moveToEnableServiceButton"])
    }
    Fail:
    {
        Web.Capture Screenshot (EnableSIO_Failed.png)
        Return With Fail (Fail selecting the Enable SIO button!)
    }
    Error:
    {
        Web.Capture Screenshot (EnableSIO_Error.png)
        Return With Error (Error selecting the Enable SIO button!)
    }
    
    // wait for the Enable popup
    If: Web.Wait For Object (//div[@class="setEmailDomain dynamicArea"],${Wait_Time})
    {
    }
    Fail:
    {
        Web.Capture Screenshot (EnableSIO_Failed.png)
        Return With Fail (Fail enabling SIO!)
    }
    Error:
    {
        Web.Capture Screenshot (EnableSIO_Error.png)
        Return With Error (Error enabling SIO!)
    }
    
    // unselect the checkbox to specify a domain if it shows
    If: Web.Wait For Object (//input[@id="specify"],${Zero_Wait_Time})
    {
        Web.Click Object (//input[@id="specify"]/parent::*)
    }
    
    // choose the do not specify option if it shows
    If: Web.Wait For Object (//*[@id="notSpecify"],${Zero_Wait_Time})
    {
        //Web.Click Object (//*[@id="notSpecify"])
        Web.Click Text (Do not specify)
    }
    
    // click Next
    Web.Wait For Object (//*[@id="nextButton"],${Very_Short_Wait_Time})
    Web.Click Object (//*[@id="nextButton"])
    
    HPCC_Library.WaitForSpinner
    
    // uncheck all devices, first click Selet all then click again if it is checked
    Web.Click Object(//*[@id="accountDetailManageServicesEnableTableId"]/descendant::span[@class="ag-header-select-all"])
    Sleep (${Very_Short_Wait_Time})
    If: Web.Wait For Object(//*[@id="accountDetailManageServicesEnableTableId"]/descendant::span[@class="ag-checkbox-checked"],${Short_Wait_Time})
    {
        Web.Click Object(//*[@id="accountDetailManageServicesEnableTableId"]/descendant::span[@class="ag-header-select-all"])
        Sleep (${Very_Short_Wait_Time})
    }
    
    // search and select the device
    If: Web.Wait For Object(//*[@id="accountDetailManageServicesEnableTableId"]/descendant::input[@class="text-search"],${Short_Wait_Time})
    {
        // enter the device in the search
        Web.Click Object(//*[@id="accountDetailManageServicesEnableTableId"]/descendant::input[@class="text-search"])
        Web.Set Text(//*[@id="accountDetailManageServicesEnableTableId"]/descendant::input[@class="text-search"],${Device})
        Web.Click Object(//*[@id="accountDetailManageServicesEnableTableId"]/descendant::span[@class="magnifier-icon magnifier-icon-list-filter"])
        
        // allow the filter to complete
        HPCC_Library.WaitForSpinner
    }
    Fail:
    {
        Web.Capture Screenshot (EnableSIO_Failed.png)
        Return With Fail (Fail searching for device '${Device}' in SIO enablement!)
    }
    Error:
    {
        Web.Capture Screenshot (EnableSIO_Error.png)
        Return With Error (Error searching for device '${Device}' in SIO enablement!)
    }
    
    // verify device is listed
    If: Web.Wait For Object(//*[@id="accountDetailManageServicesEnableTableId"]/descendant::div[@row-index="0"]/descendant::div[@col-id="assetNumber"]/descendant::span[@title="${Device}"],${Minimal_Wait_Time})
    {
        // device found
    }
    Fail:
    {
        Web.Capture Screenshot (EnableSIO_Failed.png)
        Return With Fail (Fail selecting the Enable SIO button for device '${Device}!)
    }
    Error:
    {
        Web.Capture Screenshot (EnableSIO_Error.png)
        Return With Error (Error selecting the Enable SIO button for device '${Device}'!)
    }
    
    // check for SIO already enabled
    Web.Get Text (//*[@id="accountDetailManageServicesEnableTableId"]/descendant::div[@row-index="0"]/descendant::div[@col-id="status"]/div/div/span,${SIOStatus})
    If: Equals IgnoreCase (${SIOStatus},enabled)
    {
        // already enabled, return with a Pass
        Web.Click Object (//*[@id="closeButton"])
        Return With Pass (Workpath already enabled!)
    }
    
    // ensure that all device are selected
    If: Web.Wait For Object(//*[@id="accountDetailManageServicesEnableTableId"]/descendant::span[@class="ag-checkbox-checked"],${Minimal_Wait_Time})
    {
    }
    Fail:
    {
        Web.Click Object(//*[@id="accountDetailManageServicesEnableTableId"]/descendant::span[@class="ag-header-select-all"])
        Sleep (${Very_Short_Wait_Time})
    }
    
    // when available complete the task and close the popup
    If: Web.Wait For Object (//*[@id="nextButton"],${Very_Short_Wait_Time})
    {
        Web.Click Object (//*[@id="nextButton"])
        Sleep (${Minimal_Wait_Time})
        
        Web.Wait For Object (//*[@id="nextButton"],${Very_Short_Wait_Time})
        Web.Click Object (//*[@id="nextButton"])
        HPCC_Library.WaitForSpinner
        
        Web.Wait For Object (//*[@id="moveToManageServiceButton"],${Wait_Time})
        Web.Click Object (//*[@id="moveToManageServiceButton"])
        HPCC_Library.WaitForSpinner
        
        Web.Wait For Object (//*[@id="closeButton"],${Wait_Time})
        Web.Click Object (//*[@id="closeButton"])
    }
    Fail:
    {
        Web.Capture Screenshot (EnableSIO_Failed.png)
        Return With Fail (Fail enabling SIO for customer device '${Device}'!)
    }
    Error:
    {
        Web.Capture Screenshot (EnableSIO_Error.png)
        Return With Error (Error enabling SIO for customer device '${Device}'!)
    }
    
    Sleep (${Very_Short_Wait_Time})
    
    //task status
    If: HPCC_Library.CheckTaskCompletion(${Customer},${TaskCompleteLimit})
    {
        Sleep (${Very_Short_Wait_Time})
        Return With Pass (EnableSIO completed!)
    }
    Fail:
    {
        Web.Capture Screenshot (EnableSIO_Failed.png)
        Return With Fail (Fail checking completion of SIO Enable task!)
    }
    Error:
    {
        Web.Capture Screenshot (EnableSIO_Error.png)
        Return With Error (Error checking completion of SIO Enable task!)
    }
}

