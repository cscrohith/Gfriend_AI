        Dune.Click Id (#copySettingsPage_list1 #scan_blankPageSuppressionComboBox)
        Sleep (1)
        //clicks on on option
        Common_Library.ValidateandCheck(#scan_blankPageSuppressionComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionstrue_)
        Dune.Click Id (#copySettingsPage_list1 #scan_blankPageSuppressionSettingsComboBox #scan_blankPageSuppressionComboBox)
        Sleep (1)
        //clicks on off option
        Common_Library.ValidateandCheck(#scan_blankPageSuppressionComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsfalse_) 
    }
    Fail:
    {
        Fail (Unable to select the Blank page suppression type)
    }
    
    //Scan mode for Citrine and Jasper for copy pulgin
    Sleep (2)
