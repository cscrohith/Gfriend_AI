     {
         Fail (Unable to slide the LighterDarker)
     }
     
     //ContentType for FAX
     Sleep (2)
     If: Dune.SwipeVertically (#faxSettingsPageMenuListListViewlist1,#faxSettingsPageMenuListListViewlist1ScrollBar,#scan_contentTypeSettingsComboBox,0.05)
     {
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox)
