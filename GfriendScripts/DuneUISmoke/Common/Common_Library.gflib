using Dune
using Common_Variables.gfvar

//function for the options to check 
ValidateandCheck(${ListID},${ScrollBar},${ElementID})
{     
    If: Dune.Wait For visibility (${ListID},${ElementID},1)
    {          
        Dune.Click Id (${ListID} ${ElementID})
    }
    Fail:
    {              
        Dune.SwipeVerticallyAndWaitForTransition (${ListID},${ScrollBar},${ElementID},0.05,700)
        Dune.Wait For (${ListID} ${ElementID},1)        
        Common_Library.ClickIdWithDefaultDelay(${ListID} ${ElementID})
    }   
}

SwipeAndClick(${ListID},${ScrollBar},${ElementID},${Delta},${SpeedValue})
{            
        Dune.SwipeVerticallyAndWaitForTransition (${ListID},${ScrollBar},${ElementID},${Delta},${SpeedValue})
        Common_Library.ClickIdWithDefaultDelay(${ListID} ${ElementID})
}
    
ValidateandCheckWithDeltaValue(${ListID},${ScrollBar},${ElementID},${Delta})
{    
    If: Dune.Wait For visibility (${ListID},${ElementID},1)
    {         
        Common_Library.ClickIdWithDefaultDelay(${ListID} ${ElementID})
    }
    Fail:
    {  
        Dune.SwipeVerticallyAndWaitForTransition (${ListID},${ScrollBar},${ElementID},${Delta},700)
        Common_Library.SleepTime
        Dune.Wait For (${ListID} ${ElementID},1)
        Common_Library.ClickIdWithDefaultDelay(${ListID} ${ElementID})
    }  
}

SleepTime
{
    Sleep (${SleepTime}) 
}

SleepTimeWithCustomDelay(${CustomSleepTime})
{
    Sleep (${CustomSleepTime}) 
}

ClickIdWithDefaultDelay(${ClickElementId})
{
    Dune.Click Id And Wait For Transition (${ClickElementId},${ScreenRenderDelay})
}
//function for the copy pulgin to check the original size          
ScrollToOriginalSize(${ListID},${ScrollBar},${OptionID})
{    
    Dune.SwipeVerticallyAndWaitForTransition (${ListID},${ScrollBar},${OptionID},0.05)
    Common_Library.SleepTime
    Dune.Click Id (${OptionID})
    Common_Library.SleepTime    
}
                        
//checkes the device in the home screen 
CheckHomeScreen
{    
    //waiting for the sign out button if sign out exits clicks on signout
    If: Dune.Wait For (#SignInButton #TextView, 3)
    {
        //clicking on sign out button 
        Dune.Click Id And Wait For Transition(#SignInButton #TextView, ${ScreenRenderDelay})
        Dune.Click (#userInfoSignInButton)
    } 
    Fail:
    { 
        Dune.Go To Home Screen
    }
    Common_Library.SleepTime 
}

//Eager authentication 
AuthenticationEager(${UserName},${Password}) 
{   
    //below id is sigin in or signout i'ds 
    Dune.Wait For (#SignInButton,3)        
    Dune.Click Id And Wait For Transition (#SignInButton,${ScreenRenderDelay})
    Dune.Wait For (#windowsSignInComboBox,5)
    
    Dune.Set Text (#windowsUsernameInputField,${UserName})  
    Common_Library.SleepTime
    Dune.Set Text (#windowsPasswordInputField,${Password})
    Common_Library.SleepTime 
    Dune.Click (#windowsSignInButton)    
 
    //wait for toastmessage to disappear
    If: Dune.Wait For (#SignInButton #TextView,8)
    {
        While: Dune.Wait For (#infoTextToastMessage,5) {
            Common_Library.SleepTime
        } 
    }
    Fail:
    {
        Return With Fail (unable to login)
        Stop Test Case
    }
}
    
Scan_Option_Validation_For_Citrine_and_Jasper 
{   
    //Options checks will starts from here
    If: Dune.Wait For (#optionsButton,3)
    {
        Dune.Click Id (#optionsButton)
    }
    Fail:
    {
        Return With Fail (unable to click on option button )
        Dune.Go To Home Screen
    }
        
    //content type option 
    Sleep (2)
    If: Dune.Wait For (#scanMenuListlist1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox,3)
    {
        Dune.Click Id (#scanMenuListlist1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox)
        Sleep (1) 
        //clicks on Mixed option 
        Common_Library.ValidateandCheck(#scan_contentTypeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsmixed)
        Dune.Click Id (#scanMenuListlist1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox)
        //clicks on Photo option
        Common_Library.ValidateandCheck(#scan_contentTypeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsphoto)
        Dune.Click Id (#scanMenuListlist1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox)
        //clicks on text option
        Common_Library.ValidateandCheck(#scan_contentTypeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionstext)
        Dune.Click Id (#scanMenuListlist1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox)
        //clicks on image option
        Common_Library.ValidateandCheck(#scan_contentTypeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsimage)
    }
    Fail:
    {
       Fail (Unable to select the Content type)
    }
       
    //blank Page suppression only for Citrine and Jasper
    Sleep (2)
    If: Dune.Wait For (#scanMenuListlist1 #scan_blankPageSuppressionComboBox,3)
    {
        Dune.Click Id (#scanMenuListlist1 #scan_blankPageSuppressionSettingsComboBox #scan_blankPageSuppressionComboBox)
        Sleep (1)
        //clicks on off option
        Common_Library.ValidateandCheck (#scan_blankPageSuppressionComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsfalse_)
        Dune.Click Id (#scanMenuListlist1 #scan_blankPageSuppressionSettingsComboBox #scan_blankPageSuppressionComboBox)
        Sleep (1)
        //clicks on On option
        Common_Library.ValidateandCheck (#scan_blankPageSuppressionComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionstrue_)  
    }
    Fail:
    {
        Fail (Unable to select the Blank page suppression type)
    }
          
    //color mode for Citrine and Jasper 
    Sleep (2)
    If: Dune.Wait For (#scanMenuListlist1 #scan_colorModeWithAutoDetectComboBox,3)
    {
        //for Citrine and Jasper
                     
        Dune.Click Id (#scanMenuListlist1 #scan_colorModeWithAutoDetectSettingsComboBox #scan_colorModeWithAutoDetectComboBox)
