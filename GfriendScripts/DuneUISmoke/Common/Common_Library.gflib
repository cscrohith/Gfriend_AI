        Dune.Click Id (#copy_paperSelectionMenuList #copy_mediaSizeSettingsTextImage)
        //clicks on Oficio216x340
        Common_Library.ValidateandCheck (#copy_mediaSizeMenuSelectionList,#copy_mediaSizeMenuSelectionListScrollBar,#om_16k_195x270mmcopy_mediaSize)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_mediaSizeSettingsTextImage)
        //clicks on Sixteen184x260
        Common_Library.ValidateandCheck (#copy_mediaSizeMenuSelectionList,#copy_mediaSizeMenuSelectionListScrollBar,#om_16k_184x260mmcopy_mediaSize)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_mediaSizeSettingsTextImage)
        //clicks on Sixteen197x273
        Common_Library.ValidateandCheck (#copy_mediaSizeMenuSelectionList,#copy_mediaSizeMenuSelectionListScrollBar,#roc_16k_7_dot_75x10_dot_75incopy_mediaSize)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_mediaSizeSettingsTextImage)
        //clicks on PostcardJis
        Common_Library.ValidateandCheck (#copy_mediaSizeMenuSelectionList,#copy_mediaSizeMenuSelectionListScrollBar,#jpn_hagaki_100x148mmcopy_mediaSize)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_mediaSizeSettingsTextImage)
        //clicks on DoublePostcard
        Common_Library.ValidateandCheck (#copy_mediaSizeMenuSelectionList,#copy_mediaSizeMenuSelectionListScrollBar,#jpn_oufuku_148x200mmcopy_mediaSize)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_mediaSizeSettingsTextImage)
        //clicks on EnvelopeHashTen
        Common_Library.ValidateandCheck (#copy_mediaSizeMenuSelectionList,#copy_mediaSizeMenuSelectionListScrollBar,#na_number_dash_10_4_dot_125x9_dot_5incopy_mediaSize)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_mediaSizeSettingsTextImage)
        //clicks on EnvelopeMonarch
        Common_Library.ValidateandCheck (#copy_mediaSizeMenuSelectionList,#copy_mediaSizeMenuSelectionListScrollBar,#na_monarch_3_dot_875x7_dot_5incopy_mediaSize)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_mediaSizeSettingsTextImage)
        //clicks on EnvelopeB5
        Common_Library.ValidateandCheck (#copy_mediaSizeMenuSelectionList,#copy_mediaSizeMenuSelectionListScrollBar,#iso_b5_176x250mmcopy_mediaSize)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_mediaSizeSettingsTextImage)
        //clicks on EnvelopeC5
        Common_Library.ValidateandCheck (#copy_mediaSizeMenuSelectionList,#copy_mediaSizeMenuSelectionListScrollBar,#iso_c5_162x229mmcopy_mediaSize)
        
        Dune.Click Id (#copy_paperSelectionMenuList #copy_mediaSizeSettingsTextImage)
        //clicks on EnvelopeDL
        Common_Library.ValidateandCheck (#copy_mediaSizeMenuSelectionList,#copy_mediaSizeMenuSelectionListScrollBar,#iso_dl_110x220mmcopy_mediaSize)
         
        Dune.Click Id (#copy_paperSelectionMenuList #copy_mediaSizeSettingsTextImage)
        //clicks on Any
        Common_Library.ValidateandCheck (#copy_mediaSizeMenuSelectionList,#copy_mediaSizeMenuSelectionListScrollBar,#anycopy_mediaSize)
    }
    Fail:
    {
        Fail (unable to find Paper slection)
    }
      
    //Paper type options 
    Sleep (2)
    If: Dune.Wait For (#copy_paperSelectionMenuList #copy_paperTypeSettingsTextImage,3)
    { 
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperTypeSettingsTextImage)
        Dune.Wait For (#copy_paperTypeMenuSelectionList,3)
        
        //selects anysize       
        Common_Library.ValidateandCheck (#copy_paperTypeMenuSelectionList,#copy_paperTypeMenuSelectionListScrollBar,#anycopy_paperType)
        
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperTypeSettingsTextImage)
        //selects Light 
        Common_Library.ValidateandCheck (#copy_paperTypeMenuSelectionList,#copy_paperTypeMenuSelectionListScrollBar,#stationery_dash_lightweightcopy_paperType)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperTypeSettingsTextImage)
        //selects HpEcoEFFICIENT
        Common_Library.ValidateandCheck (#copy_paperTypeMenuSelectionList,#copy_paperTypeMenuSelectionListScrollBar,#com_dot_hp_dot_EcoSMARTLitecopy_paperType)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperTypeSettingsTextImage)
        //selects  MidWeight
        Common_Library.ValidateandCheck (#copy_paperTypeMenuSelectionList,#copy_paperTypeMenuSelectionListScrollBar,#com_dot_hp_dot_midweightcopy_paperType)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperTypeSettingsTextImage)
        //selects  Heavy
        Common_Library.ValidateandCheck (#copy_paperTypeMenuSelectionList,#copy_paperTypeMenuSelectionListScrollBar,#stationery_dash_heavyweightcopy_paperType)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperTypeSettingsTextImage)
        //selects  ExtraHeavy
        Common_Library.ValidateandCheck (#copy_paperTypeMenuSelectionList,#copy_paperTypeMenuSelectionListScrollBar,#com_dot_hp_dot_extra_dash_heavycopy_paperType)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperTypeSettingsTextImage)
        //selects  ColorTransparency
        Common_Library.ValidateandCheck (#copy_paperTypeMenuSelectionList,#copy_paperTypeMenuSelectionListScrollBar,#transparencycopy_paperType)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperTypeSettingsTextImage)
        //selects  Labels
        Common_Library.ValidateandCheck (#copy_paperTypeMenuSelectionList,#copy_paperTypeMenuSelectionListScrollBar,#labelscopy_paperType)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperTypeSettingsTextImage)
        //selects  StationeryLetterhead
        Common_Library.ValidateandCheck (#copy_paperTypeMenuSelectionList,#copy_paperTypeMenuSelectionListScrollBar,#stationery_dash_letterheadcopy_paperType)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperTypeSettingsTextImage)
        //selects  Envelope
        Common_Library.ValidateandCheck (#copy_paperTypeMenuSelectionList,#copy_paperTypeMenuSelectionListScrollBar,#envelopecopy_paperType)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperTypeSettingsTextImage)
        //selects StationeryPreprinted 
        Common_Library.ValidateandCheck (#copy_paperTypeMenuSelectionList,#copy_paperTypeMenuSelectionListScrollBar,#stationery_dash_preprintedcopy_paperType)         
                  
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperTypeSettingsTextImage)
        //selects  Colored
        Common_Library.ValidateandCheck (#copy_paperTypeMenuSelectionList,#copy_paperTypeMenuSelectionListScrollBar,#stationery_dash_coloredcopy_paperType)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperTypeSettingsTextImage)
        //selects  Bond
        Common_Library.ValidateandCheck (#copy_paperTypeMenuSelectionList,#copy_paperTypeMenuSelectionListScrollBar,#stationery_dash_bondcopy_paperType)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperTypeSettingsTextImage)
        //selects  Recycled
        Common_Library.ValidateandCheck (#copy_paperTypeMenuSelectionList,#copy_paperTypeMenuSelectionListScrollBar,#com_dot_hp_dot_recycledcopy_paperType)
          
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperTypeSettingsTextImage)
        //selects Automatic
        Common_Library.ValidateandCheck (#copy_paperTypeMenuSelectionList,#copy_paperTypeMenuSelectionListScrollBar,#stationerycopy_paperType)
    }
    Fail:
    {
        Fail (unable to find Paper type)
    }
      
    //trays options 
    Sleep (2)
    If: Dune.Wait For (#copy_paperSelectionMenuList #copy_paperSourceComboBox,3)
    {
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperSourceComboBox)
        If: Dune.Wait For (#copy_paperSourceComboBoxpopupList,3)
        {
            //clicks on tray 1 
            Common_Library.ValidateandCheck (#copy_paperSourceComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionstray_dash_1)
            
            Dune.Click Id (#copy_paperSelectionMenuList #copy_paperSourceComboBox)
            //click on tray2  
            Common_Library.ValidateandCheck (#copy_paperSourceComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionstray_dash_2)
                  
            Dune.Click Id (#copy_paperSelectionMenuList #copy_paperSourceComboBox)
            //clicks on tray5  
            Common_Library.ValidateandCheck (#copy_paperSourceComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsmanual)
              
            Dune.Click Id (#copy_paperSelectionMenuList #copy_paperSourceComboBox)
            //clicks on Automatic 
            Common_Library.ValidateandCheck (#copy_paperSourceComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsauto_)
        } 
        Dune.Wait For (#copy_paperSelectionMenuList #BackButton,3)
        Dune.Click Id (#copy_paperSelectionMenuList #BackButton)
    }
    Fail:
    {
        Fail (unable to find Paper tray)
    }
     
    // Closing the option panel and click on Send button
    Sleep (2)
    If: Dune.Wait For (#copySettingsPage_list1 #closeButton,2)
    {
        Dune.Click Id (#copySettingsPage_list1 #closeButton)
         
        //click on copy button
        Dune.Wait For (#mainActionButtonOfDetailPanel,5)
        Dune.Click Id (#mainActionButtonOfDetailPanel)
        //clicks on done button, this button is available when we select the options other than 1 to 2 sided 
        Sleep (3)
        If: Dune.Wait For (#finish,30)
        {
            //this button will be avaliable only if we select original side as 2 to 1 sided 
            Dune.Click Id (#finish)
        } 
        Dune.SetOAuth2Standard_EnableTokenAuthFalse (9104,5)
        Dune.Wait For Active Job Gone (Copy,25)
        Sleep (7)
        Dune.Go To Home Screen
        Sleep (2)
        Dune.Click (#StatusButtonSignOut)
    }
}
Teardown
{
    Dune.Go To Home Screen
    Dune.Click (#StatusButtonResetSettings)
    While: Dune.Wait For (#infoTextToastMessage,5)
    {
            Common_Library.SleepTime
    } 
}