    {
        Fail (unable to find Paper type)
    }
      
    //trays options 
    Sleep (2)
    If: Dune.Wait For (#copy_paperSelectionMenuList #copy_paperSourceComboBox,3)
    {
        Dune.Click Id (#copy_paperSelectionMenuList #copy_paperSourceComboBox)
        If: Dune.Wait For (#copy_paperSourceComboBoxpopupList,3)
        {
            //clicks on tray 1 
            Common_Library.ValidateandCheck (#copy_paperSourceComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionstray_dash_1)
            
            Dune.Click Id (#copy_paperSelectionMenuList #copy_paperSourceComboBox)
            //click on tray2  
            Common_Library.ValidateandCheck (#copy_paperSourceComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionstray_dash_2)
            
            Dune.Click Id (#copy_paperSelectionMenuList #copy_paperSourceComboBox)
            //clicks on tray3 
            Common_Library.ValidateandCheck (#copy_paperSourceComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionstray_dash_3)
            
            Dune.Click Id (#copy_paperSelectionMenuList #copy_paperSourceComboBox)
            //clicks on tray4 
            Common_Library.ValidateandCheck (#copy_paperSourceComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionstray_dash_4)
            
            Dune.Click Id (#copy_paperSelectionMenuList #copy_paperSourceComboBox)
            //clicks on Automatic 
            Common_Library.ValidateandCheck (#copy_paperSourceComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsauto_)
            
            Dune.Click Id (#copy_paperSelectionMenuList #copy_paperSourceComboBox)
            //clicks on tray5  
            Common_Library.ValidateandCheck (#copy_paperSourceComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionstray_dash_5)         
        } 
        Dune.Wait For (#copy_paperSelectionMenuList #BackButton,3)
        Dune.Click Id (#copy_paperSelectionMenuList #BackButton)
    }
    Fail:
    {
        Fail (unable to find Paper tray)
    }
    
    //we are resetting the option because of booklet option
    If:Dune.Wait For (#copySettingsPage_list1 #closeButton,2)
    {
        Dune.Click Id (#copySettingsPage_list1 #closeButton)
        Dune.Go To Home Screen
        Dune.Wait For (#cedab422-33b3-4638-b6a1-604e54525215,3)
        Dune.Click (#cedab422-33b3-4638-b6a1-604e54525215)
        Dune.Wait For (#optionsDetailPanelButton,3)
        Dune.Click Id (#optionsDetailPanelButton)   
    }
    
    //Booklet option
    Sleep (2)
    If: Dune.SwipeVertically (#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#copySettingBooklet,0.05)
    { 
        Dune.Click Id (#copySettingsPage_list1 #copySettingBooklet)
        Dune.Wait For (#copy_bookletView #CheckBoxOptionsbookletFormatImageContainer,3)
        Dune.Click Id (#copy_bookletView #CheckBoxOptionsbookletFormatImageContainer)
        Dune.Wait For (#CheckBoxOptionsbordersOnEachPageImageContainer,3)
        Dune.Click Id (#CheckBoxOptionsbordersOnEachPageImageContainer) 
        Dune.Click Id (#doneButton)
    }
    Fail:
    {
        Fail (Unable to select the booklet)
    }
     
    // Closing the option panel and click on Send button
    Sleep (2)
    If: Dune.Wait For (#copySettingsPage_list1 #closeButton,2)
    {
        Dune.Click Id (#copySettingsPage_list1 #closeButton)
         
        //click on copy button
        Dune.Wait For (#mainActionButtonOfDetailPanel,5)
        Dune.Click Id (#mainActionButtonOfDetailPanel)
        //clicks on done button, this button is available when we select the options other than 1 to 2 sided 
        Sleep (3)
        If: Dune.Wait For (#doneButton,30)
        {
            //this button will be avaliable only if we select original side as 2 to 1 sided 
            Dune.Click Id (#doneButton)
        } 
        Dune.SetOAuth2Standard_EnableTokenAuthFalse (9104,5)
        Dune.Wait For Active Job Gone (Copy,25)
        Sleep (7)
        Dune.Go To Home Screen
        Sleep (2)
        Dune.Click (#StatusButtonSignOut)
    }
}

Fax_Option_Validation_For_Citrine_and_Jasper
{
    //Options checks will starts from here
    If: Dune.Wait For (#faxAllOptionsButton,3)
    {
        Dune.Click Id (#faxAllOptionsButton)
    }
    Fail:
    {
        Return With Fail (unable to click on option button )
        Dune.Go To Home Screen
    }
    
    //Original side
    Sleep (2)
    If: Dune.Wait For (#faxSettingsPageMenuListListViewlist1 #originalSidesSettings_2infoBlockRow,5) 
    {
        Dune.Click(#faxSettingsPageMenuListListViewlist1 #originalSidesSettings_2infoBlockRow)
        //Clicks on 2 sided option
        Common_Library.ValidateandCheck(#faxSettingsPageMenuListListView,#comboBoxScrollBar,#RadioButtonOptionsduplexImageContainer)
        Dune.Click Id (#faxSettingsPageMenuListListView #BackButton)

        Sleep (1)
        Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #originalSidesSettings_2infoBlockRow)
        //clicks on 1 sided option
        Common_Library.ValidateandCheck(#faxSettingsPageMenuListListView,#comboBoxScrollBar,#RadioButtonOptionssimplexImageContainer)
        Dune.Click Id (#faxSettingsPageMenuListListView #BackButton)
    }
    Fail:
    {
        Fail (Unable to select the  Original side)
    }
     
    //Original size
    Sleep (2)
    If: Dune.Wait For (#faxSettingsPageMenuListListViewlist1 #scan_originalSizeSettingsComboBox #scan_originalSizeComboBox,5)
    {
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #scan_originalSizeSettingsComboBox #scan_originalSizeComboBox)
         //Click on Letter (8.5x11 in.) option
         Common_Library.ValidateandCheck(#scan_originalSizeComboBoxpopupList, #comboBoxScrollBar, #ComboBoxOptionsna_letter_8_dot_5x11in)
         
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #scan_originalSizeSettingsComboBox #scan_originalSizeComboBox)
         //Click on Letter ▭ (8.5x11 in.) option
         Common_Library.ValidateandCheck(#scan_originalSizeComboBoxpopupList, #comboBoxScrollBar,#ComboBoxOptionscom_dot_hp_dot_ext_dot_mediaSize_dot_na_letter_8_dot_5x11in_dot_rotated)
         
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #scan_originalSizeSettingsComboBox #scan_originalSizeComboBox)
         //Click on Legal (8.5x14 in.) option
         Common_Library.ValidateandCheck(#scan_originalSizeComboBoxpopupList, #comboBoxScrollBar,#ComboBoxOptionsna_legal_8_dot_5x14in)
         
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #scan_originalSizeSettingsComboBox #scan_originalSizeComboBox)
         //Click on A4 (210x297 mm) option
         Common_Library.ValidateandCheck(#scan_originalSizeComboBoxpopupList, #comboBoxScrollBar,#ComboBoxOptionsiso_a4_210x297mm)
         
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #scan_originalSizeSettingsComboBox #scan_originalSizeComboBox)
         //Click on A4 ▭ (210x297 mm)
         Common_Library.ValidateandCheck(#scan_originalSizeComboBoxpopupList, #comboBoxScrollBar,#ComboBoxOptionscom_dot_hp_dot_ext_dot_mediaSize_dot_na_letter_8_dot_5x11in_dot_rotated)
         
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #scan_originalSizeSettingsComboBox #scan_originalSizeComboBox)
         //Click on Ledger (11x17 in.)
         Common_Library.ValidateandCheck(#scan_originalSizeComboBoxpopupList, #comboBoxScrollBar,#ComboBoxOptionsna_ledger_11x17in)
         
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #scan_originalSizeSettingsComboBox #scan_originalSizeComboBox)
         //Click on A3 (297x420 mm)
         Common_Library.ValidateandCheck(#scan_originalSizeComboBoxpopupList, #comboBoxScrollBar,#ComboBoxOptionsiso_a3_297x420mm)
     }
     Fail:
     {
         Fail (Unable to select the  Original size)
     }
     
     //LighterDarker for FAX
     Sleep (2)
     If: Dune.Wait For (#faxSettingsPageMenuListListViewlist1 #scan_lighterDarkerSettingsSlider #scan_lighterDarkerMenuSlider,5)
     {
         //sets the slider to 5 value
         Dune.SetSliderValue (#scan_lighterDarkerMenuSlider,7)
     }
     Fail:
     {
         Fail (Unable to slide the LighterDarker)
     }
     
     //ContentType for FAX
     Sleep (2)
     If: Dune.Wait For (#faxSettingsPageMenuListListViewlist1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox,5)
     {
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox)
         Sleep (1) 
         //clicks on Mixed option 
         Common_Library.ValidateandCheck(#scan_contentTypeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsmixed)
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox)
         //clicks on Photo option
         Common_Library.ValidateandCheck(#scan_contentTypeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsphoto)
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox)
         //clicks on text option
         Common_Library.ValidateandCheck(#scan_contentTypeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionstext)
     }
     Fail:
     {
         Fail (Unable to select the Content type)
     }
     
     //Resolution for FAX
     Sleep (2)
     If: Dune.SwipeVertically (#faxSettingsPageMenuListListViewlist1,#faxSettingsPageMenuListListViewlist1ScrollBar,#fax_resolutionSettingsComboBox,0.05)
     {
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #fax_resolutionSettingsComboBox #fax_resolutionComboBox)
         //clicks fine (200X200 dpi) option
         Common_Library.ValidateandCheck(#fax_resolutionComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsfine)
         
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #fax_resolutionSettingsComboBox #fax_resolutionComboBox)
         //clicks standard (200X100 dpi) option
         Common_Library.ValidateandCheck(#fax_resolutionComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsstandard)
         
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #fax_resolutionSettingsComboBox #fax_resolutionComboBox)
         //clicks Superfine (300X300 dpi) option
         Common_Library.ValidateandCheck(#fax_resolutionComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionssuperfine)
     }
     Fail:
     {
         Fail (Unable to set the Cover page option)
     }
       //cover page for FAX
     Sleep (2)
     If: Dune.SwipeVertically (#faxSettingsPageMenuListListViewlist1,#faxSettingsPageMenuListListViewlist1ScrollBar,#fax_includeCoverPageSettingsSwitch,0.05)
     {
         Dune.Click Id (#fax_includeCoverPageMenuSwitch)
     }
     Fail:
     {
         Fail (Unable to set the Cover page option)
     }
     //Notification
     Sleep (2)
     If: Dune.SwipeVertically (#faxSettingsPageMenuListListViewlist1,#faxSettingsPageMenuListListViewlist1ScrollBar,#FaxSendNotification,0.05)
     {
         //Clicks on Notification Option
         Dune.Click Id (#FaxSendNotification_2infoBlockRow)
         Sleep (1)
         
         //Clicks on Notify after job finishes
         Dune.Click Id (#onJobCompleted)
         Sleep (1)
         
         //Clicks on  Notify only if job successfull
         Dune.Click Id (#onJobFailed)
          
         Sleep (1)
         //cliks on Include Thumbnail
         Dune.Click Id (#includeThumbnailSpiceCheckBox)
         Sleep (1)
         
         // Clicks on Do not Notify
         Dune.Click Id (#never)
         
         //Clicks on Done button
         Dune.Click Id (#doneButton)
     }
     Fail:
     {
         Fail (Unable to click on Notification)
     }
     
     // Closing the option panel and click on Send button
     Sleep (2)
     If: Dune.Wait For (#faxSettingsPageMenuListListViewlist1 #closeButton,2)
     {
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #closeButton)
         Sleep (2)
         //clicks on Send button 
         Dune.Click Id (#sendFaxButtonFooterMain)
         //waiting and clicking Done button
         Dune.Wait For (#finish,20)
         Dune.Click Id (#finish)
         Dune.SetOAuth2Standard_EnableTokenAuthFalse (9104,5)
         Dune.Wait For Active Job Gone (scanFax,70)
         Sleep (5)
         Dune.Go To Home Screen
         Sleep (2)
         //clicks on Sign out 
         Dune.Click (#StatusButtonSignOut)
     }
}

PrintFromUSB_Workflow_For_Citrine_and_Jasper
{
   //Below is waiting for Print app
   If: Dune.Wait For (#PrintFolderGUID,10)
   {
       //clicks on Print App
       Dune.Click (#PrintFolderGUID)
       sleep(1)
        
       //waiting on Print From USB 
       If:Dune.Wait For (#c93bc831-99a8-454c-b508-236fc3a2a08f,10)
       {
           Dune.Click (#c93bc831-99a8-454c-b508-236fc3a2a08f)
       }
       Fail:
       {
           Return With Fail (Unable to click on Print From USB)
           Stop Test Suite
       }
   }
   Fail:
   {
       Return With Fail (Unable to click on Print Application)
       Stop Test Suite
   }
   
   //SelectFile
   sleep(1)     
   If: Dune.Wait For visibility (#scrollAreaGridLayout,${PrintFromUSBFileName},1)
   {
       Dune.Click Id (${PrintFromUSBFileName})
   }
   Fail:
   {
       Dune.SwipeVertically (#scrollAreaGridLayout,#scrollAreaGridLayoutverticalScroll,${PrintFromUSBFileName},0.05)
       Dune.Wait For (${PrintFromUSBFileName},10)
       Dune.Click Id (${PrintFromUSBFileName})
       Sleep (2)
   }
   
   //ExecutePrintJob
   sleep(1)
   If:  Dune.Wait For (#printUsbBtn,10)
   {
       Dune.Click Id (#printUsbBtn)
       Dune.SetOAuth2Standard_EnableTokenAuthFalse (9104,10)
       If: Dune.Wait For Active Job Gone(usbPrint,10)
       {
           Sleep (6)
           Dune.Go To Home Screen
           Sleep (2)
           Dune.Click (#StatusButtonSignOut)
       }
       Fail:
       {
           Return With Fail (Unable to click on Print Application)
           Stop Test Suite 
       }
   }
   Fail:
   {
       Return With Fail (Unable to click on Print Application)
       Stop Test Suite 
   }
}
 
PrintFromJobStorage_Workflow_For_Citrine_and_Jasper
{
    Wait For User Confirm (Scroll to next screen for Print from Job Storage)

    //waiting for Print From Job Storage app
    If: Dune.Wait For (#86DCD04A-5F44-4EAE-83C3-1C3C3F12E32B,10)
    {
       //clicks on Print From Job Storage app
       Dune.Click (#86DCD04A-5F44-4EAE-83C3-1C3C3F12E32B)
       sleep(1)      
   }
   Fail:
   {
       Return With Fail (Unable to click on Print Application)
       Stop Test Suite
   }
   
   //Selects the specified folder
   sleep(2)     
   If: Dune.Wait For visibility (#JobStorageAppApplicationStackView,${PrintFromJobStorageFolderName},1)
   {
       Dune.Click Id (${PrintFromJobStorageFolderName})
   }
   Fail:
   {
       Return With Fail (Unable to click on ${PrintFromJobStorageFolderName})
       Stop Test Suite
   }
   
   //Selects the file from Job Storage
   If: Dune.Wait For (#CheckBoxView,10)
   {
       Dune.Click Id (#CheckBoxView)
   }
   Fail:
   {
       Return With Fail (No jobs are avilable to select)
       Stop Test Suite
   }
   
   
   //ExecutePrintJob
   sleep(1)
   If: Dune.Wait For (#printButton,10)
   {
       Dune.Click Id (#printButton)
   }
   Fail:
   {
       Return With Fail (Unable to click on Print Application)
       Stop Test Suite
   }
   
   //Number of copies
   Sleep (2)
   If: Dune.Wait For (#SpiceViewlist1 #SpinBoxTextInput,10) 
   {
        Dune.Click Id (#SpiceViewlist1 #SpinBoxTextInput)
        Dune.Wait For (#enterKeyPositiveIntegerKeypad,3)
        Dune.Click Id (#key2PositiveIntegerKeypad)
        Dune.Click Id (#enterKeyPositiveIntegerKeypad)
    }
    Fail:
    {
        Fail (Unable to click on copies)
    }
   
   sleep(1)
   If:  Dune.Wait For (#printButtonSubmission,10)
   {
       Dune.Click Id (#printButtonSubmission)
       
       Dune.SetOAuth2Standard_EnableTokenAuthFalse (9104,10)  
       If: Dune.Wait For Active Job Gone(usbPrint,10)
       {
           Sleep (6)
           Dune.Go To Home Screen
           Sleep (2)
           Dune.Click (#StatusButtonSignOut)
       }
       Fail:
       {
           Return With Fail (Unable to click on Print Application)
           Stop Test Suite 
       }
   }
   Fail:
   {
       Return With Fail (Unable to click on Print Application)
       Stop Test Suite
   }
}

Scan_Option_Validation_For_Camden_and_Busch
{
    //Options checks will starts from here
