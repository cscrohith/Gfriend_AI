         //clicks on Mixed option 
         Common_Library.ValidateandCheck(#scan_contentTypeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsmixed)
         
         Dune.SwipeVertically (#faxSettingsPageMenuListListViewlist1,#faxSettingsPageMenuListListViewlist1ScrollBar,#scan_contentTypeSettingsComboBox,0.05)
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox)
         //clicks on Photo option
         Common_Library.ValidateandCheck(#scan_contentTypeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsphoto)
         
         Dune.SwipeVertically (#faxSettingsPageMenuListListViewlist1,#faxSettingsPageMenuListListViewlist1ScrollBar,#scan_contentTypeSettingsComboBox,0.05)
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox)
         //clicks on text option
         Common_Library.ValidateandCheck(#scan_contentTypeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionstext)
     }
     Fail:
     {
         Fail (Unable to select the Content type)
     }
     
     //Resolution for FAX
     Sleep (2)
     If: Dune.SwipeVertically (#faxSettingsPageMenuListListViewlist1,#faxSettingsPageMenuListListViewlist1ScrollBar,#fax_resolutionSettingsComboBox,0.05)
     {
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #fax_resolutionSettingsComboBox #fax_resolutionComboBox)
         //clicks fine (200X200 dpi) option
         Common_Library.ValidateandCheck(#fax_resolutionComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsfine)
         
         Dune.SwipeVertically (#faxSettingsPageMenuListListViewlist1,#faxSettingsPageMenuListListViewlist1ScrollBar,#fax_resolutionSettingsComboBox,0.05)
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #fax_resolutionSettingsComboBox #fax_resolutionComboBox)
         //clicks standard (200X100 dpi) option
         Common_Library.ValidateandCheck(#fax_resolutionComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsstandard)
         
         Dune.SwipeVertically (#faxSettingsPageMenuListListViewlist1,#faxSettingsPageMenuListListViewlist1ScrollBar,#fax_resolutionSettingsComboBox,0.05)
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #fax_resolutionSettingsComboBox #fax_resolutionComboBox)
         //clicks Superfine (300X300 dpi) option
         Common_Library.ValidateandCheck(#fax_resolutionComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionssuperfine)
     }
     Fail:
     {
         Fail (Unable to set the Cover page option)
     } 
     
     //Notification
     Sleep (2)
     If: Dune.SwipeVertically (#faxSettingsPageMenuListListViewlist1,#faxSettingsPageMenuListListViewlist1ScrollBar,#FaxSendNotification,0.05)
     {
         //Clicks on Notification Option
         Dune.Click Id (#FaxSendNotification_2infoBlockRow)
         Sleep (1)
         
         //Clicks on Notify after job finishes
         Dune.Click Id (#onJobCompleted)
         Sleep (1)
         
         //Clicks on  Notify only if job successfull
         Dune.Click Id (#onJobFailed)
          
         Sleep (1)
         //cliks on Include Thumbnail
         Dune.SwipeVertically (#FaxSendNotificationViewlist1,#FaxSendNotificationViewlist1ScrollBar,#includeThumbnailCheckBoxViewModel,0.05)
         Dune.Click Id (#includeThumbnailSpiceCheckBox)
         Sleep (1)
         
         // Clicks on Do not Notify
         Dune.SwipeVertically (#FaxSendNotificationViewlist1,#FaxSendNotificationViewlist1ScrollBar,#never,0.05)
         Dune.Click Id (#never)
         //Clicks on Done button
         Dune.Click Id (#doneButton)
     }
     Fail:
     {
         Fail (Unable to click on Notification)
     }     
     
     // Closing the option panel and click on Send button
     Sleep (2)
     If: Dune.Wait For (#faxSettingsPageMenuListListViewlist1 #closeButton,2)
     {
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #closeButton)
         Sleep (2)
         //clicks on Send button 
         Dune.Click Id (#sendFaxButtonFooterMain)
         //waiting and clicking Done button
         Dune.Wait For (#finish,20)
         Dune.Click Id (#finish)
         Dune.SetOAuth2Standard_EnableTokenAuthFalse (9104,5)
         Dune.Wait For Active Job Gone (scanFax,60)
         Sleep (5)
         Dune.Go To Home Screen
         Sleep (2)
         //clicks on Sign out 
         Dune.Click (#StatusButtonSignOut)
     }
}


PrintFromUSB_Workflow_For_Camden_and_Busch
{
    //Below is waiting for Print app
   If: Dune.Wait For (#PrintFolderGUID,10)
   {
       //clicks on Print App
       Dune.Click (#PrintFolderGUID)
       sleep(1)
        
       //waiting on Print From USB 
       If: Dune.Wait For (#c93bc831-99a8-454c-b508-236fc3a2a08f,10)
       {
           Dune.Click (#c93bc831-99a8-454c-b508-236fc3a2a08f)
       }
       Fail:
       {
           Return With Fail (Unable to click on Print From USB)
           Stop Test Suite
       }
   }
   Fail:
   {
       Return With Fail (Unable to click on Print Application)
       Stop Test Suite
   }
   
   //SelectFile
   sleep(1)     
   If: Dune.Wait For visibility (#scrollAreaGridLayout,${PrintFromUSBFileName},1)
   {
       Dune.Click Id (${PrintFromUSBFileName})
   }
   Fail:
   {
       Dune.SwipeVertically (#SpiceListViewView,#SpiceListViewViewScrollBar,${PrintFromUSBFileName},0.05)
       Dune.Wait For (${PrintFromUSBFileName},10)
       Dune.Click Id (${PrintFromUSBFileName})
       Sleep (2)
   }
   
   //Click on continue button
   sleep(1)
   If:  Dune.Wait For (#continueButton,10)
   {
       Dune.Click Id (#continueButton)
   }
   Fail:
   {
       Return With Fail (Unable to click on Print Application)
       Stop Test Suite
   }
   
   //ExecutePrintJob
   Sleep (1)
   If: Dune.Wait For(#printModeBtn,2)
   {
       Dune.Click Id (#DetailPanelverticalLayout #FooterView #FooterViewRight #printUsbBtnFD)
       Dune.SetOAuth2Standard_EnableTokenAuthFalse (9104,10)
       If: Dune.Wait For Active Job Gone(usbPrint,120)
       {
           Sleep (6)
           Dune.Go To Home Screen
           Sleep (2)
           Dune.Click (#StatusButtonSignOut)
       }
       Fail:
       {
           Return With Fail (Job did not complete)
           Stop Test Suite 
       }
   }
   Fail:
   {
       Return With Fail (Unable to click on Print Application)
       Stop Test Suite 
   }
}


Copy_Option_Validation_for_Camden_and_Busch
{
    If: Dune.Wait For (#optionsDetailPanelButton,3)
    {
        Dune.Click Id (#optionsDetailPanelButton)
    }
    Fail:
    {
        Return With Fail (Unable to click options buttion copy Application)
    }
        
    //content type option
    Sleep (2)
    If: Dune.Wait For (#copySettingsPage_list1 #scan_contentTypeComboBox,3)
    {
        Sleep (1)
        Dune.Click Id (#copySettingsPage_list1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox)
        //clicks on Photo option
        Common_Library.ValidateandCheck(#scan_contentTypeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsphoto)
        
        Dune.Click Id (#copySettingsPage_list1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox)
        //clicks on text option
        Common_Library.ValidateandCheck(#scan_contentTypeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionstext)
        
        Dune.Click Id (#copySettingsPage_list1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox)
        //clicks on image option
        Common_Library.ValidateandCheck(#scan_contentTypeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsimage)
        
        Dune.Click Id (#copySettingsPage_list1 #scan_contentTypeComboBox)
        //clicks on Mixed option
        Common_Library.ValidateandCheck(#scan_contentTypeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsmixed)
    }
    Fail:
    {
        Fail (Unable to select the Content type)
    }
      
    //blank Page suppression
    Sleep (2)
    If: Dune.Wait For (#copySettingsPage_list1 #scan_blankPageSuppressionComboBox,3)
    {
        Dune.Click Id (#copySettingsPage_list1 #scan_blankPageSuppressionComboBox)
        Sleep (1)
        //clicks on off option
        Common_Library.ValidateandCheck(#scan_blankPageSuppressionComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsfalse_)
        Dune.Click Id (#copySettingsPage_list1 #scan_blankPageSuppressionSettingsComboBox #scan_blankPageSuppressionComboBox)
        Sleep (1)
        //clicks on On option
        Common_Library.ValidateandCheck(#scan_blankPageSuppressionComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionstrue_)  
    }
    Fail:
    {
        Fail (Unable to select the Blank page suppression type)
    }
    //Scan mode for Citrine and Jasper for copy pulgin
    Sleep (2)
    If: Dune.SwipeVertically (#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_scanModeSettingsTextImage_firstinfoBlockRow,0.05)
    {
        Dune.Click Id (#copySettingsPage_list1 #scan_scanModeSettingsTextImage_firstinfoBlockRow)
        Dune.Wait For (#copy_scanModeList #scan_scanModestandardImageContainer,3)
        Dune.Click Id (#copy_scanModeList #bookMode)
        Sleep (2)
        Dune.Click Id (#copy_scanModeList #scan_scanModestandardImageContainer)
        Dune.Click Id (#footerDoneButton)
    }
    Fail:
    {
        Fail (unable to select scan mode)
    }
    
         
    //Side option
    Sleep (2)
    If: Dune.SwipeVertically (#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#copy_sidesMenuComboBox,0.05)
    If: Dune.Wait For (#copySettingsPage_list1 #copy_sidesMenuComboBox #SettingsSpiceComboBox,5) 
    {    
        Dune.Click Id (#copySettingsPage_list1 #copy_sidesMenuComboBox #SettingsSpiceComboBox)
        //clicks on 1 to 2 sided option
        Common_Library.ValidateandCheck(#SettingsSpiceComboBoxpopupList,#copySettingsPage_list1ScrollBar,#Copy1to2Sided)
         
        // this below option is available only if we select copy1to2sided option 
        Common_Library.ValidateandCheck(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_pageFlipUpEnabledMenuSwitch)
        
        Dune.SwipeVertically (#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#copy_sidesMenuComboBox,0.05) 
        Dune.Click Id (#copySettingsPage_list1 #copy_sidesMenuComboBox #SettingsSpiceComboBox)
        //clicks on 2 to 2 sided option
        Common_Library.ValidateandCheck(#SettingsSpiceComboBoxpopupList,#comboBoxScrollBar,#Copy2to2Sided)
         
        // this below option is available only if we select Copy2to2Sided option 
        Common_Library.ValidateandCheck(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_pageFlipUpEnabledMenuSwitch)
        Dune.SwipeVertically (#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#copy_sidesMenuComboBox,0.05)
        Dune.Click Id (#copySettingsPage_list1 #copy_sidesMenuComboBox #SettingsSpiceComboBox)
        //clicks on 1 to 1 sided option
        Common_Library.ValidateandCheck(#SettingsSpiceComboBoxpopupList,#comboBoxScrollBar,#Copy1to1sided)
        
        Dune.SwipeVertically (#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#copy_sidesMenuComboBox,0.05)
        Dune.Click Id (#copySettingsPage_list1 #copy_sidesMenuComboBox #SettingsSpiceComboBox)
        //clicks on 2 to 1 sided  option
        Common_Library.ValidateandCheck(#SettingsSpiceComboBoxpopupList,#comboBoxScrollBar,#Copy2to1Sided)
    }
    Fail:
    {
        Fail (Unable to select the Sides option)
    } 

    //Original size
    Sleep (2)
    If: Dune.SwipeVertically (#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_originalSizeSettingsTextImage,0.05)
    {
        Dune.Click Id (#copySettingsPage_list1 #scan_originalSizeSettingsTextImage #scan_originalSizeSettingsTextImage_2infoBlockRow)
        
        //clicks on Letter
        Common_Library.ValidateandCheck(#scan_originalSizeMenuSelectionList,#scan_originalSizeMenuSelectionListScrollBar,#na_letter_8_dot_5x11inscan_originalSize)
        
        Common_Library.ScrollToOriginalSize(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_originalSizeSettingsTextImage)
        //clicks on Executive (7.25x10.5 in.)
        Common_Library.ValidateandCheck(#scan_originalSizeMenuSelectionList,#scan_originalSizeMenuSelectionListScrollBar,#na_executive_7_dot_25x10_dot_5inscan_originalSize)
        
        Common_Library.ScrollToOriginalSize(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_originalSizeSettingsTextImage)
        //clicks on 5x8 in.
        Common_Library.ValidateandCheck(#scan_originalSizeMenuSelectionList,#scan_originalSizeMenuSelectionListScrollBar,#na_index_dash_5x8_5x8inscan_originalSize)
        
        Common_Library.ScrollToOriginalSize(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_originalSizeSettingsTextImage)
        //clicks on A4 (210x297 mm)
        Common_Library.ValidateandCheck(#scan_originalSizeMenuSelectionList,#scan_originalSizeMenuSelectionListScrollBar,#iso_a4_210x297mmscan_originalSize)
        
        Common_Library.ScrollToOriginalSize(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_originalSizeSettingsTextImage)
        //clicks on A5 (148x210 mm)
        Common_Library.ValidateandCheck(#scan_originalSizeMenuSelectionList,#scan_originalSizeMenuSelectionListScrollBar,#iso_a5_148x210mmscan_originalSize)
        
        Common_Library.ScrollToOriginalSize(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_originalSizeSettingsTextImage)
        //clicks on B5 (JIS) (182x257 mm)
        Common_Library.ValidateandCheck(#scan_originalSizeMenuSelectionList,#scan_originalSizeMenuSelectionListScrollBar,#jis_b5_182x257mmscan_originalSize)
        
        Common_Library.ScrollToOriginalSize(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_originalSizeSettingsTextImage)
        //clicks on B6 (JIS) (128x182 mm)
        Common_Library.ValidateandCheck(#scan_originalSizeMenuSelectionList,#scan_originalSizeMenuSelectionListScrollBar,#jis_b6_128x182mmscan_originalSize)
        
        Common_Library.ScrollToOriginalSize(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_originalSizeSettingsTextImage)
        //clicks on Oficio (216x340 mm)
