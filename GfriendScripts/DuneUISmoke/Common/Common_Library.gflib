    }
         
    //Side option for Citrine and Jasper only for copy plugin
     Sleep (2)
     If: Dune.Wait For (#copySettingsPage_list1 #copy_sidesMenuComboBox #SettingsSpiceComboBox,5) 
    {
        Dune.Click Id (#copySettingsPage_list1 #copy_sidesMenuComboBox #SettingsSpiceComboBox)
        //clicks on 1 to 2 sided option
        Common_Library.ValidateandCheckWithDeltaValue(#SettingsSpiceComboBoxpopupList,#copySettingsPage_list1ScrollBar,#Copy1to2Sided,${DeltaValueCopy})
        
        // this below option is available only if we select copy1to2sided option 
        Common_Library.ValidateandCheck(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_pageFlipUpEnabledMenuSwitch)
        
        Dune.Click Id (#copySettingsPage_list1 #copy_sidesMenuComboBox #SettingsSpiceComboBox)
        //clicks on 2 to 2 sided option
        Common_Library.ValidateandCheckWithDeltaValue(#SettingsSpiceComboBoxpopupList,#comboBoxScrollBar,#Copy2to2Sided,${DeltaValueCopy})
        //this below option is available only if we select Copy2to2Sided option 
        Common_Library.ValidateandCheck(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_pageFlipUpEnabledMenuSwitch)
        
        //Dune.Click Id (#copySettingsPage_list1 #copy_sidesMenuComboBox #SettingsSpiceComboBox)
        //clicks on 1 to 1 sided option
