    //Erase Edges
    If: Dune.SwipeVertically (#scanMenuListlist1,#scanMenuListlist1ScrollBar,#scan_eraseEdgesSettingsTextImage,0.05)
    {
        Dune.Click Id (#scan_eraseEdgesSettingsTextImage_2infoBlockRow)
        Sleep (1)
        
        //clear setting 
        Dune.Click Id (#scanMenuList #ScanSettingsEraseEdgesView #clearButton)
        //Unit of Measurement as Inches
        Dune.Click Id (#SettingsSpiceComboBox #contentItem)
        Dune.Wait For (#comboListInches,1)
        Dune.Click (#comboListInches)
        Sleep (1)
        
        //Millimeters
        Dune.Click Id (#SettingsSpiceComboBox #contentItem)
        Dune.Wait For (#comboListMillimeter,1)
        Dune.Click (#comboListMillimeter)
        
        //click  on Apply Same width
        Dune.Click Id (#sameWidthAllEdgesCheckbox)
        Sleep (2)
        Dune.Click Id (#sameWidthAllEdgesCheckbox)
       
        //Click on Mirror Front Side
        Dune.SwipeVertically (#ScanSettingsEraseEdgesView,#ScanSettingsEraseEdgesViewScrollBar,#mirrorFrontSideView,0.05)
        Dune.Click Id (#mirrorFrontSideCheckbox)
        Sleep (1)
        Dune.Click Id (#mirrorFrontSideCheckbox)      
       
        //Front Side
        Dune.SwipeVertically (#scanMenuListverticalLayout,#ScanSettingsEraseEdgesViewScrollBar,#topEdgeSpinBoxControlModel,0.05)
        Dune.Click Id (#scanMenuListverticalLayout #topEdgeSpinBoxControlModel #SpinBoxTextInput)
        Dune.Wait For (#backspaceKeyPositiveIntegerKeypad,2)
        Dune.Click Id (#key1PositiveIntegerKeypad)
        Dune.Click Id (#enterKeyPositiveIntegerKeypad)
        
        Dune.Click Id (#scanMenuListverticalLayout #bottomEdgeSpinBoxControlModel #SpinBoxTextInput
        Dune.Wait For (#backspaceKeyPositiveIntegerKeypad,2)
        Dune.Click Id (#key2PositiveIntegerKeypad)
        Dune.Click Id (#enterKeyPositiveIntegerKeypad)
        
        Dune.Click Id (#scanMenuListverticalLayout #leftEdgeSpinBoxControlModel #SpinBoxTextInput
        Dune.Wait For (#backspaceKeyPositiveIntegerKeypad,2)
        Dune.Click Id (#key3PositiveIntegerKeypad)
        Dune.Click Id (#enterKeyPositiveIntegerKeypad)
        
        Dune.SwipeVertically (#ScanSettingsEraseEdgesView,#ScanSettingsEraseEdgesViewScrollBar,#rightEdgeSpinBoxControlModel,0.05)
        Dune.Click Id (#scanMenuListverticalLayout #rightEdgeSpinBoxControlModel #SpinBoxTextInput
        Dune.Wait For (#backspaceKeyPositiveIntegerKeypad,2)
        Dune.Click Id (#key4PositiveIntegerKeypad)
        Dune.Click Id (#enterKeyPositiveIntegerKeypad)
        
        //Back Side
        Dune.SwipeVertically (#ScanSettingsEraseEdgesView,#ScanSettingsEraseEdgesViewScrollBar,#eraseBackTopEdgeSpinBox,0.05)
        Dune.Click Id (#scanMenuListverticalLayout #eraseBackTopEdgeSpinBoxControlModel #SpinBoxTextInput)
        Dune.Wait For (#backspaceKeyPositiveIntegerKeypad,2)
        Dune.Click Id (#key1PositiveIntegerKeypad)
        Dune.Click Id (#enterKeyPositiveIntegerKeypad)
        
        Dune.SwipeVertically (#ScanSettingsEraseEdgesView,#ScanSettingsEraseEdgesViewScrollBar,#eraseBackBottomEdgeSpinBox,0.05)
        Dune.Click Id (#scanMenuListverticalLayout #eraseBackBottomEdgeSpinBoxControlModel #SpinBoxTextInput)
        Dune.Wait For (#backspaceKeyPositiveIntegerKeypad,2)
        Dune.Click Id (#key2PositiveIntegerKeypad)
        Dune.Click Id (#enterKeyPositiveIntegerKeypad)
        
        Dune.SwipeVertically (#ScanSettingsEraseEdgesView,#ScanSettingsEraseEdgesViewScrollBar,#eraseBackRightEdgeSpinBox,0.05)
        Dune.Click Id (#scanMenuListverticalLayout #eraseBackLeftEdgeSpinBoxControlModel #SpinBoxTextInput)
        Dune.Wait For (#backspaceKeyPositiveIntegerKeypad,2)
        Dune.Click Id (#key3PositiveIntegerKeypad)
        Dune.Click Id (#enterKeyPositiveIntegerKeypad)
        
        Dune.SwipeVertically (#ScanSettingsEraseEdgesView,#ScanSettingsEraseEdgesViewScrollBar,#eraseBackRightEdgeSpinBox,0.05)
        Dune.Click Id (#scanMenuListverticalLayout #eraseBackRightEdgeSpinBoxControlModel #SpinBoxTextInput)
        Dune.Wait For (#backspaceKeyPositiveIntegerKeypad,2)
        Dune.Click Id (#key3PositiveIntegerKeypad)
        Dune.Click Id (#enterKeyPositiveIntegerKeypad)
        
        //Clicks on Done button
        Dune.Click Id (#eraseEdgeDoneButton)
    }
    Fail:
    {
        Fail (Unable to select the Erase Edges)
    }
         
    // pdfEncryption
    Sleep (2)
    If: Dune.SwipeVertically (#scanMenuListlist1,#scanMenuListlist1ScrollBar,#scan_pdfEncryptionSettingsSwitch,0.05)
    {
        //clicks the option twice 
        Repeat:2
        {
            Dune.Click Id (#scanMenuListlist1 #scan_pdfEncryptionMenuSwitch)
            Sleep (1)
        }   
    }
    Fail:
    {
        Fail (Unable to select the PDF Encryption)
    }
         
    //High Compression
    Sleep (2)
    If: Dune.SwipeVertically (#scanMenuListlist1,#scanMenuListlist1ScrollBar,#scan_highCompressionSettingsSwitch,0.05)
    {
        //clicks on the option of High compression
        Dune.Click Id (#scanMenuListlist1 #scan_highCompressionMenuSwitch)   
    }
    Fail:
    {
        Fail (Unable to select the High Compression)
    }
       
         
    // Orientation
    Sleep (2)
    If: Dune.SwipeVertically (#scanMenuListlist1,#scanMenuListlist1ScrollBar,#scan_contentOrientationSettingsComboBox,0.05)
    { 
        Dune.Click Id (#scanMenuListlist1 #scan_contentOrientationSettingsComboBox #scan_contentOrientationComboBox)
        //clicks on landscape option
        Common_Library.ValidateandCheck(#scan_contentOrientationComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionslandscape)
        Dune.Click Id (#scanMenuListlist1 #scan_contentOrientationSettingsComboBox #scan_contentOrientationComboBox)
        //clicks on Portrait option
        Common_Library.ValidateandCheck(#scan_contentOrientationComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsportrait)
    }
    Fail:
    {
        Fail (Unable to select the orientation)
    } 
         
    //File Size
    Sleep (2)
    If: Dune.SwipeVertically (#scanMenuListlist1,#scanMenuListlist1ScrollBar,#scan_qualityAndFileSizeSettingsComboBox,0.05)
    {     
        Dune.Click Id (#scanMenuListlist1 #scan_qualityAndFileSizeSettingsComboBox #scan_qualityAndFileSizeComboBox)
        //clicks on High option
        Common_Library.ValidateandCheck(#scan_qualityAndFileSizeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionshigh)
              
        Dune.Click Id (#scanMenuListlist1 #scan_qualityAndFileSizeSettingsComboBox #scan_qualityAndFileSizeComboBox)
        //clicks on Medium option
        Common_Library.ValidateandCheck(#scan_qualityAndFileSizeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsmedium)
              
        Dune.Click Id (#scanMenuListlist1 #scan_qualityAndFileSizeSettingsComboBox #scan_qualityAndFileSizeComboBox)
        //clicks on low option
        Common_Library.ValidateandCheck(#scan_qualityAndFileSizeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionslow)
              
        Dune.Click Id (#scanMenuListlist1 #scan_qualityAndFileSizeSettingsComboBox #scan_qualityAndFileSizeComboBox)
        //clicks on Hightest option
        Common_Library.ValidateandCheck(#scan_qualityAndFileSizeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionshighest)
              
        Dune.Click Id (#scanMenuListlist1 #scan_qualityAndFileSizeSettingsComboBox #scan_qualityAndFileSizeComboBox)
        //clicks on Lowest option
        Common_Library.ValidateandCheck(#scan_qualityAndFileSizeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionslowest)       
    }
    Fail:
    {
        Fail (Unable to select the File Size)
    }
         
    // Closing the option panel and click on Send button
    Sleep (2)
    If: Dune.Wait For (#scanMenuListlist1 #closeButton,2)
    {
        Dune.Click Id (#scanMenuListlist1 #closeButton)
        Sleep (2)
        //clicks on Send button 
        Dune.Click Id (#sendButtonDetailRightBlock)
        //waiting and clicking Done button
        Dune.Wait For (#finish,20)
        Dune.Click Id (#finish)
        Dune.SetOAuth2Standard_EnableTokenAuthFalse (9104,5)
        Dune.Wait For Active Job Gone (scanemail,25)
        Sleep (10)
        Dune.Go To Home Screen
        Sleep (2)
        //clicks on sigin
        Dune.Click (#StatusButtonSignOut)
    }
}
     
Copy_Option_Validation_for_Citrine_and_Jasper
{
    If: Dune.Wait For (#optionsDetailPanelButton,3)
    {
        Dune.Click Id (#optionsDetailPanelButton)  
    }
    Fail:
    {
        Return With Fail (Unable to click opyions buttion copy Application)
    }
        
    //content type option only for Citrine and Jasper in copy plugin
    Sleep (2)
    If: Dune.Wait For (#copySettingsPage_list1 #scan_contentTypeComboBox,3)
    {
        Sleep (1)
        Dune.Click Id (#copySettingsPage_list1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox)
