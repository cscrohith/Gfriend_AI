        Dune.Click Id (#scanMenuListlist1 #scan_colorModeWithAutoDetectSettingsComboBox #scan_colorModeWithAutoDetectComboBox)
        //clicks on color option
        Common_Library.ValidateandCheck(#scan_colorModeWithAutoDetectComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionscolor)
                      
        Dune.Click Id (#scanMenuListlist1 #scan_colorModeWithAutoDetectSettingsComboBox #scan_colorModeWithAutoDetectComboBox)
        //clicks on black and white option
        Common_Library.ValidateandCheck(#scan_colorModeWithAutoDetectComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsblackAndWhite)        
                
        Sleep (1)      
        Dune.Click Id (#scanMenuListlist1 #scan_colorModeWithAutoDetectSettingsComboBox #scan_colorModeWithAutoDetectComboBox)
        //clicks on grayscale only  option
        Common_Library.ValidateandCheck(#scan_colorModeWithAutoDetectComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsgrayscale)
