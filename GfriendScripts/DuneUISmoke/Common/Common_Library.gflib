        Common_Library.ValidateandCheckWithDeltaValue(#SettingsSpiceComboBoxpopupList,#comboBoxScrollBar,#Copy2to1Sided,${DeltaValueCopy})
        
        Dune.Click Id (#copySettingsPage_list1 #copy_sidesMenuComboBox #SettingsSpiceComboBox)
        //clicks on 2 to 1 sided  option
        Common_Library.ValidateandCheckWithDeltaValue(#SettingsSpiceComboBoxpopupList,#comboBoxScrollBar,#Copy1to1Sided,${DeltaValueCopy})
    }
