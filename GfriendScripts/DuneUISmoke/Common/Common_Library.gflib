        Common_Library.ScrollToOriginalSize(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_originalSizeSettingsTextImage)
        //clicks on 16k (195x270 mm
        Common_Library.ValidateandCheck(#scan_originalSizeMenuSelectionList,#scan_originalSizeMenuSelectionListScrollBar,#om_16k_195x270mmscan_originalSize)
        
        Common_Library.ScrollToOriginalSize(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_originalSizeSettingsTextImage)
        //clicks on 16k (184x260 mm)
        Common_Library.ValidateandCheck(#scan_originalSizeMenuSelectionList,#scan_originalSizeMenuSelectionListScrollBar,#om_16k_184x260mmscan_originalSize)
        
        Common_Library.ScrollToOriginalSize(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_originalSizeSettingsTextImage)
        //clicks on 16K (197x273 mm)
        Common_Library.ValidateandCheck(#scan_originalSizeMenuSelectionList,#scan_originalSizeMenuSelectionListScrollBar,#roc_16k_7_dot_75x10_dot_75inscan_originalSize)
        
        Common_Library.ScrollToOriginalSize(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_originalSizeSettingsTextImage)
        //clicks on Double Postcard (JIS) (148X200 mm)
        Common_Library.ValidateandCheck(#scan_originalSizeMenuSelectionList,#scan_originalSizeMenuSelectionListScrollBar,#jpn_oufuku_148x200mmscan_originalSize)
        
        Common_Library.ScrollToOriginalSize(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_originalSizeSettingsTextImage)
        //clicks on Statement (5.5X8.5 in.)
        Common_Library.ValidateandCheck(#scan_originalSizeMenuSelectionList,#scan_originalSizeMenuSelectionListScrollBar,#na_invoice_5_dot_5x8_dot_5inscan_originalSize)
        
        Common_Library.ScrollToOriginalSize(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_originalSizeSettingsTextImage)
        //clicks on 16K (195x270 mm)
        Common_Library.ValidateandCheck(#scan_originalSizeMenuSelectionList,#scan_originalSizeMenuSelectionListScrollBar,#om_16k_195x270mmscan_originalSize)
        
        Common_Library.ScrollToOriginalSize(#copySettingsPage_list1,#copySettingsPage_list1ScrollBar,#scan_originalSizeSettingsTextImage)
