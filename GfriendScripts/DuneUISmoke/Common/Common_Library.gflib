    If: Dune.SwipeVertically (#scanMenuListlist1,#scanMenuListlist1ScrollBar,#scan_contentOrientationSettingsComboBox,0.05)
    { 
        Dune.Click Id (#scanMenuListlist1 #scan_contentOrientationSettingsComboBox #scan_contentOrientationComboBox)
        //clicks on landscape option
        Common_Library.ValidateandCheck(#scan_contentOrientationComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionslandscape)
        
        Dune.SwipeVertically (#scanMenuListlist1,#scanMenuListlist1ScrollBar,#scan_contentOrientationSettingsComboBox,0.05)
        Dune.Click Id (#scanMenuListlist1 #scan_contentOrientationSettingsComboBox #scan_contentOrientationComboBox)
        //clicks on Portrait option
        Common_Library.ValidateandCheck(#scan_contentOrientationComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsportrait)
    }
    Fail:
    {
        Fail (Unable to select the orientation)
    } 
         
    //File Size
    Sleep (2)
    If: Dune.SwipeVertically (#scanMenuListlist1,#scanMenuListlist1ScrollBar,#scan_qualityAndFileSizeSettingsComboBox,0.05)
    {    
        Dune.Click Id (#scanMenuListlist1 #scan_qualityAndFileSizeSettingsComboBox #scan_qualityAndFileSizeComboBox)
        //clicks on High option
        Common_Library.ValidateandCheck(#scan_qualityAndFileSizeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionshigh)
        
        Dune.SwipeVertically (#scanMenuListlist1,#scanMenuListlist1ScrollBar,#scan_qualityAndFileSizeSettingsComboBox,0.05)      
        Dune.Click Id (#scanMenuListlist1 #scan_qualityAndFileSizeSettingsComboBox #scan_qualityAndFileSizeComboBox)
        //clicks on Medium option
        Common_Library.ValidateandCheck(#scan_qualityAndFileSizeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionsmedium)
        
        Dune.SwipeVertically (#scanMenuListlist1,#scanMenuListlist1ScrollBar,#scan_qualityAndFileSizeSettingsComboBox,0.05)      
        Dune.Click Id (#scanMenuListlist1 #scan_qualityAndFileSizeSettingsComboBox #scan_qualityAndFileSizeComboBox)
        //clicks on low option
        Common_Library.ValidateandCheck(#scan_qualityAndFileSizeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionslow)
        
        Dune.SwipeVertically (#scanMenuListlist1,#scanMenuListlist1ScrollBar,#scan_qualityAndFileSizeSettingsComboBox,0.05)      
        Dune.Click Id (#scanMenuListlist1 #scan_qualityAndFileSizeSettingsComboBox #scan_qualityAndFileSizeComboBox)
        //clicks on Hightest option
        Common_Library.ValidateandCheck(#scan_qualityAndFileSizeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionshighest)
        
        Dune.SwipeVertically (#scanMenuListlist1,#scanMenuListlist1ScrollBar,#scan_qualityAndFileSizeSettingsComboBox,0.05)      
        Dune.Click Id (#scanMenuListlist1 #scan_qualityAndFileSizeSettingsComboBox #scan_qualityAndFileSizeComboBox)
        //clicks on Lowest option
        Common_Library.ValidateandCheck(#scan_qualityAndFileSizeComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionslowest)      
    }
    Fail:
    {
        Fail (Unable to select the File Size)
    }
         
    // Closing the option panel and click on Send button
    Sleep (2)
    If: Dune.Wait For (#scanMenuListlist1 #closeButton,2)
    {
        Dune.Click Id (#scanMenuListlist1 #closeButton)
        Sleep (2)
        //clicks on Send button 
        Dune.Click Id (#sendButtonDetailRightBlock)
        //waiting and clicking Done button
        Dune.Wait For (#finish,20)
        Dune.Click Id (#finish)
        Dune.SetOAuth2Standard_EnableTokenAuthFalse (9104,5)
        Dune.Wait For Active Job Gone (scanemail,25)
        Sleep (10)
        Dune.Go To Home Screen
        Sleep (2)
        //clicks on sign out
        Dune.Click (#StatusButtonSignOut)
    }
}


Fax_Option_Validation_For_Camden_and_Busch
{
    //Options checks will starts from here
    If: Dune.Wait For (#faxAllOptionsButton,3)
    {
        Dune.Click Id (#faxAllOptionsButton)
    }
    Fail:
    {
        Return With Fail (unable to click on option button )
        Dune.Go To Home Screen
    }
    
    //Original side
    Sleep (2)
    If: Dune.Wait For (#faxSettingsPageMenuListListViewlist1 #scan_2sidedOriginalSettingsComboBox,5) 
    {
        Dune.Click(#faxSettingsPageMenuListListViewlist1 #scan_2sidedOriginalSettingsComboBox)
        //Clicks on 2 sided option
        Dune.Click Id (#ComboBoxOptionsduplex)
        Sleep (1)
        
        Dune.Click(#faxSettingsPageMenuListListViewlist1 #scan_2sidedOriginalSettingsComboBox)
        //clicks on 1 sided option
        Dune.Click Id (#ComboBoxOptionssimplex)
    }
    Fail:
    {
        Fail (Unable to select the  Original side)
    }
     
    //Original size
    Sleep (2)
    If: Dune.Wait For (#faxSettingsPageMenuListListViewlist1 #scan_originalSizeSettingsComboBox #scan_originalSizeComboBox,5)
    {
         Sleep (1)
         Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #scan_originalSizeSettingsComboBox #scan_originalSizeComboBox)
         Sleep (1)
