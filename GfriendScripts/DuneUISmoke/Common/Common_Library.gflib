        Common_Library.ValidateandCheck(#scan_colorModeWithAutoDetectComboBoxpopupList,#comboBoxScrollBar,#ComboBoxOptionstreatNonColorAsBlackAndWhite1)
                      
        Dune.Click Id (#scanMenuListlist1 #scan_colorModeWithAutoDetectSettingsComboBox #scan_colorModeWithAutoDetectComboBox)
