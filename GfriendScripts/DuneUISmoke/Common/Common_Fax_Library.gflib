Fax_Teardown
{ 
    Dune.Click (#BackButton)
    Dune.Click (#closeButton)
    Dune.Click (#ButtonControl)
    Dune.Click (#StatusButtonResetSettings)
    While: Dune.Wait For (#infoTextToastMessage,5)
    {
        Common_Library.SleepTime
    } 
}

Fax_OriginalSide_Teardown
{ 
    Dune.Click Id (#faxSettingsPageMenuListListView #BackButton)
    Common_Library.SleepTime 
    Dune.Click (#closeButton)
    Common_Library.SleepTime 
    Dune.Click (#ButtonControl)
    Common_Library.SleepTime 
    Dune.Click (#StatusButtonResetSettings)
    While: Dune.Wait For (#infoTextToastMessage,5)
    {
        Common_Library.SleepTime
    } 
}

Fax_Notification_Teardown
{ 
    //Clicks on Done button
    Dune.Click Id (#doneButton)
    Dune.Click (#closeButton)
    Dune.Click (#ButtonControl)
    Dune.Click (#StatusButtonResetSettings)
    While: Dune.Wait For (#infoTextToastMessage,5)
    {
        Common_Library.SleepTime
    } 
}