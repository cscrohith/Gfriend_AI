Fax_Notification_NotifyAfterJobFinishes
{   
    Common_Fax_Library.NotifyAfterJobFinishesNotifymethod_Email
    Common_Fax_Library.Fax_Notification
    Common_Fax_Library.NotifyAfterJobFinishes_Notifymethod_Print
} 

NotifyAfterJobFinishes_NotifymethodEmail
{
    Dune.Click Id (#notifyAfterJobFinishesRBViewModel)
    Sleep (1)
    Dune.Click Id (#notificationMethodComboBoxViewModel #SettingsSpiceComboBox)
    Dune.Click Id (#emailComboBoxModelImageContainer)
    Sleep (1)
    Dune.Click Id (#emailAddressTextFieldControlModel)
    Sleep (1)
    Dune.Set Text (#emailAddressTextFieldControlModel,${ToAddress})
    Sleep (1)
    //Clicks on Thumbnail
    Dune.Click Id (#includeThumbnailCheckBoxViewModelImageContainer)
    Sleep (1)
    Dune.Click Id (#sendJobNotificationDoneButton)
    Sleep (1)
    Dune.Get Text (#sendJobNotification_firstinfoBlockRow #secondInfoBlockModelChevronRight #contentItem,${Email})
    If: builtin.Equals (${Email},Email on completion)
    {
        Pass(Email notification is set successfully)
    }
    Fail:
    {
        Fail (Email on completion is not selected)
    }
}

