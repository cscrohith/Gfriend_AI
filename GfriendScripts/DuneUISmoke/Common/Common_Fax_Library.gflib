Fax_Notification_DoNotNotify
{
    // Clicks on Do not Notify
    Dune.Click Id (#never)
    Sleep (1)
    //Clicks on Done button
    Dune.Click Id (#sendJobNotificationDoneButton)
} 

Fax_ExecuteManager()
{
    // Closing the option panel and click on Send button
    Sleep (2)
    If: Dune.Wait For (#faxSettingsPageMenuListListViewlist1 #closeButton,2)
    {
        Dune.Click Id (#faxSettingsPageMenuListListViewlist1 #closeButton)
        Sleep (2)
    }
    //clicks on Send button 
    Dune.Click Id (#sendFaxButtonFooterMain)
    //waiting and clicking Done button
    Dune.Wait For (#finish,20)
    Dune.Click Id (#finish)
    Dune.SetOAuth2Standard_EnableTokenAuthFalse (9104,5)
    Dune.Wait For Active Job Gone (scanFax,70)
    Sleep (5)
    Dune.Go To Home Screen
    Sleep (2)
    //clicks on Sign out 
    Dune.Click (#SignInButton)
    Dune.Click Id(#userInfoSignInButton)
    Dune.Reset User Setting 
}
Setup
{
    If:Dune.Navigate To Application On Home Screen (#44aa632b-cfa3-4c10-8cab-697a9bef610b)
    {
        Dune.Click (#44aa632b-cfa3-4c10-8cab-697a9bef610b)
    }
    Fail:
    {
        Return With Fail (Fax app button was not found on device home screen.)
        Stop Test Suite
    }
    Common_Fax_Library.Fax_OpenOption()
}
