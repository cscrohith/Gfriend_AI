Copy_ContentType
{
    If: Dune.Wait For (#copySettingsPage_list1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox,3)
    {
        Dune.Click Id And Wait For Transition (#copySettingsPage_list1 #scan_contentTypeSettingsComboBox #scan_contentTypeComboBox, ${ScreenRenderDelay})
    }
    Fail:
    {
        Fail (Unable to select the Content type)
    } 
}

