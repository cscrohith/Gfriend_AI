Copy_Number_Of_Copies
{  
    If: Dune.Swipe Vertically And Wait For Transition (#copySettingsPage_list1, #copySettingsPage_list1ScrollBar, #copy_numberOfCopiesSettingsSpinBox, ${DefaultDeltaValue}, ${ScreenRenderDelay})
    {
        Dune.Click Id (#copySettingsPage_list1 #SpinBoxTextInput)
        Dune.Wait For (#enterKeyPositiveIntegerKeypad,3)
        Dune.Click Id (#key2PositiveIntegerKeypad)
        Dune.Click Id (#enterKeyPositiveIntegerKeypad)
    }
    Fail:
    {
        Fail (Unable to scroll to copies)
    }
}

Copy_Collate
{
    If: Dune.Swipe Vertically And Wait For Transition (#copySettingsPage_list1, #copySettingsPage_list1ScrollBar, #copy_collateToggleSettingsSwitch, ${DefaultDeltaValue}, ${ScreenRenderDelay})
    {
        Repeat:2
        {
            Dune.Click Id (#copy_collateToggleMenuSwitch)
        }
    }
    Fail:
    {
        Fail (Unable to find the collate option)
    }
}

