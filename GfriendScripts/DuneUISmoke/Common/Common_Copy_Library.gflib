{
    //clicks on Photo option
    Common_Library.SwipeAndClick (#scan_contentTypeComboBoxpopupList, #comboBoxScrollBar, #ComboBoxOptionsphoto,${DefaultDeltaValue},${ScreenRenderDelay})    
}

