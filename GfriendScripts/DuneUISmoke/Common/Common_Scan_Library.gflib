Scan_ExecuteManager(${AppType})
{
    // Closing the option panel and click on Send button
    If: Dune.Wait For (#scanMenuListlist1 #closeButton,2)
    {
        Common_Library.ClickIdWithDefaultDelay (#scanMenuListlist1 #closeButton)
        Common_Library.SleepTimeWithCustomDelay (2)
    }
    //clicks on Send button
    Common_Library.ClickIdWithDefaultDelay (#sendButtonDetailRightBlock)
    Common_Library.SleepTime
    //waiting and clicking Done button
    Dune.Wait For (#finish,20)
    Common_Library.ClickIdWithDefaultDelay (#finish)
    Common_Library.SleepTime
    Dune.SetOAuth2Standard_EnableTokenAuthFalse (9104,20)
    Dune.Wait For Active Job Gone (${AppType},25)
    Common_Library.SleepTimeWithCustomDelay (10)
    Dune.Go To Home Screen
    Common_Library.SleepTimeWithCustomDelay (2)
    //clicks on Sign out
    Dune.Click (#SignInButton)
    Dune.Click Id(#userInfoSignInButton)
}

Scan_Options_Teardown
{
    Dune.Click And Wait For Transition (#closeButton,${ScreenRenderDelay})
    Dune.Click And Wait For Transition (#BackButton,${ScreenRenderDelay})
    Dune.Click And Wait For Transition (#HomeButton,${ScreenRenderDelay})
    Dune.Click And Wait For Transition (#StatusButtonResetSettings,${ScreenRenderDelay})
    While: Dune.Wait For (#infoTextToastMessage,5)
    {
        Common_Library.SleepTime
    }
}

Scan_Teardown
{
    Dune.Click And Wait For Transition (#HomeButton,${ScreenRenderDelay})
    Dune.Click And Wait For Transition (#StatusButtonResetSettings,${ScreenRenderDelay})
    While: Dune.Wait For (#infoTextToastMessage,5)
    {
        Common_Library.SleepTime
    }
}

Scan_Options_ScanMode_Teardown
{
    //ScanMode
    If:Dune.Wait For (#GenericStructureView #BackButton,1)
    {
        Dune.Click Id (#GenericStructureView #BackButton)
    }
    Common_Scan_Library.Scan_Options_Teardown
}

Scan_Options_OriginalSide_Teardown
{
   //OriginalSide
   If:Dune.Wait For(#ScanSettingsOriginalSidesView #BackButton,1)
