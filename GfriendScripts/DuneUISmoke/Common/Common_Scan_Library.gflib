Scan_Sharpness
{
    //Sharpness
    If: Dune.SwipeVerticallyAndWaitForTransition (#scanMenuListlist1, #scanMenuListlist1ScrollBar, #scan_sharpnessSettingsSlider,${DefaultDeltaValue},${ScreenRenderDelay} )
    {
        //sets the slider to 5 value
        Dune.SetSliderValueAndWaitForTransition (#scan_sharpnessMenuSlider,5,${ScreenRenderDelay})
    }
    Fail:
    {
        Fail (Unable to set the Sharpness)
    }
}

