Scan_EraseEdges_FrontSide
{
    //Front Side
    Dune.SwipeVerticallyAndWaitForTransition (#scanMenuListverticalLayout, #ScanSettingsEraseEdgesViewScrollBar, #topEdgeSpinBoxControlModel,${DefaultDeltaValue},${ScreenRenderDelay} )

    Common_Library.ClickIdWithDefaultDelay (#scanMenuListverticalLayout #topEdgeSpinBoxControlModel #SpinBoxTextInput)

    Dune.Wait For (#backspaceKeyPositiveIntegerKeypad,2)
    Common_Library.ClickIdWithDefaultDelay (#key1PositiveIntegerKeypad)

    Common_Library.ClickIdWithDefaultDelay (#enterKeyPositiveIntegerKeypad)

    Common_Library.ClickIdWithDefaultDelay (#scanMenuListverticalLayout #bottomEdgeSpinBoxControlModel #SpinBoxTextInput)

    Dune.Wait For (#backspaceKeyPositiveIntegerKeypad,2)
    Common_Library.ClickIdWithDefaultDelay (#key2PositiveIntegerKeypad)

    Common_Library.ClickIdWithDefaultDelay (#enterKeyPositiveIntegerKeypad)

    Common_Library.ClickIdWithDefaultDelay (#scanMenuListverticalLayout #leftEdgeSpinBoxControlModel #SpinBoxTextInput)

    Dune.Wait For (#backspaceKeyPositiveIntegerKeypad,2)
    Common_Library.ClickIdWithDefaultDelay (#key3PositiveIntegerKeypad)

    Common_Library.ClickIdWithDefaultDelay (#enterKeyPositiveIntegerKeypad)

    Repeat:2
    {
        Dune.Swipe By ControlId (#ScanSettingsEraseEdgesViewScrollBar,^)
    }
    Common_Library.ClickIdWithDefaultDelay (#scanMenuListverticalLayout #rightEdgeSpinBoxControlModel #SpinBoxTextInput)

    Dune.Wait For (#backspaceKeyPositiveIntegerKeypad,2)
    Common_Library.ClickIdWithDefaultDelay (#key4PositiveIntegerKeypad)

    Common_Library.ClickIdWithDefaultDelay (#enterKeyPositiveIntegerKeypad)
}

Scan_EraseEdges_BackSide
{
    //Back Side
    Dune.SwipeVerticallyAndWaitForTransition (#ScanSettingsEraseEdgesView, #ScanSettingsEraseEdgesViewScrollBar, #eraseBackRightEdgeSpinBox,0.035, ${ScreenRenderDelay} )

    Common_Library.ClickIdWithDefaultDelay (#scanMenuListverticalLayout #eraseBackTopEdgeSpinBoxControlModel #SpinBoxTextInput)

    Dune.Wait For (#backspaceKeyPositiveIntegerKeypad,2)
    Common_Library.ClickIdWithDefaultDelay (#key1PositiveIntegerKeypad)

    Common_Library.ClickIdWithDefaultDelay (#enterKeyPositiveIntegerKeypad)

    Dune.SwipeVerticallyAndWaitForTransition (#ScanSettingsEraseEdgesView, #ScanSettingsEraseEdgesViewScrollBar, #eraseBackRightEdgeSpinBox,${DefaultDeltaValue},${ScreenRenderDelay} )

    Common_Library.ClickIdWithDefaultDelay (#scanMenuListverticalLayout #eraseBackBottomEdgeSpinBoxControlModel #SpinBoxTextInput)

    Dune.Wait For (#backspaceKeyPositiveIntegerKeypad,2)
    Common_Library.ClickIdWithDefaultDelay (#key2PositiveIntegerKeypad)

    Common_Library.ClickIdWithDefaultDelay (#enterKeyPositiveIntegerKeypad)

    Dune.SwipeVerticallyAndWaitForTransition (#ScanSettingsEraseEdgesView, #ScanSettingsEraseEdgesViewScrollBar, #eraseBackRightEdgeSpinBox,0.035, ${ScreenRenderDelay} )

    Common_Library.ClickIdWithDefaultDelay (#scanMenuListverticalLayout #eraseBackLeftEdgeSpinBoxControlModel #SpinBoxTextInput)

    Dune.Wait For (#backspaceKeyPositiveIntegerKeypad,2)
    Common_Library.ClickIdWithDefaultDelay (#key3PositiveIntegerKeypad)

    Common_Library.ClickIdWithDefaultDelay (#enterKeyPositiveIntegerKeypad)

    Repeat:2
    {
        Dune.Swipe By ControlId (#ScanSettingsEraseEdgesViewScrollBar,^)
    }

    Common_Library.ClickIdWithDefaultDelay (#scanMenuListverticalLayout #eraseBackRightEdgeSpinBoxControlModel #SpinBoxTextInput)

    Dune.Wait For (#backspaceKeyPositiveIntegerKeypad,2)
    Common_Library.ClickIdWithDefaultDelay (#key3PositiveIntegerKeypad)

    Common_Library.ClickIdWithDefaultDelay (#enterKeyPositiveIntegerKeypad)

    //Clicks on Done button
    Common_Library.ClickIdWithDefaultDelay (#eraseEdgeDoneButton)
}

