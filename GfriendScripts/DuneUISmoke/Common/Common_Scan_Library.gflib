Scan_EraseEdges
{
    //Erase Edges
    If: Dune.SwipeVerticallyAndWaitForTransition (#scanMenuListlist1, #scanMenuListlist1ScrollBar, #ScanSettingsEraseEdges,${DefaultDeltaValue},${ScreenRenderDelay} )
    {
        Common_Library.ClickIdWithDefaultDelay (#ScanSettingsEraseEdges_2infoBlockRow)

        //clear setting
        Common_Library.ClickIdWithDefaultDelay (#scanMenuList #ScanSettingsEraseEdgesView #clearButton)

        Sleep (2)
        //Unit of Measurement as Inches
        Common_Library.ClickIdWithDefaultDelay (#cUnitofMillimeteritemContainerTextImage #contentItem)

        Dune.Wait For (#comboListInchesImageContainer,1)
        Dune.Click (#comboListInchesImageContainer)
    }
    Fail:
    {
        Fail (Unable to select the Erase Edges)
    }
}

Scan_EraseEdges_Millimeters
{
    //Millimeters
    Common_Library.ClickIdWithDefaultDelay (#cUnitOfMeasureInchesitemContainerTextImage #contentItem)

    Dune.Wait For (#comboListMillimeterImageContainer,1)
    Dune.Click (#comboListMillimeterImageContainer)
}

