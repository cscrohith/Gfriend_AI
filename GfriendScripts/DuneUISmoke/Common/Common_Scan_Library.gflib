Navigate_ScanToEmail_App
{
    //Navigate to Scan Folder
    If:Dune.Navigate To Application On Home Screen (${ScanFolderID})
    {
        Common_Library.SleepTime
        //clicks on Scan Folder
        Dune.Click And Wait For Transition (${ScanFolderID},${ScreenRenderDelay})
        //wait and clicks on Scan to Email app
        Dune.Wait For (#b8460c9e-43c8-4290-a0f8-8ce450867f09,5)
        Dune.Click And Wait For Transition  (#b8460c9e-43c8-4290-a0f8-8ce450867f09,${ScreenRenderDelay})
    }
    Fail:
    {
        Return With Fail (Scan To Email app button was not found on device home screen.)
        Stop Test Suite
     }
    Common_Library.SleepTime
}

Navigate_ScanToFolder_App
{
    //Navigate to Scan Folder
    If:Dune.Navigate To Application On Home Screen (${ScanFolderID})
    {
        Common_Library.SleepTime
        //clicks on Scan Folder
        Dune.Click And Wait For Transition (${ScanFolderID},${ScreenRenderDelay})
        //wait and clicks on Scan to NetworkFolder app
        Dune.Wait For (#65acca51-619d-4e29-b1d0-6414e52f908b,5)
