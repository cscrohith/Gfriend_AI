ScanToEmail_EnterDestinationEmailAddress
{
    //entering To address, From address
    If: Dune.Wait For (#emailToFieldDestination #toEditor #emailTextFieldContainer,10)
    {
        //clicks on To address text field
        Common_Library.ClickIdWithDefaultDelay(#emailToFieldDestination #toEditor #emailTextFieldContainer)
        //types the Email address

        Dune.GenericKeyPadClick (${ToAddress})
        Common_Library.SleepTime
        //waits and clicks on save file name
        Dune.Wait For (#fileNameTextField,2)
        Common_Library.ClickIdWithDefaultDelay (#fileNameTextField)
        //gives the randow file name as number
        Get Random Number (01,1000,${FileName})
        Common_Library.SleepTime
        Dune.Set Text (#fileNameTextField,${FileName})
        Common_Library.SleepTime
        If: Dune.Wait For (#enterKey1,1)
        {
            Common_Library.ClickIdWithDefaultDelay (#enterKey1)
        }
    }
    Fail:
    {
        Return With Fail (Unable to update to Address)
    }
}

ScanToFolder_FileName
{
    //entering Filename
    If: Dune.Wait For (#folderLandingView #DetailPanelverticalLayout #scanFileNameFieldDestination,10)
    {
        Common_Library.ClickIdWithDefaultDelay(${STNQuickSetName})
        Dune.Wait For (#fileNameTextField,10)
        Common_Library.ClickIdWithDefaultDelay(#fileNameTextField)
        Get Random Number (01,1000,${FileName})
        Common_Library.SleepTime
        Dune.Set Text (#fileNameTextField,${FileName})
        Common_Library.SleepTime
        If: Dune.Wait For (#enterKey1,2)
        {
            Common_Library.ClickIdWithDefaultDelay(#enterKey1)
        }
    }
    Fail:
    {
        Return With Fail (Unable to update File name)
    }
}

