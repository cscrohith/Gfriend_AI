        Web.Get Text(//*[@id="chart-id-141"]/div,${ex})
        ReAssign Value To Variable(${DepartmentPrintReportName},${ex})
        Functional_OXPD.WaitAndClick(//*[@id="slice_141-menu"]/li[4]/div,Click Downloads)
        Sleep (2)
        //Wait for the Excel to Download
        Get Time Stamp (${DP_DownlaodedReportName},yyyyMMdd)
        Functional_OXPD.WaitAndClick(//*[@id="slice_141-menu-download-popup"]/li[2],Export To Excel)
        If: Web.Wait Until File Download Complete(${DownLoadFolderPath},${DP_DownlaodedReportName},60)
        {
            Pass (Excel downloaded successfully)
            Sleep (2)
        }
        Fail:
        { 
            Web.Close
            Fail (Failed to download the excel)
            Stop Test Case
        }
        Web.Close
        Sleep (1)
       
        ///<Description>For Excel verification</Description>
        Windows.Open Folder By Path (${DownLoadFolderPath})
        Windows.Send Special Key ([HOME])
        Windows.Send Special Key ([DOWN])
        Windows.Send Special Key ([HOME])
        Sleep (1)
        Get Time Stamp (${DP_CurrentTime},ddMMhhmmss)
        ReAssign Value To Variable(${DP_FileName},${DP_CurrentTime})
        Sleep (1)
        Concatenate Variable Values And Store Result (${DepartmentPrintReportName},${DP_FileName},${DP_ExcelName})
        Windows.Send Special Key ([F2])
        Sleep (1)
        Windows.Send Key (${DP_ExcelName})
        Sleep (1)
        Windows.Send Special Key ([ENTER])
        Sleep (1)
        Concatenate Variable Values And Store Result (${DownLoadFolderPath},${DP_ExcelName},${DP_PathAndFileNamePrefix})
        Concatenate Variable Values And Store Result (${DP_PathAndFileNamePrefix},.xlsx,${DP_StoreCompleteFilePath})
        //Read value from excel sheet
        Sleep (1)
        SpreadSheet.SetExcelPath(${DP_StoreCompleteFilePath})
        SpreadSheet.Set Worksheet(Sheet1)
        SpreadSheet.Read Cell Value By Index(2,2,${DP_DataFromExcel})
        If:Equals (${TotalUserPrintReports},${DP_DataFromExcel})
        {
            Pass (No issues are observed downloaded reports datamatches what is displayed on the webpage)
        } 
        Fail:
        {
            Windows.Send Special Key (^w)
            Fail (Downloaded reports does not matches with what is displayed on the webpage)
            Stop Test Case
        }
        Windows.Send Special Key (^w)
    }
    Fail:
    { 
        Fail (Failed opening the browser!)
        Stop Test Case
    }
}

T1984767206_DepartmentScanReport(${website-url},${Username},${Password},${DownLoadFolderPath},${DepartmentUserFileNamePrefixToRename})
{
    If: Web.Open with Chrome (${website-url},30)
    {
        //continue
        Sleep (10)
        OXPD_Common_Library.Portal_Login(${website-url},${Username},${Password})
        Sleep(1)
        //Report Menu
        Functional_OXPD.WaitAndClick(/html/body/div[1]/div[3]/div[2]/div/div[6]/a/div[2],Report Menu)
        Sleep (5)
        //User Menu
        Functional_OXPD.WaitAndClick(/html/body/div[1]/div[3]/div[2]/div/div[8],User Menu)
        Sleep (5)
        //Department Tab
        Functional_OXPD.WaitAndClick(/html/body/div[1]/div[4]/div/div[2]/div[2]/div[3]/div/div[1]/ul/li[2],Department Tab)
        Sleep (5)
        //Department Tab
        Functional_OXPD.WaitAndClick(/html/body/div[1]/div[4]/div/div[2]/div[2]/div[3]/div/div[2]/div[1]/div[1]/div/ul/li[2],Department Scan)
        Sleep (5)
