        Concatenate Variable Values And Store Result (${DeviceScanReportName},${ScanNewFileName},${ScanExcelName})
        Windows.Send Special Key ([F2])
        Sleep (1)
        Windows.Send Key (${ScanExcelName})
        Sleep (1)
        Windows.Send Special Key ([ENTER])
        Sleep (1)
        Concatenate Variable Values And Store Result (${DownLoadFolderPath},${ScanExcelName},${DS_ScanPathAndFileNamePrefix})
