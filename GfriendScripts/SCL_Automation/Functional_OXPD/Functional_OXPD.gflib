        Functional_OXPD.WaitAndClick(//*[@id="slice_147-controls"]/div,Click 3 dots)
        Sleep (2)
        Web.Get Text(//*[@id="chart-id-147"]/div,${ex})
        ReAssign Value To Variable(${DepartmentUserReportName},${ex})
        Functional_OXPD.WaitAndClick(//*[@id="slice_147-menu"]/li[4]/div,Click Downloads)
        Sleep (2)
        //Wait for the Excel to Download
        Get Time Stamp (${DU_DownlaodedReportName},yyyyMMdd)
        Functional_OXPD.WaitAndClick(//*[@id="slice_147-menu-download-popup"]/li[2],Export To Excel)
        If: Web.Wait Until File Download Complete(${DownLoadFolderPath},${DU_DownlaodedReportName},60)
        {
            Pass (Excel downloaded successfully)
            Sleep (2)
        }
        Fail:
        { 
            Web.Close
            Fail (Failed to download the excel)
            Stop Test Case
        }
        Web.Close
        Sleep (1)
       
        ///<Description>For Excel verification</Description>
        Windows.Open Folder By Path (${DownLoadFolderPath})
        Windows.Send Special Key ([HOME])
        Windows.Send Special Key ([DOWN])
        Windows.Send Special Key ([HOME])
        Sleep (1)
        Get Time Stamp (${DU_CurrentTime},ddMMhhmmss)
        ReAssign Value To Variable(${DU_FileName},${DU_CurrentTime})
        Sleep (1)
        Concatenate Variable Values And Store Result (${DepartmentUserReportName},${DU_FileName},${DU_ExcelName})
        Windows.Send Special Key ([F2])
        Sleep (1)
        Windows.Send Key (${DU_ExcelName})
        Sleep (1)
        Windows.Send Special Key ([ENTER])
        Sleep (1)
        Concatenate Variable Values And Store Result (${DownLoadFolderPath},${DU_ExcelName},${DU_PathAndFileNamePrefix})
        Concatenate Variable Values And Store Result (${DU_PathAndFileNamePrefix},.xlsx,${DU_StoreCompleteFilePath})
        //Read value from excel sheet
        Sleep (1)
        SpreadSheet.SetExcelPath(${DU_StoreCompleteFilePath})
        SpreadSheet.Set Worksheet(Sheet1)
        SpreadSheet.Read Cell Value By Index(2,2,${DU_DataFromExcel})
        If:Equals (${TotalUserPrintReports},${DU_DataFromExcel})
        {
            Pass (No issues are observed downloaded reports datamatches what is displayed on the webpage)
        } 
        Fail:
        {
            Windows.Send Special Key (^w)
            Fail (Downloaded reports does not matches with what is displayed on the webpage)
            Stop Test Case
        }
        Windows.Send Special Key (^w)
    }
    Fail:
    { 
        Fail (Failed opening the browser!)
        Stop Test Case
    }
}


T1984767206_PullPrintForColourAndMonoDevice(${IsColorMFP})
{
    JediOmni.Touch ID (hpid-2b0d0eba-3cf8-4830-833a-b024645b07fb-homescreen-button)
    Sleep (10)
    Oxpd.Get Browser Engine
    //waits and clicks on refresh button 3 times
    Functional_OXPD.DeviceWaitAndClick(//*[@id="refresh_form"]/input[3],refresh button)
    //Click Settings ID
    Functional_OXPD.DeviceWaitAndClick(,Click Settings)
    //Check the device is Colour or Mono
    If: Equals IgnoreCase (${IsColorMFP},Y)
    {
       //Click Colour
       Functional_OXPD.DeviceWaitAndClick(,Click Color)
       //Click Copies Plus button
       Repeat:10
       {
            Functional_OXPD.DeviceWaitAndClick(,Click Copies Plus Button)
       }
      //Click Print Button
       Functional_OXPD.DeviceWaitAndClick(,Click Print Button)
    }
    Repeat:10
    {
        //Click Black and White Or Mono Print
        Functional_OXPD.DeviceWaitAndClick(,Click Copies Plus Button)
    }
    //Click Print Button
     Functional_OXPD.DeviceWaitAndClick(,Click Print Button)
     Oxpd.Return Browser Engine
}

T1984767206_ScanForColourAndMonoDevice(${IsColorMFP})
{
    JediOmni.Touch ID (hpid-2b0d0eba-3cf8-4830-833a-b024645b07fb-homescreen-button)
    Sleep (5)
    Oxpd.Get Browser Engine
    //Check the device is Colour or Mono
    If: Equals IgnoreCase (${IsColorMFP},Y)
    {
       //Click Colour
       Functional_OXPD.DeviceWaitAndClick(,Click Color)
    }
    Fail:
    {
       //Click Black and White Or Mono Print
       Functional_OXPD.DeviceWaitAndClick(,Click Color)
    }
    //Click Scan
     Repeat:10
     {
         Functional_OXPD.DeviceWaitAndClick(,Click Scan)
     }
    Oxpd.Return Browser Engine
}

 DeviceWaitAndClick(${Id},${Name})
{
    If: Oxpd.Wait For Xpath  (${Id},120)
    {
        Oxpd.Touch Xpath(${Id})
    }
    Fail:
    {
         Fail (${Name} filed is not available).
         Stop Test Case
    }
}

WaitAndClickTextbox(${Id},${Value},${Name})
{
    If: Web.Wait For Object (${Id},120)
    {
        Web.Set Text (${Id},${Value})
    }
    Fail:
    {
         Fail (${Name} filed is not available).
         Stop Test Case
    }
}

WaitAndClick(${Id},${Name})
{
    If: Web.Wait For Object (${Id},120)
    {
        Web.Click Object (${Id})
    }
    Fail:
    {
         Fail (${Name} filed is not available).
         Stop Test Case
    }
}

Validate_and_generate_the_SafeQ_report_after_Print(${Before_Print})
{
    Web.Get Text (//div[@data-test-chart-name='Print Pages']//div[contains(@class\,'big_number_total')],${After_Print})
    BuiltIn.Equals (${Before_Print},${After_Print})
    If: BuiltIn.Has Value Increased (${Before_Print},${After_Print})
    {
        Pass (Print Jobs are increased successfully)
    }
    Fail:
    {
        Fail (Print Jobs are not increasing)
    }
    Web.Close
}

Validate_and_generate_the_SafeQ_report_Before_Print()
{   
    Web.Get Text (//div[@data-test-chart-name='Print Pages']//div[contains(@class\,'big_number_total')],${Before_Print}) 
    Web.Close
}

