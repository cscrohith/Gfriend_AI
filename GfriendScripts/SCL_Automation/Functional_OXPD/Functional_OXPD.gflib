///////////////////////////////////////////////////////////////////////////////////////////////////////
// Routine:         Send_Small_PDF_For_Print
//        
// Description:     Send a PDF document kept in path {Working Directory}\print-documents\pdf-doc\testfile.pdf
//
// Arguments:       None
//
// Pre-requisites:  1. The test file should be placed in correct directory path: {Working Directory}\print-documents\pdf-doc\.
//                  2. User should update the value of variable '${pdf-document-file}' in file Common_Workflow_Variable.gfvar
//                  2. The test file should be named testfile.pdf
//                  3. Adobe acrobat reader should be installed on test computer.
///////////////////////////////////////////////////////////////////////////////////////////////////////
Send_Small_Pdf_For_Print
{
    If:Windows.Print File To Print Queue (${pdf-document-file},${print-queue-name})
    {
        // GFriend execution is too fast.
        Sleep(${extra-long-wait})
        // Close Adobe application
        Windows.Send Special Key (${alt-f4})
    }
    Fail:
    {
        Fail (Failed to open the PDF file or send it to the print queue. File path: ${pdf-document-file}, print queue: ${print-queue-name})
    }
    Error:
    {
        Error (Error while opening PDF file or sending it to the print queue. File path: ${pdf-document-file}, print queue: ${print-queue-name})
    }
}

///////////////////////////////////////////////////////////////////////////////////////////////////////
// Routine:         Send_Small_Image_For_Print
//        
// Description:     Send an image document kept in path {Working Directory}\print-documents\image-doc\testfile.jpg
//
// Arguments:       None
//
// Pre-requisites:  1. The test file should be placed in correct directory path: {Working Directory}\print-documents\image-doc\
//                  2. The test file should be named testfile.jpg
//                  3. User should update the value of variable '${image-document-file}' in file Common_Workflow_Variable.gfvar
///////////////////////////////////////////////////////////////////////////////////////////////////////
Send_Small_Image_File_For_Print
{
    // Due to limitation in GFriend keywords, path for image file is hardcoded. User needs to update these paths to use the // correct file for printing. 
    If:Windows.Print PDF or Image With Application (${mspaint-executable-path},${image-document-file},${print-queue-name})
    {
        // Windows opens 'Can't complete operation' notification box. Close it to proceed.
        If:Windows.Is Exist(${cannot-complete-operation-OK-button})
        {
            Windows.Click ID (${cannot-complete-operation-OK-button})
            Sleep(${short-wait})
        }
        
        // Click the 'Print' button.
        //If:Windows.Is Exist(${print-image-button})
        //{
        //    Windows.Click ID (${print-image-button})
        //        Sleep(${short-wait})
        //}
        //Fail:
        //{
        //    Fail (Failed to click Print button on 'Printing from Win32 application' Print page. Please check if MS-Paint is availble in the path: ${mspaint-executable-path} and test image is available in path ${image-document-file} )
        //}
        //Error:
        //{
        //    Error (Error while clicking Print button on 'Printing from Win32 application' Print page. Please check if MS-Paint is availble in the path: ${mspaint-executable-path} and test image is available in path ${image-document-file})
        //}
    }
    Fail:
    {
        Fail (Failed to click Print button on 'Printing from Win32 application' Print page. Please check if MS-Paint is availble in the path: ${mspaint-executable-path} and test image is available in path ${image-document-file} )
    }
    Error:
    {
        Error (Error while clicking Print button on 'Printing from Win32 application' Print page. Please check if MS-Paint is availble in the path: ${mspaint-executable-path} and test image is available in path ${image-document-file})
    }
}

///////////////////////////////////////////////////////////////////////////////////////////////////////
// Routine:         Send_Small_Notepad_Document_For_Print
//        
// Description:     Send a notepad document kept in path {Working Directory}\print-documents\text-doc\testfile.txt
//
// Arguments:       None
//
// Pre-requisites:  1. The test file should be placed in correct directory path: {Working Directory}\print-documents\text-doc\
//                  2. The test file should be named testfile.txt
//                  3. The default application for .text files should be notepad.
///////////////////////////////////////////////////////////////////////////////////////////////////////
Send_Small_Notepad_File_For_Print
{
    If: Windows.Print File To Print Queue(${text-document-file},${print-queue-name})
    {
        // Give some time to actually open the file and send it.
        Sleep(${medium-wait})
        Pass (Print job is sent) 
    } 
    Fail:
    {
        Fail (Failed to send print job. File path: ${text-document-file} and print queue:c${print-queue-name})
    }
    Error:
    {
        Error (Error to send print job. File path: ${text-document-file} and print queue:c${print-queue-name})
    }
}


// ************************************************************************************************************
// *     Common Test case for operating printer.                                                              *              
// ************************************************************************************************************

Oxpd_Get_Browser_Engine
{
    If:Oxpd.Get Browser Engine
    {
        Return With Pass (Getting OXPD browser successful)
    }
    Error:
    {
        Return With Pass (Getting OXPD browser shouldn't be cause of error)
    }
}

Reset_Printer
{
    // During first iteration, the device is in sleep mode.
    // It takes more time to wake and calliberate.
    
    If:JediOmni.Wait For Text (${signout-text},${short-wait})
    {
        JediOmni.Touch ID(${jediomni-sign-out-button})
        JediOmni.Wait For Enable of Object (${jediomni-sign-in-button},${medium-wait})
    }
    
    JediOmni.Reset
    Sleep(${long-wait})
}

Enable_Paperless_Mode
{
    JediOmni.Enable Paperless Mode
}

Open_User_SignIn_Screen
{
   If:JediOmni.Wait For Enable of Object (${jediomni-sign-in-button},${medium-wait})
   {
       JediOmni.Touch ID (${jediomni-sign-in-button})
   }
   Fail:
   {
       Fail(Failed to find sign-in button on the screen.)
   }
   Error:
   {
       Error(Error while finding sign-in button on the screen.)
   }
}

