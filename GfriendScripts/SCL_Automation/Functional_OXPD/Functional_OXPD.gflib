 T1984767217_Validate_Pull_Print_Single_Function_Swipe_to_Print_All_Pull_Print_with_Paper_Out_and_Direct_IP_Print_Step_1_to_3
{
    Web.Click Object (//a[@data-test-id='menuItemLink' and .//div[@data-test-id='label' and normalize-space()='Printers']])
    Web.Wait For Object (//a[@data-test-id='link.embedded_templates'],20)
    Web.Click Object (//a[@data-test-id='link.embedded_templates'])
    Sleep (5)
    Web.Wait For Object (//tr[.//td[normalize-space()='OXPD']]//span[@data-title='Edit']//a,5)
    Web.Click Object (//tr[.//td[normalize-space()='OXPD']]//span[@data-title='Edit']//a)
    Web.ScrollDownToParicularObject (//*[@id="id1be"]/div[1])
    
    //verifys checkbox is checked or not
    If: Web.IsChecked (//*[@id="id1be"]/div[2]/label)
    {
        Pass (Print all job on card login is Enabled)
    }
    Fail:
    {
        Web.Wait For Object (//input[@data-test-id='configData.autoRelease'],5)
        Web.Click Object (//input[@data-test-id='configData.autoRelease'])
    }
    Web.ScrollDownToParicularObject (//input[@data-test-id='saveBtn'])
    Web.Wait For Object (//input[@data-test-id='saveBtn'],5)
    Web.Click Object (//input[@data-test-id='saveBtn'])
    Web.Wait For Object (//tr[td[normalize-space(text())='OXPD']]//span[@data-title='Deployment actions']//a,10)
    Web.Click Object (//tr[td[normalize-space(text())='OXPD']]//span[@data-title='Deployment actions']//a)
    Web.Wait For Object (//*[@data-test-id='searchInput'],10)
    Web.Click Object (//*[@data-test-id='searchInput'])
    Web.Set Text (//*[@data-test-id='searchInput'],${Device_IP})
    Web.Press PageDown Key (//*[@id="detail-view"])         
    Sleep (15)
    //Clicks on the install and configure if its workpath installation 
    Web.Click Object (//input[@data-test-id='selectAll'])      
    Sleep (5)
    //clicks on the install and configure button
    Web.Click Object (//button[@data-test-id='configure'])
    
    Web.Wait For Object (//span[@data-test-id='deployStatusIcon'],20)
        If: Web.Wait For Object (//span[@data-test-id='deployStatusIcon' and contains(@class\,'success')],180)
            {
                Pass (Device configured successfully)
            }
            Fail:
            {
                Fail (Device configuration failed)
                
            }
}
        
T1984767217_Validate_Pull_Print_Single_Function_Swipe_to_Print_All_Pull_Print_with_Paper_Out_and_Direct_IP_Print_Step4
{
    Sleep (5)
    JediOmni.Touch (.hp-button-active-jobs:last)
    JediOmni.Wait For Object (hpid-button-cancel-all,10)
    JediOmni.Touch ID (hpid-button-cancel-all)
    JediOmni.Wait For Object (hpid-button-yes,10)
    JediOmni.Touch ID (hpid-button-yes)
    JediOmni.Wait For Object (hpid-active-jobs-exit,40)
    JediOmni.Touch ID (hpid-active-jobs-exit)
    If: JediOmni.Wait For Object (hpid-message-center-exit-button),5)
    {
       JediOmni.Touch ID (hpid-message-center-exit-button) 
    }
}

T1984767217_Validate_Pull_Print_Single_Function_Swipe_to_Print_All_Pull_Print_with_Paper_Out_and_Direct_IP_Print_Step5(${PrinterQueuename},${Device_IP},${inf_Path},${Driver_Name})
{
    Windows.Add Printer (${PrinterQueuename},${Device_IP},${inf_Path},${Driver_Name})
}


T1984767192_Validate_SafeQ_Cloud_Pull_Print_Options_OXPd(${Before},${After})
{
    JediOmni.Touch ID (hpid-2b0d0eba-3cf8-4830-833a-b024645b07fb-homescreen-button)
    Sleep (10)
    //waits and clicks on refresh button 3 times
   Oxpd.Wait For Xpath (//*[@id="refresh_form"]/input[3],10)
   Repeat:3
   {  
    Oxpd.Touch Xpath (//*[@id="refresh_form"]/input[3]) 
   }
    //step4
    Oxpd.Touch Xpath (//*[@id="select_all_button"])
    //Oxpd.Get Text (//*[@id="total_jobs_element"],${Value})
    //step5
    Oxpd.Touch Xpath (//*[@id="unselect_all_button"])
    // need to verify
    //step6 getting the count before the print job are printed 
    Oxpd.Get Total Table Row Count (/html/body/div[2]/div[2]/div[2]/table,${Before})
    //step6
     //clicks on the select all button
    Oxpd.Touch Xpath (//*[@id="select_all_button"])
    Sleep (5)
    //selects all the jobs and click on the ellipses button (3 dot button)
    Oxpd.Touch Xpath (//*[@id="options_form"])
    Sleep (5)
    //selects the duplex and print 
    Oxpd.Touch Xpath (//*[@id="duplex"])
    Oxpd.Touch Xpath (//*[@id="options_print_button"])
    //waits for active jobs to clear
    JediOmni.Wait For Active Job Gone (150)
    Sleep (10)
    //step6 getting the count After the print job are printed
    Oxpd.Get Total Table Row Count (/html/body/div[2]/div[2]/div[2]/table,${After})
    If: Has Value Increased (${Before},${After})
    {
       Pass (Job count is 0 and step 2 is passed)
    }
    Fail:
    {
        Fail (Job count is not deincreased compared to previous job count and step6 is failed) 
    }
    If: Oxpd.Wait For Xpath (/html/body/div[2]/div[1]/form/input[2],150)
    {
        Oxpd.Touch Xpath (/html/body/div[2]/div[1]/form/input[2])
        Oxpd.Return Browser Engine
    } 
    Fail:
    {
        Fail (unable to signout and proceed for next step)
        Stop Test Case
    }
    //step7
    Sleep (10)
    JediOmni.Reset
    OXPD_Common_Library.Large_File_Job (${Printer})
    OXPD_Common_Library.OXPD_Device_Username_Login (${Device_Username},${Device_Password})
    If: JediOmni.Touch ID (hpid-2b0d0eba-3cf8-4830-833a-b024645b07fb-homescreen-button)
    {
        Sleep (10)
        Oxpd.Wait For Xpath (//*[@id="refresh_form"]/input[3],10)  
    }
    Fail:
    {
       Fail (Login Failed in the 7th Step)  
       Stop Test Case
    } 
    
    //waits and clicks on refresh button 
    Oxpd.Wait For Xpath (//*[@id="refresh_form"]/input[3],10) 
    Oxpd.Touch Xpath (//*[@id="refresh_form"]/input[3]) 
    //Step 8 
    //Selects 1st and 3rd and 5th job 
    Oxpd.Touch Xpath (/html/body/div[2]/div[2]/div[2]/table/tbody/tr[1])
    Sleep (3)
    Oxpd.Touch Xpath (/html/body/div[2]/div[2]/div[2]/table/tbody/tr[3])
    Sleep (3)
    Oxpd.Touch Xpath (/html/body/div[2]/div[2]/div[2]/table/tbody/tr[5])
    //step8 getting the count before the print job are printed 
    Oxpd.Get Total Table Row Count (/html/body/div[2]/div[2]/div[2]/table,${Before})
    //click ont option button (3 dot button 
    If: Oxpd.Wait For Xpath (//*[@id="options_form"],10)
    {
       Oxpd.Touch Xpath (//*[@id="options_form"]) 
       Pass (Print job is selected to print)
    }
    Fail:
     { 
         Fail (Print jobs are not selected)
         Stop Test Case
     } 
    Sleep (5)
    //selects options like duplex, Mono and the clicks on the Print button
    Oxpd.Touch Xpath (//*[@id="duplex"])
    Oxpd.Touch Xpath (//*[@id="mono"])
    Oxpd.Touch Xpath (//*[@id="options_print_button"])
    //step8 getting the count After the print job are printed
    Oxpd.Get Total Table Row Count (/html/body/div[2]/div[2]/div[2]/table,${After})
    If: Has Value Increased (${Before},${After})
    {
        Pass (Count is  decreased and step8 is failed)
    }
    Fail:
    {
        Fail (Count is not decreased and step8 is passed)
    }
    
    //waits for the retrns to print job page 
    If: Oxpd.Wait For Xpath Gone (//*[@id="hpid-oxpd-spinner"],150)
    {
        Pass (Print job are processed)  
    } 
    //Step9 is incomplete required new keyword to get the count of the jobs
    Oxpd.Get Total Table Row Count (/html/body/div[2]/div[2]/div[2]/table,${Before})
    Repeat:2
    {
        OXPD_Common_Library.Send_Job (${Printer})
    }
     Oxpd.Wait For Xpath (//*[@id="refresh_form"]/input[3],10)
    Oxpd.Touch Xpath (//*[@id="refresh_form"]/input[3])
    Oxpd.Get Total Table Row Count (/html/body/div[2]/div[2]/div[2]/table,${After})
    If: Has Value Increased (${Before},${After})
    {
        Pass (Job count is decreased and step9 is passed)
    }
    Fail:
    {
        Fail (Job count is not decreased and step9 is failed )  
    }
    
    //step 10 
    //selects the 1st job
    Oxpd.Touch Xpath (/html/body/div[2]/div[2]/div[2]/table/tbody/tr[1])
    //selects all the jobs and click on the ellipses button (3 dot button)
    Oxpd.Touch Xpath (//*[@id="options_form"])
    Sleep (5)
    //click on the Hold jobs 
    Oxpd.Touch Xpath (//*[@id="keep"])
    //selects the duplex and print 
    Oxpd.Touch Xpath (//*[@id="duplex"])
    //selects on the mono option
    Oxpd.Touch Xpath (//*[@id="mono"])
    //sets the  no of copies
    Oxpd.Touch Xpath (//*[@id="copiesOptionsFormText"])
    Oxpd.Input Text (2)
    Oxpd.Touch Xpath (//*[@id="popup_button"])
    // clicks on the print button 
    Oxpd.Touch Xpath (//*[@id="options_print_button"])
    // validation is required here 
    //waits for the retrns to print job page 
    If: Oxpd.Wait For Xpath Gone (//*[@id="hpid-oxpd-spinner"],150)
    {
        Pass (Print job are processed)  
    }
    //step 11, 12 
    // clicks on the select all button
    Oxpd.Touch Xpath (//*[@id="unselect_all_button"])
    Oxpd.Touch Xpath (//*[@id="delete_selected_button"])
}

