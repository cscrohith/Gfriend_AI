1984767202_FeautureSmartFirmware_Upgrade(${Device_IP},${BADGE_INDEX},${File_Path},${EWS_Password},${EWS_Site})
{
   Web.Click Text (Information)
    Web.Click Text (Configuration Page)
    Web.Get Text (//*[@id="FutureSmartBundleVersion"],${Firmware_version})
    pass(${Firmware_version})
    Web.Get Text (//*[@id="FirmwareRevision"],${Firmware_revision})
    Pass (${Firmware_revision})
    Web.Click Text (General)
    Web.Click Text (Firmware Upgrade)
    Web.Click Text (Choose File)
    Windows.Wait For Name (Open,5)
    Windows.Select Application (Open)
    Windows.Wait For ID (1148,10)
    Windows.Send Key (${File_Path})
    Windows.Wait For Name (Open,5)
    Windows.Send Special Key ([ENTER])
    Windows.Wait For Name (Open,10)
    If: Windows.Check Screen Contains Partial Text (id.signed.bdl)
    {
        Windows.Click Element By Partial Text (id.signed.bdl) 
    }
    Fail:
    {
        Fail (There is no bdl file)
    }
    Windows.Send Special Key ([TAB])
    Windows.Send Special Key ([TAB])
    Windows.Send Special Key ([ENTER])
    Windows.Wait For Name (Open,15)
    Web.Wait For Text (The product is restarting to complete the operation,1200)
    JediOmni.Wait Until Boot    
    While:Web.Wait For Object (//*[@id="reload-button"],10): 50
    {
        Web.Click Object (//*[@id="reload-button"])
    }
    While:Web.Wait For Text (Information,10): 180
    {
        Web.Wait For Text (Information,50)
    }
    If: Web.Open with edge (${EWS_Site},180)
    {
        //continue
    }
    Fail:
    {
        Fail (Failed opening the browser!)
        Stop Test Case
    }
    Web.Click Text (Information)
    Web.Click Text (Configuration Page)
    Web.Get Text (//*[@id="FutureSmartBundleVersion"],${UpdatedFirmware_version})
    pass(${UpdatedFirmware_version})
    Web.Get Text (//*[@id="FirmwareRevision"],${UpdatedFirmware_revision})
    Pass (${UpdatedFirmware_revision})
    If: builtin.NotEquals (${Firmware_version},${UpdatedFirmware_version})
    {
        Pass(Updated Firmware Version)
    }
    Fail:
    {
        Fail (Firmware Version not updated)
        Stop Test Case
    }
}

T1984767209_Validate_SafeQ_Cloud_Web_Portal_My_Documents_Functionality(${File_Name1},${File_Name2})
{
    //Personal dropdown
    Web.Wait For Object (//div[@data-test-id='label' and text()='Personal'],70)
    Web.Click Object (//div[@data-test-id='label' and text()='Personal'])
    Sleep (2)
    //My Documents button
    Web.Wait For Object (//div[@data-test-id='label'][normalize-space()='My documents'],10)
    Web.Click Object (//div[@data-test-id='label'][text()='My documents'])
    Sleep (2)
    //Waiting button
    Web.Wait For Object (//span[normalize-space()='Waiting'],30)
    Web.Click Object (//span[normalize-space()='Waiting'])
    //Scrolling Down
    Web.ScrollDownToParicularObject (//tr[@data-test-id='list'])
    Web.ScrollDownToParicularObject ((//tr[@data-test-id='list'])[last()])
    Windows.Send Special Key([DOWN])
    Sleep (2)
    //Checking file_name exists
    If: Web.Wait For Text (${File_Name1},10)
    {
        Pass(Jobs are available in Waiting State)
    }
    If: Web.Wait For Text (${File_Name2},10)
    {
        Pass(Jobs are available in Waiting State)
    }
    Fail:
    {
        Fail (Jobs are not available in waiting state)
    }
}

T1984767209_Validate_SafeQ_Cloud_Web_Portal_My_Documents_Upload_Functionality(${File_Name1},${File_Name2},${file-path-1},${Pull-print-queue-name})
{
    //Refresh status button
    Web.Wait For Object (//a[normalize-space()='Refresh status'],10)
    Web.Click Object (//a[normalize-space()='Refresh status'])
    If: Web.Wait For Text (Refresh status,20)
    {
        Web.Click Text (Refresh status)
    }
    //Scrolling down
    Web.ScrollDownToParicularObject (//tr[@data-test-id='list'])
    Web.ScrollDownToParicularObject ((//tr[@data-test-id='list'])[last()])
    Windows.Send Special Key([DOWN])
    Sleep (2)
    //Checking file_name exists
    If: Web.Wait For Text (${File_Name1},10)
    {
        Pass(Jobs are available in Waiting State)
    }
    If: Web.Wait For Text (${File_Name2},10)
    {
        Pass(Jobs are available in Waiting State)
    }
    Fail:
    {
        Fail (Jobs are not available in waiting state)
    }
    //Upload documents to print button
    Web.Drag File To Web (${file-path-1},//input[@data-test-id='uploadBtn'])
    Sleep(3)
    //Select pull print queue from Destination printer list box
    Web.Click Object (//select[@data-test-id='printQueue']/preceding-sibling::span/span[@role='option'])
    Windows.Send Key (${Pull-print-queue-name})
    If: Web.Wait For Object (//button[normalize-space()='Send to secure queue'],30)
    {
        Web.Click Object (//button[normalize-space()='Send to secure queue'])
    }
}

T1984767209_Validate_SafeQ_Cloud_Web_Portal_My_Documents_File_upload_Functionality(${file-path-2})
{
    Sleep (2)
    If: Web.Wait For Object (//span[normalize-space()='Upload documents to print']/parent::div,20)
    {
        Web.Click Object (//span[normalize-space()='Upload documents to print']/parent::div)
    }
    //File explorer
    Windows.Select Application (Open)
    If: Windows.Wait For ID (1148,20)
    {
        Sleep (2)
        Windows.Send Special Key (${file-path-2})
    }
    Sleep (1)
    Windows.Send Special Key ([ENTER])
    Sleep(2)
    Web.Click Object (//select[@data-test-id='printQueue']/preceding-sibling::span/span[@role='option'])
    Sleep(1)
    If: Web.Wait For Object (//button[normalize-space()='Send to secure queue'],30)
    {
        Web.Click Object (//button[normalize-space()='Send to secure queue'])
    }
    Web.Close
}

T1984767200_Validate_SafeQ_Cloud_Authentication_Short_ID_PIN(${Device_PIN},${Device_Password})
{
  Web.Wait For Object (//a[.//div[text()='Users']],10)
  Web.Click Object (//a[.//div[text()='Users']])
  Web.Wait For Object (//tr[.//td[text()='admin']]//span[@data-title='Edit']//a,30)
  Web.Click Object (//tr[.//td[text()='admin']]//span[@data-title='Edit']//a)
  Web.ScrollDownToParicularObject (//input[@data-test-id='shortId'])
  Web.Wait For Object (//input[@data-test-id='password2'],5)
  Web.Set Text (//input[@data-test-id='password1'],${Device_Password})
  Web.Set Text  (//input[@data-test-id='password2'],${Device_Password})
  Web.Set Text (//input[@data-test-id='shortId'],${Device_PIN})
  Sleep (3)
  Web.ScrollDownToParicularObject (//input[@data-test-id='saveBtn'])
  Web.Click Object (//input[@data-test-id='saveBtn'])
}

T1984767206_DevicePrintReport(${website-url},${Username},${Password},${DownLoadFolderPath},${DevicePrintFileNamePrefixToRename})
{
    If: Web.Open with Chrome (${website-url},30)    
    {
        //continue 
        Sleep (10)        
        OXPD_Common_Library.Portal_Login(${website-url},${Username},${Password})
        Sleep(1)        
        //Report Tab
        Functional_OXPD.WaitAndClick(/html/body/div[1]/div[3]/div[2]/div/div[6]/a/div[2],Report Tab)
        Sleep (5)        
        //Printer Tab
        Functional_OXPD.WaitAndClick(/html/body/div[1]/div[3]/div[2]/div/div[9]/a/div,Printer Tab)
        Sleep (5)        
        Web.Select Frame (//*[@id="superset-dashboard-panel"]/iframe) 
        Functional_OXPD.WaitAndClick(/html/body/div[1]/div[4]/div/div[2]/div[2]/div[3]/div/div[2]/div[1]/div[1]/div/ul/li[1],Print_Copy Tab)
        Sleep (2)
        ///Click dropdown for custom date selection
        Functional_OXPD.WaitAndClick(/html/body/div[7]/div/div[2]/ul/li[5],Select Custom option)
        Sleep (2)
        Get Time Stamp (${a},MM/dd/yy)
        Functional_OXPD.WaitAndClick(/html/body/div[1]/div[4]/div/div[2]/div[2]/div[3]/div/div[2]/div[1]/div[2]/div[2]/form/div[3]/span/span/input,To Date)
        Sleep (5)
        Web.Clear Text (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[3]/div/div[2]/div[1]/div[2]/div[2]/form/div[3]/span/span/input)
        Sleep (5)
        Web.Set Text(/html/body/div[1]/div[4]/div/div[2]/div[2]/div[3]/div/div[2]/div[1]/div[2]/div[2]/form/div[3]/span/span/input,${a})
        Sleep (5)
        Functional_OXPD.WaitAndClick(/html/body/div[1]/div[4]/div/div[2]/div[2]/div[3]/div/div[2]/div[1]/div[2]/div[2]/form/div[4]/button,Apply Button)
        Sleep (5)
        ///Scroll down and download excel file
        Web.ScrollDownToParicularObject(//*[@id="chart-id-217"]/div/div)
        Sleep (5)
        Functional_OXPD.WaitAndClick(//*[@id="slice_162-controls"]/div,Click 3 dots)
        Sleep (2)
        Web.Get Text(//*[@id="GRID_ID-panel-GRID_ID"]/div/div/div[1]/div/div/div[2]/div/div[1]/div/div[2],${ex})
        ReAssign Value To Variable(${TotalDevicePrintReports},${ex})
        Functional_OXPD.WaitAndClick(//*[@id="slice_162-menu"]/li[4]/div,Click Downloads)
        Sleep (2)
        //Wait for the Excel to Download
        Get Time Stamp (${DPP_DownlaodedReportName},yyyyMMdd)
        Functional_OXPD.WaitAndClick(//*[@id="slice_162-menu-download-popup"]/li[2],Export To Excel)
        If: Web.Wait Until File Download Complete(${DownLoadFolderPath},${DPP_DownlaodedReportName},60)
        {
            Pass (Excel downloaded successfully)
            Sleep (2)
        }
        Fail:
        { 
            Web.Close
            Fail (Failed to download the excel)
            Stop Test Case
        }
        Web.Close
        Sleep (1)
        
        ///<Description>For Excel verification</Description>
        Windows.Open Folder By Path (${DownLoadFolderPath})
        Windows.Send Special Key ([HOME])
        Windows.Send Special Key ([DOWN])
        Windows.Send Special Key ([HOME])
        Sleep (1)
        Get Time Stamp (${DPP_CurrentTime},ddMMhhmmss)
        ReAssign Value To Variable(${DPP_FileName},${DPP_CurrentTime})
        Sleep (1)
        Concatenate Variable Values And Store Result (${DevicePrintReportName},${DPP_FileName},${DPP_ExcelName})
        Windows.Send Special Key ([F2])
        Sleep (1)
        Windows.Send Key (${DPP_ExcelName})
        Sleep (1)
        Windows.Send Special Key ([ENTER])
        Sleep (1)
        Concatenate Variable Values And Store Result (${DownLoadFolderPath},${DPP_ExcelName},${DPP_PathAndFileNamePrefix})
        Concatenate Variable Values And Store Result (${DPP_PathAndFileNamePrefix},.xlsx,${DPP_StoreCompleteFilePath})
        //Read value from excel sheet
        Sleep (1)
        SpreadSheet.SetExcelPath(${DPP_StoreCompleteFilePath})
        SpreadSheet.Set Worksheet(Sheet1)
        SpreadSheet.Read Cell Value By Index(2,2,${DPP_ReportDataFromExcel})
        If:Equals (${TotalDevicePrintReports},${DPP_ReportDataFromExcel})
        {
            Pass (No issues are observed downloaded reports datamatches what is displayed on the webpage)
        } 
        Fail:
        {
            Windows.Send Special Key (^w)
            Fail (Downloaded reports does not matches with what is displayed on the webpage)
            Stop Test Case
        }
        Windows.Send Special Key (^w)
    }
    Fail:
    { 
        Fail (Failed opening the browser!)
        Stop Test Case
    }
}

