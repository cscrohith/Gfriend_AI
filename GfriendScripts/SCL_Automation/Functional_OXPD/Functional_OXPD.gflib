}
T1984767197_Pull_Print_Queue
{
    If: Web.Wait For Object (//a[@data-test-id='menuItemLink' and .//div[@data-test-id='label' and normalize-space()='Printers']],10)
    {
        Web.Click Object (//a[@data-test-id='menuItemLink' and .//div[@data-test-id='label' and normalize-space()='Printers']])
    }
    Fail:
    {
        Fail (Unable to click the Printer option)
        Stop Test Case
    }
    If: Web.Wait For Object (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[1]/div/div/div/ul/li[2]/a,10)
    {
        Web.Click Object (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[1]/div/div/div/ul/li[2]/a)
    }
    If: Web.Wait For Object (//*[@id="id146"]/div[1]/a,15)
    {
        Web.Click Object (//*[@id="id146"]/div[1]/a)
    }
    Web.Set Text (//*[@id="id17d"],${Pull_Print_Queue})
    //To get out of text box click anywhere on the website
    //Web.Click Object (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[2]/div/div[2]/div/div[4]/div[1])
    Web.Wait For Object (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[2]/div/div[2]/div/div[4]/div[2]/span/span/span[2]/span,5)    
    Web.Click Object (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[2]/div/div[2]/div/div[4]/div[2]/span/span/span[2]/span)
    //for Pull print queue
    Web.Click Object (/html/body/div[7]/div/div[2]/ul/li[1])
    Sleep (2)
    Web.Scroll Down To The End (/html/body/div[1]/div[4])
    Web.Wait For Object(/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[3]/div/div/input[2],5)
    Web.Click Object (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[3]/div/div/input[2])
    Sleep (3)
    Web.Close
    Sleep (3)
    Windows.Select Application (Taskbar)
    Windows.Wait For ID (SystemTrayIcon,10)
    Windows.Click ID (SystemTrayIcon)
    Windows.Select Application (System tray overflow window.)
    Windows.Wait For ID (NotifyItemIcon,15)
    Windows.Click By Tooltip (NotifyItemIcon,SAFEQ Cloud Client)
    Windows.Select Application (Context)
    Windows.Click Name (Synchronize printers now)
}

T1984767197_Direct_Print_Queue
{
    If: Web.Wait For Object (//a[@data-test-id='menuItemLink' and .//div[@data-test-id='label' and normalize-space()='Printers']],15)
    {
        Web.Click Object (//a[@data-test-id='menuItemLink' and .//div[@data-test-id='label' and normalize-space()='Printers']])
    }
    Fail:
    {
        Fail (Unable to click the Printer option)
        Stop Test Case
    }
    If: Web.Wait For Object (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[1]/div/div/div/ul/li[2]/a,10)
    {
        Web.Click Object (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[1]/div/div/div/ul/li[2]/a)
    }
    If: Web.Wait For Object (//*[@id="id146"]/div[1]/a,10)
    {
        Web.Click Object (//*[@id="id146"]/div[1]/a)
    }
    Web.Wait For Object(//*[@id="id17d"],5)
    Web.Set Text (//*[@id="id17d"],${Direct_Print_Queue})
    //To get out of text box click anywhere on the website
    //Web.Click Object (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[2]/div/div[2]/div/div[4]/div[1])
    Web.Wait For Object(/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[2]/div/div[2]/div/div[4]/div[2]/span/span/span[2]/span,5)
    Web.Click Object (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[2]/div/div[2]/div/div[4]/div[2]/span/span/span[2]/span)
    //For Direct Print queue
    Web.Click Object (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[2]/div/div[2]/div/span/div/div[2]/span/span/span[2]/span)
    Web.Set Text (/html/body/div[10]/div/span/input,${Direct_Print_Queue})
    Sleep (2)
    Windows.Send Special Key ([ENTER])
    Web.Scroll Down To The End (/html/body/div[1]/div[4])
    Web.Wait For Object(/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[3]/div/div/input[2],5)
    Web.Click Object (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[3]/div/div/input[2])
    Sleep (3)
    Web.Close
    Sleep (3)
    Windows.Select Application (Taskbar)
    Windows.Click ID (1502)
    Sleep (2)
    Windows.Click By Tooltip (NotifyItemIcon,SAFEQ Cloud Client)
    Windows.Select Application (Context)
    Windows.Click ID (6889)
    Sleep (5)
}
///////////////////////////////////////////////////////////////////////////////////////////////////////
// Routine:         Send_Small_Word_Document_For_Print
//        
// Description:     Send a word document kept in path {Working Directory}\print-documents\word-doc\testfile.docx
//
// Arguments:       None
//
// Pre-requisites:  1. The test file should be placed in correct directory path: {Working Directory}\print-documents\word-doc\
//                  2. The test file should be named testfile.docx
//                  3. Correct version of MS Word should be installed on computer
///////////////////////////////////////////////////////////////////////////////////////////////////////
Send_Small_Word_Document_For_Print
{
    If:Windows.Open File For Print(${word-document-file},${print-queue-name})
    {
        Windows.Click ID (1)
        
        //Because the Click Print button doesn't work with word documents
        //This is an alternate approach to click the print button. i.e., Alt+F, P, P
        //Click Alt+F Keys
        If:Windows.Send Special Key (${alt-f})
        {
            Sleep(1)
            // Click 'P' button on keyboard
            If:Windows.Send Key (${p-key})
            {
                Sleep(1)
                If:Windows.Send Key (${p-key})
                {
                    Sleep(1)
                    Pass(File: ${word-document-file} sent to print queue successfully.)
                    Sleep(5)
                    Windows.Close Application
                }
            }
        }
        Fail:
        {
            Fail(Failed to click print button)
            Windows.Close Application ()
        }
        Error:
        {
            Error(Error trying to click print button
            Windows.Close Application
        }
    }
    Fail:
    {
        Fail(Failed to open the word file in path: ${word-document-file})
    }
    Error:
    {
        Error(Error trying to send job to print queue)
    }
}

///////////////////////////////////////////////////////////////////////////////////////////////////////
// Routine:         Send_Small_Excel_Document_For_Print
//        
// Description:     Send a excel document kept in path {Working Directory}\print-documents\excel-doc\testfile.txt
//
// Arguments:       None
//
// Pre-requisites:  1. The test file should be placed in correct directory path: {Working Directory}\print-documents\excel-doc\
//                  2. The test file should be named testfile.xlsx
///////////////////////////////////////////////////////////////////////////////////////////////////////
Send_Small_Excel_Document_For_Print
{
    If:Windows.Open File For Print(${excel-document-file},${print-queue-name})
    {
        Windows.Click ID (1)
        
        //Because the Click Print button doesn't work with excel documents
        //This is an alternate approach to click the print button. i.e., Alt+F, P, P
        //Click Alt+F Keys
        If:Windows.Send Special Key (${alt-f})
        {
            Sleep(${ultra-short-wait})
            // Click 'P' button on keyboard
            If:Windows.Send Key (${p-key})
            {
                Sleep(${ultra-short-wait})
                If:Windows.Send Key (${p-key})
                {
                    Sleep(${ultra-short-wait})
                    Pass(File: ${excel-document-file} sent to print queue successfully.)
                    Sleep(${medium-wait})
                    Windows.Close Application
                    Sleep(${medium-wait})
                }
            }
        }
        Fail:
        {
            Fail(Failed to click print button)
            Windows.Close Application
        }
        Error:
        {
            Error(Error trying to click print button
            Windows.Close Application
        }
    }
    Fail:
    {
        Fail(Failed to open the word file in path: ${excel-document-file})
    }
    Error:
    {
        Error(Error trying to send job to print queue)
    }
}

