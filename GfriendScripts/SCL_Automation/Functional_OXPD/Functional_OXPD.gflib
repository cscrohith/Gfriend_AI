T1984767195_Download_Executable_File_To_Install_SafeQ_Windows_Client
{
    OXPD_Common_Library.Portal_Login(${website-url},${Username},${Password})
    Sleep(1)
    
    If: Web.Wait For Text (${pc-client-tab},${small-timeduration})
    {
        Web.Click Text (${pc-client-tab})
    }
    Fail:
    {
        Fail (Failed to find 'PC Client' tab on the web page.)
        Stop Test Case
    }
    Error:
    {
        Error (Failed to find 'PC Client' tab on the web page.)
        Stop Test Case
    }

    
    If: Web.Wait For Object (${safeq-windows-client},${large-timeduration})
    {
        Web.Click Object (${safeq-windows-client})
        // Give some time for the download to finish.
        Sleep(${large-timeduration})
    }
    Fail:
    {
        Fail (Failed to find 'Windows SafeQ client' download button on web page.)
        Stop Test Case
    }
    Error:
    {
        Error (Failed to find 'Windows SafeQ client' download button on web page.)
        Stop Test Case
    }
    Web.Close
}

T1984767195_Install_Executable_Application_In_Computer
{
    Windows.Open Folder By Path (${SafeQExeFilePath})
    //Sleep(${small-timeduration})
    
    // Regular windows keywords are not working. So we are resorting to
    // sending keys.
    Windows.Send Special Key ([DOWN])
    Windows.Send Special Key ([UP])
    Windows.Send Special Key (^+[ENTER])

    // Wait for EULA window to open
    Sleep(${large-timeduration})
    Windows.Select Application (${EULA-window})
    
    If: Windows.Wait For Name (${agree-button},${medium-timeduration})
    {
        Windows.Click Name (${agree-button})
        Windows.Select Application (${EULA-window})
        Windows.Wait For Name (${finish-button},${medium-timeduration})
        Windows.Click Name (${finish-button})
    } 
    Fail:
    {
        Windows.Wait For ID (${perform-full-installation},${medium-timeduration})
        Windows.Click ID (${perform-full-installation})
        Windows.Wait For Name (${next-button},${medium-timeduration})
        Windows.Click Name (${next-button})
        Windows.Wait For Name (${agree-button},${medium-timeduration})
        Windows.Click Name (${agree-button})
        Windows.Wait For Name (${finish-button},${ultra-long-timeduration})
        Windows.Click Name (${finish-button})
    }   
    Sleep(${medium-timeduration})
}

T1984767195_SignIn_SafeQ_Portal
{
    Windows.Select Application (HP Automation)
    
    // Because regular keywords are not working, we are resorting to sending
    // keys.
    Windows.Send Special Key ([TAB])
    Windows.Send Key (a)
    Windows.Send Key (d)
    Windows.Send Key (m)
    Windows.Send Key (i)
    Windows.Send Key (n)
    
    Windows.Send Special Key ([TAB])
    Windows.Send Key (A)
    Windows.Send Key (u)
    Windows.Send Key (t)
    Windows.Send Key (o)
    Windows.Send Key (m)
    Windows.Send Key (a)
    Windows.Send Key (t)
    Windows.Send Key (i)
    Windows.Send Key (o)
    Windows.Send Key (n)
    Windows.Send Key (@)
    Windows.Send Key (1)
    Windows.Send Key (2)
    Windows.Send Key (3)
    
    Windows.Send Special Key ([TAB])
    Windows.Send Special Key ([TAB])
    Windows.Send Special Key ([ENTER])
    Sleep(${small-timeduration})
}

T1984767195_Validate_Print_Queues_Existence
{
    OXPD_Common_Library.Portal_Login(${website-url},${Username},${Password})
      
    While:!Web.Wait For Object (${left-nav-bar-printers},${small-timeduration}):${medium-timeduration}
    {
        Sleep(${medium-timeduration})
    }
    If:Web.Wait For Object (${left-nav-bar-printers},${small-timeduration})
    {
        Web.Click Object(${left-nav-bar-printers})
    }
    
    While:!Web.Wait For Object (${print-queues-tab},${small-timeduration}):${medium-timeduration}
    {
        Sleep(${medium-timeduration})
    }
    
    If:Web.Wait For Object (${print-queues-tab},${small-timeduration})
    {
        Web.Click Object(${print-queues-tab})
    }
    
    While:!Web.Wait For Object (${first-print-queue},${small-timeduration}):${medium-timeduration}
    {
        Sleep(${medium-timeduration})
    }
    If:Web.Wait For Object (${first-print-queue},${small-timeduration})
    {
        Web.Get Text (${first-print-queue},${RowValue1})
        Set Variable (${print-queue-1},${RowValue1})
    }
    
    While:!Web.Wait For Object (${second-print-queue},${small-timeduration}):${medium-timeduration}
    {
        Sleep(${medium-timeduration})
    }
    If:Web.Wait For Object (${second-print-queue},${small-timeduration})
    {
        Web.Get Text (${second-print-queue},${RowValue2})
        Set Variable (${print-queue-2},${RowValue2})
    }
    
    
    // Check if the first print queue exists in computer by running the command in cmd
    Run Command (cmd.exe /c powershell -NoProfile -Command "(Get-Printer | Select-Object -ExpandProperty Name) -contains '${print-queue-1}'"  > C:\Temp\printer_check.txt, ${print-queue-1-exists}, 10)
    BuiltIn.File Contains Text (${file-path-1},True)
    
    // Check if the second print queue exists in computer by running the command in cmd
    Run Command (cmd.exe /c powershell -NoProfile -Command "(Get-Printer | Select-Object -ExpandProperty Name) -contains '${print-queue-2}'" > C:\Temp\printer_check2.txt, ${print-queue-2-exists}, 10)
    BuiltIn.File Contains Text (${file-path-2},True)
}

