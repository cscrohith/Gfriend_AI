using Windows
using Web
using Oxpd
using JediOmni

T1993711245_Authenticated_users_cannot_access_restricted_device_functions
{
   JediOmni.Swipe (>)
   Sleep (3)
  If: JediOmni.Check Screen Contains Full Text (Reports)
  {
      JediOmni.Touch Text (Reports)
  }
  Fail:
  {
       JediOmni.Swipe (>)
      JediOmni.Touch Text (Reports)
  }
  If: JediOmni.Wait For Object (hpid-popup-access-denied-confirm,20)
  {
      JediOmni.Touch ID (hpid-button-access-denied-confirm)
      Pass (User was unable to access Reports without device admin credentials.)
  }
  Fail:
  {
     Fail (User was able to access Reports without device admin credentials.) 
  }
   JediOmni.Touch Text (Sign Out)
}

T1984767189_Validate_SafeQ_Cloud_Authentication_Short_ID_PIN(${Device_PIN},${Device_Password})
{
  Web.Wait For Object (//a[.//div[text()='Users']],10)
  Web.Click Object (//a[.//div[text()='Users']])
  Sleep (10)
  Web.Wait For Object (//tr[.//td[text()='admin']]//span[@data-title='Edit']//a,10)
  Web.Click Object (//tr[.//td[text()='admin']]//span[@data-title='Edit']//a)
  Web.ScrollDownToParicularObject (//input[@data-test-id='shortId'])
  Web.Wait For Object (//input[@data-test-id='password2'],5)
  Web.Set Text (//input[@data-test-id='password1'],${Device_Password})
  Web.Set Text  (//input[@data-test-id='password2'],${Device_Password})
  Web.Set Text (//input[@data-test-id='shortId'],${Device_PIN})
  Sleep (3)
  Web.ScrollDownToParicularObject (//input[@data-test-id='saveBtn'])
  Web.Click Object (//input[@data-test-id='saveBtn'])
}


T1984767199_Validate_the_Embedded_OXP_Agent_in_SafeQ_Cloud_Configure_device(${Device_Name},${Device_IP},${Device_Serial_No})
{
If: Web.Wait For Object (//a[@data-test-id='menuItemLink' and .//div[@data-test-id='label' and normalize-space()='Printers']],5)
    {
        Web.Click Object (//a[@data-test-id='menuItemLink' and .//div[@data-test-id='label' and normalize-space()='Printers']])
    }
    Fail:
    {
        Fail (Unable to click the Printer option)
        Stop Test Case
    }
    //waits for Add Printer button
    If: Web.Wait For Object (//a[@role='button' and normalize-space()='Add printer'],30)
    {
        Sleep (10)
        Web.Click Object (//a[@role='button' and normalize-space()='Add printer'])
        //Clicks on the name 
        Web.Wait For Object (//input[@data-test-id='data.name'],10)
        Web.Set Text(//input[@data-test-id='data.name'],${Device_Name})
        //Clicks on the IP address 
        Web.Wait For Object (//input[@data-test-id='data.address'],10)
        Web.Set Text (//input[@data-test-id='data.address'],${Device_IP})    
        // Open vendor dropdown
         Web.Click Object (//select[@data-test-id='vendor']/parent::span)
        Sleep (2)
        // Select HP
         Web.Click Object (//li[normalize-space()='HP'])
        //Select Gateway Radiobutton
        Web.ScrollDownToParicularObject (//span[@data-test-id='title' and text()='Release options'])
        Web.Click Object (//input[@data-test-id='connectionMethod_Gateway'])
        Web.Press PageDown Key (//*[@id="detail-view"])
        Web.ScrollDownToParicularObject (//input[@data-test-id='data.deviceSerial'])
        //Updates Device serial number 
        Web.Click Object (//input[@data-test-id='data.deviceSerial'])
        Sleep (3)
        Web.Set Text (//input[@data-test-id='data.deviceSerial'],${Device_Serial_No})        
        Sleep (3)
        // Open template dropdown
        Web.Click Object (//div[@data-test-id='terminalConfig']//span[@role='listbox'])
        Sleep (2)
        // Select OXPD
        Web.Click Object (//li[normalize-space()='OXPD'])        
        Web.ScrollDownToParicularObject (//input[@data-test-id='saveBtn'])     
        //Clicks on the save button
        Web.Click Object (//input[@data-test-id='saveBtn'])
        Sleep (10)                                 
        If: Web.Wait For Text (${Device_IP},10)
        {
            Web.Press PageUp Key (//*[@id="detail-view"])
            Web.Wait For Object (//span[@data-test-id='message'],10)
            Pass (Printer details is saved successfully)
        }
        Fail:
        {
            Fail (Printer details is not saved)
            Stop Test Case
        }
        //clicks on the ETT
        Web.Press PageUp Key (//*[@id="detail-view"])
        Sleep (5)
        Web.Wait For Object (//a[@data-test-id='link.embedded_templates'],5)
        Web.Click Object (//a[@data-test-id='link.embedded_templates'])
        Sleep (5)
        Web.Click Object (//tr[td[normalize-space(text())='OXPD']]//span[@data-title='Deployment actions']//a)
        Sleep (5)      
        OXPD_Common_Library.OXPD_Configure (${Device_IP})
            
        //Check if OXPD Install and Configure
        Web.Wait For Object (//span[@data-test-id='deployStatusIcon'],20)
        If: Web.Wait For Object (//span[@data-test-id='deployStatusIcon' and contains(@class\,'success')],180)
            {
                Pass (Device configured successfully)
            }
        Fail:
            {
                //Check if Failed
                Web.Wait For Object (//span[@data-test-id='deployStatusIcon'],20)
                If: Web.Wait For Object (//span[@data-test-id='deployStatusIcon' and contains(@class\,'failed')],10)
                    {
                        //Click Edit for particular IP
                        Web.Click Object (//tr[@data-test-id='stateList' and .//span[@data-test-id='address' and normalize-space()='${Device_IP}']]//span[@data-test-id='edit'])
                        //Click Advanced setup
                        Web.Click Object (//a[.//span[normalize-space()='Advanced setup']])
                        //Enter password
                        Web.Set Text (//div[@data-test-id='adminPassword']//input[@type='password'],${Device_Password})
                        //Save
                        Web.Click Object (//input[@data-test-id='saveBtn'])
                        Sleep (10)
                        OXPD_Common_Library.OXPD_Configure (${Device_IP})
                        Sleep (10)
                        //Check again if Configured
                        Web.Wait For Object (//span[@data-test-id='deployStatusIcon'],20)
                        If: Web.Wait For Object (//span[@data-test-id='deployStatusIcon' and contains(@class\,'success')],180)
                        {
                            Pass (Device configured successfully after Advanced Setup)
                        }
                        Fail:
                        {
                            Fail (Configuration failed even after Advanced Setup)
                            Stop Test Case
                        }
                        JediOmni.Reset
           } 
    }
    
}
       //check in the device application is installed or not 
        If: JediOmni.Wait For Text (Secure Print,15)
            {
                Pass (Application installed ) 
            }
            Fail:
            {
                Fail (Application not installed )
            }          
}
        
        
        
