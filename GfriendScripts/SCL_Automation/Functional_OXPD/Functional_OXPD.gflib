        Web.Get Text(//*[@id="GRID_ID-panel-GRID_ID"]/div/div/div[1]/div/div/div[2]/div/div[1]/div/div[2]/div/div,${ex})
        ReAssign Value To Variable(${TotalDeviceScanReports},${ex})
        Functional_OXPD.WaitAndClick(//*[@id="slice_185-menu"]/li[4]/div,Click Downloads)
        Sleep (2)
        //Wait for the Excel to Download
        Get Time Stamp (${DownlaodedReportName},yyyyMMdd)
        Functional_OXPD.WaitAndClick(//*[@id="slice_185-menu-download-popup"]/li[2],Export To Excel)
        If: Web.Wait Until File Download Complete(${DownLoadFolderPath},${DownlaodedReportName},60)
        {
            Pass (Excel downloaded successfully)
