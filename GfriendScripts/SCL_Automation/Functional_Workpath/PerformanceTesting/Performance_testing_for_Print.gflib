T1985577798_Wake_Cases_BeforeAndAfterInstallation_App(${Device_IP},${Device_name},${Device_Serial_No},${Site},${Username},${Password})
{
      Set Variable (${Wakeup_Sum},0)
      Set Variable (${Wakeup_Sum_AfterInstallApp},0)
      Repeat:3
      {
        Info.Start Time Check (BaseLine_WakeTime_${R})
        Set Variable (${Message},${KEYWORD_OUTPUT})
        Set Variable (${Text},Time check is started and output will be saved to)
        Trim (${Message},${Text})
        ReAssign Value To Variable(${filePath_Awake_variable},${Message})
        //adding csv extension to the path
        Concatenate Variable Values And Store Result (${filePath_Awake_variable},csv,${fullfilePath_Awake}_${R})
        ReAssign Value To Variable(${fullfilePath_Awake_variable},${fullfilePath_Awake}_${R})       
        Android.Disconnect
        If: JediOmni.Is Awake
        {
            JediOmni.Wait Until Sleep (300)
        } 
        Info.Mark Start (BaseLine_WakeTime_${R},WakeTime_${R})
        JediOmni.Reset
        If: JediOmni.Is Awake
        {
            Info.Mark End (BaseLine_WakeTime_${R},WakeTime_${R})
        }
        Fail:
        {
            JediOmni.Reset
            Info.Mark End (BaseLine_WakeTime_${R},WakeTime_${R})
        }        
        Android.Re Connect
        Concatenate Variable Values And Store Result (${filePath_Awake_variable},xlsx,${filepathxls_Awake}_${R})
        ReAssign Value To Variable(${filepathxls_Awake_variable},${filepathxls_Awake}_${R})
        
        //converting csv to xlsx to read cell value
        Run Command (powershell -Command "$excel=New-Object -ComObject Excel.Application;$wb=$excel.Workbooks.Open('${fullfilePath_Awake_variable}');$wb.SaveAs('${filepathxls_Awake_variable}'\,51);$wb.Close();$excel.Quit()",${CreateXls})
        //setExcel Path and Fetch Cell value
        SpreadSheet.Set Excel Path(${filepathxls_Awake_variable})
        SpreadSheet.Set Worksheet(BaseLine_WakeTime_${R})
        SpreadSheet.Read Cell Value (WakeTime_${R},Time (ms),${WakeUp_Duration}_${R})
        ReAssign Value To Variable(${WakeUp_TimeAssign},${WakeUp_Duration}_${R})
        Calculate And Assign (${Wakeup_Sum}+${WakeUp_TimeAssign},${Wakeup_Sum})
      }      
       ////installing hpk file and Config in Tenet. // remove if device is already added in tenet
        Common_WorkPath_Library.WorkPath_Installation()
        Common_WorkPath_Library.Portal_Login (${Site},${Username},${Password})
        Functional_WorkPath.T1984992396_Validate_the_Workpath_Agentless_in_SafeQ_Cloud (${Device_IP},${Device_name},${Device_Serial_No})      
      Repeat:3
      {
        Info.Start Time Check (WakeupTime_AfterInstallApp_${R})
        Set Variable (${Message},${KEYWORD_OUTPUT})
        Set Variable (${Text},Time check is started and output will be saved to)
        Trim (${Message},${Text})        
        ReAssign Value To Variable(${AfterInstallApp_filePath_variable},${Message})
        Concatenate Variable Values And Store Result (${AfterInstallApp_filePath_variable},csv,${AfterInstallApp_fullfilePath}_${R})
        ReAssign Value To Variable(${AfterInstallApp_fullfilePath_variable},${AfterInstallApp_fullfilePath}_${R})        
        Android.Disconnect
        If: JediOmni.Is Awake
        {
            JediOmni.Wait Until Sleep (300)
        } 
        Info.Mark Start (WakeupTime_AfterInstallApp_${R},WakeTime_${R})
        JediOmni.Reset
        If: JediOmni.Is Awake
        {
            Info.Mark End (WakeupTime_AfterInstallApp_${R},WakeTime_${R})
        }
        Fail:
        {
            JediOmni.Reset
            Info.Mark End (WakeupTime_AfterInstallApp_${R},WakeTime_${R})
        }
        Android.Re Connect        
        Concatenate Variable Values And Store Result (${AfterInstallApp_filePath_variable},xlsx,${AfterInstallApp_filepathxls}_${R})
        ReAssign Value To Variable(${AfterInstallApp_filepathxls_variable},${AfterInstallApp_filepathxls}_${R})
        //converting csv to xlsx to read cell value
        Run Command (powershell -Command "$excel=New-Object -ComObject Excel.Application;$wb=$excel.Workbooks.Open('${AfterInstallApp_fullfilePath_variable}');$wb.SaveAs('${AfterInstallApp_filepathxls_variable}'\,51);$wb.Close();$excel.Quit()",${CreateXls})
        //setExcel Path and Fetch Cell value
        SpreadSheet.Set Excel Path(${AfterInstallApp_filepathxls_variable})
        SpreadSheet.Set Worksheet(WakeupTime_AfterInstallApp_${R})
        SpreadSheet.Read Cell Value (WakeTime_${R},Time (ms),${AfterInstallApp_WakeUp_Duration}_${R})        
        ReAssign Value To Variable(${AfterInstallApp_WakeUp_TimeAssign},${AfterInstallApp_WakeUp_Duration}_${R})
        Calculate And Assign (${Wakeup_Sum_AfterInstallApp}+${AfterInstallApp_WakeUp_TimeAssign},${Wakeup_Sum_AfterInstallApp})
      }
        Calculate And Assign (${Wakeup_Sum}+${Wakeup_Sum_AfterInstallApp},${Wakeup_Sum_Before_and_AfterInstallApp})
        Calculate And Assign (${Wakeup_Sum_Before_and_AfterInstallApp}/2,${Avg_Wakeup_Sum})    
}

T1985577798_WakeUpDevice_from_Card_Swipe(${BADGE_INDEX})
{
      Set Variable (${WakeupByCardSwipe_Sum},0)
      Repeat:3
      {
        Info.Start Time Check (BaseLine_WakeTime_${R})
        Set Variable (${Message},${KEYWORD_OUTPUT})
        Set Variable (${Text},Time check is started and output will be saved to)
        Trim (${Message},${Text})
        ReAssign Value To Variable(${filePath_SwipeCard_Awake_variable},${Message})
        //adding csv extension to the path
        Concatenate Variable Values And Store Result (${filePath_SwipeCard_Awake_variable},csv,${fullfilePath_SwipeCard_Awake}_${R})
        ReAssign Value To Variable(${fullfilePath_SwipeCard_Awake_variable},${fullfilePath_SwipeCard_Awake}_${R})        
        Android.Disconnect        
        If: JediOmni.Is Awake
        {
            JediOmni.Wait Until Sleep (300)
        } 
        Info.Mark Start (BaseLine_WakeTime_${R},WakeTime_${R})
        BadgeBox.Scan Badge (${BADGE_INDEX})
        If: JediOmni.Is Awake
        {
            Info.Mark End (BaseLine_WakeTime_${R},WakeTime_${R})
        }
        Fail:
        {
            BadgeBox.Scan Badge (${BADGE_INDEX})
            Info.Mark End (BaseLine_WakeTime_${R},WakeTime_${R})
        }        
        Android.Re Connect        
        Concatenate Variable Values And Store Result (${filePath_SwipeCard_Awake_variable},xlsx,${filepathxls_SwipeCard_Awake}_${R})
        ReAssign Value To Variable(${filepathxls_SwipeCard_Awake_variable},${filepathxls_SwipeCard_Awake}_${R})        
        //converting csv to xlsx to read cell value
        Run Command (powershell -Command "$excel=New-Object -ComObject Excel.Application;$wb=$excel.Workbooks.Open('${fullfilePath_SwipeCard_Awake_variable}');$wb.SaveAs('${filepathxls_SwipeCard_Awake_variable}'\,51);$wb.Close();$excel.Quit()",${CreateXls})
        //setExcel Path and Fetch Cell value
        SpreadSheet.Set Excel Path(${filepathxls_SwipeCard_Awake_variable})
        SpreadSheet.Set Worksheet(BaseLine_WakeTime_${R})
        SpreadSheet.Read Cell Value (WakeTime_${R},Time (ms),${WakeUp_SwipeCard_Duration}_${R})
        ReAssign Value To Variable(${WakeUp_SwipeCard_TimeAssign},${WakeUp_SwipeCard_Duration}_${R})
        Calculate And Assign (${WakeupByCardSwipe_Sum}+${WakeUp_SwipeCard_TimeAssign},${WakeupByCardSwipe_Sum})
      }
      Calculate And Assign (${WakeupByCardSwipe_Sum}/3,${Avg_WakeupByCardSwipe})    
}
