using Info
using SpreadSheet
using BadgeBox
using JediOmni
using Android

T1985577798_Performance_testing_for_Print_BootTime(${Device_IP},${Device_name},${Device_Serial_No},${Site},${Username},${Password}})
{
    Info.Start Time Check (Baseline_Boot_Time)
    Set Variable (${Message},${KEYWORD_OUTPUT})
    Set Variable (${Text},Time check is started and output will be saved to)
    Trim (${Message},${Text})
     ReAssign Value To Variable(${filePath},${Message})
    //adding csv extension to the path
    Concatenate Variable Values And Store Result (${filePath},csv,${fullfilePath})
    Info.Mark Start (Baseline_Boot_Time,Boot_Time)
    Common_Workpath_Library.Device_Reboot
    Info.Mark End (Baseline_Boot_Time,Boot_Time)
    Concatenate Variable Values And Store Result (${filePath},xlsx,${filepathxls})
    //converting csv to xlsx to read cell value
    Run Command (powershell -Command "$excel=New-Object -ComObject Excel.Application;$wb=$excel.Workbooks.Open('${fullfilePath}');$wb.SaveAs('${filepathxls}'\,51);$wb.Close();$excel.Quit()",${CreateXls})
    SpreadSheet.Set Excel Path(${filepathxls})
    SpreadSheet.Read Cell Value (Boot_Time,Time (ms),${BaselineBoot})    
    ////1.Baseline_Boot_Time////
    Calculate And Assign (${BaselineBoot}-0,${BaselineBoot_Time})     
    ////installing hpk file and Config in Tenet.
    Common_WorkPath_Library.WorkPath_Installation()
    Common_WorkPath_Library.Portal_Login (${Site},${Username},${Password})
    Functional_WorkPath.T1984992396_Validate_the_Workpath_Agentless_in_SafeQ_Cloud (${Device_IP},${Device_name},${Device_Serial_No})    
    ////First Boot////
    Info.Start Time Check (First_Boot_With_Solution)
    Set Variable (${CSV_Text_Path},${KEYWORD_OUTPUT})
    Set Variable (${Trim_Text},Time check is started and output will be saved to)
    Trim (${CSV_Text_Path},${Trim_Text})
     ReAssign Value To Variable(${filePath_CDrive},${CSV_Text_Path})
    //adding csv extension to the path
    Concatenate Variable Values And Store Result (${filePath_CDrive},csv,${fullfilePath_CSV})
    Info.Mark Start (First_Boot_With_Solution,First_Boot_Time)
    Common_Workpath_Library.Device_Reboot
    Info.Mark End (First_Boot_With_Solution,First_Boot_Time)
    Concatenate Variable Values And Store Result (${filePath_CDrive},xlsx,${filepathxlsx})
    //converting csv to xlsx to read cell value
    Run Command (powershell -Command "$excel=New-Object -ComObject Excel.Application;$wb=$excel.Workbooks.Open('${fullfilePath_CSV}');$wb.SaveAs('${filepathxlsx}'\,51);$wb.Close();$excel.Quit()",${CreateXls})
    SpreadSheet.Set Excel Path(${filepathxlsx})
    SpreadSheet.Set Worksheet(First_Boot_With_Solution)
    SpreadSheet.Read Cell Value (First_Boot_Time,Time (ms),${FirstBoot})
    ////////First Boot ends here ////    
     ////2.FirstBoot_Difference////
    Calculate And Assign (${FirstBoot}-${BaselineBoot},${FirstBoot_Difference})     
    ////Second Boot////
    Info.Start Time Check (Second_Boot_With_Solution)
    Set Variable (${CSV_Path},${KEYWORD_OUTPUT})
    Set Variable (${Trim_Text},Time check is started and output will be saved to)
    Trim (${CSV_Path},${Trim_Text})
    ReAssign Value To Variable(${filePath_C_Drive},${CSV_Path})
    //adding csv extension to the path
    Concatenate Variable Values And Store Result (${filePath_C_Drive},csv,${CSV_FullfilePath})
    Info.Mark Start (Second_Boot_With_Solution,Second_Boot_Time)
    Common_Workpath_Library.Device_Reboot
    Info.Mark End (Second_Boot_With_Solution,Second_Boot_Time)
    Concatenate Variable Values And Store Result (${filePath_C_Drive},xlsx,${filepath_xlsx})
    //converting csv to xlsx to read cell value
    Run Command (powershell -Command "$excel=New-Object -ComObject Excel.Application;$wb=$excel.Workbooks.Open('${CSV_FullfilePath}');$wb.SaveAs('${filepath_xlsx}'\,51);$wb.Close();$excel.Quit()",${CreateXls})
    SpreadSheet.Set Excel Path(${filepath_xlsx})
    SpreadSheet.Set Worksheet(Second_Boot_With_Solution)
    SpreadSheet.Read Cell Value (Second_Boot_Time,Time (ms),${SecondBoot})
    ////Second Boot end here ////    
    ////3.SecondBoot_Difference////
    Calculate And Assign (${SecondBoot}-${BaselineBoot},${SecondBoot_Difference})
    
}

T1985577798_Authentication Timings_UserName_Password
{
    Set Variable (${SignIn_Sum},0)
    Set Variable (${SignOut_Sum},0)
    Repeat:4
    {
        Info.Start Time Check (UserName_Password_Sign_In_${R})
        Set Variable (${Message},${KEYWORD_OUTPUT})
        Set Variable (${Text},Time check is started and output will be saved to)
        Trim (${Message},${Text})        
        //Concatenate Variable Values And Store Result (C,${Message},${filePath}_${R})
        ReAssign Value To Variable(${filePath_variable},${Message})
        Concatenate Variable Values And Store Result (${filePath_variable},csv,${fullfilePath}_${R})
        ReAssign Value To Variable(${fullfilePath_variable},${fullfilePath}_${R})      
        Info.Mark Start (UserName_Password_Sign_In_${R},SignIn_${R})
        Common_Workpath_Library.Device_Username_Login(${Device_Username},${Device_Password})
        Info.Mark End (UserName_Password_Sign_In_${R},SignIn_${R})
        //Concatenate Variable Values And Store Result (${filePath},xlsx,${filepathxls})        
        Concatenate Variable Values And Store Result (${filePath_variable},xlsx,${filepathxls}_${R})
        ReAssign Value To Variable(${filepathxls_variable},${filepathxls}_${R})       
        //converting csv to xlsx to read cell value
        Run Command (powershell -Command "$excel=New-Object -ComObject Excel.Application;$wb=$excel.Workbooks.Open('${fullfilePath_variable}');$wb.SaveAs('${filepathxls_variable}'\,51);$wb.Close();$excel.Quit()",${CreateXls})
        SpreadSheet.Set Excel Path(${filepathxls_variable})
        SpreadSheet.Set Worksheet(UserName_Password_Sign_In_${R})
        SpreadSheet.Read Cell Value (SignIn_${R},Time (ms),${SignIn_Authentication}_${R})        
        ReAssign Value To Variable(${SignIn_Authentication_Time},${SignIn_Authentication}_${R})
        Calculate And Assign (${SignIn_Sum}+${SignIn_Authentication_Time},${SignIn_Sum})        
        //=======================
        //SignOut
        Info.Start Time Check (UserName_Password_Sign_Out_${R})
        Set Variable (${Message},${KEYWORD_OUTPUT})
        Set Variable (${Text},Time check is started and output will be saved to)
        Trim (${Message},${Text})        
        //Concatenate Variable Values And Store Result (C,${Message},${filePath}_${R})
        ReAssign Value To Variable(${filePath_variable},${Message})
        Concatenate Variable Values And Store Result (${filePath_variable},csv,${fullfilePath}_${R})
        ReAssign Value To Variable(${fullfilePath_variable},${fullfilePath}_${R})
        Info.Mark Start (UserName_Password_Sign_Out_${R},SignOut_${R})
        Common_Workpath_Library.Device_Logout
        Info.Mark End (UserName_Password_Sign_Out_${R},SignOut_${R})
        Concatenate Variable Values And Store Result (${filePath_variable},xlsx,${filepathxls}_${R})
        ReAssign Value To Variable(${filepathxls_variable},${filepathxls}_${R})
        //converting csv to xlsx to read cell value
        Run Command (powershell -Command "$excel=New-Object -ComObject Excel.Application;$wb=$excel.Workbooks.Open('${fullfilePath_variable}');$wb.SaveAs('${filepathxls_variable}'\,51);$wb.Close();$excel.Quit()",${CreateXls})
        SpreadSheet.Set Excel Path(${filepathxls_variable})
        SpreadSheet.Set Worksheet(UserName_Password_Sign_Out_${R})
        SpreadSheet.Read Cell Value (SignOut_${R},Time (ms),${SignOut_Authentication}_${R})
        ReAssign Value To Variable(${SignOut_Authentication_Time},${SignOut_Authentication}_${R})
        Calculate And Assign (${SignOut_Sum}+${SignOut_Authentication_Time},${SignOut_Sum})
    }
    Calculate And Assign (${SignIn_Sum}/4,${Avg_SignIn})
    Calculate And Assign (${SignOut_Sum}/4,${Avg_SignOut})
}


T1985577798_Authentication Timings_BadgeBox_SignIn_SignOut(${BADGE_INDEX},${WaitTime})
{
    Set Variable (${SignIn_Sum},0)
    Set Variable (${SignOut_Sum},0)
    Repeat:4
    {
        Info.Start Time Check (BadgeBox_SignIn_${R})
        Set Variable (${Message},${KEYWORD_OUTPUT})
        Set Variable (${Text},Time check is started and output will be saved to)
        Trim (${Message},${Text})        
        //Concatenate Variable Values And Store Result (C,${Message},${filePath}_${R})
        ReAssign Value To Variable(${filePath_variable},${Message})
        Concatenate Variable Values And Store Result (${filePath_variable},csv,${fullfilePath}_${R})
        ReAssign Value To Variable(${fullfilePath_variable},${fullfilePath}_${R})
        Info.Mark Start (BadgeBox_SignIn_${R},SignIn_${R})
        Common_Workpath_Library.Badgebox_Login(${BADGE_INDEX},${WaitTime})
        Info.Mark End (BadgeBox_SignIn_${R},SignIn_${R})
        //Concatenate Variable Values And Store Result (${filePath},xlsx,${filepathxls})        
        Concatenate Variable Values And Store Result (${filePath_variable},xlsx,${filepathxls}_${R})
        ReAssign Value To Variable(${filepathxls_variable},${filepathxls}_${R})
        //converting csv to xlsx to read cell value
        Run Command (powershell -Command "$excel=New-Object -ComObject Excel.Application;$wb=$excel.Workbooks.Open('${fullfilePath_variable}');$wb.SaveAs('${filepathxls_variable}'\,51);$wb.Close();$excel.Quit()",${CreateXls})
        //setExcel Path and Fetch Cell value
        SpreadSheet.Set Excel Path(${filepathxls_variable})
        SpreadSheet.Set Worksheet(BadgeBox_SignIn_${R})
        SpreadSheet.Read Cell Value (SignIn_${R},Time (ms),${SignIn_Authentication}_${R})        
        ReAssign Value To Variable(${SignIn_Authentication_Time},${SignIn_Authentication}_${R})
        Calculate And Assign (${SignIn_Sum}+${SignIn_Authentication_Time},${SignIn_Sum})
        
        //=======================
        //SignOut
        Info.Start Time Check (BadgeBox_SignOut_${R})
        Set Variable (${Message},${KEYWORD_OUTPUT})
        Set Variable (${Text},Time check is started and output will be saved to)
        Trim (${Message},${Text})        
        Concatenate Variable Values And Store Result (C,${Message},${filePath}_${R})
        ReAssign Value To Variable(${filePath_variable},${filePath}_${R})
        Concatenate Variable Values And Store Result (${filePath_variable},csv,${fullfilePath}_${R})
        ReAssign Value To Variable(${fullfilePath_variable},${fullfilePath}_${R})
        Info.Mark Start (BadgeBox_SignOut_${R},SignOut_${R})
        Common_Workpath_Library.Badgebox_LogOut(${BADGE_INDEX},${WaitTime})
        Info.Mark End (BadgeBox_SignOut_${R},SignOut_${R})        
        Concatenate Variable Values And Store Result (${filePath_variable},xlsx,${filepathxls}_${R})
        ReAssign Value To Variable(${filepathxls_variable},${filepathxls}_${R})  
        //converting csv to xlsx to read cell value
        Run Command (powershell -Command "$excel=New-Object -ComObject Excel.Application;$wb=$excel.Workbooks.Open('${fullfilePath_variable}');$wb.SaveAs('${filepathxls_variable}'\,51);$wb.Close();$excel.Quit()",${CreateXls})
        //setExcel Path and Fetch Cell value
        SpreadSheet.Set Excel Path(${filepathxls_variable})
        SpreadSheet.Set Worksheet(BadgeBox_SignOut_${R})
        SpreadSheet.Read Cell Value (SignOut_${R},Time (ms),${SignOut_Authentication}_${R})
        ReAssign Value To Variable(${SignOut_Authentication_Time},${SignOut_Authentication}_${R})
        Calculate And Assign (${SignOut_Sum}+${SignOut_Authentication_Time},${SignOut_Sum})
    }
    Calculate And Assign (${SignIn_Sum}/4,${Avg_SignIn})
    Calculate And Assign (${SignOut_Sum}/4,${Avg_SignOut})
}

