T1984992405_Enable_Printer_HP_SIO
{    
    //Login to printer and release 1 job
    Functional_workpath.Send_Jobs (${Job_Path},${Queue_Name})
    Functional_workpath.HPCC_Device_PIN_Login (${Device_PIN})
    Functional_workpath.HPCC_Print_Release
    
    //Portal login to HPCC
    Functional_workpath.HPCC_Portal_Login(${HPCC_Site},${HPCC_User},${HPCC_Pwd})
    Sleep (5)
    //Click on Signin once button
    //Web.Click Object (//*[@id="app"]/div[5]/div[2]/div[3]/div/div[2]/div[2]/div[3]/div/div[1]/div[1]/img)
    Web.Wait For Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[4]/button,10)
    //Press enable button
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/button[1])
    //Select HP provider from dropdown
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/div[1]/div[2]/div)
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/div[1]/div[2]/div/ul/li[1])
    //Uncheck the box then click next button
    If: Web.IsClickable (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    {
        //Continue
    }
    Fail:
    {
        Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/div[2]/label[1])
        Sleep (2)
        Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    }
    //Type the device name to search for it
    Web.Wait For Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/section/div/section/div[1]/div/div/div[3]/div/input,15)
    Sleep (5)
    Web.Set Text (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/section/div/section/div[1]/div/div/div[3]/div/input,${HPCC_Printer})
    Sleep (5)
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/section/div/section/div[1]/div/div/div[3]/div/span[2])
    //Select model
    Sleep (2)
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/section/div/section/div[2]/div[2]/div/div[1]/div/div[1]/div[2]/div/div/div[1]/span/span[2]/span)
    //Click next
    Web.IsClickable (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    Sleep (2)
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    //Click enable
    Web.Wait For Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2],10)
    Sleep (2)
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    //Click done button
    Web.Wait For Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button,15)
    Sleep (2)
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button)
    //Wait for SIO to be enabled
    Sleep (300)
    Web.Close
    //Run after 2FA enabled
    Functional_workpath.Send_Jobs(${Job_Path},${Queue_Name})
    Functional_workpath.Validate_Printer_SIO
    Functional_workpath.HPCC_SIO_Disable
}

T1984992405_Enable_Printer_Azure_SIO
{
    //Login to printer and release 1 job
    Functional_workpath.Send_Jobs (${Job_Path},${Queue_Name})
    Functional_workpath.HPCC_Device_PIN_Login (${Device_PIN})
    Functional_workpath.HPCC_Print_Release
    
    //Portal login to HPCC
    Functional_workpath.HPCC_Portal_Login(${HPCC_Site},${HPCC_User},${HPCC_Pwd})
    //Click on Signin once button
    //Web.Click Object (//*[@id="app"]/div[5]/div[2]/div[3]/div/div[2]/div[2]/div[3]/div/div[1]/div[1]/img)
    Web.Wait For Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[4]/button,10)
    //Press enable button
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/button[1])
    //Open the dropdown
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/div[1]/div[2]/div)
    //Select Azure
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/div[1]/div[2]/div/ul/li[3])
    Web.Set Text (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/div[2]/div/div[2]/input,${Azure_Tenant})
    //Click next button
    If: Web.IsClickable (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    {
        Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    }
    Fail:
    {
        Fail (Next button not clickable try again)
    }
    //Type the device name to search for it
    Web.Wait For Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/section/div/section/div[1]/div/div/div[3]/div/input,15)
    Web.Set Text (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/section/div/section/div[1]/div/div/div[3]/div/input,${HPCC_Printer})
    Sleep (3)
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/section/div/section/div[1]/div/div/div[3]/div/span[2])
    Sleep (4)
    //Select model
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/section/div/section/div[2]/div[2]/div/div[1]/div/div[1]/div[2]/div/div/div[1]/span/span[2]/span)
    Sleep (5)
    //Click next
    Web.IsClickable (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    //Click enable
    Web.Wait For Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2],10)
    Sleep (2)
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    //Click done button
    Web.Wait For Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button,15)
    Sleep (2)
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button)
    //Wait for SIO to be enabled
    Sleep (300)
    Web.Close
    //Run after 2FA enabled
    Functional_workpath.Send_Jobs(${Job_Path},${Queue_Name})
    Functional_workpath.Validate_Printer_SIO
    Functional_workpath.HPCC_SIO_Disable
}

