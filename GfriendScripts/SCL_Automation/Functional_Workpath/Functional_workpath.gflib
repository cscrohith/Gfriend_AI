using Android
using JediOmni
using Web
using Windows

T1984992393_Validate_SafeQ_Cloud_Scan_To_Email
{
    
    JediOmni.Wait For Object (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button,20)
    JediOmni.Touch ID (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button)
    Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/quick_action_1_text'],20)
    Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/quick_action_1_text'])
    JediOmni.Wait For Object (hpid-button-continue,20)
    JediOmni.Touch ID (hpid-button-continue)
    Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/scan_job_name'],20)
    Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/scan_cancel'])
    Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/quick_action_1_text'],20)
    Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/quick_action_1_text'])
    JediOmni.Wait For Object (hpid-button-continue,20)
    JediOmni.Touch ID (hpid-button-continue)
    If: Android.Wait For Text (Workflow processed successfully,10)
    {
        Pass (Scan to Email successful.Please Check the Inbox and verify that the "Scan to Email" job arrived successfully")
    }
    Fail:
    {
        Fail (Scan to Email Unsuccessful)
    }
}

T1984992418_Validate_pull_print_Functionality_JobDetails
{
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[1],300)
    {
        //Reload Jobs
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[1])
    }
    //To set Job details
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1],200)
    {
        //First Job settings
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1]/node[3])
        //Dropdown Sides
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/exposed_dropdown']/node[1])
        //Sides--> selecting to the flip on short edge
        Android.Touch XPath (//node[@text='Flip on Short Edge'])
        //To set Copies
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/number_picker_text_input_layout']/node[1])
        Android.Input Text (2)
        //Color Mode selecting to Black & White button
        //Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/select_two_button_two'])
        Android.Press Tab Key
        //Print
        If:Android.Wait For Text (Print,30)
        {
            Android.Touch Text (Print)  
            Pass (Print job is Released successfully)
        }
        Fail:
        {
            Fail (No documents available to print)
        }
    }
}

T1984992418_Validate_pull_print_functionality_Single_Print_SelectAll_Print
{
    //Reload Jobs
    Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[1])
    //One Job Print
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1],10)
    {
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1])
        //Print button
        If:Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[2])
        {
            Pass (Print job are Releasing successfully)
        }
    }
    Fail:
    {
        Fail (No documents available to print)
    }
    //SelectAll Print
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1],10)
    {
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1])
        //Select All the jobs
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/select_all'])
        //Print button
        If:Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[2])
        {
            Pass (Print job are Releasing successfully)
        }
    }
    Fail:
    {
        Fail (No documents available to print)
    }
}

T1984992418_Validate_Pull_Print_functionality_Signle_Job_Delete_SelectAll_Delete
{
    Android.Press Home Key
    //Secure Print & Scan
    JediOmni.Touch ID (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button) 
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print'],10)
    {
        //My print jobs button
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print']) 
    }
    //Reload Jobs
    Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[1])
    //One job Delete
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1],40)
    {
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1])
        //Delete button
        If:Android.Wait For Object (com.ysoft.safeq.terminals.hp.hcp:id/delete,10)
        {
            If:Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/delete)
            {
                Pass (Jobs are deleted successfully) 
            }
        }
    }
    Fail:
    {
        Fail (No documents available to Delete)
    }   
    //Select All jobs Delete
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1],10)
    {
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1])
        //Select All the jobs
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/select_all'])     
        //Delete button
        If:Android.Wait For Object (com.ysoft.safeq.terminals.hp.hcp:id/delete,10)
        {
            If:Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/delete)
            {
                Pass (Jobs are deleted successfully) 
            }
        }
    }
    Fail:
    {
        Fail (No documents available to delete)
    } 
}

T1984992404_Validate_Print_Queue_Creation-Direct_Print(${Direct_Print_Queue_Name},${Printer_Name})
{
    Sleep (2)
    //Printers button
    If:Web.Wait For Object (//div[@data-test-id='label' and text()='Printers'],10)
    {
        Web.Click Object (//div[@data-test-id='label' and text()='Printers'])
        Sleep(2)
        //Print queues button
        Web.Wait For Object (//a[@data-test-id='link.input_ports'],20)
        Web.Click Object (//a[@data-test-id='link.input_ports'])
        //Add button
        Web.Wait For Object (//a[@role='button' and text()='Add'],10)
        Web.Click Object (//a[@role='button' and text()='Add'])
        //Name Textbox
        Web.Wait For Object (//input[@data-test-id='data.name'],10)
        Web.Click Object (//input[@data-test-id='data.name'])
        Sleep (2)
        Web.Set Text (//input[@data-test-id='data.name'],${Direct_Print_Queue_Name})
        Sleep(2)
        //Queuetype dropdown
        Web.Wait For Object(//div[text()='Queue type']/following::span[@aria-label='select'][1],10)
        Web.Click Object (//div[text()='Queue type']/following::span[@aria-label='select'][1])
        //Direct Print Queue
        Web.Wait For Object (//ul[contains(@class\,'k-list')]//li[text()='Direct print queue'],10)
        Web.Click Object (//ul[contains(@class\,'k-list')]//li[text()='Direct print queue'])
        //Select Printer dropdrown
        Web.Wait For Object (//div[text()='Printer']/following::span[@aria-label='select'][1],10)
        Web.Click Object (//div[text()='Printer']/following::span[@aria-label='select'][1])
        Sleep (2)
        //Set Printer
        Windows.Send Key (${Printer_Name})
        Sleep (2)
        Windows.Send Special Key ([ENTER])
        //Save button
        Web.Wait For Object (//input[@data-test-id='saveBtn'],10)
        Web.Click Object (//input[@data-test-id='saveBtn'])  
    }
    Fail:
    {
        Fail (Failed to create Direct print queue)
    }
}

T1984992404_Validate_Print_Queue_Creation-Pull_Print(${Pull_Print_Queue_Name},${Printer_Name})
{
    Sleep (2)
    //Printers button
    If: Web.Wait For Object (//div[@data-test-id='label' and text()='Printers'],10)
    {
        Web.Click Object (//div[@data-test-id='label' and text()='Printers'])
        Sleep(2)
        //Print queues button
        Web.Wait For Object (//a[@data-test-id='link.input_ports'],20)
        Web.Click Object (//a[@data-test-id='link.input_ports'])
        Sleep (2)
        //Add button
        Web.Wait For Object (//a[@role='button' and text()='Add'],10)
        Web.Click Object (//a[@role='button' and text()='Add'])
        Sleep (2)
        //Name Textbox
        Web.Wait For Object (//input[@data-test-id='data.name'],10)
        Web.Click Object (//input[@data-test-id='data.name'])
        Web.Set Text (//input[@data-test-id='data.name'],${Pull_Print_Queue_Name})
        //Queuetype dropdown
        Web.Wait For Object(//div[text()='Queue type']/following::span[@aria-label='select'][1],10)
        Web.Click Object (//div[text()='Queue type']/following::span[@aria-label='select'][1])
        //Pull Print Queue
        Web.Wait For Object (//ul[@role='listbox']//li[text()='Pull print queue'],10)
        Web.Click Object (//ul[@role='listbox']//li[text()='Pull print queue'])
        Sleep (2)
        //Save button
        Web.Wait For Object (//input[@data-test-id='saveBtn'],10)
        Web.Click Object (//input[@data-test-id='saveBtn'])
        Sleep (2)
        Web.Close
    }
    Fail:
    {
        Fail (Failed to create Pull print queue)  
    }
}

SynchronizePrinter()
{
    Windows.Select Application (Taskbar) 
    Windows.Wait For ID (SystemTrayIcon,10)
    Windows.Click ID (SystemTrayIcon)
    Windows.Select Application (System tray overflow window.)
    Windows.Wait For ID (NotifyItemIcon,10)
    Sleep(2)
    Windows.Click By Tooltip (NotifyItemIcon,SAFEQ Cloud Client)
    Windows.Select Application (Context)
    Windows.Click Name (Synchronize printers now)
}
 
Validate_Pull_Job_Printed(${Job_Name})
{
    If: JediOmni.Wait For Object (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button,10)
    {
       //Secure Print & Scan
       JediOmni.Touch ID (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button)
    }
    Fail:
    {
      Android.Press Home Key
      //Secure Print & Scan
      JediOmni.Touch ID (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button) 
    }
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print'],10)
    {
       //My print jobs button
       Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print']) 
    }
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[1],30)
    {
        //Reload Jobs
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[1])
    }
    //To select job from list
    If: Android.Is Text Exists (${Job_Name})
    {
        Android.Touch Text (${Job_Name})
    }
    Fail:
    {
        Fail (No documents available to print)
    }
    //Print button
    If:Android.Wait For Text (Print,30)
    {
        //Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[2])
        Android.Touch Text (Print)
        Pass (Print Job is released successfully)
    }
}

Validate_Direct_Job_Printed(${Job_Name})
{
    //Peronal dropdown
    Web.Wait For Object (//div[@data-test-id='label' and text()='Personal'],10)
    Web.Click Object (//div[@data-test-id='label' and text()='Personal'])
    Sleep (2)
    //My Documents button
    Web.Wait For Object (//div[@data-test-id='label'][normalize-space()='My documents'],10)
    Web.Click Object (//div[@data-test-id='label'][text()='My documents'])
    Sleep (2)
    //Printed
    Web.Wait For Object (//span[normalize-space()='Printed'],30)
    Web.Click Object (//span[normalize-space()='Printed'])
    Web.ScrollDownToParicularObject (//tr[@data-test-id='list'])
    Web.ScrollDownToParicularObject ((//tr[@data-test-id='list'])[last()])
    Windows.Send Special Key([DOWN])
    Sleep (2)
    //Checking Job name exists
    If: Web.Wait For Text (${Job_Name},10)
    {
        Pass(Direct print queue job printed Successfully)
    }
    Fail:
    {
        Fail (Job is not created or printed)
    }
}

T1993711401_Validate_Scanning_workflows_not_truncated(${Scan_to_Email})
{
    Sleep (2)
    //Scanning button
    Web.Wait For Object (//div[@data-test-id='label' and text()='Scanning'],50)
    Web.Click Object (//div[@data-test-id='label' and text()='Scanning'])
    //Edit button for Scan To Email
    Web.Wait For Object (//tr[.//td[normalize-space()='Email (SMTP)']]//span[@data-title='Edit']//a,10)
    Web.Click Object (//tr[.//td[normalize-space()='Email (SMTP)']]//span[@data-title='Edit']//a)
    Sleep (2)
    //Name textbox
    Web.Wait For Object (//input[@data-test-id='name'],10)
    Web.Click Object (//input[@data-test-id='name'])
    Web.Set Text (//input[@data-test-id='name'],${Scan_to_Email})
    Sleep (2)
    //Save button
    Web.Wait For Object (//input[@data-test-id='saveBtn'],10)
    Web.Click Object (//input[@data-test-id='saveBtn'])
    Sleep (2)
    Web.Close
    If: JediOmni.Wait For Text (Sign In,5)
    {
        Pass(User session logged out Successfully)
    }
    Fail:
    {
        Fail (User session is not logged out)
    }    
}

Validate_ScanToEMail_Name_Updated(${Scan_to_Email})
{
    If: JediOmni.Wait For Object (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button,10)
    {
       //Secure Print & Scan
       JediOmni.Touch ID (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button)
    }
    Fail:
    {
      Android.Press Home Key
      //Secure Print & Scan
      JediOmni.Touch ID (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button) 
    }
    //My Scan workflows button
    Android.Wait For Object (com.ysoft.safeq.terminals.hp.hcp:id/scan,15)
    Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/scan)
    If:Android.Is Text Exists (${Scan_to_Email})
    {
        Pass (Name is not truncated.)
    }
}

Validate_and_generate_the_SafeQ_report_Before_Print()
{   
    Web.Get Text (//div[@data-test-chart-name='Print Pages']//div[contains(@class\,'big_number_total')],${Before_Print}) 
    Web.Close
}

Validate_and_generate_the_SafeQ_report_after_Print(${Before_Print})
{
    Web.Get Text (//div[@data-test-chart-name='Print Pages']//div[contains(@class\,'big_number_total')],${After_Print})
    BuiltIn.Equals (${Before_Print},${After_Print})
    If: BuiltIn.Has Value Increased (${Before_Print},${After_Print})
    {
        Pass (Print Jobs are increased successfully)
    }
    Fail:
    {
        Fail (Print Jobs are not increasing)
    }
    Web.Close
}

