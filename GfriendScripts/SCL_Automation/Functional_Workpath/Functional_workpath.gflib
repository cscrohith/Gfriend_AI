               Web.ScrollDownToParicularObject (//input[@data-test-id='saveBtn' and @value='Save'])
               Web.Click Object (//input[@data-test-id='saveBtn' and @value='Save'])
               Sleep (5)
               Web.Click Object (//tr[td[normalize-space()='Workpath']]//span[@data-title='Deployment actions']//a)
               Sleep (5)
               Web.Wait For Object (//*[@data-test-id='searchInput'],10)
               Web.Click Object (//*[@data-test-id='searchInput'])
               Web.Append Text (//*[@data-test-id='searchInput'],${Device_IP})
                    
               Sleep (15)
               //Clicks on the Select all    
               Web.Click Object (//input[@data-test-id='selectAll'])
                              
               Sleep (5)
               //click on the configure
               Web.Click Object (//button[@data-test-id='configure'])
               If: Web.Wait For Object (//span[@data-test-id='deployStatusStage' and normalize-space()='Configured'],120)
                  {
                       Pass (Device configured successfully )
                   }
                   Fail:
                   {
                       Fail (Configuration failed)
                       Stop Test Case
                   }
           }   
}
 

      
      
T1984992391_Validate_SafeQ_Cloud_Device_Configuration_Workpath(${Device_IP},${Device_name},${Device_Serial_No})
{
     If: Web.Wait For Object (//a[@data-test-id='menuItemLink' and .//div[@data-test-id='label' and normalize-space()='Printers']],5)
    {
        Web.Click Object (//a[@data-test-id='menuItemLink' and .//div[@data-test-id='label' and normalize-space()='Printers']])
    }
    Fail:
    {
        Fail (Unable to click the Printer option)
        Stop Test Suite
    }
    
    //waits for Add Printer button
    If: Web.Wait For Object (//a[@role='button' and normalize-space()='Add printers'],30)
    {
        Sleep (10)
        Web.Click Object (//a[@role='button' and normalize-space()='Add printers'])
        
       Web.Wait For Object (//span[text()='One printer (Advanced)'],30)
       Web.Click Object (//span[text()='One printer (Advanced)'])
        //Clicks on the name 
        If:Web.Wait For Object (//input[@data-test-id='data.name'],30)
        {
            Web.Set Text(//input[@data-test-id='data.name'],${Device_name})
        } 
        Fail:
        {
            Fail (page is not in the add printers)
            Stop Test Case
        }
        
      
        //Clicks on the IP address 
        Web.Wait For Object (//input[@data-test-id='data.address'],10)
        Web.Set Text (//input[@data-test-id='data.address'],${Device_IP})
        
        
        // Open vendor dropdown
         Web.Click Object (//select[@data-test-id='vendor']/parent::span)
        

        // Select HP
         Web.Click Object (//li[normalize-space()='HP'])
        
        //Select Gateway Radiobutton
        Web.ScrollDownToParicularObject (//span[@data-test-id='title' and normalize-space()='Release options'])
        Web.Wait For Text (Gateway,30) 
        Web.Click Object (//input[@data-test-id='connectionMethod_Gateway'])
        Sleep (5)
        //Updates Device serial number 
        Web.ScrollDownToParicularObject (//*[@id="detail-view"])
        Web.Wait For Object (//input[@data-test-id='data.deviceSerial'],30)
        Web.Set Text (//input[@data-test-id='data.deviceSerial'],${Device_Serial_No})
        Sleep (5)
        
        // Open template dropdown
        Web.Click Object (//div[@data-test-id='terminalConfig']//span[@role='listbox'])
        Sleep (3)
        Web.Click Object (//label[normalize-space()='Embedded terminal template']/following::span[@role='listbox'][1])
        Sleep (2)
        
        // Select Workpath
        Web.Click Object (//li[normalize-space()='Workpath'])
       
        Sleep (5)
        //Clicks on the save button
        Web.ScrollDownToParicularObject (//*[@id="detail-view"])
        Web.Click Object (//input[@value='Add'])
        Web.Wait For Object (//a[@role='button' and normalize-space()='Add printers'],30)
    }                        
        If: Web.Wait For Text (${Device_IP},10)
        {
            Web.Press PageUp Key (//*[@id="detail-view"])
            Web.Wait For Object (//span[@data-test-id='message'],10)
            Pass (Printer details is saved successfully)
        }
        Fail:
        {
            Fail (Printer details is not saved)
            Stop Test Suite
        }
        
    //clicks on the ETT
    Web.Press PageUp Key (//*[@id="detail-view"])
    Sleep (5)
    Web.Wait For Object (//a[@data-test-id='link.embedded_templates'],30)
    Web.Click Object (//a[@data-test-id='link.embedded_templates'])
    Sleep (5)
    
     //Selects Workpath
      Web.Press PageUp Key (//*[@id="detail-view"])
      If: Web.Wait For Object (//tr[td[normalize-space()='Workpath']]//span[@data-title='Deployment actions']//a,20)
      {
          Web.Click Object (//tr[td[normalize-space()='Workpath']]//span[@data-title='Deployment actions']//a) 
      }
      Fail:
      {
          Fail (Unale to find the deployment actions in the current page please do re-run the testcase and before re-run delete the device details)
          Stop Test Case
      }
      
      Sleep (5)
      Common_WorkPath_Library.Workpath_Configure (${Device_IP})  
      
      
      //Check if Configured
      If: Web.Wait For Object (//span[@data-test-id='deployStatusStage' and normalize-space()='Configured'],120)
            {
                Pass (Device configured successfully)
            }
      Fail:
            {
               //Check if Failed
               If: Web.Wait For Object (//span[@data-test-id='deployStatusIcon' and contains(@class\,'failed')],10)
                   {
                        

                      //Click Edit for particular IP
                       Web.Click Object (//tr[@data-test-id='stateList' and .//span[@data-test-id='address' and normalize-space()='${Device_IP}']]//span[@data-test-id='edit'])

                       //Click Advanced setup
                       Web.Click Object (//a[.//span[normalize-space()='Advanced setup']])

                        //Enter password
                        Web.Set Text (//div[@data-test-id='adminPassword']//input[@type='password'],${Device_Password})

                        //Save
                        Web.Click Object (//input[@data-test-id='saveBtn'])
                        Common_WorkPath_Library.Workpath_Configure (${Device_IP})

                        Sleep (10)

                        //Check again if Configured
                        If: Web.Wait For Object (//span[@data-test-id='deployStatusStage' and normalize-space()='Configured'],120)
                        {
                            Pass (Device configured successfully after Advanced Setup)
                        }
                        Fail:
                        {
                            Fail (Configuration failed even after Advanced Setup)
                            Stop Test Suite
                        }
        }
}
} 


