///////////////////////////////////////////////////////////////////////////////////////////////////////
// Routine:         Send_Small_Word_Document_For_Print
//        
// Description:     Send a word document kept in path {Working Directory}\print-documents\word-doc\testfile.docx
//
// Arguments:       None
//
// Pre-requisites:  1. The test file should be placed in correct directory path: {Working Directory}\print-documents\word-doc\
//                  2. The test file should be named testfile.docx
//                  3. Correct version of MS Word should be installed on computer
///////////////////////////////////////////////////////////////////////////////////////////////////////
Send_Small_Word_Document_For_Print(${word-document-file},${print-queue-name},${alt-f},${p-key})
{
    Sleep(10)
    If:Windows.Open File For Print(${word-document-file},${print-queue-name})
    {
        Windows.Click ID (1)

        //Because the Click Print button doesn't work with word documents
        //This is an alternate approach to click the print button. i.e., Alt+F, P, P
        //Click Alt+F Keys
        If:Windows.Send Special Key (${alt-f})
        {
            Sleep(1)
            // Click 'P' button on keyboard
            If:Windows.Send Key (${p-key})
            {
                Sleep(1)
                If:Windows.Send Key (${p-key})
                {
                    Sleep(1)
                    Pass(File: ${word-document-file} sent to print queue successfully.)
                    Sleep(5)
                    //Windows.Close Application
                }
            }
        }
        Fail:
        {
            Fail(Failed to click print button)
            Windows.Close Application ()
        }
        Error:
        {
            Error(Error trying to click print button
            Windows.Close Application
        }
    }
    Fail:
    {
        Fail(Failed to open the word file in path: ${word-document-file})
    }
    Error:
    {
        Error(Error trying to send job to print queue)
    }
}

///////////////////////////////////////////////////////////////////////////////////////////////////////
// Routine:         Send_Small_Excel_Document_For_Print
//        
// Description:     Send a excel document kept in path {Working Directory}\print-documents\excel-doc\testfile.txt
//
// Arguments:       None
//
// Pre-requisites:  1. The test file should be placed in correct directory path: {Working Directory}\print-documents\excel-doc\
//                  2. The test file should be named testfile.xlsx
///////////////////////////////////////////////////////////////////////////////////////////////////////
Send_Small_Excel_Document_For_Print(${excel-document-file},${print-queue-name},${alt-f},${ultra-short-wait},${medium-wait},${p-key})
{
    If:Windows.Open File For Print(${excel-document-file},${print-queue-name})
    {
        Windows.Click ID (1)

        //Because the Click Print button doesn't work with excel documents
        //This is an alternate approach to click the print button. i.e., Alt+F, P, P
        //Click Alt+F Keys
        If:Windows.Send Special Key (${alt-f})
        {
            Sleep(${ultra-short-wait})
            // Click 'P' button on keyboard
            If:Windows.Send Key (${p-key})
            {
                Sleep(${ultra-short-wait})
                If:Windows.Send Key (${p-key})
                {
                    Sleep(${ultra-short-wait})
                    Pass(File: ${excel-document-file} sent to print queue successfully.)
                    Sleep(${medium-wait})
                    //Windows.Close Application
                    Sleep(${medium-wait})
                }
            }
        }
        Fail:
        {
            Fail(Failed to click print button)
            Windows.Close Application
        }
        Error:
        {
            Error(Error trying to click print button
            Windows.Close Application
        }
    }
    Fail:
    {
        Fail(Failed to open the word file in path: ${excel-document-file})
    }
    Error:
    {
        Error(Error trying to send job to print queue)
    }
}

///////////////////////////////////////////////////////////////////////////////////////////////////////
// Routine:         Send_Small_Presentation_For_Print
//        
// Description:     Send a ppt document kept in path {Working Directory}\print-documents\ppt-doc\testfile.txt
//
// Arguments:       None
//
// Pre-requisites:  1. The test file should be placed in correct directory path: {Working Directory}\print-documents\ppt-doc\
//                  2. The test file should be named testfile.pptx
//                  3. Microsoft office suite should be installed on the computer
///////////////////////////////////////////////////////////////////////////////////////////////////////
Send_Small_Presentation_For_Print(${ppt-document-file},${print-queue-name},${ultra-short-wait},${alt-f},${p-key})
{
    Sleep(${ultra-short-wait})
    If:Windows.Open File For Print(${ppt-document-file},${print-queue-name})
    {
        Windows.Click ID (1)

        //Because the Click Print button doesn't work with excel documents
        //This is an alternate approach to click the print button. i.e., Alt+F, P, P
        //Click Alt+F Keys
        If:Windows.Send Special Key (${alt-f})
        {
            Sleep(1)
            // Click 'P' button on keyboard
            If:Windows.Send Key (${p-key})
            {
                Sleep(1)
                If:Windows.Send Key (${p-key})
                {
                    Sleep(1)
                    Pass(File: ${ppt-document-file} sent to print queue successfully.)
                    Sleep(5)
                    //Windows.Close Application
                }
            }
        }
        Fail:
        {
            Fail(Failed to click print button)
            Windows.Close Application
        }
        Error:
        {
            Error(Error trying to click print button
            Windows.Close Application
        }
    }
    Fail:
    {
        Fail(Failed to open the word file in path: ${ppt-document-file})
    }
    Error:
    {
        Error(Error trying to send job to print queue)
    }
}

///////////////////////////////////////////////////////////////////////////////////////////////////////
// Routine:         Send_Small_PDF_For_Print
//        
// Description:     Send a PDF document kept in path {Working Directory}\print-documents\pdf-doc\testfile.pdf
//
// Arguments:       None
//
// Pre-requisites:  1. The test file should be placed in correct directory path: {Working Directory}\print-documents\pdf-doc\.
//                  2. User should update the value of variable '${pdf-document-file}' in file Common_Workflow_Variable.gfvar
//                  2. The test file should be named testfile.pdf
//                  3. Adobe acrobat reader should be installed on test computer.
///////////////////////////////////////////////////////////////////////////////////////////////////////
Send_Small_Pdf_For_Print(${pdf-document-file},${print-queue-name},${extra-long-wait},${alt-f4})
{
    If:Windows.Print File To Print Queue (${pdf-document-file},${print-queue-name})
    {
        // GFriend execution is too fast.
        Sleep(${extra-long-wait})
        // Close Adobe application
        //Windows.Send Special Key (${alt-f4})
    }
    Fail:
    {
        Fail (Failed to open the PDF file or send it to the print queue. File path: ${pdf-document-file}, print queue: ${print-queue-name})
    }
    Error:
    {
        Error (Error while opening PDF file or sending it to the print queue. File path: ${pdf-document-file}, print queue: ${print-queue-name})
    }
}

///////////////////////////////////////////////////////////////////////////////////////////////////////
// Routine:         Send_Small_Image_For_Print
//        
// Description:     Send an image document kept in path {Working Directory}\print-documents\image-doc\testfile.jpg
//
// Arguments:       None
//
// Pre-requisites:  1. The test file should be placed in correct directory path: {Working Directory}\print-documents\image-doc\
//                  2. The test file should be named testfile.jpg
//                  3. User should update the value of variable '${image-document-file}' in file Common_Workflow_Variable.gfvar
///////////////////////////////////////////////////////////////////////////////////////////////////////
Send_Small_Image_File_For_Print(${mspaint-executable-path},${image-document-file},${print-queue-name},${cannot-complete-operation-OK-button},${short-wait})
{
    // Due to limitation in GFriend keywords, path for image file is hardcoded. User needs to update these paths to use the // correct file for printing. 
    If:Windows.Print PDF or Image With Application (${mspaint-executable-path},${image-document-file},${print-queue-name})
    {
        // Windows opens 'Can't complete operation' notification box. Close it to proceed.
        If:Windows.Is Exist(${cannot-complete-operation-OK-button})
        {
            Windows.Click ID (${cannot-complete-operation-OK-button})
            Sleep(${short-wait})
        }

        // Click the 'Print' button.
        If:Windows.Is Exist(${print-image-button})
        {
            Windows.Click ID (${print-image-button})
            Sleep(${short-wait})
        }
        Fail:
        {
            Fail (Failed to click Print button on 'Printing from Win32 application' Print page. Please check if MS-Paint is availble in the path: ${mspaint-executable-path} and test image is available in path ${image-document-file} )
        }
        Error:
        {
            Error (Error while clicking Print button on 'Printing from Win32 application' Print page. Please check if MS-Paint is availble in the path: ${mspaint-executable-path} and test image is available in path ${image-document-file})
        }
    }
    Fail:
    {
        Fail (Failed to click Print button on 'Printing from Win32 application' Print page. Please check if MS-Paint is availble in the path: ${mspaint-executable-path} and test image is available in path ${image-document-file} )
    }
    Error:
    {
        Error (Error while clicking Print button on 'Printing from Win32 application' Print page. Please check if MS-Paint is availble in the path: ${mspaint-executable-path} and test image is available in path ${image-document-file})
    }
}

///////////////////////////////////////////////////////////////////////////////////////////////////////
// Routine:         Send_Small_Notepad_Document_For_Print
//        
// Description:     Send a notepad document kept in path {Working Directory}\print-documents\text-doc\testfile.txt
//
// Arguments:       None
//
// Pre-requisites:  1. The test file should be placed in correct directory path: {Working Directory}\print-documents\text-doc\
//                  2. The test file should be named testfile.txt
//                  3. The default application for .text files should be notepad.
///////////////////////////////////////////////////////////////////////////////////////////////////////
Send_Small_Notepad_File_For_Print(${text-document-file},${print-queue-name},${medium-wait})
{
    If: Windows.Print File To Print Queue(${text-document-file},${print-queue-name})
    {
        // Give some time to actually open the file and send it.
        Sleep(${medium-wait})
        Pass (Print job is sent) 
    } 
    Fail:
    {
        Fail (Failed to send print job. File path: ${text-document-file} and print queue:c${print-queue-name})
    }
    Error:
    {
        Error (Error to send print job. File path: ${text-document-file} and print queue:c${print-queue-name})
    }
}


// ************************************************************************************************************
// *     Common Test case for operating printer.                                                              *              
// ************************************************************************************************************
Reset_Printer(${signout-text},${jediomni-sign-out-button}, ${logout-button},${short-wait}, ${medium-wait}, ${long-wait})
{
    // During first iteration, the device is in sleep mode.
    // It takes more time to wake and calliberate.
    JediOmni.Is Awake

    If:JediOmni.Wait For Text (${signout-text},${short-wait})
    {
        JediOmni.Touch ID(${jediomni-sign-out-button})
        JediOmni.Wait For Enable of Object (${jediomni-sign-in-button},${medium-wait})
    }

    If: Android.Wait For XPath (${logout-button},${medium-wait})
    {
        Android.Touch XPath (${logout-button})
        Sleep(${short-wait})
    }
    JediOmni.Reset
    Sleep(${long-wait})
}



Open_SafeQ_SecurePrint_And_Scan_App(${secure-print-and-scan-app-icon},${short-wait},${medium-wait})
{
    Sleep(${medium-wait})
    If: JediOmni.Wait For Enable of Object(${secure-print-and-scan-app-icon},${medium-wait})
    {
        If: JediOmni.Touch ID (${secure-print-and-scan-app-icon})
        {
            Sleep(${short-wait})
        }
        Fail:
        {
            Fail(Failed to click on 'SafeQ' application icon on printer homescreen.)
        }
        Error:
        {
            Error(Error while trying to click on 'SafeQ' application icon on printer homescreen.)
        }
    }
    Fail:
    {
        Fail(Failed to find the 'SafeQ' application on printer homescreen.)
    }
    Error:
    {
        Error(Error while trying to find the 'SafeQ' applicaiton on printer homescreen.)
    }
}

Wait_For_MyQuickActions_Page_To_Load(${my-print-jobs-app-icon},${short-wait},${medium-wait})
{
    While:!Android.Wait For XPath (${my-print-jobs-app-icon},${short-wait}):${medium-wait} 
    {
        Sleep(${short-wait})
    }
    If: Android.Wait For XPath (${my-print-jobs-app-icon},${short-wait})
    {
        Return With Pass ('My Quick Actions' page loaded successfully)
    }
    Fail:
    {
        Return With Fail ('My Quick Actions' page not loaded successfully)
    }
    Error
    {
        Return With Error ('My Quick Actions' page not loaded successfully)
    }
}

