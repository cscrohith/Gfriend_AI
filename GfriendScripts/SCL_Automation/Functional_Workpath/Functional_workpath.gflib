T1984992389_Validate_SafeQ_Cloud_Authentication_PIN_Workpath(${EWS_Password},${Device_PIN},${Device_IP})
{
    
   If: Web.Wait For Object (//div[@data-test-id='userMenu']//button,30)
    {
        Web.Wait For Object (//a[@data-test-id='menuItemLink' and .//div[@data-test-id='label' and normalize-space()='Printers']],10)
        Web.Click Object (//a[@data-test-id='menuItemLink' and .//div[@data-test-id='label' and normalize-space()='Printers']])
    }
    Fail:
    {
        Fail (Unable to click the Printer option)
        Stop Test Suite
    }
    //clicks on the embedded_templates
    If: Web.Wait For Object (//a[@data-test-id='link.embedded_templates'],30) 
    {
     Web.Click Object (//a[@data-test-id='link.embedded_templates'])
            Sleep (5)   
    }
    Fail:
    {
        Fail (unable to click on the Embedded Terminal Templtes)
    }
    Sleep (5)
     Web.Click Object (//tr[.//td[contains(text()\,'Workpath')]]//a[contains(@class\,'k-grid-view')])
    
    
    Sleep (5)
    //clicks on the type of login dropdown
    Web.Click Object (//select[@data-test-id='loginDropdown']/preceding::span[contains(@class\,'k-dropdown')][1])
    
    //waits and cliks on the PIN login
    Web.Wait For Object (//li[contains(text()\,'PIN login')],10)
    Web.Click Object (//li[contains(text()\,'PIN login')])
    Sleep (10)
    
    //scroll and click on the save button
    Web.ScrollDownToParicularObject (//*[@id="detail-view"])
    If: Web.Wait For Object (//input[@data-test-id='saveBtn'],10)
      {
          Web.Click Object (//input[@data-test-id='saveBtn'])
      } 
      Fail:
      {
          Fail (unable to change PIN authentication)
          Stop Test Case
      }
    
    //waits and click on the users tab    
      Web.Wait For Object (//div[@data-test-id='label' and normalize-space()='Users'],10)
      Web.Click Object (//div[@data-test-id='label' and normalize-space()='Users'])
      
      //waits and click on the admin edit option
      Web.Wait For Object (//tr[.//td[normalize-space()='rdladmin@amblr.com']]//a[contains(@class\,'k-grid')],10)
      Sleep (5)
      Web.Click Object (//tr[.//td[normalize-space()='rdladmin@amblr.com']]//a[contains(@class\,'k-grid')])
      
      Web.Wait For Object (//a[.//span[normalize-space()='General setup']],10)
      
      //scroll down to the PIN text box and the pin 
      Web.ScrollDownToParicularObject (//input[@data-test-id='shortId'])
      Web.Set Text (//input[@data-test-id='shortId'],${Device_PIN})
      
      
      //scroll down and click the save button
      Web.ScrollDownToParicularObject (//input[@data-test-id='saveBtn'])
      If: Web.Wait For Object (//input[@data-test-id='saveBtn'],10)
      {
          Web.Click Object (//input[@data-test-id='saveBtn'])
      } 
      Fail:
      {
          Fail (unable to save the PIN)
          Stop Test Case
      }
    
      Sleep (5)
      
      //wait and clicks on the Printers tab 
      Web.Wait For Object (//a[@data-test-id='menuItemLink' and .//div[@data-test-id='label' and normalize-space()='Printers']],10)
        Web.Click Object (//a[@data-test-id='menuItemLink' and .//div[@data-test-id='label' and normalize-space()='Printers']])
    
    //clicks on the embedded_templates
    If: Web.Wait For Object (//a[@data-test-id='link.embedded_templates'],30) 
    {
     Web.Click Object (//a[@data-test-id='link.embedded_templates'])
        
    }
    Fail:
    {
        Fail (unable to click on the Embedded Terminal Templtes)
        Stop Test Case
    }
    Sleep (10)
    Web.ScrollDownToParicularObject (//tr[td[normalize-space()='Workpath']]//span[@data-title='Deployment actions']//a)
    Web.Click Object (//tr[td[normalize-space()='Workpath']]//span[@data-title='Deployment actions']//a)
    Sleep (5)
    Web.Wait For Object (//*[@data-test-id='searchInput'],10)
    Web.Click Object (//*[@data-test-id='searchInput'])
    Web.Append Text (//*[@data-test-id='searchInput'],${Device_IP})
            
    Sleep (15)
    //Clicks on the Select all    
    Web.Click Object (//input[@data-test-id='selectAll'])
                      
    Sleep (5)
    //click on the configure
    Web.Click Object (//button[@data-test-id='configure'])
    If: Web.Wait For Object (//span[@data-test-id='deployStatusStage' and normalize-space()='Configured'],120)
          {
               Pass (Device configured successfully )
           }
     Fail:
           {
              Web.Wait For Object (//a[.//span[@data-test-id='title' and normalize-space()='Embedded terminal templates']],10)
               Web.Click Object (//a[.//span[@data-test-id='title' and normalize-space()='Embedded terminal templates']])
               Web.Wait For Object (//tr[.//td[contains(normalize-space(),'Workpath')]]//span[@data-title='Edit']//a,10)
               Web.Click Object (//tr[.//td[contains(normalize-space(),'Workpath')]]//span[@data-title='Edit']//a)
               Web.Wait For Object (//input[@type='password' and @data-test-id='textField'],10)
               Web.Clear Text Field (//input[@type='password' and @data-test-id='textField'])
               Web.Set Text (//input[@type='password' and @data-test-id='textField'],${EWS_Password})
               Web.ScrollDownToParicularObject (//input[@data-test-id='saveBtn' and @value='Save'])
               Web.Click Object (//input[@data-test-id='saveBtn' and @value='Save'])
               Sleep (5)
               Web.Click Object (//tr[td[normalize-space()='Workpath']]//span[@data-title='Deployment actions']//a)
               Sleep (5)
               Web.Press PageUp Key (//*[@id="detail-view"])
               Web.Wait For Object (//*[@data-test-id='searchInput'],10)
               Web.Click Object (//*[@data-test-id='searchInput'])
               Web.Append Text (//*[@data-test-id='searchInput'],${Device_IP})
                    
               Sleep (15)
               //Clicks on the Select all    
               Web.Click Object (//input[@data-test-id='selectAll'])
                              
               Sleep (5)
               //click on the configure
               Web.Click Object (//button[@data-test-id='configure'])
               If: Web.Wait For Object (//span[@data-test-id='deployStatusStage' and normalize-space()='Configured'],120)
                  {
                       Pass (Device configured successfully )
                   }
                   Fail:
                   {
                       Fail (Configuration failed)
                       Stop Test Case
                   }
           }
}
       
      
      
