T1984992392_Validate_SafeQ_Cloud_Pull_Print_Options-Workpath()
{
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[1],300)
    {
        //Reload Jobs
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[1])
    }
    //To set Job details
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1],20)
    {
        //First Job settings
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1]/node[3])
        //Dropdown Sides
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/exposed_dropdown']/node[1])
        //Sides--> selecting to the flip on short edge
        Android.Touch XPath (//node[@text='Flip on Short Edge'])
        //To set Copies
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/number_picker_text_input_layout']/node[1])
        Android.Input Text (2)
        Android.Press Tab Key
        //Print
        Android.Touch XPath (//node[@class='android.widget.Button'])
    }
    If: Android.Wait For Text (Your print job has been sent to the printer, 30)
    {
        Pass (Print job is Released successfully)  
    }
    Fail:
    {
        Fail (No documents available to print)
    }
    //Delete one Job
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1],10)
    {
        //FirstJob
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1])
        //Delete button
        //Android.Touch XPath ( //node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/delete'])
        If:Android.Wait For Object (com.ysoft.safeq.terminals.hp.hcp:id/delete,10)
        {
            If:Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/delete)
            {
                Pass (Jobs are deleted successfully) 
            }
        }
    }
    Fail:
    {
        Fail (No documents available to print)
    }   
    //DeleteAll
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1],10)
    {
        //FirstJob
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1])
        //Select All the jobs
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/select_all'])
        //Delete button
        If:Android.Wait For Object (com.ysoft.safeq.terminals.hp.hcp:id/delete,10)
        {
            If:Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/delete)
            {
                Pass (Jobs are deleted successfully) 
            }
       }
    }
}

T1984992403_Portal_Login_WaitForWindowsDownloadedFile(${Site},${Username},${Password},${SafeQExeFilePath})
{
    If: Web.Open with Edge (${Site},180)
    {
        Sleep (2)
        //Username Filed
        Functional_workpath.WaitAndClickTextbox(/html/body/div[1]/div/div/form/div[2]/div[3]/input,${Username},Username)
        //Password Filed
        Functional_workpath.WaitAndClickTextbox(/html/body/div[1]/div/div/form/div[2]/div[4]/input,${Password},Password)
        //Submit Button
        Functional_workpath.WaitAndClick(/html/body/div[1]/div/div/form/div[2]/div[5]/button,SubmitButton)
        //Click PC Client
        Functional_workpath.WaitAndClick(/html/body/div[1]/div[3]/div[2]/div/div[5]/a/div[2],PC Client)
        Functional_workpath.WaitAndClick(/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div/div[2]/div[2]/div[2]/div[2]/div/span[1],Click windows)
        Functional_workpath.T1993711397_WaitForWindowsDownloadedFile(${SafeQExeFilePath})
        Web.Close
    }
    Fail:
    { 
        Fail (Failed opening the browser!)
        Stop Test Case
    }
}

WaitAndClickTextbox(${Id},${Value},${Name})
{
    If: Web.Wait For Object (${Id},120)
    {
        Web.Set Text (${Id},${Value})
    }
    Fail:
    {
         Fail (${Name} filed is not available).
         Stop Test Case
    }
}

WaitAndClick(${Id},${Name})
{
    If: Web.Wait For Object (${Id},120)
    {
        Web.Click Object (${Id})
    }
    Fail:
    {
         Fail (${Name} filed is not available).
         Stop Test Case
    }
}
 
 T1993711397_WaitForWindowsDownloadedFile(${SafeQExeFilePath})
 {
     Web.Wait Until File Download Complete (${SafeQExeFilePath},safeq-cloud-client,300)
 }

 T1993711397_RunExeAsAdministrator(${SafeQExeFilePath})
 {
    Windows.Open Folder By Path (${SafeQExeFilePath})
    Sleep (2)
    Windows.Send Special Key ([DOWN])
    Windows.Send Special Key ([UP])
    Windows.Send Special Key (^+[ENTER])
    Sleep (5)
    Windows.Select Application (SAFEQ Cloud Client 2026.05.28.3 Setup,20)
    If: Windows.Wait For Name (I Agree,10)
    {
        Windows.Click Name (I Agree)
        Windows.Select Application (SAFEQ Cloud Client 2026.05.28.3 Setup)
        Windows.Wait For Name (Finish,90)
        Windows.Click Name (Finish)
    } 
    Fail:
    {
        Windows.Wait For ID (1202,10)
        Windows.Click ID (1202)
        Windows.Wait For Name (Next >,10)
        Windows.Click Name (Next >)
        Windows.Wait For Name (I Agree,10)
        Windows.Click Name (I Agree)
        Windows.Wait For Name (Finish,90)
        Windows.Click Name (Finish)
    }
    Sleep (5)
    Windows.Select Application (HP Automation)
    // Because regular keywords are not working, we are resorting to windows keywords
    Windows.Send Special Key ([TAB])
    Windows.Send Key (a)
    Windows.Send Key (d)
    Windows.Send Key (m)
    Windows.Send Key (i)
    Windows.Send Key (n)
    Windows.Send Special Key ([TAB])
    Windows.Send Key (A)
    Windows.Send Key (u)
    Windows.Send Key (t)
    Windows.Send Key (o)
    Windows.Send Key (m)
    Windows.Send Key (a)
    Windows.Send Key (t)
    Windows.Send Key (i)
    Windows.Send Key (o)
    Windows.Send Key (n)
    Windows.Send Key (@)
    Windows.Send Key (1)
    Windows.Send Key (2)
    Windows.Send Key (3)
    Windows.Send Special Key ([TAB])
    Windows.Send Special Key ([TAB])
    Windows.Send Special Key ([ENTER]) 
 }

T1993711397_FetchPrintQueueNames_Tenent_Portal
{
    Web.Wait For Object (//*[@id="id25"]/div[3],10)
    Web.Click Object (//*[@id="id25"]/div[3])
    
    Web.Wait For Object (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[1]/div/div/div/ul/li[2]/a,20)
    Web.Click Object (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[2]/form/div[2]/div[2]/div[1]/div/div/div/ul/li[2]/a)
    
    Web.Get Text (//table[@role='grid']//tr[@role='row'][1]/td[2],${Row1Value})
    Set Variable (${print-queue-1},${Row1Value})
    Web.Get Text (//table[@role='grid']//tr[@role='row'][2]/td[2],${Row2Value})
    Set Variable (${print-queue-2},${Row2Value})
    Web.Get Text (//table[@role='grid']//tr[@role='row'][3]/td[2],${Row3Value})
    Set Variable (${print-queue-3},${Row3Value})
    Sleep (5)
}

T1993711397_NavigateWindowsPrinters_and_Scanners_Validate_PrintQueueExists
{
    Run Command (cmd.exe /c powershell -NoProfile -Command "(Get-Printer | Select-Object -ExpandProperty Name) -contains '${print-queue-1}'", ${QueueExist_1}, 10)
    If: Contains (${KEYWORD_OUTPUT},True)
    {
        Pass (Queue is Available)
    }
    
    Run Command (cmd.exe /c powershell -NoProfile -Command "(Get-Printer | Select-Object -ExpandProperty Name) -contains '${print-queue-2}'", ${QueueExist_2}, 10)
    If: Contains (${KEYWORD_OUTPUT},True)
    {
        Pass (Queue is Available)
    }
    
    Run Command (cmd.exe /c powershell -NoProfile -Command "(Get-Printer | Select-Object -ExpandProperty Name) -contains '${print-queue-3}'", ${QueueExist_3}, 10)
    If: Contains (${KEYWORD_OUTPUT},True)
    {
        Pass (Queue is Available)
    }
}

T1993711397_PullPrintFirstJobOrSelectAll(${Final_Iteration})
{
    //clicks on the secure print icon
    JediOmni.Touch ID (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button)
    Sleep (1)
    
    //My Print Jobs Button
    If: Android.Wait For Object (com.ysoft.safeq.terminals.hp.hcp:id/print,50)
    {
        Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/print)
    }
    Fail:
    {
        Fail (Failed to select My Print Jobs Button)
        Stop Test Case
    }
    Sleep (1)
    
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1],30)
    {
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1])
        
        Sleep (1)
        //If Final Iteration Select All
        If: Equals IgnoreCase (${Final_Iteration},Y)
        {
            Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/select_all'])
        }
        Sleep (1)
        
        //clicks on the Print button
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[2])
        
        While:!Android.Wait For XPath Gone (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_cancel'],10)
        {
            Sleep (1)
        }
        
        //conditions to check job is processed or not  
        If:JediOmni.Wait For Active Job Gone (100)
        {
            Pass (Print job is sucessfully completed)
        }
        Fail:    
        {
            Fail (Print job is not completed)
        }
    }
    Fail:
    {
        Fail (No documents available to Delete)
    }
}

T1984992409_Validate_SafeQ_Cloud_Web_Portal_My_Documents_Functionality(${File_Name1},${File_Name2})
