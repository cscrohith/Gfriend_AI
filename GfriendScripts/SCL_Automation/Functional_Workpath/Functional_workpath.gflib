    If: Web.IsClickable (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    {
        Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    }
    Fail:
    {
        Fail (Next button not clickable try again)
    }
    //Type the device name to search for it
    Web.Wait For Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/section/div/section/div[1]/div/div/div[3]/div/input,15)
    Web.Set Text (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/section/div/section/div[1]/div/div/div[3]/div/input,${HPCC_Printer})
    Sleep (2)
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/section/div/section/div[1]/div/div/div[3]/div/span[2])
    Sleep (5)
    //Select model
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/section/div/section/div[2]/div[2]/div/div[1]/div/div[1]/div[2]/div/div/div[1]/span/span[2]/span)
    Sleep (3)
    //Click next
    Web.IsClickable (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    Sleep (2)
    //Click enable
    Web.Wait For Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2],10)
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    Sleep (3)
    //Click done button
    Web.Wait For Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button,15)
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button)
    //Wait for SIO to be enabled
    Sleep (300)
    Web.Close
    //Run after 2FA enabled
    Functional_workpath.Send_Jobs(${Job_Path},${Queue_Name})
    Functional_workpath.Validate_Printer_SIO
    Functional_workpath.HPCC_SIO_Disable
}

HPCC_Device_PIN_Login(${Device_PIN})
{
    JediOmni.Reset
    JediOmni.Press Home Key
    JediOmni.Wait For Text (Sign In,10)
    JediOmni.Touch ID (hpid-control-signin)
    JediOmni.Wait For Object (hpid-dropdown-agent,20)
    JediOmni.Touch ID (hpid-dropdown-agent)
    //and waits and selects the SafQcolud login
    JediOmni.Wait For Object (hpid-dropdown-agent-oxp_3940c5aaf60a4214b7a9278ef2332fb7_v1,5)
    JediOmni.Touch ID (hpid-dropdown-agent-oxp_3940c5aaf60a4214b7a9278ef2332fb7_v1)
    Vision.Set Target (JediOmni)
    Vision.Set Text Grouping (word)
    Vision.Wait For Text (PIN,10)
    //Vision.Click Text (Username)
    Vision.Click XY Location (712,447,10,10)
    JediOmni.Input Text (${Device_PIN})
    Sleep (2)
    Vision.Click XY Location (822,710,1,1)
    JediOmni.Wait For Text (Sign Out,30)
}

HPCC_Print_Release
{
    JediOmni.Touch ID (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button)
    Vision.Set Text Grouping (block)
    Vision.Wait For Text (My print jobs,25)
    Vision.Click Text (My print jobs)
    Sleep (2)
    Vision.Wait For Text (Print,20)
    Vision.Click XY Location (37,164,10,10)
    Sleep (3)
    Vision.Click Text with index (Print,2)
    Vision.Wait For Text Gone (Cancel printing,30)
    Sleep (5)
    Vision.Click XY Location (1245,32,5,5)
}

Send_Jobs(${Job_Path},${Queue_Name})
{
   
    If: Windows.Print File To Print Queue (${Job_Path},${Queue_Name})
    {
        Pass (Print job is sent) 
    } 
    Fail:
    {
        Fail (Print job failed to send)
    }
    Error:
    {
        Error (Error sending in Print job)
    }
}


HPCC_Portal_Login(${HPCC_Site},${HPCC_User},${HPCC_Pwd})
{
    If: Web.Open with Chrome (${HPCC_Site},180)
    {
        //continue
    }
    
    Fail:
    { 
        Fail (Failed opening the browser!)
        Stop Test Case
    }

    Sleep (5)
    //Sign-In with Credentials
    If: Web.Wait For Object (//*[@id="username-label"],120)
    {
        Web.Set Text (//*[@id="username"],${HPCC_User})   
    }
    Fail:
    {
        Fail (Chrome browser unable to SafeQ site).
        Stop Test Case
    }
    //Click on use password
    Web.Click Object (//*[@id="user-name-form-submit"])
    
    //Wait for password screen
    If: Web.Wait For Object (//*[@id="password"],10)
    {
        Web.Set Text (//*[@id="password"],${HPCC_Pwd})
    }

    Web.Click Object (//*[@id="sign-in"])
    
    //waits for complete page to load 
    If: Web.Wait For Object (//*[@id="email"],30)
    {
        Web.Wait For Object (//*[@id="goHomeButton"]/img,10)
    }
    Fail:
    {
        Fail (Login Failed)
        Stop Test Case
    }
    Web.Refresh
    Web.Click Object (//*[@id="app"]/div[5]/div[2]/div[2]/div[1]/div[1]/a/div/div/p)
    Web.Wait For Object (//*[@id="app"]/div[5]/div[2]/div[3]/div/div/div[1]/div/div[2],10)
    Web.ScrollDownToParicularObject (//*[@id="app"]/div[5]/div[2]/div[4]/div)
    Sleep (2)
    Web.Click Text With Index (Automation-BLR,2)
    Web.Wait For Text (Automation-BLR,20)
    Sleep (3)
    //Scroll down to Sign in once
    Web.ScrollDownToParicularObject (//*[@id="showManageSignInOnceForLinkModalButton"])
}

HPCC_SIO_Disable
{
    Functional_workpath.HPCC_Portal_Login(${HPCC_Site},${HPCC_User},${HPCC_Pwd})
    //Click on Signin once button
    //Web.Click Object (//*[@id="app"]/div[5]/div[2]/div[3]/div/div[2]/div[2]/div[3]/div/div[1]/div[1]/img)
    //Press disable button
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/button[2])
    //Type the device name to search for it
    Sleep (5)
    Web.Wait For Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/section/div/section/div[1]/div/div/div[3]/div/input,15)
    Web.Set Text (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/section/div/section/div[1]/div/div/div[3]/div/input,${HPCC_Printer})
    Sleep (2)
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/section/div/section/div[1]/div/div/div[3]/div/span[2])
    //Select model
    Sleep (5)
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[2]/div[3]/div/section/div/section/div[2]/div[2]/div/div[1]/div/div[1]/div[2]/div/div/div[1]/span/span[2]/span)
    //Click next
    Sleep (3)
    Web.IsClickable (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    //Click Disable
    Sleep (3)
    Web.Wait For Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2],10)
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button[2])
    //Click done button
    Sleep (3)
    Web.Wait For Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button,15)
    Web.Click Object (/html/body/div/div[3]/div/div/div[2]/div/div/div[2]/div[3]/div/button)
    Sleep (30)
    Web.Close
}

Validate_Printer_SIO
{
    //Login to device by user or pin or badge
    Functional_workpath.HPCC_Device_PIN_Login (${Device_PIN})
    //Enter 2FA SIO pin
    JediOmni.Wait For Text Gone (Connecting to the HP cloud,30)
    Sleep (10)
    JediOmni.Touch ID (hpid-cloud-status-button)
    Sleep (3)
    JediOmni.Touch ID (hpid-hpid-pin-textbox)
    JediOmni.Input Text (${SIO_Pin})
    JediOmni.Input Text (hpid-hpid-pin-textbox,${SIO_Pin})
    Sleep (5)
    JediOmni.Touch ID (hpid-hpid-signin-button)
    
   If: JediOmni.Wait For Text (Sign Out,20) 
   {
       Pass (PIN authentication done)
   }
   Fail:
   {
       //Fail (PIN authentication failed)
       //Stop Test Case
   }
   JediOmni.Wait For Text Gone (Connecting to the HP cloud,30)
    Sleep (10)
   //Release print job
   Functional_workpath.HPCC_Print_Release
}

T1984992407_Mono_Color_Report_Device_Print${IsColorMFP}
{
    Common_WorkPath_Library.Portal_Login(${Site},${Username},${Password})
