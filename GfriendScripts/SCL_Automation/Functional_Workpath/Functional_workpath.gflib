    }
    //Upload documents to print button
    Web.Drag File To Web (${File_Path1},//input[@data-test-id='uploadBtn'])
    Sleep(3)
    //Select pull print queue from Destination printer list box
    Web.Click Object (//select[@data-test-id='printQueue']/preceding-sibling::span/span[@role='option'])
    Windows.Send Key (${Pull_Print_Queue_Name})
    //Web.Select Value From List Box (//select[@data-test-id='printQueue']/preceding-sibling::span/span[@role='option'],${Pull_Print_Queue_Name})
    If: Web.Wait For Object (//button[normalize-space()='Send to secure queue'],30)
    {
        Web.Click Object (//button[normalize-space()='Send to secure queue'])
    }
}

T1984992409_Validate_SafeQ_Cloud_Web_Portal_My_Documents_File_upload_Functionality(${File_Path2})
{
    Sleep (2)
    If: Web.Wait For Object (//span[normalize-space()='Upload documents to print']/parent::div,20)
    {
        Web.Click Object (//span[normalize-space()='Upload documents to print']/parent::div)
    }
    //File explorer
    Windows.Select Application (Open)
    If: Windows.Wait For ID (1148,20)
    {
        Sleep (2)
        Windows.Send Special Key (${File_Path2})
    }
    Sleep (1)
    Windows.Send Special Key ([ENTER])
    Sleep(2)
    //Select pull print queue from Destination printer list box
    //Web.Select Value From List Box (//select[@data-test-id='printQueue']/preceding-sibling::span/span[@role='option'],${Pull_Print_Queue_Name})
    Web.Click Object (//select[@data-test-id='printQueue']/preceding-sibling::span/span[@role='option'])
    Sleep(1)
    //Windows.Send Key (${Pull_Print_Queue_Name})
    If: Web.Wait For Object (//button[normalize-space()='Send to secure queue'],30)
    {
        Web.Click Object (//button[normalize-space()='Send to secure queue'])
    }
    Web.Close
}

Validate_SafeQ_Cloud_Web_Portal_My_Documents_File_upload_Functionality_Release_All
{
    JediOmni.Enable Paperless Mode
    If: JediOmni.Wait For Object (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button,10)
    {
       //Secure Print & Scan
       JediOmni.Touch ID (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button)
    }
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print'],300)
    {
        //My print jobs button
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print']) 
    }
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[1],300)
    {
        //Reload Jobs
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[1])
    }
    //Home button
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/home_icon'],20)
    {
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/home_icon'])
    }
    Sleep (2)
    If: JediOmni.Wait For Object (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button,10)
    {
       //Secure Print & Scan
       JediOmni.Touch ID (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button)
    }
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/printAll'],20)
    {
        //PrintAll Button
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/printAll'])
        Pass (Print jobs are Releasing successfully)
    }
    Fail:
    {
        Fail (Print job is failed to release)
    }   
}
      
