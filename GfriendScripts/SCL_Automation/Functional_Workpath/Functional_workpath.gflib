T1984992409_Validate_SafeQ_Cloud_Web_Portal_My_Documents_Upload_Functionality(${File_Name1},${File_Name2},${File_Path1},${Pull_Print_Queue_Name})
{
    //Refresh status button
    Web.Wait For Object (//a[normalize-space()='Refresh status'],10)
