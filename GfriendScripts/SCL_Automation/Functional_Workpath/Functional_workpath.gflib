    Web.Click Object (/html/body/div[1]/div[3]/div[2]/div/div[9]/a/div)
    Sleep (3)
    //Copy report from web
    Web.Get Text (//*[@id="chart-id-162"]/div/div,${web_report})
    //Download report
    Web.Select Frame (//*[@id="superset-dashboard-panel"]/iframe)
    Web.Click Object (//*[@id="slice_162-controls"]/div)
