    {
        Set Variable (${web_report},0)
    }
    //Download report
    Web.Select Frame (//*[@id="superset-dashboard-panel"]/iframe)
    Web.Click Object (//*[@id="slice_147-controls"]/div)
    Web.Wait For Object (//*[@id="slice_147-menu"]/li[4]/div/span[1],10)
    Web.Click Object (/html/body/div[4]/div/ul/li[4]/div/span[1])
    //Click download as .xlsx
    Web.Click Object (/html/body/div[13]/div/ul/li[2]/span[2])
    Sleep (10)
    Functional_workpath.VerifyReportDownloadData(${DownLoadFolderPath})
    
    //Now do job multiple times
    Functional_workpath.ScanForColorAndMonoDevices(${IsColorMFP})
    
    //Check again
    Common_WorkPath_Library.Portal_Login(${Site},${Username},${Password})
    Sleep (10)
    //Open dropdown for reports
    Web.Click Object (/html/body/div[1]/div[3]/div[2]/div/div[6]/a/div[3])
    Sleep (2)
    //Select users from reports
    Web.Click Object (/html/body/div[1]/div[3]/div[2]/div/div[8]/a/div)
    Sleep (2)
    //Select departments
    Web.Click Object (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[3]/div/div[1]/ul/li[2]/a/span)
    Sleep (3)
    //Open scan report
    Web.Click Object (/html/body/div[1]/div[4]/div/div[2]/div[2]/div[3]/div/div[2]/div[1]/div[1]/div/ul/li[2]/span)
    Sleep (3)
    //Copy report from web
    Web.Get Text (//*[@id="chart-id-147"]/div/div[1],${web_reportAfterOperation})
    If: Equals (${web_reportAfterOperation},${null_value})
    {
        Set Variable (${web_reportAfterOperation},0)
    }
    //Download report
    Web.Select Frame (//*[@id="superset-dashboard-panel"]/iframe)
    Web.Click Object (//*[@id="slice_147-controls"]/div)
    Web.Wait For Object (//*[@id="slice_147-menu"]/li[4]/div/span[1],10)
    Web.Click Object (/html/body/div[4]/div/ul/li[4]/div/span[1])
    //Click download as .xlsx
    Web.Click Object (/html/body/div[13]/div/ul/li[2]/span[2])
    Sleep (10)
    Functional_workpath.VerifyReportDownloadDataAfterOperation(${DownLoadFolderPath})
}

VerifyReportDownloadData(${DownLoadFolderPath})
{
    Web.Close
    //Check the downlaoded report
    Windows.Open Folder By Path (${DownLoadFolderPath})
    Windows.Send Special Key ([HOME])
    Windows.Send Special Key ([DOWN])
    Windows.Send Special Key ([HOME])
    Sleep (1)
    Get Random Number (100,10000,${random_last})
    Concatenate Variable Values And Store Result (\PR_,${random_last},${ExcelName})
    Windows.Send Special Key ([F2])
    Sleep (1)
    Windows.Send Key (${ExcelName})
    Sleep (1)
    Windows.Send Special Key ([ENTER])
    Sleep (1)
    Concatenate Variable Values And Store Result (${DownLoadFolderPath},${ExcelName},${PathAndFileNamePrefix})
    Concatenate Variable Values And Store Result (${PathAndFileNamePrefix},.xlsx,${StoreCompleteFilePath})
    //Read value from excel sheet
    Sleep (1)
    SpreadSheet.SetExcelPath(${StoreCompleteFilePath})
    SpreadSheet.Set Worksheet(Sheet1)
    If: SpreadSheet.Read Cell Value By Index(2,2,${result})
    {
        //Continue
        Pass (Value is ${result})
    }
    Fail:
    {
        SpreadSheet.Read Cell Value By Index(1,2,${result})
    }
    
    Windows.Send Special Key (^w)
    If: Equals (${web_report},${result})
    {
        Pass (The results are same)
    }
    Fail:
    {
        Pass (The results are different)
    }
}

VerifyReportDownloadDataAfterOperation(${DownLoadFolderPath})
{
    Web.Close
    //Check the downlaoded report
    Windows.Open Folder By Path (${DownLoadFolderPath})
    Windows.Send Special Key ([HOME])
    Windows.Send Special Key ([DOWN])
    Windows.Send Special Key ([HOME])
    Sleep (1)
    Get Random Number (100,10000,${random_lastAfterOperation})
    Concatenate Variable Values And Store Result (\PR_,${random_lastAfterOperation},${ExcelNameAfterOperation})
    Windows.Send Special Key ([F2])
    Sleep (1)
    Windows.Send Key (${ExcelNameAfterOperation})
    Sleep (1)
    Windows.Send Special Key ([ENTER])
    Sleep (1)
    Concatenate Variable Values And Store Result (${DownLoadFolderPath},${ExcelNameAfterOperation},${PathAndFileNamePrefixAfterOperation})
    Concatenate Variable Values And Store Result (${PathAndFileNamePrefixAfterOperation},.xlsx,${StoreCompleteFilePathAfterOperation})
    //Read value from excel sheet
    Sleep (1)
    SpreadSheet.SetExcelPath(${StoreCompleteFilePathAfterOperation})
    SpreadSheet.Set Worksheet(Sheet1) 
    If: SpreadSheet.Read Cell Value By Index(2,2,${resultAfterOperation})
    {
        //Continue
        Pass (Value is ${resultAfterOperation})
    }
    Fail:
    {
        SpreadSheet.Read Cell Value By Index(1,2,${resultAfterOperation})
    }
    
    Windows.Send Special Key (^w)
    If: Equals (${web_reportAfterOperation},${resultAfterOperation})
    {
        Pass (The results are same)
    }
    Fail:
    {
        Pass (The results are different)
    }
}

PrintForColorAndMonoDevices(${IsColorMFP})
{
    Common_WorkPath_Library.Send_Jobs(${Job_Path},${Queue_Name})
    Sleep (5)
    Common_WorkPath_Library.Device_PIN_Login(${Device_PIN})
    //clicks on the Secure print and scan button button
    JediOmni.Touch ID (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button)
    Android.Wait For Object (com.ysoft.safeq.terminals.hp.hcp:id/print_text,15)
    Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/print_text)
    //click first job
    Android.Wait For Object (com.ysoft.safeq.terminals.hp.hcp:id/print_list_item_checkbox,15)
    Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/print_list_item_checkbox)
    //click settings for first job
    Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/print_detail_button)
    //In Mono, no options for color change. So, repeat 10 times for Mono
    If: Equals (${IsColorMFP},N)
    {
        Repeat:10
        {
            Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/number_picker_plus)
        }
        Android.Touch Text (Print)
        Android.Wait For Object Gone (com.ysoft.safeq.terminals.hp.hcp:id/print_cancel,45)
        Android.Wait For Object (com.ysoft.safeq.terminals.hp.hcp:id/logout_secondactivity,10)
        Sleep (5)
        //After printing, Signout
        Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/home_icon)
        Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/logout_secondactivity)
    }
    
    //Repeat for 10 times for Color printer only
    If: Equals (${IsColorMFP},Y)
    {
        //For color printer, select mono
        Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/select_two_button_two)
        Repeat:10
        {
            Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/number_picker_plus)
            
        }
        Android.Touch Text (Print)
        Android.Wait For Object Gone (com.ysoft.safeq.terminals.hp.hcp:id/print_cancel,45)
        Android.Wait For Object (com.ysoft.safeq.terminals.hp.hcp:id/logout_secondactivity,10)
        Sleep (5)
        //click new first job
        Android.Wait For Object (com.ysoft.safeq.terminals.hp.hcp:id/print_list_item_checkbox,15)
        Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/print_list_item_checkbox)
        //click settings for first job
        Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/print_detail_button)
        //For color printer, select color
        Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/select_two_button_one)
        Repeat:10
        {
            Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/number_picker_plus)
        }
        Android.Touch Text (Print)
        Android.Wait For Object Gone (com.ysoft.safeq.terminals.hp.hcp:id/print_cancel,45)
        Android.Wait For Object (com.ysoft.safeq.terminals.hp.hcp:id/logout_secondactivity,10)
        Sleep (5)
        //After printing, Signout
        Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/logout_secondactivity)
    }
}

ScanForColorAndMonoDevices(${IsColorMFP})
{
    Common_WorkPath_Library.Device_PIN_Login(${Device_PIN})
    //clicks on the Secure print and scan button button
    JediOmni.Touch ID (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button)
    //Press Scan workflows button
    Android.Wait For Object (com.ysoft.safeq.terminals.hp.hcp:id/scan_text,15)
    Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/scan_text)
    
    //Repeat for 10 times for Mono and color
    If: Equals (${IsColorMFP},N)
    {
        //click the desired workflow seting
        Android.Wait For Object (com.ysoft.safeq.terminals.hp.hcp:id/scan_workflow_is_editable,15)
        Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/scan_workflow_is_editable)
        Repeat:10
        {
            //press dropdown button
            Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/text_input_end_icon)
            Android.Wait For XPath (//node[@text='Black and white'],5)
            //Select mono
            Android.Touch XPath (//node[@text='Black and white'])
            //Press scan
            Android.Touch Text (Scan)
            If: JediOmni.Wait For Object (hpid-button-continue,10)
            {
                JediOmni.Touch ID (hpid-button-continue)
            }
            Android.Wait For Object Gone (com.ysoft.safeq.terminals.hp.hcp:id/scan_cancel,45)
            Sleep (3)
        }
        //After printing, Signout
        Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/logout_secondactivity)
    }
    //Repeat for 10 times for Color only
    If: Equals (${IsColorMFP},Y)
    {
        //click the desired workflow seting
        Android.Wait For Object (com.ysoft.safeq.terminals.hp.hcp:id/scan_workflow_is_editable,15)
        Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/scan_workflow_is_editable)
        Repeat:10
        {
            //press dropdown button
            Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/text_input_end_icon)
            Android.Wait For XPath (//node[@text='Black and white'],5)
            //Select mono
            Android.Touch XPath (//node[@text='Black and white'])
            //Press scan
            Android.Touch Text (Scan)
            If: JediOmni.Wait For Object (hpid-button-continue,10)
            {
                JediOmni.Touch ID (hpid-button-continue)
            }
            Android.Wait For Object Gone (com.ysoft.safeq.terminals.hp.hcp:id/scan_cancel,45)
            Sleep (3)
        }
        Repeat:10
        {
            //press dropdown button
            Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/text_input_end_icon)
            //Select color
            Android.Wait For XPath (//node[@text='Full color'],5)
            Android.Touch XPath (//node[@text='Full color'])
            //Press scan
            Android.Touch Text (Scan)
            If: JediOmni.Wait For Object (hpid-button-continue,10)
            {
                JediOmni.Touch ID (hpid-button-continue)
            }
            Android.Wait For Object Gone (com.ysoft.safeq.terminals.hp.hcp:id/scan_cancel,45)
            Sleep (3)
            //press dropdown button
            Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/text_input_end_icon)
        }
        //After printing, Signout
        Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/logout_secondactivity)
    }
}

T1984992395_Validate_SafeQ_Cloud_Sharepoint_Behavior_Workpath_only
{ 
    // Click Secure Print & Scan
    JediOmni.Wait For Object (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button,20)
    JediOmni.Touch ID (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button)
    // Click My Scan Workflows
    Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/scan'],40)
    Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/scan'])
    // Click Scan To SharePoint
    Android.Wait For Text (Scan To SharePoint,20)
    Android.Touch Text (Scan To SharePoint)
    // Original Size screen - use the default selected page size and click Continue
    JediOmni.Wait For Object (hpid-button-continue,20)
    JediOmni.Touch ID (hpid-button-continue)
    // Verify workflow completion
    If: Android.Wait For Text (Workflow processed successfully,20)
    {
        Pass (Scan to SharePoint successful. Please check the configured SharePoint destination and verify that the scanned document was uploaded successfully)
    }
    Fail:
    {
        Fail (Scan to SharePoint Unsuccessful)
    }
}

T1984992394_Validate_SafeQ_Cloud_OneDrive_Behavior_Workpath_only
{
    // Click Secure Print & Scan
    JediOmni.Wait For Object (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button,20)
    JediOmni.Touch ID (hpid-5f271ead-1a46-4f72-b261-22f9d769ea1c-homescreen-button)
    // Click My Scan Workflows
    Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/scan'],40)
    Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/scan'])
    // Click Scan To OneDrive
    Android.Wait For Text (Scan To OneDrive,10)
    Android.Touch Text (Scan To OneDrive)
    //select folder
    Android.Wait For Object (com.ysoft.safeq.terminals.hp.hcp:id/scan_workflow_item_addon_button,10)
    Android.Touch ID (com.ysoft.safeq.terminals.hp.hcp:id/scan_workflow_item_addon_button)
    //click on Apps Folder
    Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/dialog_scan_folder_recycleview']/node[1],20)
    Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/dialog_scan_folder_recycleview']/node[1])
    //click Confirm Button
    Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[2],10)
    Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[2])
    //click on Scan Button
    Android.Wait For XPath (//node[@class='android.widget.Button'],10)
    Android.Touch XPath (//node[@class='android.widget.Button'])
    // Original Size screen - use the default selected page size and click Continue
    JediOmni.Wait For Object (hpid-button-continue,20)
    JediOmni.Touch ID (hpid-button-continue)
    // Verify workflow completion
    If: Android.Wait For Text (Workflow processed successfully,20)
    {
        Pass (Scan to OneDrive successful. Please check the configured OneDrive destination and verify that the scanned document was uploaded successfully)
    }
    Fail:    
    {
        Fail (Scan to Ondrive Unsuccessful)
    }
}

IPP_Port(${ControlPanelPath})    
{
       // IPP Port Driver installation process
        Windows.Open With Path (${ControlPanelPath})
        Windows.Select Application (Control Panel)
        Windows.Wait For Name (Devices and Printers,5)
        Windows.Click Name (Devices and Printers)
        Windows.Wait For Name (Add a printer,5)
        //Devices and Printers
        Windows.Select Application (Devices and Printers)
        Windows.Click Name (Add a printer)
        Windows.Wait For Name (Add a printer,5)
        Windows.Select Application (Add a device)
        Windows.Click Name (The printer that I want isn't listed)
        Windows.Click Name (Select a shared printer by name)
        Windows.Wait For Name (Select a shared printer by name,5)
        //Provide here serverdomain and port
        Windows.Set Text With Send Key (4655,Serverdomain\port)
        Windows.Click Name (Next)
}

