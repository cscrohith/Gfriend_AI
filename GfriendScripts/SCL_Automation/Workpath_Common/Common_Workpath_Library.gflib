using Android
using JediOmni
using Windows
using Web
using BadgeBox
using Preparation

Device_Reboot
{
    Web.Open with Chrome (${DUT_Address},30)
    Sleep (2)
    Web.Wait For Object (//*[@id="EwsLogin"],10)
    Web.Click Object (//*[@id="EwsLogin"])
    Sleep (2)
    Web.Wait For Object (//*[@id="PasswordTextBox"],10)
    Sleep (2)
    Web.Set Text (//*[@id="PasswordTextBox"],${DUT_AdminPW})
    Sleep (2)
    Web.Wait For Object (//*[@id="signInOk"],10)
    Web.Click Object (//*[@id="signInOk"])
    Sleep (2)
    Web.Wait For Object (//*[@id="Information"],10)
    Web.Click Object (//*[@id="Information"])
    Sleep (2)
    Web.Wait For Object (//*[@id="RemoteControlPanelConnect"],10)
    Web.Click Object (//*[@id="RemoteControlPanelConnect"])
    Sleep (2)
    Web.Wait For Object (//*[@id="LaunchButton"],10)
    Web.Click Object (//*[@id="LaunchButton"])
    If: JediOmni.Wait For Object (hpid-button-Ok,5)
    {
        JediOmni.Touch ID (hpid-button-Ok)
    }
    Sleep (5)
    Windows.Send Special Key ([ENTER])
    Sleep (2)
    Windows.Send Special Key ([ENTER])
    Web.Close
    JediOmni.Wait Until Boot
    Web.Open with Edge (${DUT_Address},50)
    While:Web.Wait For Object (//*[@id="reload-button"],5):50
    {
        Web.Click Object (//*[@id="reload-button"])
    }
    Windows.Send Special Key ([F5])
    Web.Wait For Object (//*[@id="Information"],50)
    Web.Wait For Text (Information,50)
    Web.Click Text (Information)
    Pass (EWS page is Ready!)
    Sleep (10)
    If: JediOmni.Press Home Key
    {
        
    }
    If: JediOmni.Wait For Object (hpid-control-signin,30)
    {
        Pass (Device control panel on home screen)
    } 
}

Device_Username_Login(${Device_Username},${Device_Password})
{
    JediOmni.Reset
    JediOmni.Press Home Key
    JediOmni.Wait For Text (Sign In,10)
    JediOmni.Touch ID (hpid-control-signin)
    JediOmni.Wait For Object (hpid-dropdown-agent,20)
    JediOmni.Touch ID (hpid-dropdown-agent)
    
    //and waits and selects the SafQcolud login
    JediOmni.Wait For Object (hpid-dropdown-agent-oxp_3940c5aaf60a4214b7a9278ef2332fb7_v1,5)
    JediOmni.Touch ID (hpid-dropdown-agent-oxp_3940c5aaf60a4214b7a9278ef2332fb7_v1)
    Common_WorkPath_Library.Handles_Please_Wait()
    If: Android.Wait For XPath (//node[@resource-id='android:id/ok'],10)
    {
        Android.Touch XPath (//node[@resource-id='android:id/ok'])
    }
    //we can see the error message after clicking on the SafeQ login button
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/terminal_error_textview'],20)
    {
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/error_fragment_reset_button'])
        Common_WorkPath_Library.Solution_Error_Handling()
        If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/authentication_username_textinputlayout'],20)
        {
            Pass (Username Page is seen )
        }
        
    }
    
    //inputs text on the username test box 
    Android.Input Text With XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/authentication_username_textinputlayout'],${Device_Username})
    
    Android.Press Enter Key
    //We can the the error message after entering te username 
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/terminal_error_textview'],20)
    {
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/error_fragment_reset_button'])
        Common_WorkPath_Library.Solution_Error_Handling()
        If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/authentication_username_textinputlayout'],20)
        {
            Pass (Username Page is seen )
        }
    }
    
    //inputs text in the password text box 
    Android.Input Text With XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/authentication_password_edittext'],${Device_Password})
    Android.Press Enter Key
    
    Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/btn_login'])
     
}
Device_Logout
{
    If: Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/logout_secondactivity'],20)
    {
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/logout_secondactivity'])
    } 
    If: JediOmni.Wait For Text (Sign Out,10)
    {
        JediOmni.Touch Text (Sign Out)
    }
    
}

