Large_File_Job(${Excel_File_Name},${Pdf_Name},${pptx_Name},${TXT_Name},${Word_Name},${JPG_Name},${GIF_Name},${BMP_Name},${Queue_Name},${App_Name})
{
    Windows.Print File To Print Queue(${Excel_File_Name},${Queue_Name})
    Windows.Print File To Print Queue(${pptx_Name},${Queue_Name})
    Windows.Print File To Print Queue(${TXT_Name},${Queue_Name})
    Windows.Print File To Print Queue(${Word_Name},${Queue_Name})
    Windows.Print PDF or Image With Application (${App_Name},${JPG_Name},${Queue_Name})
    Windows.Print PDF or Image With Application (${App_Name},${GIF_Name},${Queue_Name})
    Windows.Print PDF or Image With Application (${App_Name},${BMP_Name},${Queue_Name})
}

