using JediOmni
using Web
using BadgeBox

T1985577800_Print_Queues_Test()
{
    Repeat:5
    {
        // checks if job list empty or not 
        If:Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_problem_text'],20) 
        {
            Fail (Joblist is  Empty)
            Stop Test Case
        }
        Fail:
        {
            Pass (Joblist is not Empty)
            //contiune 
        }
        Sleep (5)
        //selects the first jobs
        Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1],20)
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/print_recycler_view']/node[1])
        //clicks on the Print button
        Android.Wait For XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[2],10)
        Android.Touch XPath (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/footer_bar']/node[1]/node[2])
        If: Web.Wait For Object Disappear (//node[@resource-id='com.ysoft.safeq.terminals.hp.hcp:id/success_job_textview'],30)
        {
            Pass (Print job is Released successfully)
        }
        Fail:
        {
            Fail (Print job is failed to release)
        }
    }
}

T1985577800_Print_Stress_Badge(${WaitTime})
{
    Sleep (1)
    BadgeBox.Scan Badge (${BADGE_INDEX})
    If: JediOmni.Wait For Text (Sign In,${WaitTime})
    {
        Pass (Badge Signout Successful)
    }
    Fail:
    {
        Fail (Failed to Signout)
        Stop Test Case   
    }
    BadgeBox.Scan Badge (${BADGE_INDEX})
    If: JediOmni.Wait For Text (Sign Out,${WaitTime})
    {
        Pass (Badge SignIn Successful)
    }
    Fail:
    {
        Fail (Failed to SignIn)
        Stop Test Case   
    } 
}

T1988557836_Verify_cardreaders_2Users_swipes(${Second_BADGE_INDEX},${WaitTime})
