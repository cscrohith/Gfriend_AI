using Oxpd
using Windows
using Web
using JediOmni
using BadgeBox

Device_Badgebox_Login(${BADGE_INDEX},${WaitTime})
{
    BadgeBox.Scan Badge (${BADGE_INDEX})
    If: JediOmni.Wait For Text (Sign Out,${WaitTime})
    {
        Pass (Badge SignIn Successful)
    }
    Fail:
    {
        Fail (Failed to SignIn)
        Stop Test Case   
    }
}

OXPD_Device_Username_Login (${Device_Username},${Device_Password})
{
    JediOmni.Reset
    JediOmni.Touch ID (hpid-control-signin)
    Oxpd.Get Browser Engine (300)
    
    Oxpd.Wait For Xpath (//*[@id="usernameLoginFormText"],20)
    
    
    If: Oxpd.Touch Xpath (//*[@id="usernameLoginFormText"])
    {
        Oxpd.Input Text (${Device_Username})
    }
    Fail:
    {
        Fail (Unable to Enter Username )
        Stop Test Case
    }
    
    JediOmni.Touch ID (hpid-keyboard-key-done)
    
    If: Oxpd.Touch Xpath (//*[@id="usernameLoginFormPass"])
    {
        Oxpd.Input Text (${Device_Password})
    }
    Fail:
    {
        Fail (Unable to Enter Password)
        Stop Test Case
    }
    Oxpd.Press Enter Key
    Sleep (10)
    If: JediOmni.Wait For Text (Sign Out,20)
    {
        Pass (Login Successfull)
        
    }
    Fail:
    {
        Fail (user is not logged in)
        Stop Test Case
    }
}

OXPD_Device_PIN_Login(${Device_PIN})
{
 
    JediOmni.Touch ID (hpid-control-signin)
    Oxpd.Get Browser Engine (300)
    
    Oxpd.Wait For Xpath (//*[@id="usernameLoginFormText"],20)
    Oxpd.Touch Xpath (//*[@id="login_switch"])
    If: Oxpd.Wait For Xpath (//*[@id="shortIdLoginFormText"],20)
    {
        Oxpd.Touch Xpath (//*[@id="shortIdLoginFormText"])
        Oxpd.Input Text (${Device_PIN})
        Oxpd.Press Enter Key
    }
   Fail:
   {
       Fail (Unable to enter the PIN)
   } 
    
    Sleep (10)
    If: JediOmni.Wait For Text (Sign Out,20)
    {
        Pass (Login Successfull)
        
    }
    Fail:
    {
        Fail (user is not logged in)
        Stop Test Case
    }
    
    
}

Send_Job(${FilePath},${PrintQueueName})
{
    If: Windows.Print File To Print Queue (${FilePath},${PrintQueueName})
    {
        Pass (Print job is sent) 
    } 
    Fail:
    {
        Fail (Print job failed to send)
    }
    Error:
    {
        Error (Error sending in Print job)
    }
}


Pull_Print_Operation
{
    JediOmni.Touch ID (hpid-2b0d0eba-3cf8-4830-833a-b024645b07fb-homescreen-button)
    Sleep (10)

    Oxpd.Get Browser Engine
    //waits and clicks on refresh button 3 times
   Oxpd.Wait For Xpath (//*[@id="refresh_form"]/input[3],10)
     
    Oxpd.Touch Xpath (//*[@id="refresh_form"]/input[3]) 
   

    //waits and select the first job in the list
    Oxpd.Wait For Xpath (/html/body/div[2]/div[2]/div[2]/table/tbody/tr[1],10)
    Oxpd.Touch Xpath (/html/body/div[2]/div[2]/div[2]/table/tbody/tr[1])

    //waits and clicks on the print button 
    Oxpd.Wait For Xpath (//*[@id="print_selected_button"],10) 
    Oxpd.Touch Xpath (//*[@id="print_selected_button"])
   
   //conditions to check job is processed or not  
    If:JediOmni.Wait For Active Job Gone (100) 
    {
        Pass (Print job is sucessfully completed)  
    }
    Fail:
    {
        Fail (Print job is not completed)
    }
}

Device_Signout
{
    If:Oxpd.Wait For Xpath (/html/body/div[2]/div[1]/form/input[2],10) 
    {
        Oxpd.Touch Xpath (/html/body/div[2]/div[1]/form/input[2])
        Pass (Logged out from the solution home page)
    } 
     If: JediOmni.Wait For Object (hp-button-signin-or-signout,10)
     {
         JediOmni.Touch ID (hp-button-signin-or-signout)
         Pass (Signed out from the device home page)
     }
    
}

Portal_Login(${Site},${Username},${Password})
{
    If: Web.Open with Chrome (${Site},180)
    {
        //contiune  
    }
    
    Fail:
        { 
            Fail (Failed opening the browser!)
            Stop Test Case
        }

    
   //Sign-In with Credentials
    If: Web.Wait For Object (//input[@type='text'][1],120)
    {
        Web.Set Text (//input[@type='text'][1],${Username})   
        Web.Click Object (//*[@id="loginSubmit"])
    }
    Fail:
    {
        Fail (Chrome browser unable to SafeQ site).
        Stop Test Case
    }
    
    Web.Click Object (//input[@type='password'])
    Web.Set Text (//input[@type='password'],${Password})
    Web.Click Object (//*[@id="loginSubmit"])
    
    //waits for complete page to load 
    If: Web.Wait For Object (//*[@data-test-id='logout-button'],30)
    {
        Web.Wait For Object (//a[@data-test-id='menuItemLink' and .//div[@data-test-id='label' and normalize-space()='Printers']],10)
    }
    Fail:
    {
        Fail (Login Failed)
        Stop Test Suite
    }
    Sleep (10)
    
}


OXPD_Configure(${Device_IP})
{
            Web.Wait For Object (//*[@data-test-id='searchInput'],10)
            Web.Click Object (//*[@data-test-id='searchInput'])
            Web.Set Text (//*[@data-test-id='searchInput'],${Device_IP})
            Web.Press PageDown Key (//*[@id="detail-view"])
            
            Sleep (15)
            //Clicks on the install and configure if its workpath installation 
            Web.Click Object (//input[@data-test-id='selectAll'])
            
            Sleep (5)
            //clicks on the install and configure button
            Web.Click Object (//button[@data-test-id='install'])
            
            
}

        
