EWS_Login(${EWS_Site},${EWS_Password})
{
    If: Web.Open with Chrome (${EWS_Site},180)
    //If: Web.Open with Edge (${EWS_Site},180)
    {
        //contiune  
    }
    Fail:
        { 
            Fail (Failed opening the browser!)
            Stop Test Case
        }
   //Sign-In with Credentials

    If: Web.Wait For Object (//*[@id="EwsLogin"],120)
    {
        Web.Click Object (//*[@id="EwsLogin"]) 
        Web.Wait For Object (//*[@id="PasswordTextBox"],30)
        Web.Click Object (//*[@id="PasswordTextBox"])     
        Web.Set Text (//*[@id="PasswordTextBox"],${EWS_Password})   
    }

    Fail:
    {
        Fail (Edge browser unable to open EWS site).
        Stop Test Case
    }

    Web.Click Object (//*[@id="signInOk"])

    //waits for complete page to load 
    If: Web.Wait For Object (//*[@id="EwsLogoff"],30)
    {
        Pass (Login Successfull)
    }
    Fail:
    {
        Fail (Login Failed)
        Stop Test Suite
    }
}
Send_Jobs(${Job_Path},${Queue_Name})
{
    Windows.Print File To Print Queue (${Job_Path},${Queue_Name})
}

Badgebox_Login(${BADGE_INDEX})
{
    BadgeBox.Scan Badge (${BADGE_INDEX})
    While:!JediOmni.Wait For Text (Sign Out,10): 10
    {
        Sleep(5)
    }
 
    If: JediOmni.Wait For Text (Sign Out,10)
    {
        Pass (Badge SigIN Successful)
    }
    Fail:
    {
        Fail (Failed to SignIn)
        Stop Test Case   
    }
}
Badgebox_LogOut(${BadgeIndex},${WaitTime})
{
    
    BadgeBox.Scan Badge (${BadgeIndex})
  
    While:!JediOmni.Wait For Text (Sign In,10): ${WaitTime}
    {
        Sleep(5)
    }

    If: JediOmni.Wait For Text (Sign In,10)
    {
        Pass (Badge Sign Out Successful)
    }
    Fail:
    {
        Fail (Failed to SignOut)
        Stop Test Case  
    }
}
T1988557809_Validation_of_Card_Reader_KioskMode(${BADGE_INDEX})
{
    Web.Click Object(//*[@id="SettingsPages"])
    Web.Click Object(//*[@id="HomeScreenCustomization"])
    Web.Select Value From List Box (//*[@id="DefaultAppId"],Secure Print)
    Web.Wait For Text (Home Screen App,5)
    BadgeBox.Scan Badge (${BADGE_INDEX})
    While:!JediOmni.Wait For Text (Sign Out,10): 5
    {
        Sleep(5)
    }
    If: JediOmni.Wait For Text (Sign Out,10)
    {
        Pass (Badge SigIN Successful)
    }
    Fail:
    {
        Fail (Failed to SignIn)
        Stop Test Case
    }
}

T1984767202_FeautureSmartFirmware_Upgrade(${Device_IP},${BADGE_INDEX},${File_Path},${EWS_Password},${EWS_Site})
{
   Web.Click Text (Information)
    Web.Click Text (Configuration Page)
    Web.Get Text (//*[@id="FutureSmartBundleVersion"],${Firmware_version})
    pass(${Firmware_version})
    Web.Get Text (//*[@id="FirmwareRevision"],${Firmware_revision})
    Pass (${Firmware_revision})
    Web.Click Text (General)
    Web.Click Text (Firmware Upgrade)
    Web.Click Text (Choose File)
    Windows.Wait For Name (Open,5)
    Windows.Select Application (Open)
    Windows.Wait For ID (1148,10)
    Windows.Send Key (${File_Path})
    Windows.Wait For Name (Open,5)
    Windows.Send Special Key ([ENTER])
    Windows.Wait For Name (Open,10)
    If: Windows.Check Screen Contains Partial Text (id.signed.bdl)
    {
        Windows.Click Element By Partial Text (id.signed.bdl) 
    }
    Fail:
    {
        Fail (There is no bdl file)
    }
    Windows.Send Special Key ([TAB])
    Windows.Send Special Key ([TAB])
    Windows.Send Special Key ([ENTER])
    Windows.Wait For Name (Open,15)
    Web.Wait For Text (The product is restarting to complete the operation,1200)
    JediOmni.Wait Until Boot    
    While:Web.Wait For Object (//*[@id="reload-button"],10): 50
    {
        Web.Click Object (//*[@id="reload-button"])
    }
    While:Web.Wait For Text (Information,10): 180
    {
        Web.Wait For Text (Information,50)
    }
    If: Web.Open with edge (${EWS_Site},180)
    {
        //contiune  
    }
    Fail:
    {
        Fail (Failed opening the browser!)
        Stop Test Case
    }
    Web.Click Text (Information)
    Web.Click Text (Configuration Page)
    Web.Get Text (//*[@id="FutureSmartBundleVersion"],${UpdatedFirmware_version})
    pass(${UpdatedFirmware_version})
    Web.Get Text (//*[@id="FirmwareRevision"],${UpdatedFirmware_revision})
    Pass (${UpdatedFirmware_revision})
    If: builtin.NotEquals (${Firmware_version},${UpdatedFirmware_version})
    {
        Pass(Updated Firmware Version)
    }
    Fail:
    {
        Fail (Firmware Version not updated)
        Stop Test Case
    }
}
T1985577784_Firmware_Upgrade(${Device_IP},${BADGE_INDEX},${File_Path},${EWS_Password},${EWS_Site})
{
   Web.Click Text (Information)
