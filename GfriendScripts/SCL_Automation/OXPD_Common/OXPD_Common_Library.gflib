    {
        Pass(Updated Firmware Version)
    }
    Fail:
    {
        Fail (Firmware Version not updated)
        Stop Test Case
    }
}
Device_Reboot
{
    Web.Open with Chrome (${DUT_Address},30)
    Sleep (2)
    Web.Wait For Object (//*[@id="EwsLogin"],10)
    Web.Click Object (//*[@id="EwsLogin"])
    Sleep (2)
    Web.Wait For Object (//*[@id="PasswordTextBox"],10)
    Sleep (2)
    Web.Set Text (//*[@id="PasswordTextBox"],${DUT_AdminPW})
    Sleep (2)
    Web.Wait For Object (//*[@id="signInOk"],10)
    Web.Click Object (//*[@id="signInOk"])
    Sleep (2)
    Web.Wait For Object (//*[@id="Information"],10)
    Web.Click Object (//*[@id="Information"])
    Sleep (2)
    Web.Wait For Object (//*[@id="RemoteControlPanelConnect"],10)
    Web.Click Object (//*[@id="RemoteControlPanelConnect"])
    Sleep (2)
    Web.Wait For Object (//*[@id="LaunchButton"],10)
    Web.Click Object (//*[@id="LaunchButton"])
    If: JediOmni.Wait For Object (hpid-button-Ok,5)
    {
        JediOmni.Touch ID (hpid-button-Ok)
    }
    Sleep (5)
    Windows.Send Special Key ([ENTER])
    Sleep (2)
    Windows.Send Special Key ([ENTER])
    Web.Close
    JediOmni.Wait Until Boot
    Web.Open with Edge (${DUT_Address},50)
    While:Web.Wait For Object (//*[@id="reload-button"],5):50
    {
        Web.Click Object (//*[@id="reload-button"])
    }
    Windows.Send Special Key ([F5])
    Web.Wait For Object (//*[@id="Information"],50)
    Web.Wait For Text (Information,50)
    Web.Click Text (Information)
    Pass (EWS page is Ready!)
    Sleep (10)
    If: JediOmni.Press Home Key
    {
        
    }
    If: JediOmni.Wait For Object (hpid-control-signin,30)
    {
        Pass (Device control panel on home screen)
    } 
}
