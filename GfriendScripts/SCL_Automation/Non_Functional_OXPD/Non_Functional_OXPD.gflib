T1988557796_Validate_the_Hot_Swap_card_reader_using_a_different_model_of_card_reader(${BADGE_INDEX_1})
{
    JediOmni.Reboot
    JediOmni.Wait Until Boot
    Sleep (120)
    JediOmni.Wait For Text (Reset,300)
    JediOmni.Enable Paperless Mode
    JediOmni.Reset
    BadgeBox.Scan Badge (${BADGE_INDEX_1})
    While:!JediOmni.Wait For Text (Sign Out,10): 10
    {
        Sleep(5)
    }
    If:JediOmni.Wait For Text (Sign Out,10)
        {
            Pass (User logged in successfully)
        }
        Fail:
        {
            Fail (User not logged in, So this testcase is failed )
        }
        Error:
        {
            Error (Please check the card in the badgebox is correctly placed or check the index)
        }
}
  
