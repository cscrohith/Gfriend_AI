T1988557805_Verify_the_card reader's_behavior_when U1_swipes_first_followed_immediately_by_U2(${BADGE_INDEX_2},${BadgeBox_2_username})
{
    BadgeBox.Scan Badge (${BADGE_INDEX_2})
    While:!JediOmni.Wait For Text (Sign Out,10): 10
    {
        Sleep(5)
    }
        If: Equals (${BadgeBox_2_username},${BadgeBox_2_username})
        {
            Pass (Second user logged in successfully)
        }
        Fail:
        {
            Fail (Second user not logged in, So this testcase is failed )
        }
        Error:
        {
            Error (Please check the card in the badgebox is correctly placed or check the index)
        }
}
T1985577773_Validate_SNMP_SecuritySettings_Enable()
{
    //Networking button
    Web.Click Object (//*[@id="mainMenu"]/li[10]/a)
    Sleep (2)
    //Network Settings button
    Web.Click Object(//*[@id="localMenu"]/li[3]/a)
    Sleep (1)
    //Web.Click Text (Network Settings)
    //Enable SNMPv1/v2 read-only access
    Web.Click Object (//*[@id="content"]/form/div[1]/div[3]/div/div/ul/li[1]/label)
    //Apply button
    Web.Click Object (//*[@id="Apply"])
    Web.Close  
}

T1985577773_Validate_SNMP_SecuritySettings_Disable()
{
    //Networking button
    Web.Click Object (//*[@id="mainMenu"]/li[10]/a)
    Sleep (1)
    //Network Settings button
    Web.Click Object(//*[@id="localMenu"]/li[3]/a)
    Sleep (1)
    //Web.Click Text (Network Settings)
    //Disable SNMPv1/v2 read-only access
    Web.Click Object (//*[@id="content"]/form/div[1]/div[3]/div/div/ul/li[2]/label)
    Sleep(2)
    //Apply button
    Web.Click Object (//*[@id="Apply"])
    Web.Close  
}

T1985577779_Validate_Security_SHA256()
{
    Web.Wait For Object (//*[@id="mainMenu"]/li[10]/a,5)
    //Networking button
    Web.Click Object (//*[@id="mainMenu"]/li[10]/a)
    //Secure Communication button
    Web.Wait For Object (//*[@id="localMenu"]/li[11]/a,5)
    Web.Click Object (//*[@id="localMenu"]/li[11]/a)
    //Available box
    Web.Wait For Object (//*[@id="sourceSelect"],5)
    //AES256-SHA256 Selection from list box 
    If: Web.Select Value From List Box (//*[@id="sourceSelect"],AES256-SHA256)
    {
        //Forward button
        Web.Wait For Object (//*[@id="forward"],5)
        Web.Click Object (//*[@id="forward"])
        Sleep (1)
        //Apply button
        Web.Wait For Object (//*[@id="Apply"],5)
        Web.Click Object (//*[@id="Apply"]) 
    }
    Fail:
    { 
        Fail (AES256-SHA256 Already present in Active state)   
    }
    Web.Close
}

T1985577784_Validate_Server_Upgrade()
{
    //Security button
    Web.Wait For Object (//div[@data-test-id='label' and text()='Security'],50)
    Web.Click Object (//div[@data-test-id='label' and text()='Security'])
    Sleep (2)
    //End points button
    Web.Wait For Object(//div[@data-test-id='label' and text()='Endpoints'],50)
    Web.Click Object (//div[@data-test-id='label' and text()='Endpoints'])
    //Servers button
    Web.Wait For Object (//span[text()='Servers'],50)
    Web.Click Object (//span[text()='Servers'])   
    If: Web.Wait For Object (//a[@data-test-id='updateServerBtn'][contains(@class\,'k-state-disabled')],30)
    {
        Fail (Already Server is in upgrade state)  
    }
    Fail:
    {
        Web.Wait For Object (//a[@data-test-id='updateServerBtn'],50)
        Web.Click Object (//a[@data-test-id='updateServerBtn'])
    }
    Web.Close
}

T1985577782_Validate_User_session()
{
    Oxpd.Return Browser Engine
    //The application goes to sleep after the configured inactivity timeout.
    JediOmni.Wait Until Power Save (180)
    //Sleep(60)
    If: JediOmni.Wait For Text (Sign In,5)
    {
        Pass(User session logged out Successfully)
    }
    Fail:
    {
        Fail (User session is not logged out)
    }
}

T1985577774_Security_FIPS(${EWS_Site})
{
    Web.Click Text (Networking)
    If:Web.Wait For Text (Secure Communication,10)
    {
        Web.Click Text (Secure Communication)
    }
    If:Web.Wait For Text (Secure Communication,10)
    {
        Web.ScrollDownToParicularObject (//*[@id="content"]/form/div[1]/div[11]/div/h3)
    }
    If: Web.IsChecked (/html/body/div[2]/div/div/div[1]/div/div[2]/form/div[1]/div[10]/div/div/div/label)
    {
        If: Web.Wait For Text (Enable FIPS,10)
        {
            Pass (Already Checked)
        }
    }
   Fail:
   {
       Web.Click Object(//*[@id="label_fips"])
       Web.Click Object(//*[@id="confirmReboot"])
       Web.Click Object (//*[@id="Apply"])
       JediOmni.Wait Until Boot
       While:Web.Wait For Object (//*[@id="reload-button"],10): 50
       {
           Web.Click Object (//*[@id="reload-button"])
       }
       While:Web.Wait For Text (Information,10): 180
       {
           Web.Wait For Text (Information,50)
       }
       Web.Click Text (Information)
       Pass (Device is Completely Ready!)
       Web.Close
   }
}

T1985577784_Firmware_Upgrade(${Device_IP},${BADGE_INDEX},${File_Path},${EWS_Password},${EWS_Site})
{
    Web.Click Text (Information)
    Web.Click Text (Configuration Page)
    Web.Get Text (//*[@id="FutureSmartBundleVersion"],${Firmware_version})
    pass(${Firmware_version})
    Web.Get Text (//*[@id="FirmwareRevision"],${Firmware_revision})
    Pass (${Firmware_revision})
    Web.Click Text (General)
    Web.Click Text (Firmware Upgrade)
    Web.Click Text (Choose File)
    Windows.Wait For Name (Open,5)
    Windows.Select Application (Open)
    Windows.Wait For ID (1148,10)
    Windows.Send Key (${File_Path})
    Windows.Wait For Name (Open,5)
    Windows.Send Special Key ([ENTER])
    Windows.Wait For Name (Open,10)
    If: Windows.Check Screen Contains Partial Text (id.signed.bdl)
    {
        Windows.Click Element By Partial Text (id.signed.bdl) 
    }
    Fail:
    {
        Fail (There is no bdl file)
    }
    Windows.Send Special Key ([TAB])
    Windows.Send Special Key ([TAB])
    Windows.Send Special Key ([ENTER])
    Windows.Wait For Name (Open,15)
    Web.Wait For Text (The product is restarting to complete the operation,1200)
    JediOmni.Wait Until Boot    
    While:Web.Wait For Object (//*[@id="reload-button"],10): 50
    {
        Web.Click Object (//*[@id="reload-button"])
    }
    While:Web.Wait For Text (Information,10): 180
    {
        Web.Wait For Text (Information,50)
    }
    If: Web.Open with edge (${EWS_Site},180)
    {
        //contiune  
    }
    Fail:
    {
        Fail (Failed opening the browser!)
        Stop Test Case
    }
    Web.Click Text (Information)
    Web.Click Text (Configuration Page)
    Web.Get Text (//*[@id="FutureSmartBundleVersion"],${UpdatedFirmware_version})
    pass(${UpdatedFirmware_version})
    Web.Get Text (//*[@id="FirmwareRevision"],${UpdatedFirmware_revision})
    Pass (${UpdatedFirmware_revision})
    If: builtin.NotEquals (${Firmware_version},${UpdatedFirmware_version})
    {
        Pass(Updated Firmware Version)
    }
    Fail:
    {
        Fail (Firmware Version not updated)
        Stop Test Case
    }
}


T1985577775_Validate_CSRF_setting()
{
   Web.Wait For Object (//*[@id="mainMenu"]/li[10]/a,5)
   //Security Tab
   Web.Click Object (/html/body/div[1]/div[3]/ul/li[8]/a)
   Sleep (1)  
   //Scroll  to Enable Cross-site Request Forgery (CSRF) prevention
   Web.ScrollDownToParicularObject (/html/body/div[2]/div/div/div[2]/div/div[2]/form/div[1]/div[4]/div[2]/div[2]/div/label)
    
   Sleep (1)
 
   If: Web.IsChecked (/html/body/div[2]/div/div/div[2]/div/div[2]/form/div[1]/div[4]/div[2]/div[1]/div/label)
   {
       Sleep (1)
       Pass (Already Checked)
   }
   Fail:
   {
       Sleep (1)
       //Click CSRF checkbox
       If: Web.Wait For Object (/html/body/div[2]/div/div/div[2]/div/div[2]/form/div[1]/div[4]/div[2]/div[1]/div/label,10)
       {
           Web.Click Object (/html/body/div[2]/div/div/div[2]/div/div[2]/form/div[1]/div[4]/div[2]/div[1]/div/label)
            Sleep (1)
       }
       Fail:
       {
           Fail (CSRF checkbox is not avaialble)
           Stop Test Case
       }
      
       If:Web.Wait For Object (/html/body/div[2]/div/div/div[2]/div/div[2]/form/div[2]/span[1]/input,10) 
       {
           //Click apply
            Web.Click Object (/html/body/div[2]/div/div/div[2]/div/div[2]/form/div[2]/span[1]/input)
            Sleep (1) 
       }
       Fail:
       {
           Fail (Apply button is not avaialble)
            Stop Test Case
       }
   }
   Web.Close
}
