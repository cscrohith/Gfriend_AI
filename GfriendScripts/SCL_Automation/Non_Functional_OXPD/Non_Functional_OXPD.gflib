T1988557795_Verify_behavior_of_SF_2.7_display_when_the_user performs_swipe_and_replace_all_actions_step1
{
    Web.Click Object (//a[@data-test-id='menuItemLink' and .//div[@data-test-id='label' and normalize-space()='Printers']])
    Web.Wait For Object (//a[@data-test-id='link.embedded_templates'],20)
    Web.Click Object (//a[@data-test-id='link.embedded_templates'])
    Sleep (5)
    Web.Wait For Object (//tr[.//td[normalize-space()='OXPD']]//span[@data-title='Edit']//a,5)
    Web.Click Object (//tr[.//td[normalize-space()='OXPD']]//span[@data-title='Edit']//a)
    Web.ScrollDownToParicularObject (//*[@id="id1be"]/div[1])

    //verifys checkbox is checked or not
    If: Web.IsChecked (//*[@id="id1be"]/div[2]/label)
    {
        Pass (Print all job on card login is Enabled)
    }
    Fail:
    {
        Web.Wait For Object (//input[@data-test-id='configData.autoRelease'],5)
        Web.Click Object (//input[@data-test-id='configData.autoRelease'])
    }
    Web.ScrollDownToParicularObject (//input[@data-test-id='saveBtn'])
    Web.Wait For Object (//input[@data-test-id='saveBtn'],5)
    Web.Click Object (//input[@data-test-id='saveBtn'])
    Web.Wait For Object (//tr[td[normalize-space(text())='OXPD']]//span[@data-title='Deployment actions']//a,10)
    Web.Click Object (//tr[td[normalize-space(text())='OXPD']]//span[@data-title='Deployment actions']//a)
    Web.Wait For Object (//*[@data-test-id='searchInput'],10)
    Web.Click Object (//*[@data-test-id='searchInput'])
    Web.Set Text (//*[@data-test-id='searchInput'],${Device_IP})
    Web.Press PageDown Key (//*[@id="detail-view"])         
    Sleep (15)
    //Clicks on the install and configure if its workpath installation 
    Web.Click Object (//input[@data-test-id='selectAll'])      
    Sleep (5)
    //clicks on the install and configure button
    Web.Click Object (//button[@data-test-id='configure'])

    Web.Wait For Object (//span[@data-test-id='deployStatusIcon'],20)
        If: Web.Wait For Object (//span[@data-test-id='deployStatusIcon' and contains(@class\,'success')],180)
            {
                Pass (Device configured successfully)
            }
            Fail:
            {
                Fail (Device configuration failed)

            }
}

T1988557795_Paper_Out_and_Direct_IP_Print_Trays
{
    If:JediOmni.Wait For Text (Tray,40)
    {
        Pass (Trays are empty)
    }
    Fail:
    {
        Fail (Tray are not empty)
    }
    JediOmni.Touch (.hp-button-active-jobs:last)
    JediOmni.Wait For Object (hpid-button-cancel-all,10)
    JediOmni.Touch ID (hpid-button-cancel-all)
    JediOmni.Wait For Object (hpid-button-yes,10)
    JediOmni.Touch ID (hpid-button-yes)
    JediOmni.Wait For Object (hpid-active-jobs-exit,40)
    JediOmni.Touch ID (hpid-active-jobs-exit)
    If: JediOmni.Wait For Object (hpid-message-center-exit-button),20)
    {
       JediOmni.Touch ID (hpid-message-center-exit-button) 
    }
}