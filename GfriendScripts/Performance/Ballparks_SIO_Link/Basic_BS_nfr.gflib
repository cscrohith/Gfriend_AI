                        Android.Wait For Text (${scan_send_msg},60)
                        Info.Mark End(${csv_filename},scanning_${R})
                        Info.Mark Start(${csv_filename},sending_${R})
                        Android.Wait For Text Gone (${scan_send_msg},60)
                        Info.Mark End(${csv_filename},sending_${R})
                    }
                }
            }
            //Info.Draw Time Graph(${csv_filename})
        } 
            
            
        
        Sleep (5)
        Android.Press Back Key
        If: Android.Wait For Text(Auto Test,30)
        {
            Android.Press Back Key
 
            If:Android.Wait For Object (com.hp.print.horizontalconnector.onedriveforbusiness:id/bt_dialog_right,30)
            {
                Android.Touch ID (com.hp.print.horizontalconnector.onedriveforbusiness:id/bt_dialog_right)
            }
            Fail:
            { 
                 Android.Press Back Key
                            
                If:Android.Wait For Object (com.hp.print.horizontalconnector.onedriveforbusiness:id/bt_dialog_right,30)
                {
                    Android.Touch ID (com.hp.print.horizontalconnector.onedriveforbusiness:id/bt_dialog_right)
                }
            
            }
        }
        
       If: JediOmni.Wait For Text (Sign Out,10)
      {
        JediOmni.Touch Text (Sign Out)
      }
    }
}

OneDriveBusinessFileRefreshPerformance(${csv_filename})
{
    // validate the auth_method
    Set Variable (${ValidAuthMethod},N)
    If: Equals IgnoreCase (${auth_method},windows)
    {
        Set Variable (${ValidAuthMethod},Y)
    }
    If: Equals IgnoreCase (${auth_method},hpac)
    {
        Set Variable (${ValidAuthMethod},Y)
    }
    If: Equals IgnoreCase (${auth_method},safecom)
    {
        Set Variable (${ValidAuthMethod},Y)
    }
    
    If: Equals (${ValidAuthMethod},N)
    {
        Return With Fail (Invalid auth_method specified!)
    }

    If: JediOmni.Wait For Text (Sign Out,10)
    {
        JediOmni.Touch Text (Sign Out)
    }
    Android.Press Back Key
    JediOmni.Press Home Key
    JediOmni.Reset
    
    // login
    If: Equals (${auth_method},windows)
    {
        Auth.WinAuthLogin(${windows_id},${windows_pw}) //Login by Window auth account.
    }
    
    If: Equals (${auth_method},hpac)
    {
       Auth.login_hpac_new(${2fa_id})
    }
   
    If: Equals (${auth_method},safecom)
    {
        Auth.login_safecom_new(${2fa_id},${windows_id},${windows_pw})
    }
    
    // wait for the cloud connection
    @JediOmni.Wait For Text (Connecting to,10)
    @JediOmni.Wait For Text Gone (Connecting to,30)
    
    If: JediOmni.Touch ID (${ID_OneDriveBusiness})
    {
        //       JediOmni.Touch ID (${ID_OneDriveBusiness})
      
       Info.Start Time Check(${csv_filename})
       If: Android.Wait For Text(FileRefreshTest,60)
        {
            Repeat:${iteration}
            {
                Sleep (3)
                If: Android.Wait For Text(FileRefreshTest,30)
                {
                    Android.Touch Text(FileRefreshTest)
                    Info.Mark Start(${csv_filename},filerefresh_${R})
                    Android.Wait For Text (000_DONT_DELETE.jpg,120)
                    Info.Mark End(${csv_filename},filerefresh_${R})
                }
                Android.Press Back Key
            }
            Info.Draw Time Graph(${csv_filename})
        } 
           
        Sleep (5)
        Android.Press Back Key     
           
        If:Android.Wait For Object (com.hp.print.horizontalconnector.onedriveforbusiness:id/bt_dialog_right,30)
        {
            Android.Touch ID (com.hp.print.horizontalconnector.onedriveforbusiness:id/bt_dialog_right)
        }
    }
}


SharepointPrintPerformance(${csv_filename},${file_name})
{
    // validate the auth_method
    Set Variable (${ValidAuthMethod},N)
    If: Equals IgnoreCase (${auth_method},windows)
    {
        Set Variable (${ValidAuthMethod},Y)
    }
    If: Equals IgnoreCase (${auth_method},hpac)
    {
        Set Variable (${ValidAuthMethod},Y)
    }
    If: Equals IgnoreCase (${auth_method},safecom)
    {
        Set Variable (${ValidAuthMethod},Y)
    }
    
    If: Equals (${ValidAuthMethod},N)
    {
        Return With Fail (Invalid auth_method specified!)
    }

    If: JediOmni.Wait For Text (Sign Out,10)
    {
        JediOmni.Touch Text (Sign Out)
    }
    Android.Press Back Key
    JediOmni.Press Home Key
    JediOmni.Reset
    
    // login
    If: Equals (${auth_method},windows)
    {
        Auth.WinAuthLogin(${windows_id},${windows_pw}) //Login by Window auth account.
    }
    
    If: Equals (${auth_method},hpac)
    {
       Auth.login_hpac_new(${2fa_id})
    }
   
    If: Equals (${auth_method},safecom)
    {
        Auth.login_safecom_new(${2fa_id},${windows_id},${windows_pw})
    }
    
    // wait for the cloud connection
    @JediOmni.Wait For Text (Connecting to,10)
    @JediOmni.Wait For Text Gone (Connecting to,30)
    
    If: JediOmni.Touch ID (${ID_Sharepoint})
    {
        //       JediOmni.Touch ID (${ID_Sharepoint})
       
       If: Android.Wait For Text(test,60)
       {
            Info.Start Time Check(${csv_filename})
            Android.Touch Text(test)
            If: Android.Wait For Text(Documents,30)
            {
                Android.Touch Text(Documents)
                If: Android.Wait For Text(Print,30)
                {
                    Android.Touch Text(Print)
                    Repeat:${iteration}
                    {
                        If: Android.Wait For Text(${file_name},30)
                        {    
                            Android.Touch Text(${file_name})
                            Info.Mark Start(${csv_filename},downloading_${R})
                            If: Android.Wait For Object (com.hp.print.horizontalconnector.sharepoint:id/btn_print,30)
                            {
                                Info.Mark End(${csv_filename},downloading_${R})
                                Android.Touch ID (com.hp.print.horizontalconnector.sharepoint:id/btn_print)
                                
                                Android.Wait For Text(Printing...,30)
                                
                                Info.Mark Start(${csv_filename},printing_${R})
                                Android.Wait For Text Gone(Printing...,90)
                            // Android.Wait For Text(Print job is complete. Total pages : 0,90)
                                Info.Mark End(${csv_filename},printing_${R})
                            }
                        }
                    }
                } 
            }
            //Info.Draw Time Graph(${csv_filename})
        }
        Sleep (5)
        Android.Press Back Key
        If: Android.Wait For Text(Print,30)
        {
            Android.Press Back Key
            If: Android.Wait For Text(Documents,30)
            {
                Android.Press Back Key
                If: Android.Wait For Text(test,30)
                {
                    Android.Press Back Key
                    If:Android.Wait For Object (com.hp.print.horizontalconnector.sharepoint:id/bt_dialog_right,10)
                    {
                        Android.Touch ID (com.hp.print.horizontalconnector.sharepoint:id/bt_dialog_right)
                    }
                }
            }
        }
        
    If: JediOmni.Wait For Text (Sign Out,10)
      {
        JediOmni.Touch Text (Sign Out)
      }
    }
}

                            
