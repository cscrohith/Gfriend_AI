HPID_2ndLinking(${csv_filename},${option})
{
    
    Info.Start Time Check(${csv_filename})
    Repeat:${iteration}
    {
        //Reset Device
        Android.Press Back Key
        JediOmni.Press Home Key
        JediOmni.Reset
        
        If:JediOmni.Wait For Text (Sign In,30) 
        {// 1. If Start
            JediOmni.Touch Text (Sign In)
            sleep(2)
            JediOmni.Touch ID (hpid-dropdown-agent)     
            sleep(3)
            
            If: Equals (${option},windows)
            {
                JediOmni.Touch Text (Windows) 
                sleep(1)
                JediOmni.Touch ID (hpid-signin-textbox-UserNameTextBox)
                JediOmni.Input Text (hpid-signin-textbox-UserNameTextBox,${windows_id})
                sleep(1)
                JediOmni.Touch ID (hpid-signin-textbox-PasswordTextBox)
                JediOmni.Input Text (hpid-signin-textbox-PasswordTextBox,${windows_pw})  
                sleep(1)
                JediOmni.Touch ID (hpid-button-signin-ok)
                
                If: JediOmni.Wait For Text (Connecting to the HP Cloud,60)
                {
                    Info.Mark Start(${csv_filename},linking_${R})
                    JediOmni.Wait For Text Gone (Connecting to the HP Cloud,30)
                    Info.Mark End(${csv_filename},linking_${R})
                }
            }

            Fail:
            {
                Sleep (1)
                If: Equals (${option},hpac)
                {
                    JediOmni.Touch ID(hpid-dropdown-agent-XAC_AuthenticationAgent4_v0) 
                    sleep(1)
                    JediOmni.Touch ID (hpid-signin-textbox-authentication-code)
                    JediOmni.Input Text (hpid-signin-textbox-authentication-code,${2fa_id})
                    sleep(1)
                    JediOmni.Touch ID (hpid-button-signin-ok)


                    // Input 6-pin code
                    If: JediOmni.Wait For Object (hpid-hpid-pin-textbox,30)
                    {
                        JediOmni.Touch ID (hpid-hpid-pin-textbox)
                        JediOmni.Input Text (hpid-hpid-pin-textbox,${2fa_pw})
                        Sleep (2)
                        JediOmni.Touch ID (hpid-hpid-signin-button)
                        If: JediOmni.Wait For Text (Connecting to the HP Cloud,60)
                        {
                            Info.Mark Start(${csv_filename},linking_${R})
                            JediOmni.Wait For Text Gone (Connecting to the HP Cloud,30)
                            Info.Mark End(${csv_filename},linking_${R})
                        }
                    }
                } 
              
                Fail:
                {
     
                    If: Equals (${auth_method},safecom)
                    {
                        JediOmni.Touch ID(hpid-dropdown-agent-SafeCom_AuthAgent_v2) 
                        sleep(1)
                        JediOmni.Touch ID (hpid-signin-textbox-99900)
                        JediOmni.Input Text (hpid-signin-textbox-99900,${2fa_id})
                        sleep(1)
                        JediOmni.Touch ID (hpid-button-signin-ok)

                        // Input 6-pin code
                        If: JediOmni.Wait For Object (hpid-hpid-pin-textbox,30)
                        {
                            JediOmni.Touch ID (hpid-hpid-pin-textbox)
                            JediOmni.Input Text (hpid-hpid-pin-textbox,${2fa_pw})
                            Sleep (2)
                            JediOmni.Touch ID (hpid-hpid-signin-button)
                            If: JediOmni.Wait For Text (Connecting to the HP Cloud,60)
                            {
                                Info.Mark Start(${csv_filename},linking_${R})
                                JediOmni.Wait For Text Gone (Connecting to the HP Cloud,30)
                                Info.Mark End(${csv_filename},linking_${R})
                            }
                        }
                    }
                    Fail:
                    {
                         If: JediOmni.Wait For Object(hpid-dropdown-agent-oxp_6fd8a1b25aca4516b6c2d81eb963a24c_v1,30)
                        {                           
                            JediOmni.Touch ID (hpid-dropdown-agent-oxp_6fd8a1b25aca4516b6c2d81eb963a24c_v1)
                            If: Android.Wait For Object(com.hp.print.authagent.secureaccess:id/btnSignInIDPW, 30)
                            {
                                Android.Touch ID(com.hp.print.authagent.secureaccess:id/btnSignInIDPW)
                                If: Android.Wait For Object(com.hp.print.authagent.secureaccess:id/edtUsername,30)
                                {
                                    Android.Input Text(com.hp.print.authagent.secureaccess:id/edtUsername,${secureaccess_id})
                                    Sleep (2)
                                    Android.Input Text(com.hp.print.authagent.secureaccess:id/edtPassword,${secureaccess_pw})
                                    If: Android.Wait For Object(com.hp.print.authagent.secureaccess:id/btnSignIn,10)
                                    {
                                        Android.Touch ID (com.hp.print.authagent.secureaccess:id/btnSignIn)
                                    }
                                }
                            }
                        }
                    }     
                   
                }
            } 
        
        }
       
        If: JediOmni.Wait For Text (Sign Out,3)
        {
            JediOmni.Touch Text (Sign Out)
        }
    }
    Info.Draw Time Graph(${csv_filename})
}
