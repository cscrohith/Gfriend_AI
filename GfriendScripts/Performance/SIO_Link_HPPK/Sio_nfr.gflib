// V1.3 2019-12-03 HPID_2ndLiking method bug fix
// V1.4 2019-12-10 Differentiate between Cloud SIO and Device SIO 

using link_variable.gfvar
using Window_auth.gflib
using 2fa.gflib


using Android
using JediOmni
using Info



CloudSIO1stLaunching(${csv_filename},${app_object_id},${app_exit_object_id},${launching_done_text})
{
    If: JediOmni.Wait For Text (Sign Out,3)
    {
        JediOmni.Touch Text (Sign Out)
    }
    Info.Start Time Check(${csv_filename})
    Repeat:${iteration}
    {
        //Reset Device
        Android.Press Back Key
        JediOmni.Press Home Key
        JediOmni.Reset
        If: Equals (${auth_method},windows)
        {
            Window_auth.WinAuthLogin(${windows_id},${windows_pw}) //Login by Window auth account.
        }
        Fail:
        {
           Sleep (1)
           If: Equals (${auth_method},hpac)
           {
               2fa.login_hpac(${2fa_id},${2fa_pw})
           }
           Fail:
           {
                Sleep (1)
                If: Equals (${auth_method},safecom)
                {
                    2fa.login_safecom(${2fa_id},${2fa_pw})
                }
                Fail:
                {
                    SecureAccess_auth(${secureaccess_id},${secureaccess_pw})
                }
           }
        } 
        
        If:JediOmni.Wait For Object (${app_object_id},10)
        {
            JediOmni.Touch ID (${app_object_id})
            Info.Mark Start(${csv_filename},launching_${R})
            
            If: Android.Wait For Text (${launching_done_text},60)
            {
                Info.Mark End(${csv_filename},launching_${R})
                
                Android.Press Back Key
                If:Android.Wait For Object (${app_exit_object_id},30)
                {
                    Android.Touch ID (${app_exit_object_id})
                }
            }
            Fail:
            {
                Info.Mark End(${csv_filename},launching_${R})
                Android.Touch Text (OK)             
            }       
        }
        If: JediOmni.Wait For Text (Sign Out,30)
        {
            JediOmni.Touch Text (Sign Out)
        }
    }
    Info.Draw Time Graph(${csv_filename})
}

