            If: Android.Wait For Text(Documents,30)
            {
                Android.Press Back Key
                If: Android.Wait For Text(test,30)
                {
                    Android.Press Back Key
                    If:Android.Wait For Object (com.hp.print.horizontalconnector.sharepoint:id/bt_dialog_right,10)
                    {
                        Android.Touch ID (com.hp.print.horizontalconnector.sharepoint:id/bt_dialog_right)
                    }
                }
            }
        }
        
    If: JediOmni.Wait For Text (Sign Out,10)
      {
        JediOmni.Touch Text (Sign Out)
      }
    }
}

                            
SharepointScanPerformance(${csv_filename})
{
    If: JediOmni.Wait For Text (Sign Out,10)
    {
        JediOmni.Touch Text (Sign Out)
    }
    Android.Press Back Key
    JediOmni.Press Home Key
    JediOmni.Reset
    If: Equals (${auth_method},windows)
    {
        Window_auth.WinAuthLogin(${windows_id},${windows_pw}) //Login by Window auth account.
    }
    Fail:
    {
       Sleep (1)
       If: Equals (${auth_method},hpac)
       {
           2fa.login_hpac(${2fa_id},${2fa_pw})
       }
       Fail:
       {
            Sleep (1)
            If: Equals (${auth_method},safecom)
            {
                2fa.login_safecom(${2fa_id},${2fa_pw})
            }
            Fail:
            {
                SecureAccess_auth.Login(${secureaccess_id},${secureaccess_pw})
            }
       }
    } 
    If: JediOmni.Wait For Object(${ID_Sharepoint},60)
    {
       JediOmni.Touch ID (${ID_Sharepoint})
       If: Android.Wait For Text(test,60)
       {
            Info.Start Time Check(${csv_filename})
            Android.Touch Text(test)
            If: Android.Wait For Text(Documents,30)
            {
                Android.Touch Text(Documents)
                If: Android.Wait For Text(Auto Test,30)
                {
                    Android.Touch Text(Auto Test)
                    Repeat:${iteration}
                    {
                        If: Android.Wait For Object (com.hp.print.horizontalconnector.sharepoint:id/fab,30) // scan icon
                        {    
                            Android.Touch ID (com.hp.print.horizontalconnector.sharepoint:id/fab)
                            If: Android.Wait For Object (com.hp.print.horizontalconnector.sharepoint:id/bt_send,30)
                            {
                                Android.Touch ID (com.hp.print.horizontalconnector.sharepoint:id/bt_send)
                                Info.Mark Start(${csv_filename},scanning_${R})
                                Android.Wait For Text (${scan_send_msg},60)
                                Info.Mark End(${csv_filename},scanning_${R})
                                Info.Mark Start(${csv_filename},sending_${R})
                                Android.Wait For Text Gone (${scan_send_msg},60)
                                Info.Mark End(${csv_filename},sending_${R})
                            }
                        }
                    }
                } 
            }
            // Info.Draw Time Graph(${csv_filename})
        }
        Sleep (5)
        Android.Press Back Key
        If: Android.Wait For Text(Auto Test,30)
        {
            Android.Press Back Key
            //  If: Android.Wait For Text(Documents,30)
            {
                Android.Press Back Key
                If: Android.Wait For Text(test,30)
                {
                    Android.Press Back Key
                    If:Android.Wait For Object (com.hp.print.horizontalconnector.sharepoint:id/bt_dialog_right,30)
                    {
                        Android.Touch ID (com.hp.print.horizontalconnector.sharepoint:id/bt_dialog_right)
                    }
                    Fail:
                    {
                       Android.Press Back Key
                        If:Android.Wait For Object (com.hp.print.horizontalconnector.sharepoint:id/bt_dialog_right,30)
                        {
                            Android.Touch ID (com.hp.print.horizontalconnector.sharepoint:id/bt_dialog_right)
                        } 
                    }
                }
            }
        }
        
         If: JediOmni.Wait For Text (Sign Out,10)
        {
        JediOmni.Touch Text (Sign Out)
        }
    }
}

DropboxPrintPerformance(${csv_filename},${file_name})
{
    If: JediOmni.Wait For Text (Sign Out,10)
    {
        JediOmni.Touch Text (Sign Out)
    }
    Android.Press Back Key
    JediOmni.Press Home Key
    JediOmni.Reset
    If: Equals (${auth_method},windows)
    {
        Window_auth.WinAuthLogin(${windows_id},${windows_pw}) //Login by Window auth account.
    }
    Fail:
    {
       Sleep (1)
       If: Equals (${auth_method},hpac)
       {
           2fa.login_hpac(${2fa_id},${2fa_pw})
       }
       Fail:
       {
            Sleep (1)
            If: Equals (${auth_method},safecom)
            {
                2fa.login_safecom(${2fa_id},${2fa_pw})
            }
            Fail:
            {
                SecureAccess_auth.Login(${secureaccess_id},${secureaccess_pw})
            }
       }
    }  
    If: JediOmni.Wait For Object(${ID_Dropbox},60)
    {
       JediOmni.Touch ID (${ID_Dropbox})
      
       If: Android.Wait For Text(Print,60)
        {
            Info.Start Time Check(${csv_filename})
            Android.Touch Text(Print)
            Repeat:${iteration}
            {
                If: Android.Wait For Text(${file_name},30)
                {    
                    Android.Touch Text(${file_name})
                    Info.Mark Start(${csv_filename},downloading_${R})
                    If: Android.Wait For Object (com.hp.print.horizontalconnector.dropbox:id/btn_print,30)
                    {
                        Info.Mark End(${csv_filename},downloading_${R})
                        Android.Touch ID (com.hp.print.horizontalconnector.dropbox:id/btn_print)
                        
                        Android.Wait For Text(Printing...,30)
                        
                        Info.Mark Start(${csv_filename},printing_${R})
                        Android.Wait For Text Gone(Printing...,90)
                            // Android.Wait For Text(Print job is complete. Total pages : 0,90)
                        Info.Mark End(${csv_filename},printing_${R})
                    }
                }
            }
            Info.Draw Time Graph(${csv_filename})
        } 
           
        Sleep (5)
        Android.Press Back Key
        If: Android.Wait For Text(Print,30)
        {
            Android.Press Back Key
           
            If:Android.Wait For Object (com.hp.print.horizontalconnector.dropbox:id/bt_dialog_right,30)
            {
                Android.Touch ID (com.hp.print.horizontalconnector.dropbox:id/bt_dialog_right)
            }
        }
    }
}

                            
