ClioPrintPerformance(${csv_filename},${file_name})
{
    If: JediOmni.Wait For Text (Sign Out,10)
    {
        JediOmni.Touch Text (Sign Out)
    }
    Android.Press Back Key
    JediOmni.Press Home Key
    JediOmni.Reset
    If: Equals (${auth_method},windows)
    {
        Window_auth.WinAuthLogin(${windows_id},${windows_pw}) //Login by Window auth account.
    }
    Fail:
    {
       Sleep (1)
       If: Equals (${auth_method},hpac)
       {
           2fa.login_hpac(${2fa_id},${2fa_pw})
       }
       Fail:
       {
            Sleep (1)
            If: Equals (${auth_method},safecom)
            {
                2fa.login_safecom(${2fa_id},${2fa_pw})
            }
            Fail:
            {
                SecureAccess_auth.Login(${secureaccess_id},${secureaccess_pw})
            }
       }
    } 
    If: JediOmni.Wait For Object(${ID_Clio},60)
    {
       JediOmni.Touch ID (${ID_Clio})
       If: Android.Wait For Text(00003-Kim,60)
       {
            Android.Touch Text(00003-Kim)
            Info.Start Time Check(${csv_filename})
                    
            If: Android.Wait For Text(Print,30)
            {
                Android.Touch Text(Print)
                Repeat:${iteration}
                {
                    Android.Swipe (^)
                    If: Android.Wait For Text(${file_name},30)
                    {    
                        Android.Touch Text(${file_name})
                        Info.Mark Start(${csv_filename},downloading_${R})
                        If: Android.Wait For Object (com.hp.print.clio:id/btn_print,30)
                        {
                            Info.Mark End(${csv_filename},downloading_${R})
                            Android.Touch ID (com.hp.print.clio:id/btn_print)
                            Android.Wait For Text(Printing...,30)
                            Info.Mark Start(${csv_filename},printing_${R})
                            Android.Wait For Text Gone(Printing...,90)
                            // Android.Wait For Text(Print job is complete. Total pages : 0,90)
                            Info.Mark End(${csv_filename},printing_${R})
                        }
                    }
                   
                }
                Info.Draw Time Graph(${csv_filename})
            }
        }
        Sleep (5)
        Android.Press Back Key
        If: Android.Wait For Text(Print,30)
        {
            Android.Press Back Key
            If: Android.Wait For Text(00003-Kim,30)
            {
                Android.Press Back Key
                If:Android.Wait For Object (com.hp.print.clio:id/bt_dialog_left,30)
                {                           
                    Android.Touch ID (com.hp.print.clio:id/bt_dialog_left)
                }      
            }
        }
    }
}

                            
ClioScanPerformance(${csv_filename})
{
    If: JediOmni.Wait For Text (Sign Out,10)
    {
        JediOmni.Touch Text (Sign Out)
    }
    Android.Press Back Key
    JediOmni.Press Home Key
    JediOmni.Reset
    If: Equals (${auth_method},windows)
    {
        Window_auth.WinAuthLogin(${windows_id},${windows_pw}) //Login by Window auth account.
    }
    Fail:
    {
       Sleep (1)
       If: Equals (${auth_method},hpac)
       {
           2fa.login_hpac(${2fa_id},${2fa_pw})
       }
       Fail:
       {
            Sleep (1)
            If: Equals (${auth_method},safecom)
            {
                2fa.login_safecom(${2fa_id},${2fa_pw})
            }
            Fail:
            {
                SecureAccess_auth.Login(${secureaccess_id},${secureaccess_pw})
            }
       }
    } 
    If: JediOmni.Wait For Object(${ID_Clio},60)
    {
       JediOmni.Touch ID (${ID_Clio})
       If: Android.Wait For Text(00003-Kim,60)
       {
            Info.Start Time Check(${csv_filename})
            Android.Touch Text(00003-Kim)

            If: Android.Wait For Text(Auto Test,30)
            {
                Android.Touch Text(Auto Test)
                Repeat:${iteration}
                {
                    If: Android.Wait For Object (com.hp.print.clio:id/btn_scan,30) // scan icon
                    {    
                        Android.Touch ID (com.hp.print.clio:id/btn_scan)
                        If: Android.Wait For Object (com.hp.print.clio:id/bt_send,30)
                        {
                            Android.Touch ID (com.hp.print.clio:id/bt_send)
                            
                            Info.Mark Start(${csv_filename},scanning_${R})
                            Android.Wait For Text (${scan_send_msg},60)
                            Info.Mark End(${csv_filename},scanning_${R})
                            Info.Mark Start(${csv_filename},sending_${R})
                            Android.Wait For Text Gone (${scan_send_msg},60)
                            Info.Mark End(${csv_filename},sending_${R})
                        }
                    }
                }
            } 

            Info.Draw Time Graph(${csv_filename})
        }
        Sleep (5)
        Android.Press Back Key
        If: Android.Wait For Text(Auto Test,30)
        {
            Android.Press Back Key
            If: Android.Wait For Text(00003-Kim,30)
            {
                Android.Press Back Key
                If:Android.Wait For Object (com.hp.print.clio:id/bt_dialog_left,30)
                {
                    Android.Touch ID (com.hp.print.clio:id/bt_dialog_left)
                }
            }
        }
    }
}

ConcurScanPerformance(${csv_filename})
{
    If: JediOmni.Wait For Text (Sign Out,10)
    {
        JediOmni.Touch Text (Sign Out)
    }
    Android.Press Back Key
    JediOmni.Press Home Key
    JediOmni.Reset
    If: Equals (${auth_method},windows)
    {
        Window_auth.WinAuthLogin(${windows_id},${windows_pw}) //Login by Window auth account.
    }
    Fail:
    {
       Sleep (1)
       If: Equals (${auth_method},hpac)
       {
           2fa.login_hpac(${2fa_id},${2fa_pw})
       }
       Fail:
       {
            Sleep (1)
            If: Equals (${auth_method},safecom)
            {
                2fa.login_safecom(${2fa_id},${2fa_pw})
            }
            Fail:
            {
                SecureAccess_auth.Login(${secureaccess_id},${secureaccess_pw})
            }
       }
    } 
    If: JediOmni.Wait For Object(${ID_Concur},60)
    {
       JediOmni.Touch ID (${ID_Concur})
      
       If: Android.Wait For Text(File name,60)
        {
            Info.Start Time Check(${csv_filename})
            Android.Touch Text(File name)
            Repeat:${iteration}
            {     
                If: Android.Wait For Object(com.hp.print.department.concur:id/btn_start,60) // scan start
                {
                    Android.Touch ID(com.hp.print.department.concur:id/btn_start)
                    Info.Mark Start(${csv_filename},scanning_${R})
                    Android.Wait For Text (Scanning...,60)
                    Android.Wait For Text Gone (Scanning...,30)
                    Info.Mark End(${csv_filename},scanning_${R})
                    If: Android.Wait For Object(com.hp.print.department.concur:id/btn_save,30)
                    {
                        Android.Touch ID(com.hp.print.department.concur:id/btn_save)
                        Info.Mark Start(${csv_filename},sending_${R})
                        Android.Wait For Object(com.hp.print.department.concur:id/bt_dialog_left,60)
                        Info.Mark End(${csv_filename},sending_${R})
                        Android.Touch ID(com.hp.print.department.concur:id/bt_dialog_left)
                    }
                }
            }
            Info.Draw Time Graph(${csv_filename})
        } 
            
        Sleep (5)

        Android.Press Back Key

        If:Android.Wait For Object (com.hp.print.department.concur:id/bt_dialog_right,30)
        {
            Android.Touch ID (com.hp.print.department.concur:id/bt_dialog_right)
        }
    }
}

SageScanPerformance(${csv_filename})
{
