                2fa.login_safecom(${2fa_id},${2fa_pw})
            }
            Fail:
            {
                SecureAccess_auth.Login(${secureaccess_id},${secureaccess_pw})
            }
       }
    } 
    If: JediOmni.Wait For Object(${ID_Sage},60)
    {
       JediOmni.Touch ID (${ID_Sage})
      
       If: Android.Wait For Text(Load Originals,60)
        {
            Info.Start Time Check(${csv_filename})
            Android.Touch Text(Load Originals)
            Repeat:${iteration}
            {     
                If: Android.Wait For Text (Attachment Folders,30) // scan start
                {
                    Android.Touch Text (Attachment Folders)
                    Info.Mark Start(${csv_filename},scanning_${R})
                    Android.Wait For Text (Scanning...,60)
                    Android.Wait For Text Gone (Scanning...,30)
                    Info.Mark End(${csv_filename},scanning_${R})
                    If: Android.Wait For Object(com.hp.print.sageintacct:id/btnSaveAttachment,30)
                    {   
                        Android.Touch ID (com.hp.print.sageintacct:id/btnSaveAttachment)
                        Info.Mark Start(${csv_filename},sending_${R})
                        Android.Wait For Object(com.hp.print.sageintacct:id/btnDone,60)
                        Info.Mark End(${csv_filename},sending_${R})
                        Android.Touch ID(com.hp.print.sageintacct:id/btnDone)
                    }
                }
            }
            Info.Draw Time Graph(${csv_filename})
        } 
            
        Sleep (5)

        Android.Press Back Key

        If:Android.Wait For Object (com.hp.print.sageintacct:id/bt_dialog_right,30)
        {
            Android.Touch ID (com.hp.print.sageintacct:id/bt_dialog_right)
        }
    }
}

ImanagePrintPerformance(${csv_filename},${file_name})
{
    If: JediOmni.Wait For Text (Sign Out,10)
