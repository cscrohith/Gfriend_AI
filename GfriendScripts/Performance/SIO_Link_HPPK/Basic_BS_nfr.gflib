${scan_send_msg}= Sending 1/1...
using link_variable.gfvar
using 2fa.gflib
using Android
using JediOmni
using Info

Scan2EmailScanPerformance(${csv_filename},${from_address},${to_address})
{
    If: JediOmni.Wait For Text (Sign Out,10)
    {
        JediOmni.Touch Text (Sign Out)
    }
    Android.Press Back Key
    JediOmni.Press Home Key
    JediOmni.Reset
    If: Equals (${auth_method},windows)
    {
        Window_auth.WinAuthLogin(${windows_id},${windows_pw}) //Login by Window auth account.
    }
    Fail:
    {
       Sleep (1)
       If: Equals (${auth_method},hpac)
       {
           2fa.login_hpac(${2fa_id},${2fa_pw})
       }
       Fail:
       {
            Sleep (1)
            If: Equals (${auth_method},safecom)
            {
                2fa.login_safecom(${2fa_id},${2fa_pw})
            }
            Fail:
            {
                SecureAccess_auth.Login(${secureaccess_id},${secureaccess_pw})
            }
       }
    } 
    If: JediOmni.Wait For Object(${ID_Scan2Email},60)
    {
        JediOmni.Touch ID (${ID_Scan2Email})
        Info.Start Time Check(${csv_filename})
        
        Repeat:${iteration}
        {
            If: Android.Wait For Object(com.hp.print.scanapps.email:id/tagsEditTextFrom,60)
            {
                Android.Input Text(com.hp.print.scanapps.email:id/tagsEditTextFrom,${from_address})
                Android.Input Text(com.hp.print.scanapps.email:id/tagsEditTextTo,${to_address})
                
                Sleep (2)
                JediOmni.Touch Position(50,50)
                Sleep (2)

                Android.Touch ID (com.hp.print.scanapps.email:id/bt_send)

                Info.Mark Start(${csv_filename},scanning_${R})

                Android.Wait For Text (${scan_send_msg},60)
                Info.Mark End(${csv_filename},scanning_${R})
                Info.Mark Start(${csv_filename},sending_${R})
                Android.Wait For Text Gone (${scan_send_msg},60)
                Info.Mark End(${csv_filename},sending_${R})
           }  
        }
        Info.Draw Time Graph(${csv_filename})
    }
    Sleep (5)
    Android.Press Back Key
    Sleep (5)
}

Scan2SMBScanPerformance(${csv_filename})
{
    If: JediOmni.Wait For Text (Sign Out,10)
    {
        JediOmni.Touch Text (Sign Out)
    }
    Android.Press Back Key
    JediOmni.Press Home Key
    JediOmni.Reset
    If: Equals (${auth_method},windows)
    {
        Window_auth.WinAuthLogin(${windows_id},${windows_pw}) //Login by Window auth account.
    }
    Fail:
    {
       Sleep (1)
       If: Equals (${auth_method},hpac)
       {
           2fa.login_hpac(${2fa_id},${2fa_pw})
       }
       Fail:
       {
            Sleep (1)
            If: Equals (${auth_method},safecom)
            {
                2fa.login_safecom(${2fa_id},${2fa_pw})
            }
            Fail:
            {
                SecureAccess_auth.Login(${secureaccess_id},${secureaccess_pw})
            }
       }
    } 
    
    If: JediOmni.Wait For Object(${ID_Scan2SMB},60)
    {
        JediOmni.Touch ID (${ID_Scan2SMB})
        Info.Start Time Check(${csv_filename})
        
        Repeat:${iteration}
        {
            If: Android.Wait For Object(com.hp.print.scanapps.smb:id/ivAddBtn,60)
            {
                Android.Touch ID (com.hp.print.scanapps.smb:id/ivAddBtn)
                Android.Input Text(com.hp.print.scanapps.smb:id/et_folderPaths,${smb_ip})
                Android.Touch ID (com.hp.print.scanapps.smb:id/bt_done)
                Sleep (2)
                Android.Input Text (com.hp.print.scanapps.smb:id/et_username,${smb_id})
                Sleep (2)
                Android.Touch ID (com.hp.print.scanapps.smb:id/et_domain)
                Sleep (2)
                Android.Input Text (com.hp.print.scanapps.smb:id/et_domain,${smb_domain})
                Sleep (2)
                Android.Touch ID (com.hp.print.scanapps.smb:id/et_password)
                Android.Input Text (com.hp.print.scanapps.smb:id/et_password,${smb_pw})
                Sleep (2)
                JediOmni.Touch Position(50,50)
                Sleep (2)
                Android.Touch ID (com.hp.print.scanapps.smb:id/bt_ok)

                Android.Touch ID (com.hp.print.scanapps.smb:id/bt_send)

                Info.Mark Start(${csv_filename},scanning_${R})

                Android.Wait For Text (Sending...,60)
                Info.Mark End(${csv_filename},scanning_${R})
                Info.Mark Start(${csv_filename},sending_${R})
                Android.Wait For Text Gone (Sending...,60)
                Info.Mark End(${csv_filename},sending_${R})
           }  
        }
        Info.Draw Time Graph(${csv_filename})
    }
    Sleep (5)
    Android.Press Back Key
    Sleep (5)
}

