login_equitrac(${id},${pin})
{
    //  If: JediOmni.Wait For Text (Sign Out,3)
    {
        //  Sleep (1)
    }
    //  Fail:
    {
        // Authentication with HP AC auth
        If:JediOmni.Wait For Text (Sign In,30) 
        {
          JediOmni.Touch Text (Sign In) 
          sleep(2)
          JediOmni.Touch ID (hpid-dropdown-agent)     
          sleep(3)
          JediOmni.Touch ID(hpid-dropdown-agent-EqSolution_EquitracAuthAgent_v1) 
          sleep(1)
          JediOmni.Touch ID (hpid-signin-textbox-prompt2)
          JediOmni.Input Text (hpid-signin-textbox-prompt2,${id})
          sleep(1)
          JediOmni.Touch ID (hpid-button-signin-ok)
