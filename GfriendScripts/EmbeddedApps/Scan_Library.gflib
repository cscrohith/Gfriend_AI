/// <File>Scan_Library</File>
/// <Modified>2021-07-16</Modified>
/// <Description>Library of scan related routines for use with embedded apps</Description>
/// <Precondition></Precondition>
/// <Author>Ron Pridmore</Author>

// these variable file references need to be changed to not point to other folders
// when used in the STF GFriend plugin
//Using StandardTimeouts.gfvar
Using ..\Common\StandardTimeouts.gfvar
// these library references need to be changed to not point to other folders
// when used in the STF GFriend plugin
//Using Common_LIbrary.gflib
Using ..\Common\Common_LIbrary.gflib

Using JediOmni

/// <Name>ScanPages</Name>
/// <Description>Scan the specified # of page(s) with preview</Description>
/// <Parameters>OptNumPagesionText : number of pages to scan</Parameters>
/// <Precondition>a scan app is open and all options set</Precondition>
/// <Notes></Notes>
ScanPages (${NumPages})
{
    Repeat:${NumPages}
    {
        If: Equals (${R},1)
        {
            // first page press the preview start
            JediOmni.Touch ID (hpid-preview-touch-to-start)
        }
        Fail:
        {
            // additional pages
            JediOmni.Touch ID (hpid-preview-button-add-pages)
        }
        
        // handle the Add Pages screen if shown
        If: JediOmni.Wait For Object (hpid-prompt-add-pages,${Very_Short_Wait_Time})
        {
            JediOmni.Touch ID (hpid-button-scan)
            JediOmni.Wait For Object Gone (hpid-prompt-add-pages,${Short_Wait_Time})
        }
        
        // wait for the scanning screen to show/disappear
        If: JediOmni.Wait For Text (Scanning...,${Very_Short_Wait_Time})
        {
            JediOmni.Wait For Text Gone (Scanning...,${Long_Wait})
        }
        
        // handle the original size screen if shown
        If: JediOmni.Wait For Object (hpid-button-continue,${Very_Short_Wait_Time})
        {
            JediOmni.Touch ID (hpid-button-continue)
            JediOmni.Wait For Object Gone (hpid-button-continue,${Short_Wait_Time})
        }

        // wait for the scanning screen to show/disappear
        If: JediOmni.Wait For Text (Scanning...,${Very_Short_Wait_Time})
        {
            JediOmni.Wait For Text Gone (Scanning...,${Long_Wait})
        }
        
        // wait for the Add Page button to be available
        JediOmni.Wait For Object (hpid-preview-button-add-pages,${Long_Wait})
    }
}

/// <Name>OpenScanOptions</Name>
/// <Description>Open the scan options screen</Description>
/// <Parameters></Parameters>
/// <Precondition>Already in the scan screen</Precondition>
/// <Notes></Notes>
OpenScanOptions
{
    // check for the options already open, if so return Pass
    If: JediOmni.Wait For Object (#hpid-button-options-show-hide[aria-label="Hide Options"],${Zero_Wait_Time})
    {
        Return With Pass (OpenScanOptions complete!)
    }
    
    // open the options screen
    If: JediOmni.Touch (#hpid-button-options-show-hide[aria-label="Options"])
    {
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (OpenScanOptions_Fail.png)
        Return With Fail (Fail while opening scan options!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (OpenScanOptions_Error.png)
        Return With Error (Error while opening scan options!)
    }
    
    // wait for the button to show Hide Options text
    If: JediOmni.Wait For Object (#hpid-button-options-show-hide[aria-label="Hide Options"],${Short_Wait_Time})
    {
        Return With Pass (OpenScanOptions complete!)
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (OpenScanOptions_Fail.png)
        Return With Fail (Fail while opening scan options!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (OpenScanOptions_Error.png)
        Return With Error (Error while opening scan options!)
    }
}

/// <Name>CloseScanOptions</Name>
/// <Description>Close the scan options screen</Description>
/// <Parameters></Parameters>
/// <Precondition>Already in the scan options screen</Precondition>
/// <Notes></Notes>
CloseScanOptions
{
    // check for the options not open, if so return Pass
    If: JediOmni.Wait For Object (#hpid-button-options-show-hide[aria-label="Options"],${Zero_Wait_Time})
    {
        Return With Pass (CloseScanOptions complete!)
    }
    
    // open the options screen
    If: JediOmni.Touch (#hpid-button-options-show-hide[aria-label="Hide Options"])
    {
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (CloseScanOptions_Fail.png)
        Return With Fail (Fail while closing scan options!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (OCloseScanOptions_Error.png)
        Return With Error (Error while closing scan options!)
    }
    
    // wait for the button to show Hide Options text
    If: JediOmni.Wait For Object (#hpid-button-options-show-hide[aria-label="Options"],${Short_Wait_Time})
    {
        Return With Pass (CloseScanOptions complete!)
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (CloseScanOptions_Fail.png)
        Return With Fail (Fail while closing scan options!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (OCloseScanOptions_Error.png)
        Return With Error (Error while closing scan options!)
    }
}

/// <Name>SelectScanOption</Name>
/// <Description>Select the specified option from the scan options screen</Description>
/// <Parameters>OptionID : element ID of option</Parameters>
/// <Parameters>OptionText : text of option</Parameters>
/// <Precondition>Scan Options screen open</Precondition>
/// <Notes>Called by multiple routines in this library</Notes>
SelectScanOption (${OptionID},${OptionText})
{
    If: JediOmni.Wait For Object (div.hp-option-list.hp-show,${Zero_Wait_Time})
    {
        // press the option by element ID if specified, else by text
        If: Equals (${OptionID},)
        {
            // press by text
            JediOmni.Touch Text (${OptionText})
        }
        Fail:
        {
            JediOmni.Touch ID (${OptionID})
        }

        // check for specified option screen
        If: JediOmni.Wait For Object (.hp-setting-view[aria-label^="${OptionText}"],${Very_Short_Wait_Time})
        {
            Return With Pass (Select Scan Option complete!)
        }
        Fail:
        {
            Return With Fail (Fail while selecting the specified scan option!)
        }
        Error:
        {
            Return With Error (Error while selecting specified scan option!)
        }
    }
    Fail:
    {
        Return With Fail (Fail while selecting specified scan option!)
    }
    Error:
    {
        Return With Error (Error while selecting specified scan option!)
    }
}

/// <Name>SetScanOption_OriginalSides</Name>
/// <Description>Set the Original Sides option</Description>
/// <Parameters>OriginalSide : original sides option text</Parameters>
/// <Parameters>FlipUp : Y = original sides Flip Up option checked for 2-sided</Parameters>
/// <Precondition>Scan Options screen already showing</Precondition>
/// <Notes></Notes>
SetScanOption_OriginalSides (${OriginalSide},${FlipUp_YN})
{    // check for option specified
    If: Common_LIbrary.CheckVariableContainsValue (${OriginalSide})
    {
    }
    Fail:
    {
        Return With Pass (No Original Sides specified)
    }
    
    If: Scan_Library.SelectScanOption (hpid-option-sides,Sides)
    {
        // press the specified option
        If: JediOmni.Touch (#hpid-original-sides-selection li[aria-label*="${OriginalSide}"])
        {
            Sleep (${Minimal_Wait_Time})
            
            // set the Flip Up option for 2-sided
            If: Equals IgnoreCase (${OriginalSide},2-sided)
            {
                If: Equals IgnoreCase (${FlipUp_YN},Y)
                {
                    If: JediOmni.Wait For Object (#hpid-original-sides-flippagesup-checkbox[aria-label*="Unselected"],${Zero_Wait_Time})
                    {
                        JediOmni.Touch (#hpid-original-sides-flippagesup-checkbox)
                    }
                }
                Fail:
                {
                    If: JediOmni.Wait For Object (#hpid-original-sides-flippagesup-checkbox[aria-label*="Selected"],${Zero_Wait_Time})
                    {
                        JediOmni.Touch (#hpid-original-sides-flippagesup-checkbox)
                    }
                }
            }
            
            // clear the option screen and return Pass
            JediOmni.Touch (.hp-setting-view .hp-header > span)
            JediOmni.Wait For Object Gone (#hpid-option-sides-screen,${Short_Wait_Time})
            
            // success
            Return With Pass (Set Scan Option Original Sides complete!)
        }
        Fail:
        {
            // check for the Option screen still showing indicating failure
            If: JediOmni.Wait For Object (#hpid-option-sides-screen,${Zero_Wait_Time})
            {
                // clear the option screen
                @JediOmni.Touch (.hp-setting-view .hp-header > span)
                JediOmni.Wait For Object Gone (#hpid-option-sides-screen,${Short_Wait_Time})
            }
            
            Return With Fail (Fail while selecting Original Sides scan option!)
        }
        Error:
        {
            Return With Error (Error while selecting Original Sides scan option!)
        }
    }
    Fail:
    {
        Return With Fail (Fail while selecting Original Sides scan option!)
    }
    Error:
    {
        Return With Error (Error while selecting Original Sides scan option!)
    }
}

