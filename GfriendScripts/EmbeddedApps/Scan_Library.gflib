/// <Name>SetScanOption_ScanMode</Name>
/// <Description>Set the scan mode option.
///   Valid Scan Mode options: Standard document; Book; 2-sided ID</Description>
/// <Parameters>ScanMode : scan mode text</Parameters>
/// <Parameters>PromptForPages_YN : For Standard document Y to prompt for pages, else no prompt
///   For 2-sided ID Y to prompt for both sides</Parameters>
/// <Precondition>Scan Options screen already showing</Precondition>
/// <Notes></Notes>
SetScanOption_ScanMode (${ScanMode},${PromptForPages_YN})
{
    // check for option specified
    If: Common_LIbrary.CheckVariableContainsValue (${ScanMode})
    {
    }
    Fail:
    {
        Return With Pass (No ScanMode specified)
    }
    If: Equals (${ScanMode},)
    {
        Return With Pass (No ScanMode specified)
    }
    
    If: Scan_Library.SelectScanOption (hpid-option-scan-mode,Scan Mode)
    {
        // uncheck the prompt for additional pages checkbox, if checked
        If: JediOmni.Wait For Object (#hpid-prompt-add-page-checkbox[aria-label*="Selected"],${Zero_Wait_Time})
        {
            JediOmni.Touch ID (hpid-prompt-add-page-checkbox)
            Sleep (${Minimal_Wait_Time})
        }
        
        // press the specified option
        If: JediOmni.Touch (#hpid-option-scan-mode-screen li[aria-label^="${ScanMode}"])
        {
            Sleep (${Minimal_Wait_Time})
            
            // set the prompt for pages option if necessary
            If: JediOmni.Wait For Object (#hpid-prompt-add-page-checkbox,${Zero_Wait_Time})
            {
                If: Equals (${PromptForPages_YN},Y)
                {
                    If: JediOmni.Wait For Object (#hpid-prompt-add-page-checkbox[aria-label*="Unselected"],${Zero_Wait_Time})
                    {
                        JediOmni.Touch ID (hpid-prompt-add-page-checkbox)
                    }
                }
                Fail:
                {
                    If: JediOmni.Wait For Object (#hpid-prompt-add-page-checkbox[aria-label*="Selected"],${Zero_Wait_Time})
                    {
                        JediOmni.Touch ID (hpid-prompt-add-page-checkbox)
                    }
                }
            }
            
            // set the prompt for both sides option if necessary
            If: JediOmni.Wait For Object (#hpid-prompt-to-scan-both-sides,${Zero_Wait_Time})
            {
                If: Equals (${PromptForPages_YN},Y)
                {
                    If: JediOmni.Wait For Object (#hpid-prompt-to-scan-both-sides[aria-label*="Unselected"],${Zero_Wait_Time})
                    {
                        JediOmni.Touch ID (hpid-prompt-to-scan-both-sides)
                    }
                }
                Fail:
                {
                    If: JediOmni.Wait For Object (#hpid-prompt-to-scan-both-sides[aria-label*="Selected"],${Zero_Wait_Time})
                    {
                        JediOmni.Touch ID (hpid-prompt-to-scan-both-sides)
                    }
                }
            }
            
            // clear the option screen and return fail
            JediOmni.Touch (.hp-setting-view .hp-header > span)
            JediOmni.Wait For Object Gone (#hpid-option-scan-mode-screen,${Short_Wait_Time})
            
            // success
            Return With Pass (Set Scan Option Scan Mode complete!)
        }
        Fail:
        {
            Return With Fail (Fail while selecting Collate scan option!)
        }
        Error:
        {
            Return With Error (Error while selecting Scan Mode scan option!)
        }
    }
    Fail:
    {
        Return With Fail (Fail while selecting Scan Mode scan option!)
    }
    Error:
    {
        Return With Error (Error while selecting Scan Mode scan option!)
    }
}

