/// <Name>SelectPaperSelectionOption</Name>
/// <Description>Select the Paper Selection screen, then 
///   select the specified Paper Selection option</Description>
/// <Parameters>PaperOptionID : element ID of option</Parameters>
/// <Parameters>PaperOptionText : text of option</Parameters>
/// <Precondition>Scan Options screen open</Precondition>
/// <Notes>Called by multiple routines in this library</Notes>
SelectPaperSelectionOption (${PaperOptionID},${PaperOptionText})
{
    // open the Paper Selection options screen
    If: Scan_Library.SelectScanOption (hpid-option-paper-select,Paper Selection)
    {
        // select the specified paper option
        If: JediOmni.Touch ID (${PaperOptionID})
        {
            // check for specified option screen
            If: JediOmni.Wait For Object (.hp-setting-view[aria-label^="${PaperOptionText}"],${Zero_Wait_Time})
            {
                Return With Pass (SelectPaperSelectionOption complete!)
            }
            Fail:
            {
                Return With Fail (Fail while selecting the specified Paper Selection scan option!)
            }
            Error:
            {
                Return With Error (Error while selecting specified Paper Selection scan option!)
            }
        }
    }
    Fail:
    {
        Return With Fail (Fail while selecting Paper Selection scan option!)
    }
    Error:
    {
        Return With Error (Error while selecting Paper Selection scan option!)
    }
}

