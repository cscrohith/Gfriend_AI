/// <Name>SetScanOption_PaperTray</Name>
/// <Description>Set the paper tray option.
///   Sample of valid Trays: Automatically select; Manual feed;
///   Tray 1; Tray 2; Tray 3; Tray 4</Description>
/// <Parameters>PaperTray : paper tray text</Parameters>
/// <Precondition>Scan Options screen already showing</Precondition>
/// <Notes></Notes>
SetScanOption_PaperTray (${PaperTray})
{
    // check for option specified
    If: Common_LIbrary.CheckVariableContainsValue (${PaperTray})
    {
    }
    Fail:
    {
        Return With Pass (No PaperTray specified)
    }
    If: Equals (${PaperTray},)
    {
        Return With Pass (No PaperTray specified)
    }
    
    If: Scan_Library.SelectPaperSelectionOption (hpid-media-source,Paper Tray)
    {
        If: JediOmni.Touch (#hpid-media-source-details li.hp-listitem[aria-label*="${PaperTray}"])
        {
            Sleep (${Minimal_Wait_Time})
        }
            
        // check for the Option screen still showing indicating failure
        If: JediOmni.Wait For Object (#hpid-media-source-details,${Zero_Wait_Time})
        {
            // clear the option screen and return fail
            JediOmni.Touch (#hpid-media-source-details .hp-header > span)
            JediOmni.Wait For Object Gone (#hpid-media-source-details,${Short_Wait_Time})

            // clear the option screen and return fail
            JediOmni.Touch (.hp-setting-view .hp-header > span)
            JediOmni.Wait For Object Gone (#hpid-option-paper-select-screen,${Short_Wait_Time})
            
            Return With Fail (Fail while selecting Paper Tray scan option!)
        }
        Fail:
        {
            // success close the Paper Selection screen
            JediOmni.Touch (.hp-setting-view .hp-header > span)
            JediOmni.Wait For Object Gone (#hpid-option-paper-select-screen,${Short_Wait_Time})
            
            
            Return With Pass (Set Scan Option Paper Tray complete!)
        }
        Error:
        {
            Return With Error (Error while selecting Paper Tray scan option!)
        }
    }
    Fail:
    {
        Return With Fail (Fail while selecting Paper Selection scan option!)
    }
    Error:
    {
        Return With Error (Error while selecting Paper Selection scan option!)
    }
}

