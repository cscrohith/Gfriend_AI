${Enable_PaperlessMode}=Y

// proxy parameters
${Enable_WebServices}=N
${Device_ProxyServer}=web-proxy.austin.hpicorp.net
${Device_ProxyPort}=8080
${Device_ProxyExceptionsList}=*.etl.boi.rd.hpicorp.net;15.13.*;127.0.0.1;15.86.*

// Date/time parameters
${Set_DateTime}=N
${DateTime_TimeZone}=Mountain Time
${DateTime_AdjustDaylightSavings}=Y
${DateTime_DateFormat}=MM_DD_YYYY
${DateTime_TimeFormat}=HOUR_12
${DateTime_SynchToTimeServer}=Y
${DateTime_TimeServerAddress}=etl.boi.rd.hpicorp.net
${DateTime_TimeServerPort}=1230
${DateTime_TimeServerPeriod}=24

// Windows auth parameters
${Configure_WindowsAuth}=Y
${Enable_WindowsAuth}=N
${WindowsAuth_Domain}=etl.boi.rd.hpicorp.net
${WindowsAuth_Use_SSL_YN}=N
${WindowsAuth_Name_Match_Attrribute}=
${WindowsAuth_Email_Attribut}=
${WindowsAuth_User_Name_Attribute}=

${Set_DefaultSignIn}=Y
${SignIn_Default}=Windows
//${SignIn_Default}=Local Device

