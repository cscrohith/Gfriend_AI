///<Name>Perform_PrintJob</Name>
///<Description>Print the currently selected document</Description>
///<Parameters>PrintJobCompleteTimeout : time out for job complete in seconds</Parameters>
///<Precondition>A document has been selected and the Print screen is displayed</Precondition>
///<Notes></Notes>
Perform_PrintJob(${PrintJobCompleteTimeout})
{
    // ensure in print screen
    If: Android.Wait For Object (com.hp.print.horizontalconnector.dropbox:id/btn_print,${Long_Wait})
    {
    }
    Fail:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Fail (Fail while performing print job!)
    }
    Error:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Error (Error while performing print job!)
    }

    Android.Touch ID (com.hp.print.horizontalconnector.dropbox:id/btn_print)
    
    If: Android.Wait For Text (Printing...,${Long_Wait})
    {
    }
    Fail:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Fail (Fail while performing print job!)
    }
    Error:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Error (Error while performing print job!)
    }

//  If: Android.Wait For Text (Print job is complete.,${PrintJobCompleteTimeout})
//    If: Android.Wait For Object Gone (com.hp.print.horizontalconnector.dropbox:id/ll_dialog_main,${PrintJobCompleteTimeout})
    If: Android.Wait For Object (com.hp.print.horizontalconnector.dropbox:id/toolbar,${PrintJobCompleteTimeout})
    {
        Return With Pass (Perform_PrintJob completed!)
    }
    
    //    If: Android.Wait For Object Gone (com.hp.print.horizontalconnector.dropbox:id/ll_dialog_main,${Short_Wait_Time})
    If: Android.Wait For Text (Print job is complete.,${Zero_Wait_Time})
    {
        Android.Touch Text (OK)
        Return With Pass (Perform_PrintJob completed!)
    }
    
    // at this point the job did not complete successfully in time
    If: Android.Touch Text (Cancel Job)
    {
        Android.Wait For Text (Yes,${Short_Wait_Time})
        Android.Touch Text (Yes)
        Android.Wait For Text (OK,${Short_Wait_Time})
        Android.Touch Text (OK)
        //print not success, return fail
        Return With Fail (Fail print document within 1800 seconds, job cancelled!)
    }
    Fail:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Fail (Fail while performing print job!)
    }
    Error:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Error (Error while performing print job!)
    }
} 
