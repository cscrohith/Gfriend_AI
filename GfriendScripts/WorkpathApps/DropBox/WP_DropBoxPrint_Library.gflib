///<File>WP_DropboxPrint_Library.gflib</File>
///<Modified>2021-09-24</Modified>
///<Description>library of print routines for use with the HP for Dropbox Workpath App</Description>
///<Precondition></Precondition>
///<Author>Ron Pridmore</Author>

// these variable file references need to be changed to not point to other folders
// when used in the STF GFriend plugin
//Using StandardTimeouts.gfvar
Using ..\..\Common\StandardTimeouts.gfvar

// these library references need to be changed to not point to other folders
// when used in the STF GFriend plugin
//Using Common_LIbrary.gflib
Using ..\..\Common\Common_LIbrary.gflib

Using WP_Dropbox_Library.gflib

Using JediOmni
Using Android

///<Name>SetPrintOption_Copies</Name>
///<Description>Set the number of copies print option</Description>
///<Parameters>Num_Copies : number of copies to print</Parameters>
///<Precondition></Precondition>
///<Notes></Notes>
SetPrintOption_Copies(${Num_Copies})
{
    // check for option specified
    If: Common_LIbrary.CheckVariableContainsValue (${Num_Copies})
    {
    }
    Fail:
    {
        Return With Pass (No Num_Copies specified)
    }
    
    // select the option
    If: Android.Touch ID (com.hp.print.horizontalconnector.dropbox:id/et_number_of_copies)
    {
        // set the specified option
        Android.Input Text (com.hp.print.horizontalconnector.dropbox:id/et_number_of_copies,${Num_Copies})
        Return With Pass (SetPrintOption_Copies completed!)
    }
    Fail:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Fail (Fail while setting Number of Copies print option!)
    }
    Error:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Error (Error while setting Number of Copies print option!)
    }
}

///<Name>SetPrintOption_OutputSides</Name>
///<Description>Set the output sides print option</Description>
///<Parameters>OutputSides : sides text</Parameters>
///<Precondition></Precondition>
///<Notes></Notes>
SetPrintOption_OutputSides(${OutputSides})
{
    // check for option specified
    If: Common_LIbrary.CheckVariableContainsValue (${OutputSides})
    {
    }
    Fail:
    {
        Return With Pass (No OutputSides specified)
    }
    
    // select the option
    Android.Touch Text (Output Sides)
    If: Android.Wait For Object (com.hp.print.horizontalconnector.dropbox:id/bt_done,${Very_Short_Wait_Time})
    {
    }
    Fail:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Fail (Fail while setting Output Sides print option!)
    }
    Error:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Error (Error while setting Output Sides print option!)
    }
    
    // set the specified option
    If: Android.Touch Text (${OutputSides})
    {
        // press the Done button if it shows
        @Android.Touch ID (com.hp.print.horizontalconnector.dropbox:id/bt_done)
        Return With Pass (SetPrintOption_OutputSides completed!)
    }
    Fail:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        // press the Done button to close the option view
        @Android.Touch ID (com.hp.print.horizontalconnector.dropbox:id/bt_done)
        Return With Fail (Fail while setting Output Sides print option!)
    }
    Error:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        // press the Done button to close the option view
        @Android.Touch ID (com.hp.print.horizontalconnector.dropbox:id/bt_done)
        Return With Error (Error while setting Output Sides print option!)
    }
}

///<Name>SetPrintOption_ColorBlack</Name>
///<Description>Set the color/black option</Description>
///<Parameters>Color_Black : color/black text</Parameters>
///<Precondition></Precondition>
///<Notes></Notes>
SetPrintOption_ColorBlack(${Color_Black})
{
    // check for option specified
    If: Common_LIbrary.CheckVariableContainsValue (${Color_Black})
    {
    }
    Fail:
    {
        Return With Pass (No Color_Black specified)
    }
    
    // click on the option
    If: Android.Touch Text (Color/Black)
    {
    }
    Fail:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Fail (Fail while selecting Color/Black print option!)
    }
    Error:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Error (Error while selecting Color/Black print option!)
    }
    
    // set the specified option
    //    If: Android.Touch Text (${Color_Black})
    If: Android.Touch XPath (//*[@resource-id='com.hp.print.horizontalconnector.dropbox:id/tv_title' and @text='${Color_Black}'])
    {
        Sleep (${Minimal_Wait_Time})
        Return With Pass (SetPrintOption_ColorBlack completed!)
    }
    Fail:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Fail (Fail while selecting Color/Black print option!)
    }
    Error:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Error (Error while selecting Color/Black print option!)
    }
}

///<Name>SetPrintOption_PaperSelection_PaperSize</Name>
///<Description>Set the paper size option</Description>
///<Parameters>PaperSize : paper size text</Parameters>
///<Precondition></Precondition>
///<Notes></Notes>
SetPrintOption_PaperSelection_PaperSize(${PaperSize})
{
    // check for option specified
    If: Common_LIbrary.CheckVariableContainsValue (${PaperSize})
    {
    }
    Fail:
    {
        Return With Pass (No PaperSize specified)
    }
    
    If: Android.Check Screen Contains Partial Text (${PaperSize})
    {
        Return With Pass (SetPrintOption_PaperSelection_PaperSize completed!)
    }

    // click on the option
    Android.Touch Text (Paper Selection)
    Android.Wait For Text (Paper Size,${Very_Short_Wait_Time})
    If: Android.Touch Text (Paper Size)
    {
    }
    Fail:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Fail (Fail while selecting Paper Size print option!)
    }
    Error:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Error (Error while selecting Paper Size print option!)
    }

    // find the specified option
    Android.Wait For Object (com.hp.print.horizontalconnector.dropbox:id/rl_content_pane,${Very_Short_Wait_Time})
    While:Android.Check Screen Not Contains Partial Text (${PaperSize}):3
    {
        Android.Swipe (com.hp.print.horizontalconnector.dropbox:id/rl_content_pane,^)
    }
    // if still not displayed then scroll up upto 4 pages
    While: Android.Check Screen Not Contains Full Text (${PaperSize}): 4
    {
        Android.Swipe (com.hp.print.horizontalconnector.dropbox:id/rl_content_pane,v)
    }
        
    // click on the specified option
    //    If: Android.Touch Text (${PaperSize})
    If: Android.Touch XPath (//*[@resource-id='com.hp.print.horizontalconnector.dropbox:id/tv_title' and @text='${PaperSize}'])
    {
        Android.Wait For Object Gone (ccom.hp.print.horizontalconnector.dropbox:id/rl_content_pane,${Short_Wait_Time})
        
        //Android.Touch ID (com.hp.print.horizontalconnector.dropbox:id/iv_more_image)
        @Android.Touch ID (com.hp.print.horizontalconnector.dropbox:id/rl_back)
        
        Return With Pass (SetPrintOption_PaperSelection_PaperSize completed!)
    }
    Fail:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Fail (Fail while selecting Paper Size print option!)
    }
    Error:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Error (Error while selecting Paper Size print option!)
    }
}

///<Name>SetPrintOption_PaperSelection_PaperType</Name>
///<Description>Set the paper type option</Description>
///<Parameters>PaperType : paper type text</Parameters>
///<Precondition></Precondition>
///<Notes></Notes>
SetPrintOption_PaperSelection_PaperType(${PaperType})
{
    // check for option specified
    If: Common_LIbrary.CheckVariableContainsValue (${PaperType})
    {
    }
    Fail:
    {
        Return With Pass (No PaperType specified)
    }
    
    If: Android.Check Screen Contains Partial Text (${PaperType})
    {
        Return With Pass (SetPrintOption_PaperSelection_PaperType completed!)
    }
    
    // click on the option
    Android.Touch Text (Paper Selection)
    Android.Wait For Text (Paper Type,${Very_Short_Wait_Time})
    Android.Touch Text (Paper Type)

    // find the specified option
    Android.Wait For Object (com.hp.print.horizontalconnector.dropbox:id/rl_content_pane,${Very_Short_Wait_Time})
    While:Android.Check Screen Not Contains Partial Text (${PaperType}):6
    {
        //                Android.Swipe (com.hp.print.horizontalconnector.dropbox:id/lv_option_sub_list,^)
        Android.Drag (75,60,75,25)
    }
    // if still not displayed then scroll up upto 4 pages
    While: Android.Check Screen Not Contains Full Text (${PaperType}): 6
    {
        //                Android.Swipe (com.hp.print.horizontalconnector.dropbox:id/lv_option_sub_list,v)
        Android.Drag (75,25,75,60)
    }
        
    // click on the specified option
    //    If: Android.Touch Text (${PaperType})
    If: Android.Touch XPath (//*[@resource-id='com.hp.print.horizontalconnector.dropbox:id/tv_title' and @text='${PaperType}'])
    {
        Android.Wait For Object Gone (ccom.hp.print.horizontalconnector.dropbox:id/rl_content_pane,${Short_Wait_Time})
        
        //Android.Touch ID (com.hp.print.horizontalconnector.dropbox:id/iv_more_image)
        @Android.Touch ID (com.hp.print.horizontalconnector.dropbox:id/rl_back)
        
        Return With Pass (SetPrintOption_PaperSelection_PaperType completed!)
    }
    Fail:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Fail (Fail while selecting Paper Type print option!)
    }
    Error:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Error (Error while selecting Paper Type print option!)
    }
}

///<Name>SetPrintOption_PaperSelection_PaperTray</Name>
///<Description>Set the tray option</Description>
///<Parameters>PaperTray : tray text</Parameters>
///<Precondition></Precondition>
///<Notes></Notes>
SetPrintOption_PaperSelection_PaperTray(${PaperTray})
{
    // check for option specified
    If: Common_LIbrary.CheckVariableContainsValue (${PaperTray})
    {
    }
    Fail:
    {
        Return With Pass (No PaperTray specified)
    }
    
    // click on the option
    Android.Touch Text (Paper Selection)
    Android.Wait For Text (Paper Tray,${Very_Short_Wait_Time})
    Android.Touch Text (Paper Tray)

    // find the specified option
    Android.Wait For Object (com.hp.print.horizontalconnector.dropbox:id/rl_content_pane,${Very_Short_Wait_Time})
    While:Android.Check Screen Not Contains Partial Text (${PaperTray}):2
    {
        Android.Drag (75,60,75,25)
    }
    // if still not displayed then scroll up upto 4 pages
    While: Android.Check Screen Not Contains Full Text (${PaperTray}):2
    {
        Android.Drag (75,25,75,60)
    }
        
    // click on the specified option
    //    If: Android.Touch Text (${PaperTray})
    If: Android.Touch XPath (//*[@resource-id='com.hp.print.horizontalconnector.dropbox:id/tv_title' and @text='${PaperTray}'])
    {
        Android.Wait For Object Gone (ccom.hp.print.horizontalconnector.dropbox:id/rl_content_pane,${Short_Wait_Time})
        
        //Android.Touch ID (com.hp.print.horizontalconnector.dropbox:id/iv_more_image)
        @Android.Touch ID (com.hp.print.horizontalconnector.dropbox:id/rl_back)
        
        Return With Pass (SetPrintOption_PaperSelection_PaperTray completed!)
    }
    Fail:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Fail (Fail while selecting Paper Tray print option!)
    }
    Error:
    {
        WP_Dropbox_Library.CheckForErrorMessage
        Return With Error (Error while selecting Paper Tray print option!)
    }
}

