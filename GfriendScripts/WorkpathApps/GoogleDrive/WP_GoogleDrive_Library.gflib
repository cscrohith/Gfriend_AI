///<File>WP_GoogleDrive_Library.gflib</File>
///<Modified>2021-09-24</Modified>
///<Description>library of common routines for use with the HP for Google Drive Workpath App</Description>
///<Precondition></Precondition>
///<Author>Ron Pridmore</Author>

${AppSignIn_ScreenChange_Timeout}=90
${Loading_Icon_Show_Timeout}=5
${Loading_Icon_Gone_Timeout}=60
${App_Splash_Gone_Timeout}=90

// these variable file references need to be changed to not point to other folders
// when used in the STF GFriend plugin
//Using StandardTimeouts.gfvar
Using ..\..\Common\StandardTimeouts.gfvar

Using Android
Using JediOmni

///<Name>CheckForLoadingIcon</Name>
///<Description>Check for the loading icon to appear then disappear</Description>
///<Parameters></Parameters>
///<Precondition></Precondition>
///<Notes>This is called by multiple routines in this and other OneDrive libraries</Notes>
CheckForLoadingIcon
{
    //    If: Android.Wait For Object (com.hp.print.horizontalconnector.googledrive:id/ll_dots,${Loading_Icon_Show_Timeout})
    If: Android.Wait For Object (com.hp.print.horizontalconnector.googledrive:id/fl_dot_animation,${Loading_Icon_Show_Timeout})
    {
        //        Android.Wait For Object Gone (com.hp.print.horizontalconnector.googledrive:id/ll_dots,${Loading_Icon_Gone_Timeout})
        Android.Wait For Object Gone (com.hp.print.horizontalconnector.googledrive:id/fl_dot_animation,${Loading_Icon_Gone_Timeout})
    }
}

///<Name>CheckForErrorMessage</Name>
///<Description>Check for loss of server connection message</Description>
///<Parameters></Parameters>
///<Precondition></Precondition>
///<Notes>This is called by multiple routines in this and other OneDrive libraries</Notes>
CheckForErrorMessage
{
    If: Android.Wait For Object (com.android.inputmethod.latin:id/keyboard_view,${Zero_Wait_Time})
    {
        Android.Hide Keyboard
    }
    
    If: Android.Wait For Object (com.hp.print.horizontalconnector.googledrive:id/ll_dialog_main,${Zero_Wait_Time})
    {
        Set Variable (${Error_Text}, )
        @Android.Get Text (com.hp.print.horizontalconnector.googledrive:id/tv_contents,${Error_Text})
        
        Android.Capture Screen Shot (CheckForErrorMessage_Fail.png)
        // clear the popup message
        //@Android.Touch Text (OK)
        //@Android.Touch Text (DONE)
        //@Android.Touch Text (Done)
        @Android.Touch ID (com.hp.print.horizontalconnector.googledrive:id/bt_dialog_left)

        If: Contains Ignore Case (${Error_Text},Server access has been lost)
        {
            Return With Fail (Fail - Server access lost while in app!)
        }
        If: Contains Ignore Case (${Error_Text},Unable to retrieve data)
        {
            Return With Fail (Fail - Unable to retrieve data from cloud services while in app!)
        }
        If: Contains Ignore Case (${Error_Text},Unable to preview data)
        {
            Return With Fail (Fail - Unable to preview data from cloud services while in app!)
        }
        If: Contains Ignore Case (${Error_Text},App could not load)
        {
            Return With Fail (Fail - App could not load!)
        }
    }
    Fail:
    {
        Return With Pass (Check for Server Loss complete!)
    }
}

///<Name>HandleAppEula</Name>
///<Description>Handle the EULA screen</Description>
///<Parameters></Parameters>
///<Precondition></Precondition>
///<Notes>This is called by HandleAppOpening in this library</Notes>
HandleAppEula
{
    If: Android.Wait For Object (com.hp.print.horizontalconnector.googledrive:id/bt_hp_privacy,${Zero_Wait_Time})
    {
        //Terms Information
        //I have read and agree to the above documents.
        Android.Touch ID (com.hp.print.horizontalconnector.googledrive:id/cb_agree)
        //Tap Continue button.
        If: Android.Touch ID (com.hp.print.horizontalconnector.googledrive:id/bt_continue)
        {
            If: Android.Wait For Object Gone (com.hp.print.horizontalconnector.googledrive:id/bt_continue,${Wait_Time})
            {
                Return With Pass (HandleAppEula completed)
            }
            Fail:
            {
                Return With Fail (Fail handling the HP Privacy and EULA screen!)
            }
        }
        Fail:
        {
            Return With Fail (Fail handling the HP Privacy and EULA screen!)
        }
    }
}

///<Name>EnterLoginUserID</Name>
///<Description>Enter app the UserID</Description>
///<Parameters>Login_UserID : app UserID</Parameters>
///<Precondition></Precondition>
///<Notes>This is called by AppLogin in this library</Notes>
EnterLoginUserID(${Login_UserID})
{
    // Input ID
//    If: Android.Wait For Object (Email,${Minimal_Wait_Time})
//    {
//    }
//    Fail:
//    {
//        Return With Fail (Fail entering UserID in to Google Drive app!)
//    }
//    Error:
//    {
//        Return With Error (Error entering UserID in to Google Drive app!)
//    }
    
    Android.Touch ID (Email)
    Sleep (${Very_Short_Wait_Time})
    If: Android.Input Text (Email,${Login_UserID})
    {
        Android.Hide Keyboard
        Sleep (${Short_Wait_Time})
    }
    Fail:
    {
        Return With Fail (Fail entering UserID in to Google Drive app!)
    }
    Error:
    {
        Return With Error (Error entering UserID in to Google Drive app!)
    }
    
    If: Android.Touch ID (next)
    {
        If: Android.Wait For Object Gone (Email,${AppSignIn_ScreenChange_Timeout})
        {
        }
        Fail:
        {
            // UserID failed
            Return With Fail (Fail entering UserID in to Google Drive app!)
        }
    }
    Fail:
    {
        Return With Fail (Fail entering UserID in to Google Drive app!)
    }
    Error:
    {
        Return With Error (Error entering UserID in to Google Drive app!)
    }
}

