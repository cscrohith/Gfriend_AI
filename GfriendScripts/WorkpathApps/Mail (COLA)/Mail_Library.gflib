//
// Notes:
//
// Version:
/////////////////////////////////////////////////
AppSignout
{
    If: Mail_Library.CheckForServerLoss
    {
    }
    Fail:
    {
        Fail (Fail handling the app opening!)
        Stop Test Case
    }
    Error:
    {
