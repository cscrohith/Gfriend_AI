        Android.Wait For Text (Leaving the App,10)
        Android.Touch Text (YES)
        Sleep (5)
    }
    Fail:
    {
        Fail (Fail while signing out of Mail app!)
    }
    Error:
    {
        Error (Error while signing out of Mail app!)
    }
}

