/////////////////////////////////////////////////
// Routine:         SearchForEmail
// Description:     Search for email and and click on it
//
// Arguments:       ${SearchText} - test to search
//
// Pre-requisites:
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
SearchForEmail(${SearchText})
{
    If: Android.Touch ID (com.hp.print.emailplus:id/atvSearch)
    {
        Sleep (2)

        Android.Input Text (com.hp.print.emailplus:id/atvSearch,${SearchText})

        Sleep (2)
        
        Android.Wait For Object (com.hp.print.emailplus:id/tvSearchResults,10)
        
        If: Android.Touch ID With Index (com.hp.print.emailplus:id/clMailItemLayout,1)
        {
            Sleep (2)
            If: Android.Wait For Object (com.hp.print.emailplus:id/tvReply,10)
            {
            }
            Fail:
            {
                Fail (Fail selecting email for ${SearchText}!)
            }
            Error:
            {
                Error (Error while selecting email for ${SearchText}!)
            }
        }
        Fail:
        {
            Fail (Fail searching for ${SearchText}!)
        }
        Error:
        {
            Error (Error while searching for ${SearchText}!)
        }
    }
    Fail:
    {
        Fail (Fail selecting the Search box searching for ${SearchText}!)
    }
    Error:
    {
        Error (Error while selecting the Search box searching for ${SearchText}!)
    }
}

