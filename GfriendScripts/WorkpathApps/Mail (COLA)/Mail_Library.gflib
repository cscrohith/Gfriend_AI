/////////////////////////////////////////////////
// Routine:         EnterEmailInfo
// Description:     enter the necessary info for an email
//
// Arguments:       ${Destination} - detination address(s)
//                  ${Subject} - subject text
//                  ${Body} - body text
//
// Pre-requisites:
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
EnterEmailInfo(${Destination},${Subject},${Body})
{
    // enter the To if specified
    If: Equals (${Destination},)
    {// no destination specified, leave as-is
    }
    Fail:
    {// enter the Destination
        Android.Touch ID (com.hp.print.emailplus:id/atvToAddresses)
        Android.Input Text (com.hp.print.emailplus:id/atvToAddresses,${Destination})
        // click off to close the keyboard
        Android.Touch ID (com.hp.print.emailplus:id/appbar)
    }
    
    // Subject if specified
    If: Equals (${Subject},)
    {// no subject specified, leave as-is
    }
    Fail:
    {// enter the Subject
        Android.Touch ID (com.hp.print.emailplus:id/atvSubject)
        Android.Input Text (com.hp.print.emailplus:id/atvSubject,${Subject})
        // click off to close the keyboard
        Android.Touch ID (com.hp.print.emailplus:id/appbar)
    }
    // Message Body if specified
    If: Equals (${Body},)
    {// no subject specified, leave as-is
    }
    Fail:
    {// enter the Message Body
        Android.Touch ID (editor)
        If: Android.Get Text (editor,${PevBodyText})
        {
            Android.Input Text (editor,${Body}${PevBodyText})
        }
        Fail:
        {
            Android.Input Text (editor,${Body})
        }
        // click off to close the keyboard
        Android.Touch ID (com.hp.print.emailplus:id/appbar)
    }
}

/////////////////////////////////////////////////
// Routine:         AddScanToEmail
// Description:     add scan to the email
//
// Arguments:       ${ScanFilename} - name for file or scans
//                  ${NumPages} - number of pages to scan
//
// Pre-requisites:
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
AddScanToEmail(${ScanFilename},${NumPages})
{
    // wait for the to filename text box
    If: Android.Wait For Object (com.hp.print.emailplus:id/atvEditFileName,10)
    {
        // set the file name
        Get Time Stamp (${Time})
        Android.Input Text (com.hp.print.emailplus:id/atvEditFileName,${ScanFilename}_${Time})
        
        // click off to close the keyboard
        Android.Touch ID (com.hp.print.emailplus:id/appbar)
        
        // initiate the scan
        Android.Wait For Object (com.hp.print.emailplus:id/tvScanTab,5)
        Android.Touch ID (com.hp.print.emailplus:id/tvScanTab)
        Sleep (2)
        
        // wait for the image preview screen
        If: JediOmni.Wait For Text (Scanning...,20)
        {
            JediOmni.Wait For Text Gone (Scanning...,60)
            Sleep (10)
        }
        If: Equals (${NumPages},1)
        {// 1 page, no action
        }
        Fail:
        {// multiple pages
            Repeat:${NumPages}
            {
                If: Equals (${NumPages},${R})
                {// last scan already done, no action
                }
                Fail:
                {// add a page
                    JediOmni.Wait For Object (hpid-preview-button-add-pages,20)
                    JediOmni.Touch ID (hpid-preview-button-add-pages)
                    Sleep (5)
                    JediOmni.Wait For Object (hpid-button-scan,20)
                    JediOmni.Touch ID (hpid-button-scan)
                    Sleep (10)
                }
            }
        }
        // all pages added, finish the scan
        JediOmni.Touch ID (hpid-button-start)
        While:!Android.Wait For Object (com.hp.print.emailplus:id/tvCreateFile,10):${NumPages}
        {
            Sleep(10)
        }
        Android.Touch ID (com.hp.print.emailplus:id/tvCreateFile)
        Android.Wait For Object (com.hp.print.emailplus:id/tvSendEmail,10)
    }
    Fail:
    {
        Fail (Fail while sending email!)
    }
    Error:
    {
        Error (Error while sending email!)
    }
}

/////////////////////////////////////////////////
// Routine:         SendEmail
// Description:     send the currently initiated email, or reply
//
// Arguments:       ${NumPages} - number of pages in scan 
//                          (used to estimate processing time)
//
// Pre-requisites:
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
SendEmail(${NumPages})
{
    // wait for the to address text box
    If: Android.Wait For Object (com.hp.print.emailplus:id/tvSendEmail,10)
    {
        // send the email
        Android.Touch ID (com.hp.print.emailplus:id/tvSendEmail)
        
        // wait for the confirm dialog
        If: Android.Wait For Text (Confirm Sending,5)
        {
            Android.Touch Text (Yes)
        }
        Sleep (5)
        
        // wait for the email to finish sending
        While:!Android.Wait For Object (com.hp.print.emailplus:id/tvNewEmail,10): ${NumPages}
        {
            Sleep(10)
        }
        If: Android.Wait For Object (com.hp.print.emailplus:id/tvNewEmail,10)
        {// finished, no action
        }
        Fail:
        {
            Fail (Fail while sending email!)
        }
        Error:
        {
            Error (Error while sending email!)
        }
    }
    Fail:
    {
        Fail (Fail while sending email!)
    }
    Error:
    {
        Error (Error while sending email!)
    }
}

