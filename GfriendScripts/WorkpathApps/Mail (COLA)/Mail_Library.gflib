using Android
using JediOmni
using Info

/////////////////////////////////////////////////
// Routine:         CheckForServerLoss
// Description:     check for loss of server connection message
//
// Arguments:       
//
// Pre-requisites:  
//
// Notes:   this is called by multiple rotines
//
// Version:
/////////////////////////////////////////////////
CheckForServerLoss
{
    If: Android.Check Screen Contains Partial Text (Server access has been lost)
    {
        // clear the message
        Android.Capture Screen Shot (CheckForServerLoss_Fail.png)
        @Android.Touch Text (OK)
        @Android.Touch Text (DONE)
        Fail (Fail - Server access lost while in app!)
    }
}

/////////////////////////////////////////////////
// Routine:         CheckAndClearSaveDraftMessage
// Description:     check for and clear the Safe Draft message
//
// Arguments:       
//
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
CheckAndClearSaveDraftMessage
{
    If: Android.Check Screen Contains Full Text (Save as Draft?)
    {
        // clear the message
        Android.Touch Text (OK)
    }
}


/////////////////////////////////////////////////
// Routine:         HandleAppEula
// Description:     handle the EULA screen
//
// Arguments:       
//
// Pre-requisites:  
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
HandleAppEula
{
    //Terms Information
    If: Android.Wait For Text (I have read and agree to the above documents.,5)
    {// the Eula page is displayed, handle it
        //I have read and agree to the above documents.
        If: Android.Wait For Object (com.hp.print.emailplus:id/cb_agree,5)
        {
            Android.Touch ID (com.hp.print.emailplus:id/cb_agree)
        }
        //Tap Continue button.
        If: Android.Wait For Object (com.hp.print.emailplus:id/bt_continue,5)
        {
            Android.Touch ID (com.hp.print.emailplus:id/bt_continue)
            //Android.Wait For Object Gone (com.hp.print.emailplus:id/bt_continue,10)
            Sleep (5)
        }
    }
    Fail:
    {
        Fail (Fail waiting for the EULA screen to display in Mail app!)
    } 
}

/////////////////////////////////////////////////
// Routine:         EnterLoginUserID
// Description:     enter the userID
//
// Arguments:       ${Login_UserID} - UserID
//
// Pre-requisites:
//
// Notes:   this was modified to not use the Android WebView commands
//              because those commands are slower and 
//              sometimes miss typing characters
//
// Version:
/////////////////////////////////////////////////
EnterLoginUserID(${Login_UserID})
{
    //    If: Mail_Library.CheckForServerLoss
    If: Mail_Library.CheckForServerLoss
    {
        // Input ID
        //    If: Android.Wait For Web Object (//*[@class='placeholderContainer']/input[1],20)
        If: Android.Wait For Object (i0116,20)
        {
            //        Android.Touch Web Object (//*[@class='placeholderContainer']/input[1])
            Android.Touch ID (i0116)
            //        If: Android.Set Text Web Object (//*[@class='placeholderContainer']/input[1],${Login_UserID})
            If: Android.Input Text (i0116,${Login_UserID})
            {
                //Sleep(5)
                Android.Touch ID (loginHeader)
                If: Android.Touch Text With Index (Next,0)
                {
                    Sleep(10)
                    //                If: Android.Is Web Text Exist (Next)
                    If: Android.Check Screen Contains Full Text (Next)
                    {// UserID failed
                        Android.Capture Screen Shot (EnterLoginUserID_Fail.png)
                        Fail (Fail entering UserID in to Mail app!)
                    }
                }
                Fail:
                {
                    Fail (Fail entering UserID in to Mail app!)
                }
                Error:
                {
                    Error (Error entering UserID in to Mail app!)
                }
            }
            Fail:
            {
                Fail (Fail entering UserID in to Mail app!)
            }
            Error:
            {
                Error (Error entering UserID in to Mail app!)
            }
        }
        Fail:
        {
            Fail (Fail entering UserID in to Mail app!)
        }
        Error:
        {
            Error (Error entering UserID in to Mail app!)
        }
    }
    Fail:
    {
        Fail (Fail handling the app opening!)
    }
    Error:
    {
        Error (Error while handling the app opening!)
    }
}

/////////////////////////////////////////////////
// Routine:         EnterLoginUserPW
// Description:     enter the user's password
//
// Arguments:       ${Login_PW} - Password
//
// Pre-requisites:
//
// Notes:   this was modified to not use the Android WebView commands
//              because those commands are slower and 
//              sometimes miss typing characters
//
// Version:
/////////////////////////////////////////////////
EnterLoginUserPW(${Login_PW})
{
    If: Mail_Library.CheckForServerLoss
    {
        //    If: Android.Wait For Web Object (//*[@class='placeholderContainer']/input[1],20)
        If: Android.Wait For Object (i0118,20)
        {
            //        Android.Touch Web Object (//*[@class='placeholderContainer']/input[1])
            Android.Touch ID (i0118)
            //        If: Android.Set Text Web Object (//*[@class='placeholderContainer']/input[1],${Login_PW})
            If: Android.Input Text (i0118,${Login_PW})
            {
                // Tap Login button.
                Android.Touch ID (loginHeader)
                If: Android.Touch Text With Index (Sign in,0)
                {
                    Sleep (10)
                    //                If: Android.Is Web Text Exist (Enter password)
                    If: Android.Wait For Text (Forgot password?,0)
                    {// Login failed
                        Android.Capture Screen Shot (EnterLoginUserPW_Fail.png)
                        Fail (Fail entering Password in to Mail app!)
                    }
                }
                Fail:
                {
                    Fail (Fail entering Password in to Mail app!)
                }
                Error:
                {
                    Error (Error entering Password in to Mail app!)
                }
            }
            Fail:
            {
                Fail (Fail entering Password in to Mail app!)
            }
            Error:
            {
                Error (Error entering Password in to Mail app!)
            }
        }
        Fail:
        {
            Fail (Fail entering Password in to Mail app!)
        }
        Error:
        {
            Error (Error entering Password in to Mail app!)
        }
    }
    Fail:
    {
        Fail (Fail handling the app opening!)
    }
    Error:
    {
        Error (Error while handling the app opening!)
    }
}

/////////////////////////////////////////////////
// Routine:         AppLogin
// Description:     Log In to the app
//
// Arguments:       ${ID} - UserID
//                  ${Pw} - Password
//
// Pre-requisites:
//
// Notes:   this was modified to not use the Android WebView commands
//              because those commands are slower and 
//              sometimes miss typing characters
//
// Version:
/////////////////////////////////////////////////
AppLogin(${ID},${Pw})
{
     If: Mail_Library.CheckForServerLoss
    {
        //Done popup
        If: Android.Wait For Text (DONE,1)
        {
            Android.Touch Text(DONE)
            
            //Login by WebView
            Android.Wait For Text Gone (Connecting to the authentication server,30)

            //Sleep(10)

    //        // Get Webview control.
    //        If: Android.Get Webview (60)
    //        {
                // Input ID
                If: Mail_Library.EnterLoginUserID(${ID})
                {
                    If: Mail_Library.EnterLoginUserPW(${Pw})
                    {
                        // check for Stay signed in page
                        //If: Android.Is Web Text Exist (Stay signed in?)
                        //                    If: Android.Wait For Text (Stay signed in?,0)
                        If: Android.Check Screen Contains Partial Text (Stay Signed in)
                        {
                            Android.Touch Text With Index (No,0)
                            Sleep (10)
                        }
                        // return Webview control
                        //                    Android.Return Webview
                    }
                    Fail:
                    {
                        Fail (Fail entering password signing in to Mail app!)
                    }
                    Error:
                    {
                        Error (Error entering password signing in to Mail app!)
                    }
                }
                Fail:
                {
                    Fail (Fail entering userID signing in to Mail app!)
                }
                Error:
                {
                    Error (Error entering userID signing in to Mail app!)
                }
    //        }
    //        Fail:
    //        {
    //            Fail (Fail connecting to Webview in Mail app!)
    //        }
    //        Error:
    //        {
    //            Error (Error connecting to Webview in Mail app!)
    //        }
        }
        Fail:
        {
            Fail (Fail waiting for the sign in screen in Mail app!)
        }
    }
    Fail:
    {
        Fail (Fail handling the app opening!)
    }
    Error:
    {
        Error (Error while handling the app opening!)
    }
}

