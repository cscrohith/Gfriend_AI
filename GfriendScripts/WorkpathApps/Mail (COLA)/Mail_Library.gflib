/////////////////////////////////////////////////
// Routine:         SelectScanOption
// Description:     select the specified option from 
//                      the scan options screen
//
// Arguments:       ${OptionText} - text of option
//
// Pre-requisites:
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
SelectScanOption (${OptionText})
{
    If: Android.Wait For Object (com.hp.print.emailplus:id/lv_option_list,2)
    {
        // if the option is not displayed, then scroll down upto 2 pages
        While: Android.Check Screen Not Contains Full Text (${OptionText}): 2
        {
            Android.Swipe (com.hp.print.emailplus:id/lv_option_list,v)
        }
        // if still not displayed then scroll up upto 4 pages
        While: Android.Check Screen Not Contains Full Text (${OptionText}): 4
        {
            Android.Swipe (com.hp.print.emailplus:id/lv_option_list,^)
        }
        If: Android.Check Screen Contains Full Text (${OptionText})
        {
            Android.Touch Text (${OptionText})
        }
        Fail:
        {
            Fail (Fail while selecting ${OptionText} scan option!)
        }
        Error:
        {
            Error (Error while selecting ${OptionText} scan option!)
        }
    }
    Fail:
    {
        Fail (Fail while selecting ${OptionText} scan option!)
    }
    Error:
    {
        Error (Error while selecting ${OptionText} scan option!)
    }
}

/////////////////////////////////////////////////
// Routine:         SetScanOption_FileType
// Description:     set the File Type
//
// Arguments:       ${FileType} - type text
//
// Pre-requisites:
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
SetScanOption_FileType (${FileType})
{
    If: Mail_Library.SelectScanOption (File Type and Resolution)
    {
        // check for type already selected
        Android.Get Text (com.hp.print.emailplus:id/btn_file_type,${CurrentFileType})
        If: Equals (${CurrentFileType},${FileType})
        {// type already selected
            Android.Touch ID (com.hp.print.emailplus:id/iv_more_image)
            Sleep (1)
        }
        Fail:
        {// type not already selected
            Android.Touch ID (com.hp.print.emailplus:id/btn_file_type)
            Sleep (2)
            
            // find the type in the list
            If: Android.Check Screen Not Contains Full Text (${FileType})
            {// type not shown, swipe up then down
                Android.Swipe (com.hp.print.emailplus:id/rp_container,v)
                Android.Swipe (com.hp.print.emailplus:id/rp_container,v)
                Sleep (1)
                If: Android.Check Screen Not Contains Full Text (${FileType})
                {// type still not shown, swipe down
                    Android.Swipe (com.hp.print.emailplus:id/rp_container,^)
                    Android.Swipe (com.hp.print.emailplus:id/rp_container,^)
                    Sleep (1)
                }
            }
            
            // click on the type
            If: Android.Touch Text (${FileType})
            {
                Sleep (1)
                Android.Touch ID (com.hp.print.emailplus:id/bt_done)
                Sleep (3)
            }
            Fail:
            {
                Fail (Fail while selecting File Type scan option!)
            }
            Error:
            {
                Error (Error while selecting File Type scan option!)
            }
        }
    }
    Fail:
    {
        Fail (Fail while selecting File Type scan option!)
    }
    Error:
    {
        Error (Error while selecting File Type scan option!)
    }
}


