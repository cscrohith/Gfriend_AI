/////////////////////////////////////////////////
// Routine:         HandleSaveCredentials
// Description:     handle the save credentials screen
//
// Arguments:       ${SaveYN} - Y to save the credentials
//
// Pre-requisites:
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
HandleSaveCredentials(${SaveYN})
{
    If: Mail_Library.CheckForServerLoss
    {
        // check for the save credentials popup
        If: Android.Wait For Object (com.hp.print.emailplus:id/ll_dialog_main,5)
        {
            If: Android.Check Screen Contains Partial Text (Do you want to save your)
            {
                If: Equals(${SaveYN},Y)
                {
                    Android.Touch Text (SAVE)
                }
                Fail:
                {
                    Android.Touch Text (NO THANKS)
                }
                If: Android.Wait For Object (com.hp.print.emailplus:id/snackbar_action,2)
                {
                    Android.Touch ID (com.hp.print.emailplus:id/snackbar_action)
                }
                Sleep (5)
            }
        }
    }
    Fail:
    {
        Fail (Fail handling the app opening!)
    }
    Error:
    {
        Error (Error while handling the app opening!)
    }
}

/////////////////////////////////////////////////
// Routine:         HandleAppOpening
// Description:     handle the app opening
//
// Arguments:       ${UserID} - UserID/Username
//                  ${UserPW} - Password
//
// Pre-requisites:
//
// Notes:
//
// Version:
/////////////////////////////////////////////////
HandleAppOpening(${UserID},${UserPW})
{
    Sleep (10)
    
    If: Mail_Library.CheckForServerLoss
    {
    }
    Fail:
    {
        Fail (Fail handling the app opening!)
        Stop Test Case
    }
    Error:
    {
        Error (Error while handling the app opening!)
        Stop Test Case
    }
    Sleep (0)
    
    // check for EULA screen
    If: Android.Wait For Text (I have read and agree to the above documents.,0)
    {
        If: Mail_Library.HandleAppEula
        {
        }
        Fail:
        {
            Fail (Fail handling the EULA screen!)
            Stop Test Case
        }
        Error:
        {
            Error (Error while handling the EULA screen!)
            Stop Test Case
        }
    }
    Sleep (0)
    
    // check for popup indicating need to sign in
    If:Android.Wait For Text (DONE,10)
    {
        If: Mail_Library.AppLogin(${UserID},${UserPW})
        {// login complete, wait for the app main page to display
            If: Android.Wait For Object (com.hp.print.emailplus:id/tvTitle,15)
            {// at main screen, done
            }
            Fail:
            {
                If: Android.Wait For Object (com.hp.print.emailplus:id/ll_dialog_main,5)
                {// dialog displayed, done
                }
                Fail:
                {
                    Fail (Fail accessing the app main screen!)
                }
            }
        }
        Fail:
        {
            Fail (Fail while signin in to the Mail app!)
        }
        Error:
        {
            Error (Error while signin in to the Mail app!)
        }
    }
}

/////////////////////////////////////////////////
// Routine:         AppSignout
