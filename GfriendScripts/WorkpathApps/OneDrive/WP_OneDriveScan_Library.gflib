///<File>WP_OneDriveScan_Library.gflib</File>
///<Modified>2021-09-24</Modified>
///<Description>Library of scan routines for use with the HP for OneDrive Personal Workpath App</Description>
///<Precondition></Precondition>
///<Author>Ron Pridmore</Author>

// these variable file references need to be changed to not point to other folders
// when used in the STF GFriend plugin
//Using StandardTimeouts.gfvar
Using ..\..\Common\StandardTimeouts.gfvar

// these library references need to be changed to not point to other folders
// when used in the STF GFriend plugin
//Using Common_LIbrary.gflib
Using ..\..\Common\Common_LIbrary.gflib

Using WP_OneDrive_Library.gflib

Using Android
Using JediOmni

///<Name>OpenScanOptions</Name>
///<Description>Open the scan options screen</Description>
///<Parameters></Parameters>
///<Precondition></Precondition>
///<Notes></Notes>
OpenScanOptions
{
    // open the options screen
    If: Android.Wait For Object (com.hp.print.horizontalconnector.onedriveforpersonal:id/bt_hide_options,${Short_Wait_Time})
    {
        Android.Touch ID (com.hp.print.horizontalconnector.onedriveforpersonal:id/bt_hide_options)
        // wait for the button to show Hide Options text
        Android.Wait For Text (Hide Options,${Short_Wait_Time})
    }
    Fail:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Fail (Fail while opening scan job options!)
    }
    Error:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Error (Error while opening scan job options!)
    }
}

///<Name>CloseScanOptions</Name>
///<Description>Close the scan options screen</Description>
///<Parameters></Parameters>
///<Precondition></Precondition>
///<Notes></Notes>
CloseScanOptions
{
    // close the optinos screen
    If: Android.Touch ID (com.hp.print.horizontalconnector.onedriveforpersonal:id/bt_hide_options)
    {
        // wait for the File Name textbox to display
        Android.Wait For Object (com.hp.print.horizontalconnector.onedriveforpersonal:id/editTextDescription,${Short_Wait_Time})
    }
    Fail:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Fail (Fail while closing scan options!)
    }
    Error:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Error (Error while closing scan options!)
    }
}

///<Name>SelectScanOption</Name>
///<Description>Select the specified option from the scan options screen</Description>
///<Parameters>OptionText : text of option</Parameters>
///<Precondition></Precondition>
///<Notes>Called by multiple routines in this library</Notes>
SelectScanOption(${OptionText})
{
    If: Android.Wait For Object (com.hp.print.horizontalconnector.onedriveforpersonal:id/lv_option_list,${Very_Short_Wait_Time})
    {
        // if the option is not displayed, then swipe down up to 2 pages
        While:!Android.Wait For Text (${OptionText},${Zero_Wait_Time}):2
        {
            Android.Swipe (com.hp.print.horizontalconnector.onedriveforpersonal:id/lv_option_list,v)
        }
        // if still not displayed then swipe up to 4 pages
        While:!Android.Wait For Text (${OptionText},${Zero_Wait_Time}):4
        {
            Android.Swipe (com.hp.print.horizontalconnector.onedriveforpersonal:id/lv_option_list,^)
        }
        If: Android.Touch Text (${OptionText})
        {
        }
        Fail:
        {
            Return With Fail (Fail while selecting ${OptionText} scan option!)
        }
        Error:
        {
            Return With Error (Error while selecting ${OptionText} scan option!)
        }
    }
    Fail:
    {
        Return With Fail (Fail while selecting ${OptionText} scan option!)
    }
    Error:
    {
        Return With Error (Error while selecting ${OptionText} scan option!)
    }
}

///<Name>SetScanOption_FileType</Name>
///<Description>Set the File Type</Description>
///<Parameters>FileType : type text</Parameters>
///<Precondition></Precondition>
///<Notes></Notes>
SetScanOption_FileType(${FileType})
{
    // check for option specified
    If: Common_LIbrary.CheckVariableContainsValue (${FileType})
    {
    }
    Fail:
    {
        Return With Pass (No FileType specified!)
    }
    
    If: WP_OneDriveScan_Library.SelectScanOption (File Type and Resolution)
    {
    }
    Fail:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Fail (Fail while selecting File Type scan option!)
    }
    Error:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Error (Error while selecting File Type scan option!)
    }

    // check for type already selected
    Android.Get Text (com.hp.print.horizontalconnector.onedriveforpersonal:id/btn_file_type,${CurrentFileType})
    If: Equals (${CurrentFileType},${FileType})
    {// type already selected
        Android.Touch ID (com.hp.print.horizontalconnector.onedriveforpersonal:id/bt_done)
        Android.Wait For Object Gone (com.hp.print.horizontalconnector.onedriveforpersonal:id/bt_done,${Short_Wait_Time})
        
        Return With Pass (SetScanOption_FileType complete!)
    }
    
    // type not already selected
    Android.Touch ID (com.hp.print.horizontalconnector.onedriveforpersonal:id/btn_file_type)
    Android.Wait For Object (com.hp.print.horizontalconnector.onedriveforpersonal:id/lv_option_sub_list,${Short_Wait_Time})
    
    // find the type in the list
    While:!Android.Wait For Text (${FileType},${Zero_Wait_Time}):2
    {
        Android.Swipe (com.hp.print.horizontalconnector.onedriveforpersonal:id/lv_option_sub_list,v)
    }
    While:!Android.Wait For Text (${FileType},${Zero_Wait_Time}):4
    {
        Android.Swipe (com.hp.print.horizontalconnector.onedriveforpersonal:id/lv_option_sub_list,^)
    }
    
    // click on the type
    //    If: Android.Touch Text (${FileType})
    If: Android.Touch XPath (//*[@resource-id='com.hp.print.horizontalconnector.onedriveforpersonal:id/tv_title' and @text='${FileType}'])
    {
        Android.Wait For Object Gone (com.hp.print.horizontalconnector.onedriveforpersonal:id/lv_option_sub_list,${Short_Wait_Time})
        Android.Touch ID (com.hp.print.horizontalconnector.onedriveforpersonal:id/bt_done)
        Android.Wait For Object Gone (com.hp.print.horizontalconnector.onedriveforpersonal:id/bt_done,${Short_Wait_Time})
        
        Return With Pass (SetScanOption_FileType complete!)
    }
    Fail:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Fail (Fail while selecting File Type scan option!)
    }
    Error:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Error (Error while selecting File Type scan option!)
    }
}

///<Name>SetScanOption_Resolution</Name>
///<Description>Set the resolution option</Description>
///<Parameters>Resolution : resolution text</Parameters>
///<Precondition></Precondition>
///<Notes></Notes>
SetScanOption_Resolution(${Resolution})
{
    // check for option specified
    If: Common_LIbrary.CheckVariableContainsValue (${Resolution})
    {
    }
    Fail:
    {
        Return With Pass (No Resolution specified)
    }
    
    If: WP_OneDriveScan_Library.SelectScanOption (File Type and Resolution)
    {
    }
    Fail:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Fail (Fail while selecting Resolution scan option!)
    }
    Error:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Error (Error while selecting Resolution scan option!)
    }
    
    // check for type already selected
    Android.Get Text (com.hp.print.horizontalconnector.onedriveforpersonal:id/btn_resolution,${CurrentResolution})
    If: Equals (${CurrentResolution},${Resolution})
    {// type already selected
        Android.Touch ID (com.hp.print.horizontalconnector.onedriveforpersonal:id/bt_done)
        Android.Wait For Object Gone (com.hp.print.horizontalconnector.onedriveforpersonal:id/bt_done,${Short_Wait_Time})
        
        Return With Pass (SetScanOption_Resolution completed!)
    }
    Fail:
    {// type not already selected
        Android.Touch ID (com.hp.print.horizontalconnector.onedriveforpersonal:id/btn_resolution)
        Android.Wait For Object (com.hp.print.horizontalconnector.onedriveforpersonal:id/lv_option_sub_list,${Short_Wait_Time})
        
        // find the type in the list
        While:!Android.Wait For Text (${Resolution},${Zero_Wait_Time}):1
        {
            Android.Swipe (com.hp.print.horizontalconnector.onedriveforpersonal:id/lv_option_sub_list,v)
        }
        While:!Android.Wait For Text (${Resolution},${Zero_Wait_Time}):2
        {
            Android.Swipe (com.hp.print.horizontalconnector.onedriveforpersonal:id/lv_option_sub_list,^)
        }
        
        // click on the type
        //        If: Android.Touch Text (${Resolution})
        If: Android.Touch XPath (//*[@resource-id='com.hp.print.horizontalconnector.onedriveforpersonal:id/tv_title' and @text='${Resolution}'])
        {
            Android.Wait For Object Gone (com.hp.print.horizontalconnector.onedriveforpersonal:id/lv_option_sub_list,${Short_Wait_Time})
            Android.Touch ID (com.hp.print.horizontalconnector.onedriveforpersonal:id/bt_done)
            Android.Wait For Object Gone (com.hp.print.horizontalconnector.onedriveforpersonal:id/bt_done,${Short_Wait_Time})
        
            Return With Pass (SetScanOption_Resolution completed!)
        }
        Fail:
        {
            WP_OneDrive_Library.CheckForErrorMessage
            Return With Fail (Fail while selecting Resolution scan option!)
        }
        Error:
        {
            WP_OneDrive_Library.CheckForErrorMessage
            Return With Error (Error while selecting Resolution scan option!)
        }
    }
}

///<Name>SetScanOption_ColorBlack</Name>
///<Description>Set the Color Black option</Description>
///<Parameters>Color_Black : color/black text</Parameters>
///<Precondition></Precondition>
///<Notes></Notes>
SetScanOption_ColorBlack(${Color_Black})
{
    // check for option specified
    If: Common_LIbrary.CheckVariableContainsValue (${Color_Black})
    {
    }
    Fail:
    {
        Return With Pass (No Color Black specified)
    }
    
    If: WP_OneDriveScan_Library.SelectScanOption (Color/Black)
    {
    }
    Fail:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Fail (Fail while selecting Color/Black scan option!)
    }
    Error:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Error (Error while selecting Color/Black scan option!)
    }

    // click on the option
    //    If: Android.Touch Text (${Color_Black})
    If: Android.Touch XPath (//*[@resource-id='com.hp.print.horizontalconnector.onedriveforpersonal:id/tv_title' and @text='${Color_Black}'])
    {
    }
    Fail:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Fail (Fail while selecting Color/Black scan option!)
    }
    Error:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Error (Error while selecting Color/Black scan option!)
    }
    
    Sleep (${Minimal_Wait_Time})
    If: Android.Check Screen Not Contains Partial Text (The following conditions)
    {
        Android.Wait For Object Gone (com.hp.print.horizontalconnector.onedriveforpersonal:id/sfl_option_main,${Short_Wait_Time})
        Return With Pass (SetScanOption_ColorBlack completed!)
    }
    Fail:
    {// the specified option caused a conflict
        Android.Touch Text (OK)
        Return With Fail (Fail - the specified Color/Black scan option is not allowed!)
    }
}

///<Name>SetScanOption_OriginalSize</Name>
///<Description>Set the original size option</Description>
///<Parameters>OriginalSize : original size text</Parameters>
///<Precondition></Precondition>
///<Notes></Notes>
SetScanOption_OriginalSize(${OriginalSize})
{
    // check for option specified
    If: Common_LIbrary.CheckVariableContainsValue (${OriginalSize})
    {
    }
    Fail:
    {
        Return With Pass (No OriginalSize specified)
    }
    
    If: WP_OneDriveScan_Library.SelectScanOption (Original Size)
    {
    }
    Fail:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Fail (Fail while selecting Original Size scan option!)
    }
    Error:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Error (Error while selecting Original Size scan option!)
    }
    
    While:Android.Check Screen Not Contains Full Text (${OriginalSize}):3
    {
        //Android.Swipe (com.hp.print.horizontalconnector.onedriveforpersonal:id/rp_container,^)
        Android.Swipe (com.hp.print.horizontalconnector.onedriveforpersonal:id/rl_content_pane,^)
    }
    // if still not displayed then scroll up upto 4 pages
    While: Android.Check Screen Not Contains Full Text (${OriginalSize}): 4
    {
        //Android.Swipe (com.hp.print.horizontalconnector.onedriveforpersonal:id/rp_container,v)
        Android.Swipe (com.hp.print.horizontalconnector.onedriveforpersonal:id/rl_content_pane,v)
    }
    
    // click on the type
    //    If: Android.Touch Text (${OriginalSize})
    If: Android.Touch XPath (//*[@resource-id='com.hp.print.horizontalconnector.onedriveforpersonal:id/tv_title' and @text='${OriginalSize}'])
    {
        Android.Wait For Object Gone (com.hp.print.horizontalconnector.onedriveforpersonal:id/sfl_option_main,${Short_Wait_Time})
        
        Return With Pass (SetScanOption_OriginalSize completed!)
    }
    Fail:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Fail (Fail while selecting Original Size scan option!)
    }
    Error:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        Return With Error (Error while selecting Original Size scan option!)
    }
}

