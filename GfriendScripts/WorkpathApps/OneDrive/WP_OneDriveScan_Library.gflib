///<Name>InitiateScanJob</Name>
///<Description>Initiate a scan job</Description>
///<Parameters></Parameters>
///<Precondition></Precondition>
///<Notes></Notes>
InitiateScanJob
{
    // press the Scan button
    If: Android.Touch ID (com.hp.print.horizontalconnector.onedriveforpersonal:id/fab)
    {
        If: Android.Wait For Object (com.hp.print.horizontalconnector.onedriveforpersonal:id/editTextDescription,${Wait_Time})
        {
        }
        Fail:
        {
            Return With Fail (Fail while initiating scan job!)
        }
        Error:
        {
            Return With Error (Error while initiating scan job!)
        }
    }
    Fail:
    {
        Return With Fail (Fail while initiating scan job!)
    }
    Error:
    {
        Return With Error (Error while initiating scan job!)
    }
}

///<Name>SetFileName</Name>
///<Description>Set the file name</Description>
///<Parameters>ScanFilename : name of file(s) to save</Parameters>
///<Precondition>Scan job has been initiated</Precondition>
///<Notes></Notes>
SetFileName(${ScanFilename})
{
    // set the filename if needed
    If: Common_LIbrary.CheckVariableContainsValue (${ScanFilename})
    {
    }
    Fail:
    {
        // filename is not specified so leave as default
        Return With Pass (Set File Name complete - left as default!)
    }
    
    //    Get Time Stamp (${Time})

    // set the filename
    //    If: Android.Input Text (com.hp.print.horizontalconnector.onedriveforpersonal:id/editTextDescription,${ScanFilename}_${Time})
    If: Android.Input Text (com.hp.print.horizontalconnector.onedriveforpersonal:id/editTextDescription,${ScanFilename})
    {
        Android.Hide Keyboard
    }
    Fail:
    {
        Return With Fail (Fail while initiating scan job!)
    }
    Error:
    {
        Return With Error (Error while initiating scan job!)
    }
}

///<Name>ScanAndCompleteJob</Name>
///<Description>Scan page(s) and complete the scan job</Description>
///<Parameters>OptNumPagesionText : number of pages to scan</Parameters>
///<Parameters>JobCompleteTimeout : number of seconds to wait for completion</Parameters>
///<Precondition>Scan job has been initiated</Precondition>
///<Notes></Notes>
ScanAndCompleteJob(${NumPages}, ${JobCompleteTimeout})
{
    // if > 1 page then complete with preview
    If: Equals (${NumPages},${Minimal_Wait_Time})
    {
    }
    Fail:
    {
        // start the scan by pressing the preview frame
        Android.Touch ID (com.hp.print.horizontalconnector.onedriveforpersonal:id/no_preview)

        // wait for the scanning screen to show/disappear
        If: JediOmni.Wait For Text (Scanning...,${Wait_Time})
        {
            JediOmni.Wait For Text Gone (Scanning...,${Long_Wait})
        }
        
        // clear the Add Pages screen if it appears
        If: JediOmni.Wait For Object (hpid-prompt-add-pages,${Wait_Time})
        {
            JediOmni.Touch ID (hpid-button-done)
        }
        
        // wait for the image preview screen
        If: JediOmni.Wait For Object (hpid-oxp-preview-dialog,${Wait_Time})
        {
            // at this point 1 page has been scanned into the preview
            // handle additional pages if necessary
            Repeat:${NumPages}
            {
                If: Equals (${NumPages},${R})
                {// last scan already done, no action
                }
                Fail:
                {// add a page
                    JediOmni.Wait For Object Gone (#hpid-preview-button-add-pages.hp-disabled,${Long_Wait})
                    Sleep (${Minimal_Wait_Time})
                    JediOmni.Touch ID (hpid-preview-button-add-pages)
                    JediOmni.Wait For Object (hpid-button-scan,${Long_Wait})
                    JediOmni.Touch ID (hpid-button-scan)
                }
            }
        
            // all pages added, finish the scan
            JediOmni.Wait For Object Gone (#hpid-button-start.hp-disabled,${Long_Wait})
            Sleep (${Very_Short_Wait_Time})
            JediOmni.Touch ID (hpid-button-start)
            
            Android.Wait For Text (Image processing...,${Wait_Time})
            Android.Wait For Text Gone (Image processing...,${Very_Long_Wait})
        }
        Fail:
        {
            Oxpd.Return Browser Engine
            Return With Fail (Fail while accessing scan job preview!)
        }
        Error:
        {
            Oxpd.Return Browser Engine
            Return With Error (Error while accessing scan job preview!)
        }
    }
    
    Android.Touch ID (com.hp.print.horizontalconnector.onedriveforpersonal:id/bt_send)
    
    // if 1 page then wait for scanning message to disappear
    If: Equals (${NumPages},${Minimal_Wait_Time})
    {
        If: Android.Wait For Text (Scanning...,${Long_Wait})
        {
            Android.Wait For Text Gone (Scanning...,${Long_Wait})
        }
    }
    
    //    If: Android.Wait For Object Gone (com.hp.print.horizontalconnector.onedriveforpersonal:id/ll_dialog_main,${JobCompleteTimeout})
    If: Android.Wait For Object (com.hp.print.horizontalconnector.onedriveforpersonal:id/toolbar,${JobCompleteTimeout})
    {
        WP_OneDrive_Library.CheckForLoadingIcon
    }
    Fail:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        @Android.Touch ID (com.hp.print.horizontalconnector.onedriveforpersonal:id/bt_dialog_left)
        Return With Fail (Fail while completing scan job!)
    }
    Error:
    {
        WP_OneDrive_Library.CheckForErrorMessage
        @Android.Touch ID (com.hp.print.horizontalconnector.onedriveforpersonal:id/bt_dialog_left)
        Return With Error (Error while completing scan job!)
    }
}
