///<File>DeviceAuth.gflib</File>
///<Modified>2021-02-17</Modified>
///<Description>Library of device authentication related routines</Description>
///<Precondition></Precondition>
///<Author>Ron Pridmore</Author>

Using JediOmni
Using Oxpd

///<Name>AdminSignIn</Name>
///<Description>Authenticate with the local admin</Description>
///<Parameters>Admin_PW: admin password</Parameters>
///<Precondition></Precondition>
///<Notes></Notes>
AdminSignIn (${Admin_PW})
{
    // check for need to clear auth
    If: JediOmni.Wait For Text (Sign Out,0)
    {
        DeviceAuth.SignOut
    }
    
    // check for need to enter sign in screen
   
    //If: JediOmni.Wait For Text (Sign In,0)
    If: Wait For Object (hpid-control-signin,0)
    {
        JediOmni.Touch ID (hpid-control-signin)
    }

    If: JediOmni.Wait For Object (hpid-dropdown-agent,3)
    {
        // check for access type Local Device
        JediOmni.Get Text (hpid-dropdown-agent, ${Buffer})
        If: Equals (${Buffer},Local Device)
        {
        }
        Fail:
        {
            // select the Local Device option
            JediOmni.Touch ID (hpid-dropdown-agent)
            JediOmni.Wait For Object (hpid-dropdown-agent-hp_EmbeddedPin_v1,2)
            JediOmni.Touch ID (hpid-dropdown-agent-hp_EmbeddedPin_v1)
        }
        
        // complete the sign in
        JediOmni.Wait For Object (hpid-signin-dropdown-PinDropDown,1)
        JediOmni.Touch ID (hpid-signin-dropdown-PinDropDown)
        JediOmni.Wait For Object (hpid-signin-list-item-AdminItem,1)
        JediOmni.Touch ID (hpid-signin-list-item-AdminItem)
        
        // short delay to allow the appropriate code textbox to display 
        // (there are actually 2 with same id)
        Sleep (1)
        JediOmni.Enter Access Code (${Admin_PW})
        
        // press the keyboard OK button
        If: JediOmni.Wait For Object (hpid-keyboard-key-done,0)
        {
            JediOmni.Touch ID (hpid-keyboard-key-done)
            Sleep (2)
        }
        
        // press the Sign In button if showing
        If: JediOmni.Wait For Object (hpid-button-signin-ok,1)
        {
            JediOmni.Touch ID (hpid-button-signin-ok)
        }
    }
}

///<Name>SignIn_Windows</Name>
///<Description>Sign In on device with Windows auth</Description>
///<Parameters>ID: UserID/Username</Parameters>
///<Parameters>Pw: UPassword</Parameters>
///<Parameters>Domain: Domain</Parameters>
///<Precondition></Precondition>
///<Notes></Notes>
SignIn_Windows (${ID},${Pw},${Domain})
{
    // clear any existing auth
    If: DeviceAuth.ClearAuth
    {
    }
    Fail:
    {
        Return With Fail (Failed clearing any existing authentication!)
    }
    Error:
    {
        Return With Error (Error clearing any existing authentication!)
    }

    // press the Sign In button
    If: JediOmni.Touch ID (hpid-control-signin)
    {
    }
    Fail:
    {
        Return With Fail (Failed clicking the Sign In button!)
    }
    Error:
    {
        Return With Error (Error while clicking the Sign In button!)
    }
    
    // check for Windows as default
    If: JediOmni.Wait For Text (Windows,2)
    {// Windows is default, no additional action
    }
    Fail:
    {
        // Windows is not the default, check the dropdown list
        JediOmni.Wait For Object (hpid-dropdown-agent,3)
        JediOmni.Touch ID (hpid-dropdown-agent)
        JediOmni.Wait For Object (hpid-dropdown-agent-hp_EmbeddedWindows_v1,2)
        
        // select Windows auth
        If: JediOmni.Touch ID (hpid-dropdown-agent-hp_EmbeddedWindows_v1)
        {
        }
        Fail:
        {
            Return With Fail (Failed selecting Windows authentication type!)
        }
        Error:
        {
            Return With Error (Error while selecting Windows authentication type!)
        }
    }
    
    // select domain if specified
    If: Equals (${Domain},)
    {
    }
    Fail:
    {
        // check for the specified domain as default
        JediOmni.Wait For Object (hpid-signin-dropdown-DomainDropDown,3)
        JediOmni.Get Text (hpid-signin-dropdown-DomainDropDown,${SetDomain})
        //        If: JediOmni.Wait For Text (${Domain},0)
        //        If: JediOmni.Check Screen Contains Partial Text (${Domain})
        If: Contains Ignore Case (${SetDomain},${Domain})
        {// specified domain is default, no additional action
        }
        Fail:
        {
            // select the domain
            JediOmni.Touch ID (hpid-signin-dropdown-DomainDropDown)
            JediOmni.Touch Text (${Domain})
        }
    }
    
    // complete the sign in
    JediOmni.Wait For Object (hpid-signin-textbox-UserNameTextBox,3)
    JediOmni.Touch ID (hpid-signin-textbox-UserNameTextBox)
    JediOmni.Input Text (hpid-signin-textbox-UserNameTextBox,${ID})
    JediOmni.Touch ID (hpid-signin-textbox-PasswordTextBox)
    JediOmni.Input Text (hpid-signin-textbox-PasswordTextBox,${Pw})
    
    JediOmni.Wait For Object (hpid-button-signin-ok,2)
    JediOmni.Touch ID (hpid-button-signin-ok)
}

///<Name>HPAC_Agent_Code_Entry</Name>
///<Description>Enter the user code for HPAC Agent auth</Description>
///<Parameters>ID: User Code</Parameters>
///<Precondition></Precondition>
///<Notes>Called from routine SignIn_HPAC in this library</Notes>
HPAC_Agent_Code_Entry(${ID})
{// enter the user code for HPAC auth
    JediOmni.Wait For Object (hpid-signin-textbox-authentication-code,2)
    JediOmni.Touch ID (hpid-signin-textbox-authentication-code)
    JediOmni.Input Text (hpid-signin-textbox-authentication-code,${ID})
    
    JediOmni.Wait For Object (hpid-button-signin-ok,2)
    JediOmni.Touch ID (hpid-button-signin-ok)
}

///<Name>SignIn_HPAC</Name>
///<Description>Sign In on device with HPAC Agent auth</Description>
///<Parameters>ID: UserID</Parameters>
///<Precondition></Precondition>
///<Notes>Handles HPAC sign in with code for PIC, IRM, DRA or agentless IRM</Notes>
SignIn_HPAC (${ID})
{
    // clear any existing auth
    If: DeviceAuth.ClearAuth
    {
    }
    Fail:
    {
        Return With Fail (Failed clearing any existing authentication!)
    }
    Error:
    {
        Return With Error (Error clearing any existing authentication!)
    }

    If: JediOmni.Touch ID (hpid-control-signin)
    {
    }
    Fail:
    {
        Return With Fail (Failed clicking the Sign In button!)
    }
    Error:
    {
        Return With Error (Error while clicking the Sign In button!)
    }
    
    JediOmni.Wait For Object (hpid-dropdown-agent,3)
    JediOmni.Touch ID (hpid-dropdown-agent)
    Sleep (1)
    
    // try HPAC Agentless (IRM Auth) then HPAC-DRA, then HAPC-IFM, then HPAC-PIC authentication
    If: JediOmni.Wait For Text (IRM Auth,0)
    {
        JediOmni.Touch Text (IRM Auth)
        Oxpd.Get Browser Engine
        If: Oxpd.Wait For Text (Code,10)
        {// enter the code and complete in the OXPD screen
            Oxpd.Touch Id (authentication_screen-request-code_userCode)
            Oxpd.Input Text (${ID})
            JediOmni.Touch ID (hpid-keyboard-key-done)
            Oxpd.Touch Id (authentication_screen-request-code_accept)
            Oxpd.Return Browser Engine
        }
        Fail:
        {
            Fail (Failed entering the ID Code for HPAC agentless authentication!)
        }
        Error:
        {
            Fail (Failed entering the ID Code for HPAC agentless authentication!)
        }
    }
    Fail:
    {
        If: JediOmni.Wait For Text (HPAC - DRA,0)
        {// HPAC -DRA
            JediOmni.Touch Text (HPAC - DRA)
            DeviceAuth.HPAC_Agent_Code_Entry(${ID})
        }
        Fail:
        {// HPAC-IRM
            If: JediOmni.Wait For Text (HPAC - IRM,0)
            {
                JediOmni.Touch Text (HPAC - IRM)
                DeviceAuth.HPAC_Agent_Code_Entry(${ID})
            }
            Fail:
            {// HPAC-PIC
                If: JediOmni.Wait For Text (HPAC - PIC,0)
                {
                    JediOmni.Touch Text (HPAC - PIC)
                    DeviceAuth.HPAC_Agent_Code_Entry(${ID})
                }
                Fail:
                {// no HPAC auth found
                    Fail (Failed to find HPAC-DRA, HPAC-IRM or HPAC-PIC authentication type!)
                }
                Error:
                {
                    Error (Error while selecting HPAC authentication type!)
                }
            }
            Error:
            {
                Error (Error while selecting HPAC authentication type!)
            }
        }
        Error:
        {
            Error (Error while selecting HPAC authentication type!)
        }
    }
    Error:
    {
        Error (Error while selecting HPAC authentication type!)
    }
}

///<Name>SignIn_Papercut</Name>
///<Description>Sign In on device with Papercut auth</Description>
///<Parameters>ID: UserID/Username</Parameters>
///<Parameters>Code: User Code</Parameters>
///<Parameters>Pw: Password/Username</Parameters>
///<Precondition></Precondition>
///<Notes>Handles Papercut authentication with codee or user/password for L1 agent or agentless</Notes>
SignIn_Papercut (${ID},${Code},${Pw})
{
    // clear any existing auth
    If: DeviceAuth.ClearAuth
    {
    }
    Fail:
    {
        Return With Fail (Failed clearing any existing authentication!)
    }
    Error:
    {
        Return With Error (Error clearing any existing authentication!)
    }

    If: JediOmni.Touch ID (hpid-control-signin)
    {
    }
    Fail:
    {
        Return With Fail (Failed clicking the Sign In button!)
    }
    Error:
    {
        Return With Error (Error while clicking the Sign In button!)
    }
    
    JediOmni.Wait For Object (hpid-dropdown-agent,3)
    JediOmni.Touch ID (hpid-dropdown-agent)
    Sleep (1)
    
    // try to select the PaperCut agent auth
    If: JediOmni.Touch ID (hpid-dropdown-agent-PaperCut_AuthenticationAgent_v1)
    {// handle the PaperCut agent sign in
        If: JediOmni.Wait For Object (hpid-signin-textbox-UserNameTextBox,1)
        {// username & pasword
            JediOmni.Touch ID (hpid-signin-textbox-UserNameTextBox)
            JediOmni.Input Text (hpid-signin-textbox-UserNameTextBox,${ID})
            JediOmni.Touch ID (hpid-signin-textbox-PasswordTextBox)
            JediOmni.Input Text (hpid-signin-textbox-PasswordTextBox,${Pw})
        }
        If: JediOmni.Wait For Object (hpid-signin-textbox-UserIDTextBox,1)
        {// usercode
            JediOmni.Touch ID (hpid-signin-textbox-UserIDTextBox)
            JediOmni.Input Text (hpid-signin-textbox-UserIDTextBox,${Code})
        }
        
        JediOmni.Wait For Object (hpid-button-signin-ok,2)
        JediOmni.Touch ID (hpid-button-signin-ok)
        
        // handle the PaperCut user account info popup if it shows
        If: JediOmni.Wait For Object (hpid-button-Ok,3)
        {
            JediOmni.Touch ID (hpid-button-Ok)
        }
    }
    Fail:
    {// try to press the PaperCut option
        If: JediOmni.Touch Text (PaperCut)
        {
        }
        Fail:
        {// second try
            If: JediOmni.Touch Text (Papercut)
            {
            }
            Fail:
            {
                Return With Fail (Failed while selecting PaperCut authentication type!)
            }
            Error:
            {
                Return With Error (Error while selecting PaperCut authentication type!)
            }
        }
        Error:
        {
            Return With Error (Error while selecting PaperCut authentication type!)
        }

        // handle the PaperCut OXPd sign in
        //        Sleep (1)
        Oxpd.Get Browser Engine
        // attempt to enter username
        If: Oxpd.Touch Id (username-input)
        {// username & password
            Oxpd.Input Text (${ID})
            JediOmni.Touch ID (hpid-keyboard-key-done)
            Oxpd.Touch Id (password-input)
            Oxpd.Input Text (${Pw})
            JediOmni.Touch ID (hpid-keyboard-key-done)
        }
        Fail:
        {// attempt to enter id
            If: Oxpd.Touch Id (id-input)
            {
                Oxpd.Input Text (${Code})
                JediOmni.Touch ID (hpid-keyboard-key-done)
            }
            Fail:
            {
                Oxpd.Return Browser Engine
                Return With Fail (Failed to enter username/password or ID for PaperCut auth!)
            }
        }
        
        Oxpd.Touch Id (login-submit)
        Oxpd.Return Browser Engine
    }
}

///<Name>SignIn_SafeCom</Name>
///<Description>Sign In on device with SafeCom auth</Description>
///<Parameters>ID: UserID/Username</Parameters>
///<Parameters>Code: User Code</Parameters>
///<Parameters>Pw: Password/Username</Parameters>
///<Parameters>Domain: Domain/Username</Parameters>
///<Precondition></Precondition>
///<Notes>Handles SafeCom authentication with codee or user/password for L1 agent or agentless</Notes>
SignIn_SafeCom (${ID},${Code},${Pw},${Domain})
{
    // clear any existing auth
    If: DeviceAuth.ClearAuth
    {
    }
    Fail:
    {
        Return With Fail (Failed clearing any existing authentication!)
    }
    Error:
    {
        Return With Error (Error clearing any existing authentication!)
    }

    If: JediOmni.Touch ID (hpid-control-signin)
    {
    }
    Fail:
    {
        Return With Fail (Failed clicking the Sign In button!)
    }
    Error:
    {
        Return With Error (Error while clicking the Sign In button!)
    }
    
    JediOmni.Wait For Object (hpid-dropdown-agent,3)
    JediOmni.Touch ID (hpid-dropdown-agent)
    Sleep (1)
    
    // try to select the SafeCom agent auth
    If: JediOmni.Touch ID (hpid-dropdown-agent-SafeCom_AuthAgent_v2)
    {// check for Code auth
        If: JediOmni.Wait For Object (hpid-signin-textbox-99900,1)
        {// usercode
            JediOmni.Touch ID (hpid-signin-textbox-99900)
            JediOmni.Input Text (hpid-signin-textbox-99900,${Code})
        }
        // check for username/password auth
        If: JediOmni.Wait For Object (hpid-signin-textbox-99903,0)
        {// username & pasword
            JediOmni.Touch ID (hpid-signin-textbox-99903)
            JediOmni.Input Text (hpid-signin-textbox-99903,${ID})
            If: JediOmni.Touch ID (hpid-signin-textbox-99919)
            {// enter the domain if it is visible
                JediOmni.Input Text (hpid-signin-textbox-99919,${Domain})
            }
            JediOmni.Touch ID (hpid-signin-textbox-99918)
            JediOmni.Input Text (hpid-signin-textbox-99918,${Pw})
        }
        
        JediOmni.Wait For Object (hpid-button-signin-ok,2)
        JediOmni.Touch ID (hpid-button-signin-ok)
    }
    Fail:
    {// try to press the KOFAX option
        If: JediOmni.Touch Text (KOFAX)
        {// handle the SafeCom OXPd sign in
            //            Sleep (1)
            Oxpd.Get Browser Engine
            // attempt to enter code
            If: Oxpd.Touch Id (aVXNlcklE)
            {// code
                Oxpd.Input Text (${Code})
                JediOmni.Touch ID (hpid-keyboard-key-done)
            }
            Fail:
            {// attempt to enter username/password/domain
                If: Oxpd.Touch Id (aVXNlcm5hbWU)
                {
                    Oxpd.Input Text (${ID})
                    JediOmni.Touch ID (hpid-keyboard-key-done)
                    Oxpd.Touch Id (aUGFzc3dvcmQ)
                    Oxpd.Input Text (${Pw})
                    JediOmni.Touch ID (hpid-keyboard-key-done)
                    
                    If: Oxpd.Check Screen Not Contains Text (${Domain})
                    {
                        If: Oxpd.Touch Id (aRG9tYWlu)
                        {
                            // this needs to be done in a better way
                            // when there is the capability to clear
                            // the text of an element in the Oxpd library
//                            // clear the existing domain
//                            Repeat:30
//                            {
//                                JediOmni.Touch ID (hpid-keyboard-key-right)
//                                Oxpd.Press BackSpace Key
//                            }
                            Oxpd.Input Text (${Domain})
                            JediOmni.Touch ID (hpid-keyboard-key-done)
                        }
                    }
                }
                Fail:
                {
                    Return With Fail (Failed identifying SafeCom/Kofax UC auth type!)
                }
                Error:
                {
                    Return With Error (Error identifying SafeCom/Kofax UC auth type!)
                }
            }
            
            //Oxpd.Touch Id (btnLogin_wrapper)
            Oxpd.Touch Id (btnLogin)
            Oxpd.Return Browser Engine
        }
        Fail:
        {
            Fail (Failed selecting SafeCom auth type!)
        }
        Error:
        {
            Error (Error seleting SafeCom auth type!)
        }
    }
    Error:
    {
        Error (Error while selecting SafeCom authentication type!)
    }
}

