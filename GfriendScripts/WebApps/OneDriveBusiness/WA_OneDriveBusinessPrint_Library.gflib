    Error:
    {
        JediOmni.Capture Screen Shot (SetPrintOption_PaperSelection_Collate_Error.png)
        Oxpd.Return Browser Engine
        Return With Error (Error while selecting Collate print option!)
    }
}

/// <Name>Perform_PrintJob</Name>
/// <Description>Print the currently selected document</Description>
/// <Parameters>PrintJobCompleteTimeout : timeout (seconds) for job to complete successfully</Parameters>
/// <Precondition>File selected in print screen</Precondition>
/// <Notes></Notes>
Perform_PrintJob(${PrintJobCompleteTimeout})
{
    If: Oxpd.Get Browser Engine
    {
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (Perform_PrintJob_Fail.png)
        Return With Fail (Fail while performing print job!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (Perform_PrintJob_Error.png)
        Return With Error (Error while performing print job!)
    }

    // ensure in print options screen
    If: Oxpd.Wait For Css (#PrintOptions.role,${Long_Wait})
    {
        Oxpd.Touch ID (StartPrint)
        
        // wait for the print popup to display
        Oxpd.Wait For XPath (//div[@id="print"][@style="display: block;"],${Long_Wait})
  
        // wait for the print popup to disappear
        // to verify that the job is complete or successful
        //        If: Oxpd.Wait For Xpath (//*[@id="storage-description" or contains\(text\(\)\,"Job is complete"\)],${PrintJobCompleteTimeout})
        
        If: Oxpd.Wait For Xpath (//*[@id="print"]/descendant::*[contains\(translate\(text\(\)\, "ABCDEFGHIJKLMNOPQRSTUVWXYZ"\, "abcdefghijklmnopqrstuvwxyz"\)\, "complete"\) or contains\(translate\(text\(\)\, "ABCDEFGHIJKLMNOPQRSTUVWXYZ"\, "abcdefghijklmnopqrstuvwxyz"\)\, "success"\)], ${PrintJobCompleteTimeout})
        {
            //        If: Oxpd.Wait For Xpath (//*[contains\(text\(\)\,"Job is complete"\)],${Minimal_Wait_Time})
            
            If: Oxpd.Wait For Xpath (//*[@id="print"]/descendant::*[contains\(translate\(text\(\)\, "ABCDEFGHIJKLMNOPQRSTUVWXYZ"\, "abcdefghijklmnopqrstuvwxyz"\)\, "complete"\) or contains\(translate\(text\(\)\, "ABCDEFGHIJKLMNOPQRSTUVWXYZ"\, "abcdefghijklmnopqrstuvwxyz"\)\, "success"\)], ${Minimal_Wait_Time})
            {
                Oxpd.Touch Id (scan-cancel-button)
            }
            Sleep (${Short_Wait_Time})
            Oxpd.Return Browser Engine
            Return With Pass (Set Print Option Perform Print Job complete!)
        }
        Fail:
        {
            JediOmni.Capture Screen Shot (Perform_PrintJob_Fail.png)
            //job did not complete, attempt to close the print popup then return fail
            @Oxpd.Touch ID (Print-cancel-button)
            Oxpd.Return Browser Engine
            Return With Fail (Fail print document within the speicfied timeout)
        }
        Error:
        {
            JediOmni.Capture Screen Shot (Perform_PrintJob_Error.png)
            //job did not complete, attempt to close the print popup then return fail
            @Oxpd.Touch ID (Print-cancel-button)
            Oxpd.Return Browser Engine
            Return With Error (Error print document within the speicfied timeout)
        }
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (Perform_PrintJob_Fail.png)
        Oxpd.Return Browser Engine
        Return With Fail (Fail - print screen not displayed!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (Perform_PrintJob_Error.png)
        Oxpd.Return Browser Engine
        Return With Error (Error  - print screen not displayed!)
    }
}
