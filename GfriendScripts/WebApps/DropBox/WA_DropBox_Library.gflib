/// <File>WA_Dropbox_Library</File>
/// <Modified>2021-09-13</Modified>
/// <Description>Library of common routines for use with the 
///   HP for Dropbox Web App</Description>
/// <Precondition></Precondition>
/// <Author>Ron Pridmore</Author>

// these variable file references need to be changed to not point to other folders
// when used in the STF GFriend plugin
//Using StandardTimeouts.gfvar
Using ..\..\Common\StandardTimeouts.gfvar

Using JediOmni
Using Oxpd

/// <Name>CheckForLoadingIcon</Name>
/// <Description>Check for the loading icon to appear then disappear</Description>
/// <Parameters></Parameters>
/// <Precondition>Oxpd.Get Browser a has been executed</Precondition>
/// <Notes>This is called by multiple routines in this and other Dropbox libraries</Notes>
CheckForLoadingIcon
{
    If: Oxpd.Wait For XPath (//*[\(@id="loadingIcon" or @id="loading"\) and not\(@hidden\)],${Short_Wait_Time})
    {
        Oxpd.Wait For XPath Gone (//*[\(@id="loadingIcon" or @id="loading"\) and not\(@hidden\)],${Long_Wait})
    }
}

/// <Name>CheckForServerLoss</Name>
/// <Description>Check for loss of server connection message</Description>
/// <Parameters></Parameters>
/// <Precondition>Oxpd.Get Browser a has been executed</Precondition>
/// <Notes>This is called by multiple routines in this and other Dropbox libraries
///    For error handler:
///      "serverAccessLost": "Server access has been lost. Please try again",
///      "unableToRetrieveData": "Unable to retrieve data from the cloud services",
///      "unableToPreviewData": "Unable to preview data from the cloud services",
///      "downloadFailed": "Failed to download",
///      "WPPFailed": "App could not load, WPP Authorization failed.",
///      "HPCCFailed": "App could not load, HPCC Authorization failed.",
///      "ValidatePrinterMessageFailed": "App could not load, Validate Printer Message failed.",
///      "PrinterEntityDiscoveryFailed": "App could not load, Printer Entity Discovery failed.",
///      "PrinterUUIDFailed": "App could not load, not able to get printer uuid"</Notes>
CheckForServerLoss
{ 
    If: Oxpd.Wait For Css (#genericModel[style*="block"],${Minimal_Wait_Time})
    {
        Set Variable (${Error_Text}, )
        @Oxpd.Get Text (Text,${Error_Text})
        // clear the popup message
        @Oxpd.Touch Id (done-button)
        //@Oxpd.Touch Text (OK)
        //@Oxpd.Touch Text (DONE)
        //@Oxpd.Touch Text (Done)
        If: Contains Ignore Case (${Error_Text},Server access has been lost)
        {
            Return With Fail (Fail - Server access lost while in app!)
        }
        If: Contains Ignore Case (${Error_Text},Unable to retrieve data)
        {
            Return With Fail (Fail - Unable to retrieve data from cloud services while in app!)
        }
        If: Contains Ignore Case (${Error_Text},Unable to preview data)
        {
            Return With Fail (Fail - Unable to preview data from cloud services while in app!)
        }
        If: Contains Ignore Case (${Error_Text},App could not load)
        {
            Return With Fail (Fail - App could not load!)
        }
    }
    Fail:
    {
        Return With Pass (Check for Server Loss complete!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (CheckForServerLoss_Error.png)
        Return With Error (Error checking for Server access lost!)
    }
}

/// <Name>HandleAppEula</Name>
/// <Description>Handle the EULA screen</Description>
/// <Parameters></Parameters>
/// <Precondition>Oxpd.Get Browser a has been executed</Precondition>
/// <Notes></Notes>
HandleAppEula
{
    // the Eula page is displayed, handle it
    Oxpd.Touch Css (label.checkbox)
    // press the Continue button.
    Oxpd.Touch Id (continue-button)
    
    // wait for the privacy page
    If: Oxpd.Wait For Css (#IHaveReadPrivacyPolicy,${Very_Short_Wait_Time})
    {
        // the privacy policy page is displayed, handle it
        Oxpd.Touch Css (label.checkbox)
        // press the Continue button.
        Oxpd.Touch Id (continue-button)
        
        Return With Pass (Handle App Eula complete!)
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (HandleAppEula_Fail.png)
        Return With Fail (Fail waiting for the Privacy Policy screen to display in Dropbox app!)
    }
}

/// <Name>EnterLoginUserID</Name>
/// <Description>Enter the userID</Description>
/// <Parameters>Login_UserID : UserID</Parameters>
/// <Precondition>Oxpd.Get Browser a has been executed</Precondition>
/// <Notes></Notes>
EnterLoginUserID(${Login_UserID})
{
    // check for the email entry
    //    If: Oxpd.Wait For Css (#Email,${Minimal_Wait_Time})
    If: Oxpd.Wait For Text Contains (Email or phone,${Long_Wait})
    {
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserID_Fail.png)
        Return With Fail (Fail entering UserID in to Dropbox app!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserID_Error.png)
        Return With Error (Error entering UserID in to Dropbox app!)
    }
    
    // enter the user's email
    If: Oxpd.Touch ID (Email)
    {
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserID_Fail.png)
        Return With Fail (Fail entering UserID in to Dropbox app!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserID_Error.png)
        Return With Error (Error entering UserID in to Dropbox app!)
    }
    
    If: JediOmni.Wait For Object (hpid-keyboard-key-done,${Short_Wait_Time})
    {
    }
    Fail:
    {
        // force the keyboard to display
        Oxpd.Press Enter Key
        JediOmni.Wait For Object (hpid-keyboard-key-done,${Short_Wait_Time})
    }
    
    If: Oxpd.Input Text (${Login_UserID})
    {
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserID_Fail.png)
        Return With Fail (Fail entering UserID in to Dropbox app!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserID_Error.png)
        Return With Error (Error entering UserID in to Dropbox app!)
    }
    
    // close the keyboard
    JediOmni.Touch ID (hpid-keyboard-key-done)
    Sleep (${Minimal_Wait_Time})
    
    // press the Next button and wait for it to disappear
    If: Oxpd.Touch ID (next)
    {
        If: Oxpd.Wait For Id Gone (next,${Long_Wait})
        {
            Return With Pass (Enter Login UserID complete!)
        }
        Fail:
        {
            // UserID failed
            JediOmni.Capture Screen Shot (EnterLoginUserID_Fail.png)
            Return With Fail (Fail entering UserID in to Dropbox app!)
        }
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserID_Fail.png)
        Return With Fail (Fail entering UserID in to Dropbox app!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserID_Error.png)
        Return With Error (Error entering UserID in to Dropbox app!)
    }
}

/// <Name>EnterLoginUserPW</Name>
/// <Description>Enter the user's password</Description>
/// <Parameters>Login_PW : Password</Parameters>
/// <Precondition>Oxpd.Get Browser a has been executed</Precondition>
/// <Notes></Notes>
EnterLoginUserPW(${Login_PW})
{
