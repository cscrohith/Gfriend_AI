/// <Name>AppLogin</Name>
/// <Description>Log In to the app</Description>
/// <Parameters>ID : UserID</Parameters>
/// <Parameters>Pw : Password</Parameters>
/// <Precondition>Oxpd.Get Browser a has been executed</Precondition>
/// <Notes></Notes>
AppLogin(${ID},${Pw})
{
    // delay to allow the sign in page to display
    //    If: Oxpd.Wait For Id (login-content,${Long_Wait})
    //    If: Oxpd.Wait For Css (.auth-google.button-primary,${Long_Wait})
    //If: Oxpd.Wait For Css (#page-header,${Long_Wait})
    //    If: Oxpd.Wait For Text Contains (Sign in to Dropbox,${Long_Wait})
    If: Oxpd.Wait For Css (#home-icon,${Long_Wait})
    {
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserPW_Fail.png)
        Return With Fail (Fail accessing the sign in page in Dropbox app!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserPW_Error.png)
        Return With Error (Error accessing the sign page in Dropbox app!)
    }

    Sleep (${Short_Wait_Time})
    
    // check for the cookies consent iframe
    If: Oxpd.Wait For Css (#consent-iframe,${Minimal_Wait_Time})
    {
        // because we cannot access the elements inside the iframe
        // we need to touch the possition of the Accept All button
        Oxpd.Touch Position (75,80)
        
        If: JediOmni.Wait For Object (hpid-oxpd-spinner,${Short_Wait_Time})
        {
            JediOmni.Wait For Object Gone (hpid-oxpd-spinner,${Long_Wait})
        }
    }
    
    // go to the sign in with Google option
    Oxpd.Wait For Css (#home-icon,${Short_Wait_Time})
    Sleep (${Short_Wait_Time})
    
    
    // scroll to show the Sign in with Google button
    While:!Oxpd.Wait For Css (button.auth-google.button-primary,${Minimal_Wait_Time}):6
    {
        Set Variable (${Scroll_Down},Y)
        If: Oxpd.Wait For Css (button.signin-button,1)
        {
            JediOmni.Drag (90,30,90,60)
            Set Variable (${Scroll_Down},N)
        }
        If: Oxpd.Wait For Css (input[name="login_password"],1)
        {
            JediOmni.Drag (90,30,90,60)
            Set Variable (${Scroll_Down},N)
        }
        If: Oxpd.Wait For Css (input[name="login_email"],1)
        {
            JediOmni.Drag (90,30,90,60)
            Set Variable (${Scroll_Down},N)
        }
        If: Equals (${Scroll_Down},Y)
        {
            JediOmni.Drag (90,60,90,30)
        }
        Sleep (${Very_Short_Wait_Time})
    }
    
    // touch the Sign in with Google button and wait for the 
    // Google sign in screen to show
    If: Oxpd.Touch Css (button.auth-google.button-primary)
    {
    }
    Fail:
    {
        Return With Fail (Fail pressing the Sign in with Google button!)
    }
    Error:
    {
        Return With Error (Error pressing the Sign in with Google button!)
    }
    
    If: JediOmni.Wait For Text (Sign in - Google Accounts,${Very_Long_Wait})
    {
    }
    Fail:
    {
        Return With Fail (Fail accessing the Sign in with Google screen!)
    }
    Error:
    {
        Return With Error (Error accessing the Sign in with Google screen!)
    }
    
    // enter user ID
    If: WA_Dropbox_Library.EnterLoginUserID(${ID})
    {
    }
    Fail:
    {
        Return With Fail (Fail entering userID signing in to Dropbox app!)
    }
    Error:
    {
        Return With Error (Error entering userID signing in to Dropbox app!)
    }
    
    // enter password
    If: WA_Dropbox_Library.EnterLoginUserPW(${Pw})
    {
        Return With Pass (App Login complete!)
    }
    Fail:
    {
        Return With Fail (Fail entering userID signing in to Dropbox app!)
    }
    Error:
    {
        Return With Error (Error entering userID signing in to Dropbox app!)
    }
}

/// <Name>ClearGuide</Name>
/// <Description>Clear the app guide screen</Description>
/// <Parameters></Parameters>
/// <Precondition>Oxpd.Get Browser a has been executed</Precondition>
/// <Notes></Notes>
ClearGuide
{
    // clear the guide screen if shown
    If: Oxpd.Wait For Xpath (//*[@id="guide" and not\(@hidden\)],${Minimal_Wait_Time})
    {
        // set the checkbox to not show again and close
        Oxpd.Touch Css (.checkbox)
        Oxpd.Touch ID (close-guide)
        Oxpd.Wait For Xpath (//*[@id="guide" and @hidden="hidden"],${Short_Wait_Time})
        
        Return With Pass (Clear Guide complete!)
    }
}

/// <Name>HandleSaveCredentials</Name>
/// <Description>Handle the save credentials screen</Description>
/// <Parameters>SaveYN : Y to save the credentials</Parameters>
/// <Precondition>Oxpd.Get Browser a has been executed</Precondition>
/// <Notes></Notes>
HandleSaveCredentials(${SaveYN})
{
    // check the option to not show again
    OXPd.Touch ID (rememberCheckBox)
    If: Equals(${SaveYN},Y)
    {
        Oxpd.Touch Xpath (//*[@id="RememberMe"]//descendant::button[text\(\)="Save"])
    }
    Fail:
    {
        Oxpd.Touch Xpath (//*[@id="RememberMe"]//descendant::button[text\(\)="No thanks"])
    }
    
    Return With Pass (HandleSaveCredentials complete!)
}

/// <Name>HandleAppOpening</Name>
/// <Description>Handle the app opening</Description>
/// <Parameters>UserID : UserID/Username</Parameters>
/// <Parameters>UserPW : Password</Parameters>
/// <Parameters>SaveAccountYN : Y to save the credentials</Parameters>
/// <Parameters>VerifySIOConnect : Y to check for successful SIO connection
///        if the Terms/Privacy, or EULA page shows SIO connecion
///        is not successful and routing returns with Fail
///    N - ignore checking SIO connection</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
HandleAppOpening(${UserID},${UserPW},${SaveAccountYN},${VerifySIOConnect})
{
    If: Oxpd.Get Browser Engine
    {
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (HandleAppOpening_Fail.png)
        Return With Fail (Fail while handling the Dropbox app opening!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (HandleAppOpening_Error.png)
        Return With Error (Error while handling the Dropbox app opening!)
    }
    
    If: Oxpd.Wait For Css (.loading-page,${Short_Wait_Time})
    {
        Oxpd.Wait For Css (#genericModel[style*="block"]\, #header.storage-DropBox,${Long_Wait})
    }

    If: Oxpd.Wait For Xpath (//*[@id="TermsOfUseAndPrivacyPolicy" and "${VerifySIOConnect}"="Y"],${Minimal_Wait_Time})
    {
        JediOmni.Capture Screen Shot (HandleAppOpening_Fail.png)
        Oxpd.Return Browser Engine
        Return With Fail (SIO connection Failed!)
    }
    
    // check for EULA screen
    If: Oxpd.Wait For Css (#TermsOfUseAndPrivacyPolicy,${Minimal_Wait_Time})
    {
        If: WA_Dropbox_Library.HandleAppEula
        {
        }
        Fail:
        {
            WA_Dropbox_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Fail (Fail while handling the EULA and Privacy Policy pages!)
        }
        Error:
        {
            WA_Dropbox_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Error (Error while handling the EULA and Privacy Policy pages!)
        }
    }
    
    // check for popup stating leaving HP environment
    If: Oxpd.Wait For Css (#genericModel[style*="block"],${Minimal_Wait_Time})
    {
        // press Done on the popup
        Oxpd.Touch Id (done-button)
        Oxpd.Wait For Css Gone (#genericModel[style*="block"],${Wait_Time})
        
        // attempt to sign in
        If: WA_Dropbox_Library.AppLogin(${UserID},${UserPW})
        {
        }
        Fail:
        {
            WA_Dropbox_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Fail (Fail while signin in to the Dropbox app!)
        }
        Error:
        {
            WA_Dropbox_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Error (Error while signin in to the Dropbox app!)
        }
    }
    
    // login complete, wait for the app main page to display
    // check for app main screen
    If: Oxpd.Wait For Css (#header.storage-DropBox,${Long_Wait})
    {
        WA_Dropbox_Library.CheckForLoadingIcon
        
        If: Oxpd.Wait For Css (#RememberMe[style~="block;"],${Minimal_Wait_Time})
        {
            // handle the option to save app credentials
            If: WA_Dropbox_Library.HandleSaveCredentials(${SaveAccountYN})
            {
            }
            Fail:
            {
                WA_Dropbox_Library.CheckForServerLoss
                Oxpd.Return Browser Engine
                Return With Fail (Fail while saving app credentials Dropbox app!)
            }
            Error:
            {
                WA_Dropbox_Library.CheckForServerLoss
                Oxpd.Return Browser Engine
                Return With Error (Error while saving app credentials Dropbox app!)
            }
        }
        
        // clear the guide if shown
        If: WA_Dropbox_Library.ClearGuide
        {
            Oxpd.Return Browser Engine
            Return With Pass (Handle App Opening complete!)
        }
        Fail:
        {
            WA_Dropbox_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Fail (Fail accessing the Dropbox app main screen!)
        }
        Error:
        {
            WA_Dropbox_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Error (Error accessing the Dropbox app main screen!)
        }
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (HandleAppOpening_Fail.png)
        WA_Dropbox_Library.CheckForServerLoss
        Oxpd.Return Browser Engine
        Return With Fail (Fail accessing the Dropbox app main screen!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (HandleAppOpening_Error.png)
        WA_Dropbox_Library.CheckForServerLoss
        Oxpd.Return Browser Engine
        Return With Error (Error accessing the Dropbox app main screen!)
    }
}

/// <Name>AppExit</Name>
/// <Description>exit out of the app</Description>
/// <Parameters>BackOut_YN : Y to backout, else sign out</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
AppExit (${BackOut_YN})
{
    If: Oxpd.Get Browser Engine
    {
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (AppExit_Fail.png)
        Return With Fail (Fail while exiting Dropbox app!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (AppExit_Error.png)
        Return With Error (Error while exiting Dropbox app!)
    }
    
    // check for server connection loss
    If: WA_Dropbox_Library.CheckForServerLoss
    {
    }
    Fail:
    {
        Oxpd.Return Browser Engine
        Return With Fail (Fail while exiting Dropbox app!)
    }
    Error:
    {
        Oxpd.Return Browser Engine
        Return With Error (Error while exiting Dropbox app!)
    }
    
    // ensure at the main folder
    // since the ReturnToMainFolder routine
    // gets/returns the browser, must release
    // it here and get it again after
    Oxpd.Return Browser Engine
    WA_Dropbox_Library.ReturnToMainFolder
    Oxpd.Get Browser Engine
    
    // initiate backout or signout as specified
    If: Equals IgnoreCase (${BackOut_YN},Y)
    {
        // backout
        If: Oxpd.Touch Css (.back)
        {
        }
        Fail:
        {
            JediOmni.Capture Screen Shot (AppExit_Fail.png)
            Oxpd.Return Browser Engine
            Return With Fail (Fail while backing out of Dropbox app!)
        }
        Error:
        {
            JediOmni.Capture Screen Shot (AppExit_Error.png)
            Oxpd.Return Browser Engine
            Return With Error (Error while backing out of Dropbox app!)
        }
    }
    Fail:
    {
        // signout
        If:  Oxpd.Touch ID(toggleDropdown)
        {
            Sleep (${Minimal_Wait_Time})
            Oxpd.Touch ID(SignOut)
        }
        Fail:
        {
            JediOmni.Capture Screen Shot (AppExit_Fail.png)
            Oxpd.Return Browser Engine
            Return With Fail (Fail while signing out of Dropbox app!)
        }
        Error:
        {
            JediOmni.Capture Screen Shot (AppExit_Error.png)
            Oxpd.Return Browser Engine
            Return With Error (Error while signing out of Dropbox app!)
        }
    }
    
    If: Oxpd.Wait For Css (#listViewExit[style*="block"],${Short_Wait_Time})
    {
        Oxpd.Touch Id (Exit)
    }
    If: Oxpd.Wait For Css (#listViewExitWithoutSignout[style*="block"],${Minimal_Wait_Time})
    {
        Oxpd.Touch Id (Exit1)
    }
    
    Oxpd.Return Browser Engine
    
    JediOmni.Wait For Object (hpid-homescreen-logo-icon,${Wait_Time})
    JediOmni.Press Home Key
    Sleep (${Very_Short_Wait_Time})
    Return With Pass (App Exit complete!)
}

/// <Name>ReturnToMainFolder</Name>
/// <Description>Return to the app main screen</Description>
/// <Parameters></Parameters>
/// <Precondition>Oxpd.Get Browser a has been executed</Precondition>
/// <Notes></Notes>
ReturnToMainFolder
{
    If: Oxpd.Get Browser Engine
    {
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (ReturnToMainFolder_Fail.png)
        Return With Fail (Fail while returning to the main folder!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (ReturnToMainFolder_Error.png)
        Return With Error (Error while returning to the main folder!)
    }
    
    WA_Dropbox_Library.CheckForServerLoss
    
    // job has completed
    While:!Oxpd.Wait For XPath (//*[@id="StorageLogo" and not\(@hidden\)],${Minimal_Wait_Time}):10
    {
        Oxpd.Touch Css (.back)
        
        WA_Dropbox_Library.CheckForLoadingIcon
    }
    
    Oxpd.Return Browser Engine
    
    Return With Pass (Return to Main Folder complete!)
}

/// <Name>EnterSearch</Name>
/// <Description>Enter the search text</Description>
/// <Parameters>SearchText : text to search</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
EnterSearch(${SearchText})
{
    If: Oxpd.Get Browser Engine
    {
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (EnterSearch_Fail.png)
        Return With Fail (Fail while entering search text!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (EnterSearch_Error.png)
        Return With Error (Error while entering search text!)
    }

    If: OXPd.Touch ID (searchInput)
    {
        // delay to allow the keyboard to be visible and available
        Sleep (${Very_Short_Wait_Time})
        
        OXPd.Input Text (${SearchText})
        
        JediOmni.Touch ID (hpid-keyboard-key-done)
        WA_Dropbox_Library.CheckForLoadingIcon

        Oxpd.Return Browser Engine
        Return With Pass (Search entry complete!)
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (EnterSearch_Fail.png)
        WA_Dropbox_Library.CheckForServerLoss
        Oxpd.Return Browser Engine
        Return With Fail (Fail while entering search text!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (EnterSearch_Error.png)
        WA_Dropbox_Library.CheckForServerLoss
        Oxpd.Return Browser Engine
        Return With Error (Error while entering search text!)
    }
}

/// <Name>SearchFolder</Name>
/// <Description>Search for a folder and select it</Description>
/// <Parameters>FolderName : folder name</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
SearchFolder(${FolderName})
{
    If: WA_Dropbox_Library.EnterSearch(${FolderName})
    {
        If: Oxpd.Get Browser Engine
        {
        }
        Fail:
        {
            JediOmni.Capture Screen Shot (SearchFolder_Fail.png)
            Return With Fail (Fail while searching for folder!)
        }
        Error:
        {
            JediOmni.Capture Screen Shot (SearchFolder_Error.png)
            Return With Error (Error while searching for folder!)
        }
        
        // check for app/connection issue messages
        If: WA_Dropbox_Library.CheckForServerLoss
        {
        }
        Fail:
        {
            Oxpd.Return Browser Engine
            Return With Fail (Fail while searching for folder!)
        }
        Error:
        {
            Oxpd.Return Browser Engine
            Return With Error (Error while searching for folder!)
        }

        If: Oxpd.Wait For Xpath (//*[@id="file-listing"]/ul/li/div,${Long_Wait})
        {
            Sleep (${Very_Short_Wait_Time})
            Oxpd.Touch Xpath (//*[@id="file-listing"]/ul/li/div)
            WA_Dropbox_Library.CheckForLoadingIcon

            // verify that the specified folder was entered
            // this does not work as of 11/23
//            //            Oxpd.Get Text (listViewHeaderContent,${EnteredFolderName})
//            Oxpd.Get Text (storage-description,${EnteredFolderName})
//            Replace (${EnteredFolderName},",)
//            Trim (${EnteredFolderName})
//            
//            If: Equals IgnoreCase (${EnteredFolderName},${FolderName})
//            {// success
                Oxpd.Return Browser Engine
                Return With Pass (Search Folder complete!)
//            }
//            Fail:
//            {
//                WA_Dropbox_Library.CheckForServerLoss
//                JediOmni.Capture Screen Shot (SearchFolder_Fail.png)
//                Oxpd.Return Browser Engine
//                Return With Fail (Fail while searching for folder!)
//            }
//            Error:
//            {
//                WA_Dropbox_Library.CheckForServerLoss
//                JediOmni.Capture Screen Shot (SearchFolder_Error.png)
//                Oxpd.Return Browser Engine
//                Return With Error (Error while searching for folder!)
//            }
        }
        Fail:
        {
            JediOmni.Capture Screen Shot (SearchFolder_Fail.png)
            WA_Dropbox_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Fail (Fail while searching for folder '${FolderName}'!)
        }
        Error:
        {
            JediOmni.Capture Screen Shot (SearchFolder_Error.png)
            WA_Dropbox_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Error (Error while searching for folder '${FolderName}'!)
        }
    }
    Fail:
    {
        WA_Dropbox_Library.CheckForServerLoss
        Oxpd.Return Browser Engine
        Return With Fail (Fail while searching for folder '${FolderName}'!)
    }
    Error:
    {
        WA_Dropbox_Library.CheckForServerLoss
        Oxpd.Return Browser Engine
        Return With Error (Error while searching for folder '${FolderName}'!)
    }
}

/// <Name>SearchFolder</Name>
/// <Description>Search for a folder and select it</Description>
/// <Parameters>FileName : file name</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
SearchFile(${FileName})
{
    If: WA_Dropbox_Library.EnterSearch(${FileName})
    {
        If: Oxpd.Get Browser Engine
        {
        }
        Fail:
        {
            JediOmni.Capture Screen Shot (SearchFile_Fail.png)
            Return With Fail (Fail while searching for file!)
        }
        Error:
        {
            JediOmni.Capture Screen Shot (SearchFile_Error.png)
            Return With Error (Error while searching for file!)
        }
        
        // check for app/connection issue messages
        If: WA_Dropbox_Library.CheckForServerLoss
        {
        }
        Fail:
        {
            Oxpd.Return Browser Engine
            Return With Fail (Fail while searching for a file!)
        }
        Error:
        {
            Oxpd.Return Browser Engine
            Return With Error (Error while searching for a file!)
        }

        If: Oxpd.Wait For Xpath (//*[@id="file-listing"]/ul/li/div,${Long_Wait})
        {
            Sleep (${Very_Short_Wait_Time})
            Oxpd.Touch Xpath (//*[@id="file-listing"]/ul/li/div)
            
            If: Oxpd.Wait For Css (#PrintOptions,${Long_Wait})
            {// success
                Oxpd.Return Browser Engine
                Return With Pass (Search File complete!)
            }
            Fail:
            {
                JediOmni.Capture Screen Shot (SearchFile_Fail.png)
                WA_Dropbox_Library.CheckForServerLoss
                Oxpd.Return Browser Engine
                Return With Fail (Fail while searching for a file '${FileName}'!)
            }
            Error:
            {
                JediOmni.Capture Screen Shot (SearchFile_Error.png)
                WA_Dropbox_Library.CheckForServerLoss
                Oxpd.Return Browser Engine
                Return With Error (Error while searching for a file '${FileName}'!)
            }
        }
        Fail:
        {
            JediOmni.Capture Screen Shot (SearchFile_Fail.png)
            WA_Dropbox_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Fail (Fail while searching for a file '${FileName}'!)
        }
        Error:
        {
            JediOmni.Capture Screen Shot (SearchFile_Error.png)
            WA_Dropbox_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Error (Error while searching for a file '${FileName}'!)
        }
    }
    Fail:
    {
        WA_Dropbox_Library.CheckForServerLoss
        Oxpd.Return Browser Engine
        Return With Fail (Fail while searching for a file '${FileName}'!)
    }
    Error:
    {
        WA_Dropbox_Library.CheckForServerLoss
        Oxpd.Return Browser Engine
        Return With Error (Error while searching for a file '${FileName}'!)
    }
}