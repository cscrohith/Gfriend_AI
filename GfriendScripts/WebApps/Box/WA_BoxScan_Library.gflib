/// <File>WA_BoxScan_Library</File>
/// <Modified>2021-09-27</Modified>
/// <Description>Library of print routines for use with the HP for Box Web App</Description>
/// <Precondition></Precondition>
/// <Author>Ron Pridmore</Author>

// these variable file references need to be changed to not point to other folders
// when used in the STF GFriend plugin
//Using StandardTimeouts.gfvar
Using ..\..\Common\StandardTimeouts.gfvar

// these library references need to be changed to not point to other folders
// when used in the STF GFriend plugin
//Using Common_LIbrary.gflib
Using ..\..\Common\Common_LIbrary.gflib

Using Oxpd
Using JediOmni

/// <Name>OpenScanOptions</Name>
/// <Description>Open the scan options screen</Description>
/// <Parameters></Parameters>
/// <Precondition>Already in the scan screen</Precondition>
/// <Notes></Notes>
OpenScanOptions
{
    If: Oxpd.Get Browser Engine
    {
    }
    Fail:
    {
        Return With Fail (Fail while opening scan job options!)
    }
    Error:
    {
        Return With Error (Error while opening scan job options!)
    }

    // open the options screen
    If: Oxpd.Wait For Css (button#Options,${Short_Wait_Time})
    {
        Oxpd.Touch ID (Options)
        
        // wait for the button to show Hide Options text
        Oxpd.Wait For Css (div#Options,${Short_Wait_Time})
        Oxpd.Return Browser Engine
        Return With Pass (Open Scan Options complete!)
    }
    Fail:
    {
        Oxpd.Return Browser Engine
        Return With Fail (Fail while opening scan job options!)
    }
    Error:
    {
        Oxpd.Return Browser Engine
        Return With Error (Error while opening scan job options!)
    }
}

/// <Name>CloseScanOptions</Name>
/// <Description>Close the scan options screen</Description>
/// <Parameters></Parameters>
/// <Precondition>Already in the scan options screen</Precondition>
/// <Notes></Notes>
CloseScanOptions
{
    If: Oxpd.Get Browser Engine
    {
    }
    Fail:
    {
        Return With Fail (Fail while closing scan options!)
    }
    Error:
    {
        Return With Error (Error while closing scan options!)
    }

    // close the options screen
    If: Oxpd.Touch ID (HideOptions)
    {
        // wait for the Scan Options button to display
        Oxpd.Wait For Css (button#Options,${Short_Wait_Time})
        Oxpd.Return Browser Engine
        Return With Pass (Close Scan Options complete!)
    }
    Fail:
    {
        Oxpd.Return Browser Engine
        Return With Fail (Fail while closing scan options!)
    }
    Error:
    {
        Oxpd.Return Browser Engine
        Return With Error (Error while closing scan options!)
    }
}

/// <Name>SelectScanOption</Name>
/// <Description>Select the specified option from the scan options screen</Description>
/// <Parameters>OptionText : text of option</Parameters>
/// <Precondition>Oxpd.Get Browser a has been executed</Precondition>
/// <Notes>Called by multiple routines in this library</Notes>
SelectScanOption (${OptionText})
{
    If: Oxpd.Wait For Css (div#Options,${Minimal_Wait_Time})
    {
        @Oxpd.Touch Text (${OptionText})
        // short delay to ensure the option screen displays
        Sleep (${Minimal_Wait_Time})
        // if still not displayed then swipe up to 4 pages
        While:Oxpd.Wait For Css (div#Options,${Minimal_Wait_Time}):4
        {
            JediOmni.Drag (50,80,50,20)
            @Oxpd.Touch Text (${OptionText})
            // short delay for possible screen change
            Sleep (${Minimal_Wait_Time})
        }

        // check for in specified option screen
        If: Oxpd.Wait For Text (${OptionText},${Minimal_Wait_Time})
        {
            Return With Pass (Select Scan Option '${OptionText}' complete!)
        }
        Fail:
        {
            Return With Fail (Fail while selecting the specified scan option '${OptionText}'!)
        }
        Error:
        {
            Return With Error (Error while selecting specified scan option '${OptionText}'!)
        }
    }
    Fail:
    {
        Return With Fail (Fail while selecting specified scan option '${OptionText}'!)
    }
    Error:
    {
        Return With Error (Error while selecting specified scan option '${OptionText}'!)
    }
}

/// <Name>SetScanOption_FileType</Name>
/// <Description>Set the File Type</Description>
/// <Parameters>FileType : type text</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
SetScanOption_FileType (${FileType})
{
    // check for option specified
    If: Common_LIbrary.CheckVariableContainsValue (${FileType})
    {
    }
    Fail:
    {
        Return With Pass (No FileType specified!)
    }
    
    If: Oxpd.Get Browser Engine
    {
    }
    Fail:
    {
        Return With Fail (Fail while selecting File Type scan option!)
    }
    Error:
    {
        Return With Error (Error while selecting File Type scan option!)
    }

    If: WA_BoxScan_Library.SelectScanOption (File Type and Resolution)
    {
        // check for type already selected
        Oxpd.Get Text (fileTypeValue,${CurrentFileType})
        Replace (${CurrentFileType},",)
        Trim (${CurrentFileType})
        
        If: Equals (${CurrentFileType},${FileType})
        {// type already selected
            Oxpd.Touch ID (Done)
            Oxpd.Wait For Text Gone (Done,${Short_Wait_Time})
            Oxpd.Return Browser Engine
            Return With Pass (Set Scan Option File Type complete!)
        }
        Fail:
        {// type not already selected
            Oxpd.Touch ID (fileTypeValue)
            Oxpd.Wait For CSS (#FileTypeHeader,${Short_Wait_Time})
            Sleep (${Minimal_Wait_Time})
            
            // find the file type in the list
            // loop trying to select the specified item
            // and scrolling the screen until the item
            // has been set to the active (selected) item
            @Oxpd.Touch Text (${FileType})
            While:!Oxpd.Wait For Xpath (//li[contains\(@class\,"active-list"\)]/div[text\(\)="${FileType}"],${Minimal_Wait_Time}):4
            {
                JediOmni.Drag (50,80,50,20)
                Sleep (${Minimal_Wait_Time})
                @Oxpd.Touch Text (${FileType})
            }
            
            // verify the specified item is selelcted
            If: Oxpd.Wait For Xpath (//li[contains\(@class\,"active-list"\)]/div[text\(\)="${FileType}"],${Minimal_Wait_Time})
            {
                // succuss, close and return to the Options screen
                Oxpd.Touch ID (Done)
                Sleep (${Minimal_Wait_Time})
                Oxpd.Touch ID (Done)
                Oxpd.Wait For Css (div#Options,${Short_Wait_Time})
                Oxpd.Return Browser Engine
                Return With Pass (Set Scan Option File Type '${FileType}' complete!)
            }
            Fail:
            {
                // failure backout and return to the Options screen
                Oxpd.Touch Css (.back)
                Sleep (${Minimal_Wait_Time})
                Oxpd.Touch ID (Done)
                Oxpd.Wait For Css (div#Options,${Short_Wait_Time})
                Oxpd.Return Browser Engine
                Return With Fail (Fail while selecting File Type scan option '${FileType}'!)
            }
            Error:
            {
                // error backout and return to the Options screen
                Oxpd.Touch Css (.back)
                Sleep (${Minimal_Wait_Time})
                Oxpd.Touch ID (Done)
                Oxpd.Wait For Css (div#Options,${Short_Wait_Time})
                Oxpd.Return Browser Engine
                Return With Error (Error while selecting File Type scan option '${FileType}'!)
            }
        }
    }
    Fail:
    {
        Oxpd.Return Browser Engine
        Return With Fail (Fail while selecting File Type scan option!)
    }
    Error:
    {
        Oxpd.Return Browser Engine
        Return With Error (Error while selecting File Type scan option!)
    }
}

/// <Name>SetScanOption_FileType</Name>
