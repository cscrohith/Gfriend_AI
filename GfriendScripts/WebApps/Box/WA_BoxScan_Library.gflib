/// <Name>SetScanOption_Orientation</Name>
/// <Description>Set the orientation option</Description>
/// <Parameters>Orientation : orientation text</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
SetScanOption_Orientation (${Orientation})
{
    // check for option specified
    If: Common_LIbrary.CheckVariableContainsValue (${Orientation})
    {
    }
    Fail:
    {
        Return With Pass (No Orientation specified)
    }
    
    If: Oxpd.Get Browser Engine
    {
    }
    Fail:
    {
        Return With Fail (Fail while selecting Orientation scan option!)
    }
    Error:
    {
        Return With Error (Error while selecting Orientation scan option!)
    }
    
    // drag slightly to work around an issue clicking when list at top
    JediOmni.Drag (50,80,50,60)
    
    If: WA_BoxScan_Library.SelectScanOption (Content Orientation)
    {
        // find the file type in the list
        If: Equals IgnoreCase (${Orientation},Landscape)
        {
            Oxpd.Touch Id (Landscape)
        }
        Fail:
        {
            Oxpd.Touch Id (Portrait)
        }
        
        Oxpd.Touch ID (Done)
        Oxpd.Wait For Css (div#Options,${Short_Wait_Time})
        Oxpd.Return Browser Engine
        Return With Pass (Set Scan Option Orientation '${Orientation}' complete!)
    }
    Fail:
    {
        Oxpd.Return Browser Engine
        Return With Fail (Fail while selecting Orientation scan option!)
    }
    Error:
    {
        Oxpd.Return Browser Engine
        Return With Error (Error while selecting Orientation scan option!)
    }
}

/// <Name>InitiateScanJob</Name>
/// <Description>Initiate a scan job</Description>
/// <Parameters></Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
InitiateScanJob
{
    If: Oxpd.Get Browser Engine
    {
    }
    Fail:
    {
        Return With Fail (Fail while initaiting scan job!)
    }
    Error:
    {
        Return With Error (Error while initaiting scan job!)
    }

    // slight delay to ensure button is avaliable
    Sleep (${Minimal_Wait_Time})
    
    // press the Scan button
    If: Oxpd.Touch ID (Scan)
    {
        Oxpd.Wait For Css (#scanJob,${Wait_Time})
    
        Oxpd.Return Browser Engine
        Return With Pass (Initiate Scan Job complete!)
    }
    Fail:
    {
        Oxpd.Return Browser Engine
        Return With Fail (Fail while initiating scan job!)
    }
    Error:
    {
        Oxpd.Return Browser Engine
        Return With Error (Error while initiating scan job!)
    }
}

/// <Name>SetFileName</Name>
/// <Description>Set the file name</Description>
/// <Parameters>ScanFilename : name of file(s) to save</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
SetFileName(${ScanFilename})
{
    // set the filename if needed
    If: Common_LIbrary.CheckVariableContainsValue (${ScanFilename})
    {
    }
    Fail:
    {
        // filename is not specified so leave as default
        Return With Pass (Set File Name complete - left as default!)
    }

    If: Oxpd.Get Browser Engine
    {
    }
    Fail:
    {
        Return With Fail (Fail while initaiting scan job!)
    }
    Error:
    {
        Return With Error (Error while initaiting scan job!)
    }
    
    // enter the filename
    Oxpd.Touch CSS (.file-name>input)
    // short delay to ensure the keyboard is available
    Sleep (${Minimal_Wait_Time})
    
    // check for need to clear the default file name
    Oxpd.Get Text (scanText,${ExistingFileName})
    If: Equals (${ExistingFileName},"")
    {
    }
    Fail:
    {
        // clear the filename texbox
        Repeat:25
        {
            JediOmni.Touch ID (hpid-keyboard-key-backspace)
        }
    }
    // enter the specified file name
    Oxpd.Input Text (${ScanFilename})
    
    JediOmni.Touch ID (hpid-keyboard-key-done)
    Sleep (${Minimal_Wait_Time})

    Oxpd.Return Browser Engine
    
    Return With Pass (Set File Name '${ScanFilename}' complete!)
}

/// <Name>ScanAndCompleteJob</Name>
/// <Description>Scan page(s) and complete the scan job</Description>
/// <Parameters>OptNumPagesionText : number of pages to scan</Parameters>
/// <Parameters>JobCompleteTimeout : number of seconds to wait for completion</Parameters>
/// <Precondition>scan job has been initiated, options and file name set</Precondition>
/// <Notes></Notes>
ScanAndCompleteJob(${NumPages}, ${JobCompleteTimeout})
{
    If: Oxpd.Get Browser Engine
    {
    }
    Fail:
    {
        Return With Fail (Fail while completing scan job!)
    }
    Error:
    {
        Return With Error (Error while completing scan job!)
    }

    // if only 1 page then complete without preview
    If: Equals (${NumPages},${Minimal_Wait_Time})
    {
        // press the scan button
        Oxpd.Touch ID (Send)

        // wait for the scanning screen to show/disappear
        If: JediOmni.Wait For Text (Scanning,${Wait_Time})
        {
            JediOmni.Wait For Text Gone (Scanning,${Long_Wait})
        }
    
        // clear the Add Pages screen if it appears
        If: JediOmni.Wait For Object (hpid-prompt-add-pages,${Wait_Time})
        {
            JediOmni.Touch ID (hpid-button-done)
        }
    }
    Fail:
    {
        // start the scan by pressing the preview frame
        Oxpd.Touch ID (Preview)
        
        // wait for the scanning screen to show/disappear
        If: JediOmni.Wait For Text (Scanning...,${Wait_Time})
        {
            JediOmni.Wait For Text Gone (Scanning...,${Long_Wait})
        }
        
        // clear the Add Pages screen if it appears
        If: JediOmni.Wait For Object (hpid-prompt-add-pages,${Wait_Time})
        {
            JediOmni.Touch ID (hpid-button-done)
        }
        
        // wait for the image preview screen
        If: JediOmni.Wait For Object (hpid-oxp-preview-dialog,${Wait_Time})
        {
            // at this point 1 page has been scanned into the preview
            // handle additional pages if necessary
            If: Equals (${NumPages},${Minimal_Wait_Time})
            {// 1 page, no action
            }
            Fail:
            {// multiple pages
                Repeat:${NumPages}
                {
                    If: Equals (${NumPages},${R})
                    {// last scan already done, no action
                    }
                    Fail:
                    {// add a page
                        JediOmni.Wait For Object Gone (#hpid-preview-button-add-pages.hp-disabled,${Long_Wait})
                        Sleep (${Minimal_Wait_Time})
                        JediOmni.Touch ID (hpid-preview-button-add-pages)
                        JediOmni.Wait For Object (hpid-button-scan,${Long_Wait})
                        JediOmni.Touch ID (hpid-button-scan)
                    }
                }
            }
        
            // all pages added, finish the scan
            JediOmni.Wait For Object Gone (#hpid-button-start.hp-disabled,${Long_Wait})
            Sleep (${Very_Short_Wait_Time})
            JediOmni.Touch ID (hpid-button-start)
        }
        Fail:
        {
            Oxpd.Return Browser Engine
            Return With Fail (Fail while accessing scan job preview!)
        }
        Error:
        {
            Oxpd.Return Browser Engine
            Return With Error (Error while accessing scan job preview!)
        }
    }
    
    // wait for the job to complete within the specified time
    //    If: Oxpd.Wait For Xpath (//*[@id="storage-description" or text\(\)="Scan Complete"],${JobCompleteTimeout})
    
    If: Oxpd.Wait For Xpath (//*[@id="scanJob"]/descendant::*[contains\(translate\(text\(\)\, "ABCDEFGHIJKLMNOPQRSTUVWXYZ"\, "abcdefghijklmnopqrstuvwxyz"\)\, "complete"\) or contains\(translate\(text\(\)\, "ABCDEFGHIJKLMNOPQRSTUVWXYZ"\, "abcdefghijklmnopqrstuvwxyz"\)\, "success"\)],${JobCompleteTimeout})
    {
        //        If: Oxpd.Wait For Text (Scan Complete,${Minimal_Wait_Time})
        
        If: Oxpd.Wait For Xpath (//*[@id="scanJob"]/descendant::*[contains\(translate\(text\(\)\, "ABCDEFGHIJKLMNOPQRSTUVWXYZ"\, "abcdefghijklmnopqrstuvwxyz"\)\, "complete"\) or contains\(translate\(text\(\)\, "ABCDEFGHIJKLMNOPQRSTUVWXYZ"\, "abcdefghijklmnopqrstuvwxyz"\)\, "success"\)], ${Minimal_Wait_Time})
        {
            Oxpd.Touch Id (scan-cancel-button)
        }
        Sleep (${Short_Wait_Time})
        Oxpd.Return Browser Engine
        Return With Pass (Complete Scan Job complete!)
    }
    Fail:
    {
        Oxpd.Return Browser Engine
        Return With Fail (Fail completing scan job with specified timeout!)
    }
    Error:
    {
        Oxpd.Return Browser Engine
        Return With Error (Error while completing scan job!)
    }
}
