/// <Name>SetScanOption_ColorBlack</Name>
/// <Description>Set the Color Black option</Description>
/// <Parameters>Color_Black : color/black text</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
SetScanOption_ColorBlack (${Color_Black})
{
    // check for option specified
    If: Common_LIbrary.CheckVariableContainsValue (${Color_Black})
    {
    }
    Fail:
    {
        Return With Pass (No Color Black specified)
    }
    
    If: Oxpd.Get Browser Engine
    {
    }
    Fail:
    {
        Return With Fail (Fail while selecting Color/Black scan option!)
    }
    Error:
    {
        Return With Error (Error while selecting Color/Black scan option!)
    }
    
    // drag slightly to work around an issue clicking when list at top
    JediOmni.Drag (50,80,50,60)
    
    If: WA_BoxScan_Library.SelectScanOption (Color/Black)
    {
        // scroll down for Black or Black Gray
        If: Contains (${Color_Black},Black)
        {
            JediOmni.Drag (50,80,50,20)
            Sleep (${Minimal_Wait_Time})
        }

        Oxpd.Touch Text (${Color_Black})
        Sleep (${Minimal_Wait_Time})
        
        // succuss, close and return to the Options screen
        Oxpd.Touch ID (Done)
        Oxpd.Wait For Css (div#Options,${Short_Wait_Time})
        
        Oxpd.Return Browser Engine
        Return With Pass (Set Scan Option Color/Black '${Color_Black}' complete!)
    }
    Fail:
    {
        Oxpd.Return Browser Engine
        Return With Fail (Fail while selecting Color/Black scan option!)
    }
    Error:
    {
        Oxpd.Return Browser Engine
        Return With Error (Error while selecting Color/Black scan option!)
    }
}

