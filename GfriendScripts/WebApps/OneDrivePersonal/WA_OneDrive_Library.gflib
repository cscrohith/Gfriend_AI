    }
    Fail:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserPW_Fail.png)
        Return With Fail (Fail entering Password in to OneDrive Personal app!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserPW_Error.png)
        Return With Error (Error entering Password in to OneDrive Personal app!)
    }
    
    If: Oxpd.Touch ID (i0118)
    {
        If: JediOmni.Wait For Object (hpid-keyboard-key-done,${Very_Short_Wait_Time})
        {
        }
        Fail:
        {
            // force the keyboard to display
            Oxpd.Press Enter Key
            JediOmni.Wait For Object (hpid-keyboard-key-done,${Very_Short_Wait_Time})
        }
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserPW_Fail.png)
        Return With Fail (Fail entering Password in to OneDrive Personal app!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserPW_Error.png)
        Return With Error (Error entering Password in to OneDrive Personal app!)
    }
    
    If: Oxpd.Input Text (${Login_PW})
    {
        // close the keyboard
        JediOmni.Touch ID (hpid-keyboard-key-done)
        Sleep (${Minimal_Wait_Time})
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserPW_Fail.png)
        Return With Fail (Fail entering Password in to OneDrive Personal app!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserPW_Error.png)
        Return With Error (Error entering Password in to OneDrive Personal app!)
    }
    
    // press the Sign in button and wait for it to disappear
    If: Oxpd.Touch Id (idSIButton9)
    {
        If: Oxpd.Wait For Css Gone (#idSIButton9[value="Sign in"],${Long_Wait})
        {
            Return With Pass (Enter Login User Password complete!)
        }
        Fail:
        {
            // Login failed
            JediOmni.Capture Screen Shot (EnterLoginUserPW_Fail.png)
            Return With Fail (Fail entering Password in to Onerive Personal app!)
        }
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserPW_Fail.png)
        Return With Fail (Fail entering Password in to OneDrive Personal app!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserPW_Error.png)
        Return With Error (Error entering Password in to OneDrive Personal app!)
    }
}

/// <Name>AppLogin</Name>
/// <Description>Log In to the app</Description>
/// <Parameters>ID : UserID</Parameters>
/// <Parameters>Pw : Password</Parameters>
/// <Precondition>Oxpd.Get Browser a has been executed</Precondition>
/// <Notes></Notes>
AppLogin(${ID},${Pw})
{
    // delay to allow the MS sign in page to display
    If: Oxpd.Wait For Css (form#i0281,${Long_Wait})
    {
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserPW_Fail.png)
        Return With Fail (Fail accessing the sign in page in OneDrive Personal app!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (EnterLoginUserPW_Error.png)
        Return With Error (Error accessing the sign page in OneDrive Personal app!)
    }
    
    // enter user ID
    If: WA_OneDrive_Library.EnterLoginUserID(${ID})
    {
    }
    Fail:
    {
        Return With Fail (Fail entering userID signing in to OneDrive Personal app!)
    }
    Error:
    {
        Return With Error (Error entering userID signing in to OneDrive Personal app!)
    }
    
    // enter password
    If: WA_OneDrive_Library.EnterLoginUserPW(${Pw})
    {
        // check for app permissions to MS account
        If: Oxpd.Check Screen Contains Text (Permissions requested)
        {
            Oxpd.Touch Id (idSIButton9)
            Oxpd.Wait For Id Gone (idSIButton9,${Long_Wait})
            //Oxpd.Wait For Xpath Gone (//*[contains\(text\(\)\,"Let this app access"\)],${Long_Wait})
        }
        
        // check for app access to MS account
        If: Oxpd.Check Screen Contains Text (Let this app access)
        {
            Oxpd.Touch Id (idBtn_Accept)
            Oxpd.Wait For Text Gone (Let this app access,${Long_Wait})
            //Oxpd.Wait For Xpath Gone (//*[contains\(text\(\)\,"Let this app access"\)],${Long_Wait})
        }
        
        // check for reduce num times sign in message
        If: Oxpd.Check Screen Contains Text (Do this to reduce)
        {
            Oxpd.Touch Id (idBtn_Back)
        }
        
        // check for Stay signed in page
        If: Oxpd.Check Screen Contains Text (Stay signed in)
        {
            Oxpd.Touch Id (idBtn_Back)
        }
        Return With Pass (App Login complete!)
    }
    Fail:
    {
        Return With Fail (Fail entering userID signing in to OneDrive Personal app!)
    }
    Error:
    {
        Return With Error (Error entering userID signing in to OneDrive Personal app!)
    }
}

/// <Name>ClearGuide</Name>
/// <Description>Clear the app guide screen</Description>
/// <Parameters></Parameters>
/// <Precondition>Oxpd.Get Browser a has been executed</Precondition>
/// <Notes></Notes>
ClearGuide
{
    // clear the guide screen if shown
    If: Oxpd.Wait For Xpath (//*[@id="guide" and not\(@hidden\)],${Minimal_Wait_Time})
    {
        // set the checkbox to not show again and close
        Oxpd.Touch Css (.checkbox)
        Oxpd.Touch ID (close-guide)
        Oxpd.Wait For Xpath (//*[@id="guide" and @hidden="hidden"],${Short_Wait_Time})
        
        Return With Pass (Clear Guide complete!)
    }
}

/// <Name>HandleSaveCredentials</Name>
/// <Description>Handle the save credentials screen</Description>
/// <Parameters>SaveYN : Y to save the credentials</Parameters>
/// <Precondition>Oxpd.Get Browser a has been executed</Precondition>
/// <Notes></Notes>
HandleSaveCredentials(${SaveYN})
{
    // check the option to not show again
    OXPd.Touch ID (rememberCheckBox)
    If: Equals(${SaveYN},Y)
    {
        Oxpd.Touch Xpath (//*[@id="RememberMe"]//descendant::button[text\(\)="Save"])
    }
    Fail:
    {
        Oxpd.Touch Xpath (//*[@id="RememberMe"]//descendant::button[text\(\)="No thanks"])
    }
    
    Return With Pass (HandleSaveCredentials complete!)
}

/// <Name>HandleAppOpening</Name>
/// <Description>Handle the app opening</Description>
/// <Parameters>UserID : UserID/Username</Parameters>
/// <Parameters>UserPW : Password</Parameters>
/// <Parameters>SaveAccountYN : Y to save the credentials</Parameters>
/// <Parameters>VerifySIOConnect : Y to check for successful SIO connection
///        if the Terms/Privacy, or EULA page shows SIO connecion
///        is not successful and routing returns with Fail
///    N - ignore checking SIO connection</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
HandleAppOpening(${UserID},${UserPW},${SaveAccountYN},${VerifySIOConnect})
{
    If: Oxpd.Get Browser Engine
    {
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (HandleAppOpening_Fail.png)
        Return With Fail (Fail while handling the OneDrive Personal app opening!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (HandleAppOpening_Error.png)
        Return With Error (Error while handling the OneDrive Personal app opening!)
    }
    
    If: Oxpd.Wait For Css (.loading-page,${Short_Wait_Time})
    {
        Oxpd.Wait For Css (#genericModel[style*="block"]\, #header.storage-onedrive,${Long_Wait})
    }

    If: Oxpd.Wait For Xpath (//*[@id="TermsOfUseAndPrivacyPolicy" and "${VerifySIOConnect}"="Y"],${Minimal_Wait_Time})
    {
        JediOmni.Capture Screen Shot (HandleAppOpening_Fail.png)
        Oxpd.Return Browser Engine
        Return With Fail (SIO connection Failed!)
    }
    
    // check for EULA screen
    If: Oxpd.Wait For Css (#TermsOfUseAndPrivacyPolicy,${Minimal_Wait_Time})
    {
        If: WA_OneDrive_Library.HandleAppEula
        {
        }
        Fail:
        {
            WA_OneDrive_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Fail (Fail while handling the EULA and Privacy Policy pages!)
        }
        Error:
        {
            WA_OneDrive_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Error (Error while handling the EULA and Privacy Policy pages!)
        }
    }
    
    // check for popup stating leaving HP environment
    If: Oxpd.Wait For Css (#genericModel[style*="block"],${Minimal_Wait_Time})
    {
        // press Done on the popup
        Oxpd.Touch Id (done-button)
        Oxpd.Wait For Css Gone (#genericModel[style*="block"],${Wait_Time})
        
        // attempt to sign in
        If: WA_OneDrive_Library.AppLogin(${UserID},${UserPW})
        {
        }
        Fail:
        {
            WA_OneDrive_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Fail (Fail while signin in to the OneDrive Personal app!)
        }
        Error:
        {
            WA_OneDrive_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Error (Error while signin in to the OneDrive Personal app!)
        }
    }
    
    // login complete, wait for the app main page to display
    // check for app main screen
    If: Oxpd.Wait For Css (#header.storage-onedrive,${Long_Wait})
    {
        WA_OneDrive_Library.CheckForLoadingIcon
        
        If: Oxpd.Wait For Css (#RememberMe[style~="block;"],${Minimal_Wait_Time})
        {
            // handle the option to save app credentials
            If: WA_OneDrive_Library.HandleSaveCredentials(${SaveAccountYN})
            {
            }
            Fail:
            {
                WA_OneDrive_Library.CheckForServerLoss
                Oxpd.Return Browser Engine
                Return With Fail (Fail while saving app credentials OneDrive Personal app!)
            }
            Error:
            {
                WA_OneDrive_Library.CheckForServerLoss
                Oxpd.Return Browser Engine
                Return With Error (Error while saving app credentials OneDrive Personal app!)
            }
        }
        
        // clear the guide if shown
        If: WA_OneDrive_Library.ClearGuide
        {
            Oxpd.Return Browser Engine
            Return With Pass (Handle App Opening complete!)
        }
        Fail:
        {
            WA_OneDrive_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Fail (Fail accessing the OneDrive Personal app main screen!)
        }
        Error:
        {
            WA_OneDrive_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Error (Error accessing the OneDrive Personal app main screen!)
        }
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (HandleAppOpening_Fail.png)
        WA_OneDrive_Library.CheckForServerLoss
        Oxpd.Return Browser Engine
        Return With Fail (Fail accessing the OneDrive Personal app main screen!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (HandleAppOpening_Error.png)
        WA_OneDrive_Library.CheckForServerLoss
        Oxpd.Return Browser Engine
        Return With Error (Error accessing the OneDrive Personal app main screen!)
    }
}

/// <Name>AppExit</Name>
/// <Description>exit out of the app</Description>
/// <Parameters>BackOut_YN : Y to backout, else sign out</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
AppExit (${BackOut_YN})
{
    If: Oxpd.Get Browser Engine
    {
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (AppExit_Fail.png)
        Return With Fail (Fail while exiting OneDrive Personal app!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (AppExit_Error.png)
        Return With Error (Error while exiting OneDrive Personal app!)
    }
    
    // check for server connection loss
    If: WA_OneDrive_Library.CheckForServerLoss
    {
    }
    Fail:
    {
        Oxpd.Return Browser Engine
        Return With Fail (Fail while exiting OneDrive Personal app!)
    }
    Error:
    {
        Oxpd.Return Browser Engine
        Return With Error (Error while exiting OneDrive Personal app!)
    }
    
    // ensure at the main folder
    // since the ReturnToMainFolder routine
    // gets/returns the browser, must release
    // it here and get it again after
    Oxpd.Return Browser Engine
    WA_OneDrive_Library.ReturnToMainFolder
    Oxpd.Get Browser Engine
    
    // initiate backout or signout as specified
    If: Equals IgnoreCase (${BackOut_YN},Y)
    {
        // backout
        If: Oxpd.Touch Css (.back)
        {
        }
        Fail:
        {
            JediOmni.Capture Screen Shot (AppExit_Fail.png)
            Oxpd.Return Browser Engine
            Return With Fail (Fail while backing out of OneDrive Personal app!)
        }
        Error:
        {
            JediOmni.Capture Screen Shot (AppExit_Error.png)
            Oxpd.Return Browser Engine
            Return With Error (Error while backing out of OneDrive Personal app!)
        }
    }
    Fail:
    {
        // signout
        If:  Oxpd.Touch ID(toggleDropdown)
        {
            Sleep (${Minimal_Wait_Time})
            Oxpd.Touch ID(SignOut)
        }
        Fail:
        {
            JediOmni.Capture Screen Shot (AppExit_Fail.png)
            Oxpd.Return Browser Engine
            Return With Fail (Fail while signing out of OneDrive Personal app!)
        }
        Error:
        {
            JediOmni.Capture Screen Shot (AppExit_Error.png)
            Oxpd.Return Browser Engine
            Return With Error (Error while signing out of OneDrive Personal app!)
        }
    }
    
    If: Oxpd.Wait For Css (#listViewExit[style*="block"],${Short_Wait_Time})
    {
        Oxpd.Touch Id (Exit)
    }
    If: Oxpd.Wait For Css (#listViewExitWithoutSignout[style*="block"],${Minimal_Wait_Time})
    {
        Oxpd.Touch Id (Exit1)
    }
    
    // delay to allow the main app screen to clear
    // then force to the Home screen
    // because the app does not fully close on its own
    // this should be reworked when the app closes correctly
    Sleep (${Short_Wait_Time})
    
    // check for the app screen still visible
    If: JediOmni.Wait For Object (.hp-oxpd-app-screen,${Zero_Wait_Time})
    {
        // check for the option to pick an account
        If: Oxpd.Check Screen Contains Text (Pick an account)
        {
            //            Oxpd.Touch Text (Signed in)
            Oxpd.Touch Xpath (//*[@id="tilesHolder"]//descendant::div[@class="table-row"][1])
            //        Oxpd.Wait For Text (You signed out of your account,${Wait_Time})
        }
    }
    Oxpd.Return Browser Engine
    
    JediOmni.Wait For Object (hpid-homescreen-logo-icon,${Wait_Time})
    JediOmni.Press Home Key
    Sleep (${Very_Short_Wait_Time})
    Return With Pass (App Exit complete!)
}

/// <Name>ReturnToMainFolder</Name>
/// <Description>Return to the app main screen</Description>
/// <Parameters></Parameters>
/// <Precondition>Oxpd.Get Browser a has been executed</Precondition>
/// <Notes></Notes>
ReturnToMainFolder
{
    If: Oxpd.Get Browser Engine
    {
    }
    Fail:
    {
        JediOmni.Capture Screen Shot (ReturnToMainFolder_Fail.png)
        Return With Fail (Fail while returning to the main folder!)
    }
    Error:
    {
        JediOmni.Capture Screen Shot (ReturnToMainFolder_Error.png)
        Return With Error (Error while returning to the main folder!)
    }
    
    WA_OneDrive_Library.CheckForServerLoss
    
    // job has completed
    While:!Oxpd.Wait For XPath (//*[@id="StorageLogo" and not\(@hidden\)],${Minimal_Wait_Time}):10
    {
        Oxpd.Touch Css (.back)
        
        WA_OneDrive_Library.CheckForLoadingIcon
    }
    
    Oxpd.Return Browser Engine
    
    Return With Pass (Return to Main Folder complete!)
}

/// <Name>EnterSearch</Name>
/// <Description>Enter the search text</Description>
/// <Parameters>SearchText : text to search</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
EnterSearch(${SearchText})
{
