        If: Oxpd.Wait For Xpath (//*[@id="file-listing"]/ul/li/div,${Long_Wait})
        {
            Sleep (${Very_Short_Wait_Time})
            Oxpd.Touch Xpath (//*[@id="file-listing"]/ul/li/div)
            WA_OneDrive_Library.CheckForLoadingIcon

            // verify that the specified folder was entered
            // this does not work as of 11/23
//            //            Oxpd.Get Text (listViewHeaderContent,${EnteredFolderName})
//            Oxpd.Get Text (storage-description,${EnteredFolderName})
//            Replace (${EnteredFolderName},",)
//            Trim (${EnteredFolderName})
//            
//            If: Equals IgnoreCase (${EnteredFolderName},${FolderName})
//            {// success
                Oxpd.Return Browser Engine
                Return With Pass (Search Folder complete!)
//            }
//            Fail:
//            {
//                WA_OneDrive_Library.CheckForServerLoss
//                JediOmni.Capture Screen Shot (SearchFolder_Fail.png)
//                Oxpd.Return Browser Engine
//                Return With Fail (Fail while searching for folder!)
//            }
//            Error:
//            {
//                WA_OneDrive_Library.CheckForServerLoss
//                JediOmni.Capture Screen Shot (SearchFolder_Error.png)
//                Oxpd.Return Browser Engine
//                Return With Error (Error while searching for folder!)
//            }
        }
        Fail:
        {
            JediOmni.Capture Screen Shot (SearchFolder_Fail.png)
            WA_OneDrive_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Fail (Fail while searching for folder '${FolderName}'!)
        }
        Error:
        {
            JediOmni.Capture Screen Shot (SearchFolder_Error.png)
            WA_OneDrive_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Error (Error while searching for folder '${FolderName}'!)
        }
    }
    Fail:
    {
        WA_OneDrive_Library.CheckForServerLoss
        Oxpd.Return Browser Engine
        Return With Fail (Fail while searching for folder '${FolderName}'!)
    }
    Error:
    {
        WA_OneDrive_Library.CheckForServerLoss
        Oxpd.Return Browser Engine
        Return With Error (Error while searching for folder '${FolderName}'!)
    }
}

/// <Name>SearchFolder</Name>
/// <Description>Search for a folder and select it</Description>
/// <Parameters>FileName : file name</Parameters>
/// <Precondition></Precondition>
/// <Notes></Notes>
SearchFile(${FileName})
{
    If: WA_OneDrive_Library.EnterSearch(${FileName})
    {
        If: Oxpd.Get Browser Engine
        {
        }
        Fail:
        {
            JediOmni.Capture Screen Shot (SearchFile_Fail.png)
            Return With Fail (Fail while searching for file!)
        }
        Error:
        {
            JediOmni.Capture Screen Shot (SearchFile_Error.png)
            Return With Error (Error while searching for file!)
        }
        
        // check for app/connection issue messages
        If: WA_OneDrive_Library.CheckForServerLoss
        {
        }
        Fail:
        {
            Oxpd.Return Browser Engine
            Return With Fail (Fail while searching for a file!)
        }
        Error:
        {
            Oxpd.Return Browser Engine
            Return With Error (Error while searching for a file!)
        }

        If: Oxpd.Wait For Xpath (//*[@id="file-listing"]/ul/li/div,${Long_Wait})
        {
            Sleep (${Very_Short_Wait_Time})
            Oxpd.Touch Xpath (//*[@id="file-listing"]/ul/li/div)
            
            If: Oxpd.Wait For Css (#PrintOptions,${Long_Wait})
            {// success
                Oxpd.Return Browser Engine
                Return With Pass (Search File complete!)
            }
            Fail:
            {
                JediOmni.Capture Screen Shot (SearchFile_Fail.png)
                WA_OneDrive_Library.CheckForServerLoss
                Oxpd.Return Browser Engine
                Return With Fail (Fail while searching for a file '${FileName}'!)
            }
            Error:
            {
                JediOmni.Capture Screen Shot (SearchFile_Error.png)
                WA_OneDrive_Library.CheckForServerLoss
                Oxpd.Return Browser Engine
                Return With Error (Error while searching for a file '${FileName}'!)
            }
        }
        Fail:
        {
            JediOmni.Capture Screen Shot (SearchFile_Fail.png)
            WA_OneDrive_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Fail (Fail while searching for a file '${FileName}'!)
        }
        Error:
        {
            JediOmni.Capture Screen Shot (SearchFile_Error.png)
            WA_OneDrive_Library.CheckForServerLoss
            Oxpd.Return Browser Engine
            Return With Error (Error while searching for a file '${FileName}'!)
        }
    }
    Fail:
    {
        WA_OneDrive_Library.CheckForServerLoss
        Oxpd.Return Browser Engine
        Return With Fail (Fail while searching for a file '${FileName}'!)
    }
    Error:
    {
        WA_OneDrive_Library.CheckForServerLoss
        Oxpd.Return Browser Engine
        Return With Error (Error while searching for a file '${FileName}'!)
    }
}
